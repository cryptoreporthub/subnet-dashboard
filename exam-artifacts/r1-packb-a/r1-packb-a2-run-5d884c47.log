r,\\n    sources: Optional[List[str]] = None,\\n    disputed: bool = False,\\n    negative_since: Optional[str] = None,\\n    refresh_incomplete: bool = False,\\n) -> Dict[str, Any]:\\n    return {\\n        \\\"validity\\\": validity,\\n        \\\"sources\\\": list(sources or []),\\n        \\\"disputed\\\": disputed,\\n        \\\"negative_since\\\": negative_since,\\n        \\\"refresh_incomplete\\\": refresh_incomplete,\\n    }\\n\\n\\ndef _merge_sources(\\n    prior: Optional[Dict[str, Any]],\\n    *,\\n    tmc_positive: Optional[bool],\\n    probe_positive: Optional[bool],\\n) -> Tuple[str, List[str], bool, Optional[str], bool]:\\n    \\\"\\\"\\\"Return validity, sources, disputed, negative_since, refresh_incomplete.\\\"\\\"\\\"\",\"startLine\":80,\"endLine\":200,\"totalLines\":849,\"truncated\":false,\"source\":\"fixture\"}",
