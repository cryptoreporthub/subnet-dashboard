          "output": "{\"ok\":true,\"path\":\"tests/test_subnet_universe.py\",\"sha\":\"dca882a04a483325e4a9190c5d2e461bd1eb2b99\",\"text\":\"\\ndef test_t4_no_truncation_above_max_netuids(universe_tmp):\\n  \\\"\\\"\\\"Membership keeps every netuid the sources return; MAX_NETUIDS bounds the probe only.\\\"\\\"\\\"\\n  big = list(range(250))\\n  builder = SnapshotBuilder(\\n      tmc_fetch=lambda: (set(big), {n: {\\\"netuid\\\": n} for n in big}, True),\\n      probe_fetch=lambda netuids, deadline: ({n: True for n in netuids}, True),\\n  )\\n  built = builder.build(None).snapshot\\n  assert len(built.netuids) == 250\\n  assert built.cap_reached is False\\n\\n\\ndef test_t5_corrupt_persistence_emergency_registry(universe_tmp, caplog):\\n  \\\"\\\"\\\"Invalid JSON on disk -> emergency_registry without crash.\\\"\\\"\\\"\\n  universe_tmp.write_text(\\\"{not-json\\\", encoding=\\\"utf-8\\\")\\n  provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n  snap = provider.get_snapshot()\\n  assert snap.status == \\\"emergency_registry\\\"\\n  good = _prior_snapshot([1, 2, 3])\\n  provider.replace_snapshot_for_tests(good, persist=True)\\n  with open(universe_tmp, \\\"r\\\", encoding=\\\"utf-8\\\") as handle:\\n    payload = json.load(handle)\\n  assert len(payload[\\\"netuids\\\"]) == 3\\n\\n\\ndef test_t6_concurrent_reads_during_write(universe_tmp):\\n  \\\"\\\"\\\"Readers never observe torn snapshots during publish.\\\"\\\"\\\"\\n  provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n  provider.replace_snapshot_for_tests(_prior_snapshot([1, 2, 3]))\\n  errors: list[str] = []\\n  stop = threading.Event()\\n\\n  def reader() -> None:\\n      while not stop.is_set():\\n          snap = provider.get_snapshot()\\n          netuids = list(snap.netuids)\\n          if netuids != sorted(netuids):\\n              errors.append(f\\\"unsorted: {netuids}\\\")\\n          if len(set(netuids)) != len(netuids):\\n              errors.append(f\\\"dupes: {netuids}\\\")\\n\\n  threads = [threading.Thread(target=reader) for _ in range(8)]\\n  for thread in threads:\\n      thread.start()\\n  for idx in range(20):\\n      provider.replace_snapshot_for_tests(_prior_snapshot(list(range(idx, idx + 5))))\\n  stop.set()\\n  for thread in threads:\\n      thread.join(timeout=2)\\n  assert not errors\\n\\n\\ndef test_t7_api_sort_filter_compat():\\n  \\\"\\\"\\\"_apply_subnets_query sort/filter unchanged apart from membership count.\\\"\\\"\\\"\\n  from starlette.requests import Request\\n\\n  from server import _apply_subnets_query\\n\\n  base = {\\n      \\\"items\\\": [{\\\"id\\\": n, \\\"netuid\\\": n, \\\"emission\\\": n * 10, \\\"status\\\": \\\"active\\\"} for n in range(5)],\\n      \\\"feed_meta\\\": {\\\"source\\\": \\\"blockmachine\\\", \\\"sources\\\": [\\\"blockmachine\\\"], \\\"universe_status\\\": \\\"ok\\\"},\\n  }\\n  scope = {\\n      \\\"type\\\": \\\"http\\\",\\n      \\\"method\\\": \\\"GET\\\",\\n      \\\"path\\\": \\\"/api/subnets\\\",\\n      \\\"headers\\\": [],\\n      \\\"query_string\\\": b\\\"sort=emission&order=desc&limit=2&offset=1\\\",\\n  }\\n  request = Request(scope)\\n  out = _apply_subnets_query(base, request)\\n  assert out[\\\"meta\\\"][\\\"total\\\"] == 5\\n  assert out[\\\"meta\\\"][\\\"universe_status\\\"] == \\\"ok\\\"\\n  assert [row[\\\"netuid\\\"] for row in out[\\\"subnets\\\"]] == [3, 2]\\n\\n\\ndef test_t8_partial_refresh_does_not_start_removal_clock(universe_tmp):\\n  \\\"\\\"\\\"Timeout/incomplete refresh must not mark unobserved members invalid.\\\"\\\"\\\"\\n  prior = _prior_snapshot([10, 11, 12])\\n  builder = SnapshotBuilder(\\n      tmc_fetch=lambda: (set(), {}, False),\\n      probe_fetch=lambda netuids, deadline: ({10: None, 11: None, 12: None}, False),\\n  )\\n  built = builder.build(prior).snapshot\\n  assert built.refresh_incomplete is True\\n  for netuid in (10, 11, 12):\\n      entry = built.validity_map[str(netuid)]\\n      assert entry[\\\"validity\\\"] in (\\\"positive\\\", \\\"unobserved\\\")\\n      assert entry.get(\\\"negative_since\\\") in (None, \\\"\\\")\\n\\n\\ndef test_t9_chain_unregistered_beats_tmc_listing(universe_tmp):\\n  \\\"\\\"\\\"Owner rule (2026-10-25): the chain wins. Unregistered on chain leaves expected now; the row keeps its 48h grace.\\\"\\\"\\\"\\n  prior = _prior_snapshot([42])\\n  builder = SnapshotBuilder(\\n      tmc_fetch=lambda: ({42}, {42: {\\\"netuid\\\": 42}}, True),\\n      probe_fetch=lambda netuids, deadline: ({42: False}, True),\\n  )\\n  built = builder.build(prior).snapshot\\n  assert 42 in built.netuids\\n  entry = built.validity_map[\\\"42\\\"]\\n  assert entry[\\\"validity\\\"] == \\\"negative\\\"\\n  assert entry[\\\"disputed\\\"] is True\\n  assert entry[\\\"negative_since\\\"]\\n\\n\\ndef test_sn7_off_chain_but_tmc_listed_leaves_expected_at_127_and_keeps_its_row(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"Owner rule (2026-10-25): SN7 is off chain while TMC lists it. Expected drops to 127; SN7's row keeps its grace.\\\"\\\"\\\"\\n    import internal.council.snapshot_coverage as cov\\n    import internal.subnet_universe as universe\\n\\n    netuids = list(range(1, 129))\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(netuids), {n: {\\\"netuid\\\": n} for n in netuids}, True),\\n        probe_fetch=lambda ns, deadline: ({n: n in netuids and n != 7 for n in ns}, True),\\n    )\\n    built = builder.build(_prior_snapshot(netuids)).snapshot\\n    assert built.validity_map[\\\"7\\\"][\\\"validity\\\"] == \\\"negative\\\"\\n    assert built.validity_map[\\\"7\\\"][\\\"disputed\\\"] is True\\n    assert built.validity_map[\\\"7\\\"][\\\"negative_since\\\"]\\n    assert 7 in built.netuids\\n\\n    monkeypatch.setattr(universe, \\\"get_snapshot\\\", lambda: built)\\n    receipt = cov.load_membership_receipt()\\n    assert len(receipt[\\\"expected_netuids\\\"]) == 127\\n    assert 7 not in receipt[\\\"expected_netuids\\\"]\\n    assert receipt[\\\"inactive_netuids\\\"] == [7]\\n\\n\\ndef test_chain_unregistered_tmc_listed_row_leaves_after_grace_and_stays_gone(universe_tmp):\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = _prior_snapshot([42, 43])\\n    prior = replace(\\n        prior,\\n        validity_map={\\n            **prior.validity_map,\\n            \\\"42\\\": _validity_entry(validity=\\\"negative\\\", sources=[\\\"taomarketcap\\\"], disputed=True, negative_since=old),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({42, 43}, {42: {\\\"netuid\\\": 42}, 43: {\\\"netuid\\\": 43}}, True),\\n        probe_fetch=lambda netuids, deadline: ({42: False, 43: True}, True),\\n    )\\n    first = builder.build(prior)\\n    assert 42 not in first.snapshot.netuids\\n    assert 43 in first.snapshot.netuids\\n    second = builder.build(first.snapshot).snapshot\\n    assert 42 not in second.netuids\\n\\n\\ndef test_partial_chain_read_never_marks_a_tmc_listed_netuid_negative(universe_tmp):\\n    prior = _prior_snapshot([42])\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({42}, {42: {\\\"netuid\\\": 42}}, True),\\n        probe_fetch=lambda netuids, deadline: ({}, False),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert built.validity_map[\\\"42\\\"][\\\"validity\\\"] != \\\"negative\\\"\\n\\n\\ndef test_chain_never_removes_root_even_if_a_probe_reports_it_unregistered(universe_tmp):\\n    prior = _prior_snapshot([0, 42])\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({0, 42}, {0: {\\\"netuid\\\": 0}, 42: {\\\"netuid\\\": 42}}, True),\\n        probe_fetch=lambda netuids, deadline: ({0: False, 42: True}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert 0 in built.netuids\\n    assert built.validity_map[\\\"0\\\"][\\\"validity\\\"] != \\\"negative\\\"\\n\\n\\ndef test_negative_validity_removal_after_grace(universe_tmp):\\n    \\\"\\\"\\\"Continuous negative validity removes member only after 48h grace.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(99,),\\n        rows=({\\\"netuid\\\": 99, \\\"name\\\": \\\"SN99\\\"},),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"99\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"],\\n                negative_since=old,\\n            )\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, True),\\n        probe_fetch=lambda netuids, deadline: ({99: False}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert 99 not in built.netuids\\n\\n\\ndef test_provider_grace_removal_via_refresh_once(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"Provider.refresh_once() must publish grace-eligible removals.\\\"\\\"\\\"\\n    monkeypatch.setattr(\\\"internal.subnet_universe._ci_or_test\\\", lambda: False)\\n    monkeypatch.setenv(\\\"RUN_MODE\\\", \\\"worker\\\")\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(99, 100),\\n        rows=(\\n            {\\\"netuid\\\": 99, \\\"name\\\": \\\"SN99\\\"},\\n            {\\\"netuid\\\": 100, \\\"name\\\": \\\"SN100\\\"},\\n        ),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"99\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\"],\\n                negative_since=old,\\n            ),\\n            \\\"100\\\": _validity_entry(validity=\\\"positive\\\", sources=[\\\"taomarketcap\\\"]),\\n        },\\n    )\\n    builder = Snap