(self) -> UniverseSnapshot:\\n        snap = self._snapshot\\n        if snap.status == \\\"emergency_registry\\\" or not snap.netuids:\\n            return UniverseSnapshot.emergency_registry(reason=\\\"no_usable_snapshot\\\")\",\"startLine\":600,\"endLine\":780,\"totalLines\":848,\"truncated\":false,\"source\":\"fixture\"}",
