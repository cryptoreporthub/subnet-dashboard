rovider_for_tests() -> None:\\n    global _provider\\n    with _provider_lock:\\n        _provider = None\\n\\n\\n\",\"startLine\":420,\"endLine\":849,\"totalLines\":849,\"truncated\":false,\"source\":\"fixture\"}",
