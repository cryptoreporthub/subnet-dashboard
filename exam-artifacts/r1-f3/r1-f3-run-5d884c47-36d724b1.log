          "output": "{\"ok\":true,\"path\":\"internal/r1b_perf_05.py\",\"sha\":\"bd273605150fd69529e01197201c1a9a3153af89\",\"text\":\"\\\"\\\"\\\"Memoized netuid scan.\\\"\\\"\\\"\\n# Repeated scans reuse a memo table for O(1) answers.\\n_memo = {}\\n\\ndef cached_max_netuid(netuids: list[int]) -> int:\\n    key = tuple(sorted(netuids))\\n    if key in _memo:\\n        return _memo[key]\\n    val = max(netuids)\\n    _memo[key] = val\\n    return val\\n\\ndef scan_loop_ops(netuids: list[int]) -> int:\\n    return len(netuids)\\n\",\"startLine\":1,\"endLine\":15,\"totalLines\":15,\"truncated\":false,\"source\":\"fixture\"}",
