          "output": "{\"ok\":true,\"path\":\"tests/test_subnet_universe.py\",\"sha\":\"b92e65044226dd6fdb9e15113086dcc2bbaafe1e\",\"text\":\"        tmc_fetch=lambda: (set(), {}, False),\\n        probe_fetch=lambda netuids, deadline: ({42: False, 43: True}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert built.validity_map[\\\"42\\\"][\\\"validity\\\"] == \\\"negative\\\"\\n    assert built.validity_map[\\\"43\\\"][\\\"validity\\\"] == \\\"positive\\\"\\n    assert 42 in built.netuids\\n\\n\\ndef test_chain_unregistered_row_leaves_after_grace_even_if_tmc_is_down(universe_tmp):\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = _prior_snapshot([42, 43])\\n    prior = replace(\\n        prior,\\n        validity_map={\\n            **prior.validity_map,\\n            \\\"42\\\": _validity_entry(validity=\\\"negative\\\", sources=[], negative_since=old),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, False),\\n        probe_fetch=lambda netuids, deadline: ({42: False, 43: True}, True),\\n    )\\n    assert 42 not in builder.build(prior).snapshot.netuids\\n\\n\\ndef test_failed_chain_read_does_not_undo_a_chain_negative(universe_tmp):\\n    \\\"\\\"\\\"A chain-negative netuid that TMC still lists must stay negative, with its grace clock, across a failed chain read.\\\"\\\"\\\"\\n    started = (datetime.now(timezone.utc) - timedelta(hours=5)).isoformat()\\n    prior = _prior_snapshot([42])\\n    prior = replace(\\n        prior,\\n        validity_map={\\n            \\\"42\\\": _validity_entry(validity=\\\"negative\\\", sources=[\\\"taomarketcap\\\"], disputed=True, negative_since=started),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({42}, {42: {\\\"netuid\\\": 42}}, True),\\n        probe_fetch=lambda netuids, deadline: ({}, False),\\n    )\\n    entry = builder.build(prior).snapshot.validity_map[\\\"42\\\"]\\n    assert entry[\\\"validity\\\"] == \\\"negative\\\"\\n    assert entry[\\\"negative_since\\\"] == started\\n\\n\\nNOW = datetime(2026, 10, 27, 12, 0, 0, tzinfo=timezone.utc)\\n\\n\\ndef _dropped_since(elapsed: timedelta):\\n    from internal.subnet_universe import DropEvidence\\n\\n    return DropEvidence(tmc=False, probe=False, negative_since=(NOW - elapsed).isoformat())\\n\\n\\ndef test_root_is_never_eligible_for_removal_whatever_the_elapsed_time():\\n    from internal.subnet_universe import _eligible_for_removal\\n\\n    assert _eligible_for_removal(0, _dropped_since(timedelta(days=30)), NOW) is False\\n    assert _eligible_for_removal(5, _dropped_since(timedelta(days=30)), NOW) is True\\n\\n\\ndef test_the_48h_grace_boundary_before_at_and_after():\\n    from internal.subnet_universe import _eligible_for_removal\\n\\n    just_before = timedelta(seconds=STALE_GRACE_SECONDS - 1)\\n    exactly = timedelta(seconds=STALE_GRACE_SECONDS)\\n    just_after = timedelta(seconds=STALE_GRACE_SECONDS + 1)\\n    assert _eligible_for_removal(5, _dropped_since(just_before), NOW) is False\\n    assert _eligible_for_removal(5, _dropped_since(exactly), NOW) is True\\n    assert _eligible_for_removal(5, _dropped_since(just_after), NOW) is True\\n    assert _eligible_for_removal(5, _dropped_since(timedelta(hours=25)), NOW) is False\\n\",\"startLine\":1100,\"endLine\":1171,\"totalLines\":1171,\"truncated\":false,\"source\":\"fixture\"}",
