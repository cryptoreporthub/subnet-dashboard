          "output": "{\"ok\":true,\"path\":\"tests/test_subnet_universe.py\",\"sha\":\"4c4d504eee36e0617dca66ad590c94f8f8d90845\",\"text\":\"  request = Request(scope)\\n  out = _apply_subnets_query(base, request)\\n  assert out[\\\"meta\\\"][\\\"total\\\"] == 5\\n  assert out[\\\"meta\\\"][\\\"universe_status\\\"] == \\\"ok\\\"\\n  assert [row[\\\"netuid\\\"] for row in out[\\\"subnets\\\"]] == [3, 2]\\n\\n\\ndef test_t8_partial_refresh_does_not_start_removal_clock(universe_tmp):\\n  \\\"\\\"\\\"Timeout/incomplete refresh must not mark unobserved members invalid.\\\"\\\"\\\"\\n  prior = _prior_snapshot([10, 11, 12])\\n  builder = SnapshotBuilder(\\n      tmc_fetch=lambda: (set(), {}, False),\\n      probe_fetch=lambda netuids, deadline: ({10: None, 11: None, 12: None}, False),\\n  )\\n  built = builder.build(prior).snapshot\\n  assert built.refresh_incomplete is True\\n  for netuid in (10, 11, 12):\\n      entry = built.validity_map[str(netuid)]\\n      assert entry[\\\"validity\\\"] in (\\\"positive\\\", \\\"unobserved\\\")\\n      assert entry.get(\\\"negative_since\\\") in (None, \\\"\\\")\\n\\n\\ndef test_t9_chain_unregistered_beats_tmc_listing(universe_tmp):\\n  \\\"\\\"\\\"Owner rule (2026-10-25): the chain wins. Unregistered on chain leaves expected now; the row keeps its 48h grace.\\\"\\\"\\\"\\n  prior = _prior_snapshot([42])\\n  builder = SnapshotBuilder(\\n      tmc_fetch=lambda: ({42}, {42: {\\\"netuid\\\": 42}}, True),\\n      probe_fetch=lambda netuids, deadline: ({42: False}, True),\\n  )\\n  built = builder.build(prior).snapshot\\n  assert 42 in built.netuids\\n\\n\\ndef test_sn7_off_chain_but_tmc_listed_leaves_expected_at_127_and_keeps_its_row(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"Owner rule (2026-10-25): SN7 is off chain while TMC lists it. Expected drops to 127; SN7's row keeps its grace.\\\"\\\"\\\"\\n    import internal.council.snapshot_coverage as cov\\n    import internal.subnet_universe as universe\\n\\n    netuids = list(range(1, 129))\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(netuids), {n: {\\\"netuid\\\": n} for n in netuids}, True),\\n        probe_fetch=lambda ns, deadline: ({n: n in netuids and n != 7 for n in ns}, True),\\n    )\\n    built = builder.build(_prior_snapshot(netuids)).snapshot\\n    assert built.validity_map[\\\"7\\\"][\\\"validity\\\"] == \\\"negative\\\"\\n    assert built.validity_map[\\\"7\\\"][\\\"disputed\\\"] is True\\n    assert built.validity_map[\\\"7\\\"][\\\"negative_since\\\"]\\n    assert 7 in built.netuids\\n\\n    monkeypatch.setattr(universe, \\\"get_snapshot\\\", lambda: built)\\n    receipt = cov.load_membership_receipt()\\n    assert len(receipt[\\\"expected_netuids\\\"]) == 127\\n    assert 7 not in receipt[\\\"expected_netuids\\\"]\\n    assert receipt[\\\"inactive_netuids\\\"] == [7]\\n\\n\\ndef test_chain_unregistered_tmc_listed_row_leaves_after_grace_and_stays_gone(universe_tmp):\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = _prior_snapshot([42, 43])\\n    prior = replace(\\n        prior,\\n        validity_map={\\n            **prior.validity_map,\\n            \\\"42\\\": _validity_entry(validity=\\\"negative\\\", sources=[\\\"taomarketcap\\\"], disputed=True, negative_since=old),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({42, 43}, {42: {\\\"netuid\\\": 42}, 43: {\\\"netuid\\\": 43}}, True),\\n        probe_fetch=lambda netuids, deadline: ({42: False, 43: True}, True),\\n    )\\n    first = builder.build(prior)\\n    assert 42 not in first.snapshot.netuids\\n    assert 43 in first.snapshot.netuids\\n    second = builder.build(first.snapshot).snapshot\\n    assert 42 not in second.netuids\\n\\n\\ndef test_partial_chain_read_never_marks_a_tmc_listed_netuid_negative(universe_tmp):\\n    prior = _prior_snapshot([42])\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({42}, {42: {\\\"netuid\\\": 42}}, True),\\n        probe_fetch=lambda netuids, deadline: ({}, False),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert built.validity_map[\\\"42\\\"][\\\"validity\\\"] != \\\"negative\\\"\\n\\n\\ndef test_chain_never_removes_root_even_if_a_probe_reports_it_unregistered(universe_tmp):\\n    prior = _prior_snapshot([0, 42])\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({0, 42}, {0: {\\\"netuid\\\": 0}, 42: {\\\"netuid\\\": 42}}, True),\\n        probe_fetch=lambda netuids, deadline: ({0: False, 42: True}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert built is not None\\n\\n\\ndef test_negative_validity_removal_after_grace(universe_tmp):\\n    \\\"\\\"\\\"Continuous negative validity removes member only after 48h grace.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(99,),\\n        rows=({\\\"netuid\\\": 99, \\\"name\\\": \\\"SN99\\\"},),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"99\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"],\\n                negative_since=old,\",\"startLine\":190,\"endLine\":300,\"totalLines\":1138,\"truncated\":false,\"source\":\"fixture\"}",
