ids(reader.call_fn(), at_hash)\\n    except Exception as exc:\\n        logger.warning(\\\"subnet_universe registration read failed: %s\\\", exc)\\n        return {}, False\\n    if outcome != \\\"ok\\\":\\n        return {}, False\\n    if deadline is not None and time.monotonic() >= deadline:\\n        return {}, False\\n    registered = set(members)\\n    observed: Dict[int, Optional[bool]] = {\\n        n: n in registered for n in netuids if n != ROOT_NETUID\\n    }\\n    for n in registered:\\n        if n not in observed:\\n            observed[n] = True\\n    return observed, True\\n\\n\\ndef _validity_entry(\\n    *,\\n    validity: str,\\n    sources: Optional[List[str]] = None,\\n    disputed: bool = False,\\n    negative_since: Optional[str] = None,\\n    refresh_incomplete: bool = False,\\n) -> Dict[str, Any]:\\n    return {\\n        \\\"validity\\\": validity,\\n        \\\"sources\\\": list(sources or []),\\n        \\\"disputed\\\": disputed,\\n        \\\"negative_since\\\": negative_since,\\n        \\\"refresh_incomplete\\\": refresh_incomplete,\\n    }\\n\\n\\ndef _merge_sources(\\n    prior: Optional[Dict[str, Any]],\\n    *,\\n    tmc_positive: Optional[bool],\\n    probe_positive: Optional[bool],\\n) -> Tuple[str, List[str], bool, Optional[str], bool]:\\n    \\\"\\\"\\\"Return validity, sources, disputed, negative_since, refresh_incomplete.\\\"\\\"\\\"\",\"startLine\":120,\"endLine\":200,\"totalLines\":851,\"truncated\":false,\"source\":\"fixture\"}",
