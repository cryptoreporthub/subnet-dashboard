--- /dev/null
+++ b/review-gate-bot/tests/r17-gate-order.test.ts
@@ -0,0 +1,214 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { computeGate, verdictAt, type PinnedVerdict } from "../bot/lib/gate.js";
+import { asComment, gateStateFrom } from "../bot/lib/gh.js";
+import { collectPinnedVerdicts, GATE_BOT_LOGIN, SIMIBOT_APP_ID, VERDICT_PIN_TEST_REF, type CommentLike } from "../bot/lib/verdicts.js";
+import { composeVerdictBody } from "../bot/tools/post_verdict.js";
+import { marker } from "../bot/lib/tag.js";
+
+const HEAD = "c4ae04cda0c81c4dcd0c48f9add9f46846da0cc2";
+const SIMIBOT = { login: "simibot[bot]", type: "Bot" as const };
+const SIMIBOT_APP = { id: SIMIBOT_APP_ID, slug: "simibot" };
+
+function mcBotComment(
+  id: number,
+  verdict: "PASS" | "MODIFY" | "FAIL",
+  createdAt: string,
+  updatedAt?: string,
+): CommentLike {
+  const body = `${marker("mc-verdict", HEAD)}\n${composeVerdictBody({
+    verdict,
+    headSha: HEAD,
+    body: "Review notes.",
+    skills: [{ skill: "adversarial-review", used: true, note: "ran" }],
+  })}`;
+  return {
+    id,
+    body,
+    createdAt,
+    updatedAt,
+    user: { login: `${GATE_BOT_LOGIN}`, type: "Bot" },
+    performedViaGithubApp: { slug: "simi-revision" },
+  };
+}
+
+function simibotMcComment(
+  id: number,
+  verdict: "PASS" | "MODIFY" | "FAIL",
+  createdAt: string,
+  updatedAt?: string,
+): CommentLike {
+  const body = `${verdict} at ${HEAD}\n<!-- mc-verdict:${HEAD} -->`;
+  return {
+    id,
+    body,
+    createdAt,
+    updatedAt,
+    user: SIMIBOT,
+    performedViaGithubApp: SIMIBOT_APP,
+  };
+}
+
+function gateWithMcComments(comments: CommentLike[]) {
+  return gateStateFrom({
+    headSha: HEAD,
+    comments,
+    reviews: [],
+    suite: "clean",
+    replitTaggedForSha: HEAD,
+    replitTaggedAt: "2026-10-26T04:00:00Z",
+  });
+}
+
+test("ordering uses createdAt only: edited PASS after later FAIL still leaves FAIL at the slot", () => {
+  const pinned = collectPinnedVerdicts({
+    reviews: [],
+    comments: [
+      {
+        id: 1,
+        body: `PASS at \`${HEAD}\``,
+        createdAt: "2026-10-26T04:00:00Z",
+        updatedAt: "2026-10-26T04:10:00Z",
+        user: { login: "cursor[bot]", type: "Bot" },
+        performedViaGithubApp: null,
+      },
+      {
+        id: 2,
+        body: `FAIL at \`${HEAD}\``,
+        createdAt: "2026-10-26T04:05:00Z",
+        user: { login: "cursor[bot]", type: "Bot" },
+        performedViaGithubApp: null,
+      },
+    ],
+    resolveSha: () => HEAD,
+  });
+  assert.deepEqual(
+    pinned.map((p) => p.verdict),
+    ["PASS", "FAIL"],
+  );
+  assert.equal(verdictAt(pinned, "cursor", HEAD), "FAIL");
+});
+
+test("two verdicts at the same createdAt disagreeing fail closed to FAIL", () => {
+  const t = "2026-10-26T04:00:00.000Z";
+  const pinned: PinnedVerdict[] = [
+    { reviewer: "mc", verdict: "PASS", headSha: HEAD, at: t },
+    { reviewer: "mc", verdict: "FAIL", headSha: HEAD, at: t },
+  ];
+  assert.equal(verdictAt(pinned, "mc", HEAD), "FAIL");
+});
+
+test("MC edited comment cannot supply PASS (gate bot marker form)", () => {
+  const passThenEdited = mcBotComment(1, "PASS", "2026-10-26T04:00:00Z", "2026-10-26T06:00:00Z");
+  const failNewer = mcBotComment(2, "FAIL", "2026-10-26T04:05:00Z");
+  const gate = gateWithMcComments([passThenEdited, failNewer]);
+  assert.equal(gate.mc, "FAIL");
+  assert.equal(gate.next, "blocked");
+});
+
+test("MC FAIL edited to PASS in place does not pin MC PASS", () => {
+  const failEditedToPass = simibotMcComment(1, "FAIL", "2026-10-26T04:00:00Z", "2026-10-26T06:00:00Z");
+  failEditedToPass.body = `PASS at ${HEAD}\n<!-- mc-verdict:${HEAD} -->`;
+  const pinned = collectPinnedVerdicts({ reviews: [], comments: [failEditedToPass], ref: VERDICT_PIN_TEST_REF }).filter((p) => p.reviewer === "mc");
+  assert.deepEqual(pinned, []);
+});
+
+test("later new MC PASS replaces an earlier FAIL on the same head (no sticky FAIL)", () => {
+  const fail = simibotMcComment(1, "FAIL", "2026-10-26T04:00:00Z");
+  const pass = simibotMcComment(2, "PASS", "2026-10-26T05:00:00Z");
+  const pinned = collectPinnedVerdicts({ reviews: [], comments: [fail, pass] }).filter((p) => p.reviewer === "mc");
+  assert.equal(pinned.at(-1)?.verdict, "PASS");
+  assert.equal(verdictAt(pinned, "mc", HEAD), "PASS");
+});
+
+test("owner Replit PASS still pins when the report comment was edited", () => {
+  const pinned = collectPinnedVerdicts({
+    reviews: [],
+    comments: [
+      {
+        id: 10,
+        body: `Replit: PASS at ${HEAD}`,
+        createdAt: "2026-10-26T04:00:00Z",
+        updatedAt: "2026-10-26T05:00:00Z",
+        user: { login: "cryptoreporthub", type: "User" },
+        performedViaGithubApp: null,
+      },
+    ],
+    resolveSha: () => HEAD,
+  });
+  assert.equal(pinned[0]?.reviewer, "replit");
+  assert.equal(pinned[0]?.verdict, "PASS");
+});
+
+test("gate replay case A (G2): edited MC PASS after FAIL must stay blocked", () => {
+  const raw = [
+    {
+      id: 1,
+      body: `PASS at ${HEAD}\n<!-- mc-verdict:${HEAD} -->`,
+      created_at: "2026-10-26T04:00:00Z",
+      updated_at: "2026-10-26T06:00:00Z",
+      user: SIMIBOT,
+      performed_via_github_app: SIMIBOT_APP,
+    },
+    {
+      id: 2,
+      body: `FAIL at ${HEAD}\n<!-- mc-verdict:${HEAD} -->`,
+      created_at: "2026-10-26T04:05:00Z",
+      user: SIMIBOT,
+      performed_via_github_app: SIMIBOT_APP,
+    },
+  ];
+  const gate = gateStateFrom({
+    headSha: HEAD,
+    comments: raw.map((c) => asComment(c)),
+    reviews: [],
+    suite: "clean",
+  });
+  assert.equal(gate.mc, "FAIL");
+  assert.equal(gate.next, "blocked");
+});
+
+test("gate replay case B (G4): edited PASS then newer FAIL stays blocked", () => {
+  const raw = [
+    {
+      id: 1,
+      body: `PASS at ${HEAD}\n<!-- mc-verdict:${HEAD} -->`,
+      created_at: "2026-10-26T04:00:00Z",
+      updated_at: "2026-10-26T04:02:00Z",
+      user: SIMIBOT,
+      performed_via_github_app: SIMIBOT_APP,
+    },
+    {
+      id: 2,
+      body: `FAIL at ${HEAD}\n<!-- mc-verdict:${HEAD} -->`,
+      created_at: "2026-10-26T04:05:00Z",
+      user: SIMIBOT,
+      performed_via_github_app: SIMIBOT_APP,
+    },
+  ];
+  const gate = gateStateFrom({
+    headSha: HEAD,
+    comments: raw.map((c) => asComment(c)),
+    reviews: [],
+    suite: "clean",
+  });
+  assert.equal(gate.mc, "FAIL");
+  assert.equal(gate.next, "blocked");
+});
+
+test("a newer MC PASS comment replaces an older FAIL on the same head in computeGate", () => {
+  const state = computeGate({
+    headSha: HEAD,
+    suite: "clean",
+    verdicts: [
+      { reviewer: "mc", verdict: "FAIL", headSha: HEAD, at: "2026-10-26T04:00:00Z" },
+      { reviewer: "mc", verdict: "PASS", headSha: HEAD, at: "2026-10-26T05:00:00Z" },
+      { reviewer: "cursor", verdict: "PASS", headSha: HEAD, at: "2026-10-26T04:10:00Z" },
+      { reviewer: "ditto", verdict: "PASS", headSha: HEAD, at: "2026-10-26T04:11:00Z" },
+    ],
+    replitTaggedForSha: HEAD,
+    replitTaggedAt: "2026-10-26T04:00:00Z",
+  });
+  assert.equal(state.mc, "PASS");
+  assert.notEqual(state.next, "blocked");
+});
diff --git a/review-gate-bot/tests/r18-verdict-pin.test.ts b/review-gate-bot/tests/r18-verdict-pin.test.ts
new file mode 100644
index 00000000..f17d159a
--- /dev/null
+++ b/review-gate-bot/tests/r18-verdict-pin.test.ts
@@ -0,0 +1,224 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { computeGate, verdictAt } from "../bot/lib/gate.js";
+import { gateStateFrom } from "../bot/lib/gh.js";
+import { hydrateVerdictPinsFromKv, MemoryVerdictPinStore } from "../bot/lib/verdict_pin.js";
+import postVerdict from "../bot/tools/post_verdict.js";
+import { collectPinnedVerdicts, CURSOR_BOT_LOGIN, VERDICT_PIN_TEST_REF, type CommentLike } from "../bot/lib/verdicts.js";
+
+const H1 = "a".repeat(40);
+const H2 = "b".repeat(40);
+const REF = VERDICT_PIN_TEST_REF;
+
+function cursorComment(id: number, body: string, createdAt: string, updatedAt?: string): CommentLike {
+  return {
+    id,
+    body,
+    createdAt,
+    updatedAt,
+    user: { login: CURSOR_BOT_LOGIN, type: "Bot" },
+    performedViaGithubApp: null,
+  };
+}
+
+function gateAt(head: string, comments: CommentLike[], store = new MemoryVerdictPinStore()) {
+  return gateStateFrom({
+    headSha: head,
+    comments,
+    reviews: [],
+    suite: "clean",
+    ref: REF,
+    pinStore: store,
+  });
+}
+
+test("row 1: Cursor PASS @ H1 edited to PASS @ H2 does not merge on H2", () => {
+  const store = new MemoryVerdictPinStore();
+  const first = cursorComment(1, `PASS at \`${H1}\``, "2026-10-26T04:00:00Z", "2026-10-26T04:00:00Z");
+  collectPinnedVerdicts({ reviews: [], comments: [first], ref: REF, pinStore: store, resolveSha: () => H1 });
+  const edited = cursorComment(1, `PASS at \`${H2}\``, "2026-10-26T04:00:00Z", "2026-10-26T06:00:00Z");
+  const gate = gateAt(H2, [edited], store);
+  assert.notEqual(gate.cursor, "PASS");
+  assert.notEqual(gate.next, "mergeable");
+});
+
+test("row 2: Ditto FAIL edited to PASS stays blocked", () => {
+  const store = new MemoryVerdictPinStore();
+  const fail = {
+    id: 2,
+    body: `FAIL at \`${H1}\``,
+    createdAt: "2026-10-26T04:00:00Z",
+    updatedAt: "2026-10-26T04:00:00Z",
+    user: { login: "cryptoreporthub", type: "User" as const },
+    performedViaGithubApp: { slug: "ditto-code", id: 3889634 },
+  } satisfies CommentLike;
+  collectPinnedVerdicts({ reviews: [], comments: [fail], ref: REF, pinStore: store, resolveSha: () => H1 });
+  const edited = { ...fail, body: `PASS at \`${H1}\``, updatedAt: "2026-10-26T05:00:00Z" };
+  const gate = gateAt(H1, [edited], store);
+  assert.equal(gate.ditto, "FAIL");
+  assert.equal(gate.next, "blocked");
+});
+
+test("row 3: MC firstSeen FAIL survives edit to junk", () => {
+  const store = new MemoryVerdictPinStore();
+  const fail = {
+    id: 3,
+    body: `FAIL at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    createdAt: "2026-10-26T04:00:00Z",
+    updatedAt: "2026-10-26T04:00:00Z",
+    user: { login: "simibot[bot]", type: "Bot" as const },
+    performedViaGithubApp: { id: 5501340, slug: "simibot" },
+  } satisfies CommentLike;
+  collectPinnedVerdicts({ reviews: [], comments: [fail], ref: REF, pinStore: store });
+  const junk = { ...fail, body: "Thanks, updated.", updatedAt: "2026-10-26T05:00:00Z" };
+  const gate = gateAt(H1, [junk], store);
+  assert.equal(gate.mc, "FAIL");
+  assert.equal(gate.next, "blocked");
+});
+
+test("row 4: edited MODIFY→PASS ignored; newer MODIFY comment wins", () => {
+  const store = new MemoryVerdictPinStore();
+  const modify = {
+    id: 4,
+    body: `MODIFY at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    createdAt: "2026-10-26T04:00:00Z",
+    updatedAt: "2026-10-26T04:00:00Z",
+    user: { login: "simibot[bot]", type: "Bot" as const },
+    performedViaGithubApp: { id: 5501340, slug: "simibot" },
+  } satisfies CommentLike;
+  const passNew = {
+    id: 5,
+    body: `PASS at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    createdAt: "2026-10-26T05:00:00Z",
+    user: { login: "simibot[bot]", type: "Bot" as const },
+    performedViaGithubApp: { id: 5501340, slug: "simibot" },
+  } satisfies CommentLike;
+  collectPinnedVerdicts({ reviews: [], comments: [modify, passNew], ref: REF, pinStore: store });
+  const edited = { ...modify, body: `PASS at ${H1}\n<!-- mc-verdict:${H1} -->`, updatedAt: "2026-10-26T06:00:00Z" };
+  const pinned = collectPinnedVerdicts({ reviews: [], comments: [edited, passNew], ref: REF, pinStore: store }).filter((p) => p.reviewer === "mc");
+  assert.equal(verdictAt(pinned, "mc", H1), "PASS");
+});
+
+test("row 5: same-second body hash change without timestamp bump fails closed on PASS upgrade", () => {
+  const store = new MemoryVerdictPinStore();
+  const fail = cursorComment(10, `FAIL at \`${H1}\``, "2026-10-26T04:00:00.000Z", "2026-10-26T04:00:00.000Z");
+  collectPinnedVerdicts({ reviews: [], comments: [fail], ref: REF, pinStore: store, resolveSha: () => H1 });
+  const passSameSecond = cursorComment(10, `PASS at \`${H1}\``, "2026-10-26T04:00:00.000Z", "2026-10-26T04:00:00.000Z");
+  const pinned = collectPinnedVerdicts({ reviews: [], comments: [passSameSecond], ref: REF, pinStore: store, resolveSha: () => H1 });
+  assert.equal(pinned.at(-1)?.verdict, "FAIL");
+});
+
+test("row 6: first sight already edited never records PASS", () => {
+  const editedPass = {
+    id: 11,
+    body: `PASS at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    createdAt: "2026-10-26T04:00:00Z",
+    updatedAt: "2026-10-26T05:00:00Z",
+    user: { login: "simibot[bot]", type: "Bot" as const },
+    performedViaGithubApp: { id: 5501340, slug: "simibot" },
+  } satisfies CommentLike;
+  const pinned = collectPinnedVerdicts({ reviews: [], comments: [editedPass], ref: REF, pinStore: new MemoryVerdictPinStore() });
+  assert.deepEqual(pinned.filter((p) => p.reviewer === "mc"), []);
+});
+
+test("row 3b: firstSeen PASS @ H1 kept when body edited to junk", () => {
+  const store = new MemoryVerdictPinStore();
+  const pass = {
+    id: 12,
+    body: `PASS at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    createdAt: "2026-10-26T04:00:00Z",
+    updatedAt: "2026-10-26T04:00:00Z",
+    user: { login: "simibot[bot]", type: "Bot" as const },
+    performedViaGithubApp: { id: 5501340, slug: "simibot" },
+  } satisfies CommentLike;
+  collectPinnedVerdicts({ reviews: [], comments: [pass], ref: REF, pinStore: store });
+  const junk = { ...pass, body: "noise", updatedAt: "2026-10-26T05:00:00Z" };
+  const gate = gateAt(H1, [junk], store);
+  assert.equal(gate.mc, "PASS");
+});
+
+test("T2: PASS without blocking field is allowed again (r10 schema)", async () => {
+  const execute = postVerdict.execute as unknown as (input: unknown, ctx: unknown) => Promise<unknown>;
+  const result = await execute(
+    {
+      headSha: H1,
+      verdict: "PASS",
+      body: "ok",
+      skills: [{ skill: "adversarial-review", used: true, note: "ran" }],
+    },
+    {
+      session: { purpose: "eval", continuationKey: undefined },
+      host: { github: { getOctokit: async () => { throw new Error("no"); } } },
+    },
+  );
+  assert.deepEqual(result, { posted: false, reason: "eval", verdict: "PASS" });
+});
+
+test("kv read failure is fail-closed for PASS", () => {
+  class FailStore extends MemoryVerdictPinStore {
+    override get(): undefined {
+      throw new Error("kv down");
+    }
+  }
+  const comment = cursorComment(20, `PASS at \`${H1}\``, "2026-10-26T04:00:00Z", "2026-10-26T04:00:00Z");
+  const pinned = collectPinnedVerdicts({
+    reviews: [],
+    comments: [comment],
+    ref: REF,
+    pinStore: new FailStore(),
+    resolveSha: () => H1,
+  });
+  assert.deepEqual(pinned, []);
+});
+
+test("MC fix A: PASS @ H1 then edit FAIL @ H1 then edit PASS @ H1 stays blocked", () => {
+  const store = new MemoryVerdictPinStore();
+  const pass = {
+    id: 30,
+    body: `PASS at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    createdAt: "2026-10-26T04:00:00Z",
+    updatedAt: "2026-10-26T04:00:00Z",
+    user: { login: "simibot[bot]", type: "Bot" as const },
+    performedViaGithubApp: { id: 5501340, slug: "simibot" },
+  } satisfies CommentLike;
+  collectPinnedVerdicts({ reviews: [], comments: [pass], ref: REF, pinStore: store });
+  const fail = {
+    ...pass,
+    body: `FAIL at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    updatedAt: "2026-10-26T05:00:00Z",
+  };
+  collectPinnedVerdicts({ reviews: [], comments: [fail], ref: REF, pinStore: store });
+  const passAgain = {
+    ...fail,
+    body: `PASS at ${H1}\n<!-- mc-verdict:${H1} -->`,
+    updatedAt: "2026-10-26T06:00:00Z",
+  };
+  const gate = gateAt(H1, [passAgain], store);
+  assert.equal(gate.mc, "FAIL");
+  assert.equal(gate.next, "blocked");
+});
+
+test("MC fix B: hydrate kv.get failure is fail-closed for PASS", async () => {
+  const store = new MemoryVerdictPinStore();
+  const comment = cursorComment(21, `PASS at \`${H1}\``, "2026-10-26T04:00:00Z", "2026-10-26T04:00:00Z");
+  await hydrateVerdictPinsFromKv({
+    kv: {
+      get: async () => {
+        throw new Error("kv down");
+      },
+      put: async () => {},
+      delete: async () => {},
+    },
+    ref: REF,
+    comments: [comment],
+    store,
+  });
+  const pinned = collectPinnedVerdicts({
+    reviews: [],
+    comments: [comment],
+    ref: REF,
+    pinStore: store,
+    resolveSha: () => H1,
+  });
+  assert.deepEqual(pinned, []);
+});
