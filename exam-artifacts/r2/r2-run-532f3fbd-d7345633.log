          "output": "{\"ok\":true,\"path\":\"tests/test_subnet_universe.py\",\"sha\":\"c308b207e1d5054a85064ad388414e6ec347e339\",\"text\":\"\\n    monkeypatch.setenv(\\\"RUN_MODE\\\", \\\"web\\\")\\n    reloaded = reader.reload_from_disk_if_stale()\\n    assert list(reloaded.netuids) == [10, 11, 12]\\n\\n\\ndef test_get_lkg_or_emergency_uses_provider_singleton(universe_tmp):\\n    provider = get_provider()\\n    provider.replace_snapshot_for_tests(_prior_snapshot([7, 8, 9]))\\n    snap = get_lkg_or_emergency()\\n    assert list(snap.netuids) == [7, 8, 9]\\n\\n\\ndef test_cold_start_empty_tmc_emergency_registry(universe_tmp):\\n    \\\"\\\"\\\"No prior snapshot + empty successful TMC => emergency_registry, never zero-member ok.\\\"\\\"\\\"\\n    built = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, True),\\n        probe_fetch=lambda netuids, deadline: ({}, True),\\n    ).build(None).snapshot\\n    assert built.status == \\\"emergency_registry\\\"\\n    assert len(built.netuids) == 0\\n    assert built.refresh_incomplete is True\\n    assert built.degraded is True\\n\\n\\ndef test_cold_start_empty_tmc_emergency_registry_via_provider(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"Provider on cold start must not publish zero-member ok snapshot.\\\"\\\"\\\"\\n    monkeypatch.setattr(\\\"internal.subnet_universe._ci_or_test\\\", lambda: False)\\n    monkeypatch.setenv(\\\"RUN_MODE\\\", \\\"worker\\\")\\n    provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n    snap = provider.get_snapshot()\\n    assert snap.status == \\\"emergency_registry\\\"\\n    assert len(snap.netuids) == 0\\n    assert snap.refresh_incomplete is True\\n    provider.set_builder(\\n        SnapshotBuilder(\\n            tmc_fetch=lambda: (set(), {}, True),\\n            probe_fetch=lambda netuids, deadline: ({}, True),\\n        )\\n    )\\n    result = provider.refresh_once()\\n    assert len(result.netuids) == 0\\n    assert result.refresh_incomplete is True\\n    assert result.degraded is True\\n    assert result.status != \\\"ok\\\"\\n\\n\\ndef test_tmc_fetch_bypasses_live_subnet_clip(monkeypatch):\\n    \\\"\\\"\\\"Universe membership must not inherit live_subnets 75-row clip.\\\"\\\"\\\"\\n    live_stub = [{\\\"netuid\\\": i} for i in range(75)]\\n    tmc_stub = [{\\\"netuid\\\": i} for i in range(130)]\\n    monkeypatch.setattr(\\\"fetchers.taomarketcap.get_all_subnets\\\", lambda: live_stub)\\n    monkeypatch.setattr(\\\"fetchers.taomarketcap._get_all_subnets_tao\\\", lambda: tmc_stub)\\n    from internal.subnet_universe import _default_tmc_fetch\\n\\n    netuids, _, complete = _default_tmc_fetch()\\n    assert complete\\n    assert len(netuids) == 130\\n    assert max(netuids) >= 129\\n\\n\\ndef test_build_probes_full_range_when_tmc_complete():\\n    \\\"\\\"\\\"TMC-complete refresh probes 0..MAX_NETUIDS-1 for subnets beyond TMC pagination.\\\"\\\"\\\"\\n    prior = _prior_snapshot(list(range(75)))\\n    probed: list[int] = []\\n\\n    def probe_fetch(netuids, deadline):\\n        probed.extend(netuids)\\n        return {n: True for n in netuids if n >= 125}, True\\n\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(range(75)), {n: {\\\"netuid\\\": n} for n in range(75)}, True),\\n        probe_fetch=probe_fetch,\\n    )\\n    built = builder.build(prior).snapshot\\n    assert max(probed) >= MAX_NETUIDS - 1\\n    assert len(built.netuids) > 75\\n\\n\\ndef test_lkg_empty_tmc_retains_full_snapshot_via_provider(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"Existing LKG + empty successful TMC must not publish zero-member ok snapshot.\\\"\\\"\\\"\\n    monkeypatch.setattr(\\\"internal.subnet_universe._ci_or_test\\\", lambda: False)\\n    monkeypatch.setenv(\\\"RUN_MODE\\\", \\\"worker\\\")\\n    prior = UniverseSnapshot(\\n        netuids=tuple(range(100, 160)),\\n        rows=tuple({\\\"netuid\\\": n, \\\"name\\\": f\\\"SN{n}\\\"} for n in range(100, 160)),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={},\\n    )\\n    provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n    provider.replace_snapshot_for_tests(prior, persist=True)\\n    provider.set_builder(\\n        SnapshotBuilder(\\n            tmc_fetch=lambda: (set(), {}, True),\\n            probe_fetch=lambda netuids, deadline: ({}, True),\\n        )\\n    )\\n    result = provider.refresh_once()\\n    assert len(result.netuids) == 60\\n    assert result.degraded is True\\n    assert result.status == \\\"degraded\\\"\\n    assert provider.get_snapshot().netuids == prior.netuids\\n\\n\\ndef test_build_rows_tags_tmc_source():\\n    \\\"\\\"\\\"TMC-backed universe rows carry taomarketcap source markers for feed meta.\\\"\\\"\\\"\\n    from internal.subnets.feed import subnet_enrichment_status, subnet_feed_meta\\n\\n    rows = _build_rows(\\n        [1, 2],\\n        {1: {\\\"netuid\\\": 1, \\\"volume\\\": 10}, 2: {\\\"netuid\\\": 2, \\\"price\\\": 0.01}},\\n    )\\n    assert all(r[\\\"source\\\"] == \\\"taomarketcap\\\" for r in rows)\\n    meta = subnet_feed_meta(rows)\\n    assert meta[\\\"source\\\"] == \\\"taomarketcap\\\"\\n    assert \\\"taomarketcap\\\" in meta[\\\"sources\\\"]\\n    assert subnet_enrichment_status(rows) == \\\"names_only\\\"\\n\\n\\ndef test_build_rows_preserves_membership_netuids():\\n    \\\"\\\"\\\"Source tagging must not add, drop, or reorder universe membership.\\\"\\\"\\\"\\n    netuids = [1, 74, 75, 80, 87, 90, 118]\\n    tmc = {n: {\\\"netuid\\\": n, \\\"volume\\\": 1.0} for n in netuids}\\n    rows = _build_rows(netuids, tmc)\\n    assert [int(r[\\\"netuid\\\"]) for r in rows] == netuids\\n    assert len(rows) == len(netuids)\\n\\n\\ndef test_universe_snapshot_feed_meta_tmc_backed_129_rows():\\n    \\\"\\\"\\\"129-row TMC membership must not report source=registry when rows lack markers.\\\"\\\"\\\"\\n    netuids = list(range(129))\\n    validity = {\\n        str(n): _validity_entry(validity=\\\"positive\\\", sources=[\\\"taomarketcap\\\"]) for n in netuids\\n    }\\n    snap = UniverseSnapshot(\\n        netuids=tuple(netuids),\\n        rows=tuple({\\\"netuid\\\": n, \\\"name\\\": f\\\"SN{n}\\\"} for n in netuids),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"degraded\\\",\\n        degraded=True,\\n        validity_map=validity,\\n    )\\n    meta = universe_snapshot_feed_meta(snap)\\n    assert meta[\\\"source\\\"] == \\\"taomarketcap\\\"\\n    assert \\\"taomarketcap\\\" in meta[\\\"sources\\\"]\\n    assert snap.netuids == tuple(netuids)\\n    assert len(snap.rows) == 129\\n\\n\\ndef test_emergency_registry_feed_meta_names_only():\\n    \\\"\\\"\\\"Emergency registry fallback stays source=registry.\\\"\\\"\\\"\\n    from internal.subnets.feed import subnet_enrichment_status\\n\\n    snap = UniverseSnapshot.emergency_registry()\\n    meta = universe_snapshot_feed_meta(snap)\\n    assert meta == {\\\"source\\\": \\\"registry\\\", \\\"sources\\\": [\\\"registry\\\"]}\\n    rows = list(snap.rows)\\n    assert subnet_enrichment_status(rows) == \\\"names_only\\\"\\n\\n\\ndef test_blockmachine_feed_meta_live_enrichment():\\n    \\\"\\\"\\\"Live/blockmachine row metadata behavior unchanged.\\\"\\\"\\\"\\n    from internal.subnets.feed import subnet_enrichment_status, subnet_feed_meta\\n\\n    rows = [{\\\"netuid\\\": i, \\\"live\\\": True, \\\"source\\\": \\\"blockmachine\\\"} for i in range(5)]\\n    meta = subnet_feed_meta(rows)\\n    assert meta[\\\"source\\\"] == \\\"blockmachine\\\"\\n    assert subnet_enrichment_status(rows) == \\\"live\\\"\\n\\n\\ndef test_list_subnets_meta_tmc_backed_snapshot(monkeypatch):\\n    \\\"\\\"\\\"_list_subnets_base_rows + _apply_subnets_query report honest TMC metadata.\\\"\\\"\\\"\\n    from starlette.requests import Request\\n\\n    from server import _apply_subnets_query, _list_subnets_base_rows\\n\\n    netuids = list(range(129))\\n    validity = {\\n        str(n): _validity_entry(validity=\\\"positive\\\", sources=[\\\"taomarketcap\\\"]) for n in netuids\\n    }\\n    snap = UniverseSnapshot(\\n        netuids=tuple(netuids),\\n        rows=tuple({\\\"netuid\\\": n, \\\"name\\\": f\\\"SN{n}\\\", \\\"volume\\\": 1.0} for n in netuids),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"degraded\\\",\\n        degraded=True,\\n        validity_map=validity,\\n    )\\n    monkeypatch.setattr(\\\"internal.subnet_universe.get_snapshot\\\", lambda: snap)\\n    monkeypatch.setattr(\\\"internal.subnet_universe.ensure_background_refresh\\\", lambda: None)\\n    base = _list_subnets_base_rows()\\n    assert base[\\\"feed_meta\\\"][\\\"source\\\"] == \\\"taomarketcap\\\"\\n    assert base[\\\"feed_meta\\\"][\\\"enrichment_status\\\"] == \\\"names_only\\\"\\n    scope = {\\n        \\\"type\\\": \\\"http\\\",\\n        \\\"method\\\": \\\"GET\\\",\\n        \\\"path\\\": \\\"/api/subnets\\\",\\n        \\\"headers\\\": [],\\n        \\\"query_string\\\": b\\\"limit=3\\\",\\n    }\\n    out = _apply_subnets_query(base, Request(scope))\\n    assert out[\\\"meta\\\"][\\\"total\\\"] == 129\\n    assert out[\\\"meta\\\"][\\\"source\\\"] == \\\"taomarketcap\\\"\\n    assert \\\"taomarketcap\\\" in out[\\\"meta\\\"][\\\"sources\\\"]\\n    assert out[\\\"meta\\\"][\\\"enrichment_status\\\"] == \\\"names_only\\\"\\n\\n\\ndef _snapshot_with(netuids: list[int], validity_map: dict, *, refresh_incomplete: bool = False) -> UniverseSnapshot:\\n    return UniverseSnapshot(\\n        netuids=tuple(netuids),\\n        rows=tuple({\\\"netuid\\\": n, \\\"name\\\": f\\\"SN{n}\\\"} for n in netuids),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"degraded\\\" if refresh_incomplete else \\\"ok\\\",\\n        degraded=refresh_incomplete,\\n        validity_map=validity_map,\\n        refresh_incomplete=refresh_incomplete,\\n    )\\n\\n\\ndef test_shrink_allowed_incomplete_refresh_grace_eligible_ok():\\n    \\\"\\\"\\\"Incomplete refresh may shrink when every removed netuid is grace-eligible.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = _snapshot_with(\\n        [130, 132, 100],\\n        {\\n            \\\"130\\\": _validity_entry(validity=\\\"negative\\\", negative_since=old),\\n            \\\"132\\\": _validity_entry(validity=\\\"negative\\\", negative_since=old),\\n            \\\"100\\\": _validity_entry(validity=\\\"positive\\\"),\\n        },\\n    )\\n    built = _snapshot_with(\\n        [100],\\n        {\\\"100\\\": _validity_entry(validity=\\\"positive\\\")},\\n        refresh_incomplete=True,\\n    )\\n    dropped = {\\n        130: DropEvidence(tmc=False, probe=False, negative_since=old),\\n        132: DropEvidence(tmc=False, probe=False, negative_since=old),\\n    }\\n    assert _shrink_allowed(prior, MembershipBuild(built, dropped)) is True\\n\\n\\ndef test_shrink_allowed_in_grace_blocked():\\n    \\\"\\\"\\\"Shrink is denied while any removed netuid is still within 48h grace.\\\"\\\"\\\"\\n    recent = (datetime.now(timezone.utc) - timedelta(seconds=60)).isoformat()\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    validity = {\\n        \\\"130\\\": _validity_entry(validity=\\\"negative\\\", negative_since=old),\\n        \\\"132\\\": _validity_entry(validity=\\\"negative\\\", negative_since=recent),\\n        \\\"100\\\": _validity_entry(validity=\\\"positive\\\"),\\n    }\\n    prior = _snapshot_with([130, 132, 100], validity)\\n    built_incomplete = _snapshot_with([100], {\\\"100\\\": validity[\\\"100\\\"]}, refresh_incomplete=True)\\n    built_complete = _snapshot_with([100], {\\\"100\\\": validity[\\\"100\\\"]})\\n    dropped = {\\n        130: DropEvidence(tmc=False, probe=False, negative_since=old),\\n        132: DropEvidence(tmc=False, probe=False, negative_since=recent),\\n    }\\n    assert _shrink_allowed(prior, MembershipBuild(built_incomplete, dropped)) is False\\n    assert _shrink_allowed(prior, MembershipBuild(built_complete, dropped)) is False\\n\\n\\ndef test_unsafe_shrink_warning_logs_removed_netuids(universe_tmp, caplog):\\n    \\\"\\\"\\\"Blocked-shrink warning names the removed netuids, sorted.\\\"\\\"\\\"\\n    prior = _prior_snapshot([1, 2, 3])\\n    built = _snapshot_with([1], {\\\"1\\\": _validity_entry(validity=\\\"positive\\\")}, refresh_incomplete=True)\\n    provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n    provider.replace_snapshot_for_tests(prior)\\n\\n    class _StubBuilder:\\n        def build(self, _prior):\\n            return MembershipBuild(built)\\n\\n    provider.set_builder(_StubBuilder())  # type: ignore[arg-type]\\n    with caplog.at_level(logging.WARNING, logger=\\\"internal.subnet_universe\\\"):\\n        provider.refresh_once()\\n    assert \\\"unsafe shrink blocked (3 -> 1)\\\" in caplog.text\\n    assert \\\"removed=[2, 3]\\\" in caplog.text\\n    assert provider.get_snapshot().netuids == prior.netuids\\n\\n\\ndef test_aged_negative_retained_when_probe_rpc_error(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"RPC failures must not remove grace-eligible negatives or start removal clocks.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(105,),\\n        rows=({\\\"netuid\\\": 105, \\\"name\\\": \\\"SN105\\\"},),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"105\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"],\\n                negative_since=old,\\n            )\\n        },\\n    )\\n\\n    _patch_registration(monkeypatch, [], read=\\\"rpc_error\\\")\\n\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, False),\\n        probe_fetch=None,\\n    )\\n    built = builder.build(prior).snapshot\\n    assert 105 in built.netuids\\n    entry = built.validity_map[\\\"105\\\"]\\n    assert entry[\\\"validity\\\"] == \\\"negative\\\"\\n    assert entry.get(\\\"refresh_incomplete\\\") is True\\n    assert entry.get(\\\"negative_since\\\") == old\\n\\n\\ndef test_aged_negative_not_removed_when_probe_unobserved_incomplete(universe_tmp):\\n    \\\"\\\"\\\"Incomplete per-netuid probe must not drop aged negatives.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(106,),\\n        rows=({\\\"netuid\\\": 106, \\\"name\\\": \\\"SN106\\\"},),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"106\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\"],\\n                negative_since=old,\\n            )\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, True),\\n        probe_fetch=lambda netuids, deadline: ({106: None}, False),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert 106 in built.netuids\\n\\n\\ndef test_no_price_on_one_positive_does_not_snapshot_freeze_membership(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"One refresh: confirmed-positive, TMC-absent no_price, new netuid; shrink aged negative.\\n\\n    Regression for PR #1378: per-netuid no_price must not set snapshot refresh_incomplete or\\n    force prior-only membership when a new netuid is observed and an unrelated grace-eligible\\n    negative is individually complete.\\n    \\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(100, 105, 130),\\n        rows=(\\n            {\\\"netuid\\\": 100, \\\"name\\\": \\\"SN100\\\"},\\n            {\\\"netuid\\\": 105, \\\"name\\\": \\\"SN105\\\"},\\n            {\\\"netuid\\\": 130, \\\"name\\\": \\\"SN130\\\"},\\n        ),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"100\\\": _validity_entry(validity=\\\"positive\\\", sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"]),\\n            \\\"105\\\": _validity_entry(validity=\\\"positive\\\", sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"]),\\n            \\\"130\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"],\\n                negative_since=old,\\n            ),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (\\n            {100, 201},\\n            {\\n                100: {\\\"netuid\\\": 100, \\\"name\\\": \\\"SN100\\\"},\\n                201: {\\\"netuid\\\": 201, \\\"name\\\": \\\"SN201\\\"},\\n            },\\n            True,\\n        ),\\n        probe_fetch=lambda netuids, deadline: (\\n            {100: True, 105: None, 130: False, 201: True},\\n            True,\\n        ),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert built.refresh_incomplete is False\\n    assert built.message != \\\"Refresh incomplete — retained last-known-good universe\\\"\\n    assert built.netuids != prior.netuids\\n    assert 100 in built.netuids\\n    assert 105 in built.netuids\\n    assert 201 in built.netuids\\n    assert built.validity_map[\\\"105\\\"].get(\\\"refresh_incomplete\\\") is True\\n    assert 130 not in built.netuids\\n\\n    monkeypatch.setattr(\\\"internal.subnet_universe._ci_or_test\\\", lambda: False)\\n    monkeypatch.setenv(\\\"RUN_MODE\\\", \\\"worker\\\")\\n    provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n    provider.replace_snapshot_for_tests(prior)\\n    provider.set_builder(builder)\\n    result = provider.refresh_once()\\n    assert result.refresh_incomplete is False\\n    assert result.netuids != prior.netuids\\n    assert 201 in result.netuids\\n    assert 105 in result.netuids\\n    assert 100 in result.netuids\\n    assert 130 not in result.netuids\\n\\n\\ndef test_no_price_probe_does_not_match_rpc_error_membership(universe_tmp):\\n    \\\"\\\"\\\"no_price and rpc_error must not remove aged negatives or advance removal clocks.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = UniverseSnapshot(\\n        netuids=(201, 202),\\n        rows=(\\n            {\\\"netuid\\\": 201, \\\"name\\\": \\\"SN201\\\"},\\n            {\\\"netuid\\\": 202, \\\"name\\\": \\\"SN202\\\"},\\n        ),\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={\\n            \\\"201\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"],\\n                negative_since=old,\\n            ),\\n            \\\"202\\\": _validity_entry(\\n                validity=\\\"negative\\\",\\n                sources=[\\\"taomarketcap\\\", \\\"blockmachine_probe\\\"],\\n                negative_since=old,\\n            ),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, False),\\n        probe_fetch=lambda netuids, deadline: ({201: None, 202: None}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert 201 in built.netuids\\n    assert 202 in built.netuids\\n    assert built.validity_map[\\\"201\\\"].get(\\\"refresh_incomplete\\\") is True\\n    assert built.validity_map[\\\"202\\\"].get(\\\"refresh_incomplete\\\") is True\\n\\n\\ndef test_emergency_rows_empty_without_registry(monkeypatch):\\n    \\\"\\\"\\\"Missing registry must not fabricate netuids 0..74.\\\"\\\"\\\"\\n    monkeypatch.setattr(\\\"internal.subnet_universe._read_registry_rows\\\", lambda: [])\\n\\n    import internal.subnets.feed as feed_mod\\n\\n    monkeypatch.setattr(\\n        feed_mod,\\n        \\\"registry_subnet_rows\\\",\\n        lambda: (_ for _ in ()).throw(RuntimeError(\\\"no registry\\\")),\\n    )\\n    from internal.subnet_universe import _emergency_rows\\n\\n    assert _emergency_rows() == []\\n    snap = UniverseSnapshot.emergency_registry()\\n    assert snap.netuids == ()\\n    assert snap.refresh_incomplete is True\\n\\n\\ndef test_tmc_positive_without_price_retained(universe_tmp):\\n    \\\"\\\"\\\"Source-confirmed positive survives missing on-chain price.\\\"\\\"\\\"\\n    prior = _prior_snapshot([77])\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({77}, {77: {\\\"netuid\\\": 77, \\\"name\\\": \\\"SN77\\\"}}, True),\\n        probe_fetch=lambda netuids, deadline: ({77: None}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert 77 in built.netuids\\n    assert built.validity_map[\\\"77\\\"][\\\"validity\\\"] == \\\"positive\\\"\\n\\n\\ndef test_refresh_once_publishes_grace_removal_despite_incomplete_refresh(universe_tmp):\\n    \\\"\\\"\\\"Prod loop fix: degraded sources must not pin grace-eligible negatives forever.\\\"\\\"\\\"\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = _snapshot_with(\\n        [130, 132, 100],\\n        {\\n            \\\"130\\\": _validity_entry(validity=\\\"negative\\\", negative_since=old),\\n            \\\"132\\\": _validity_entry(validity=\\\"negative\\\", negative_since=old),\\n            \\\"100\\\": _validity_entry(validity=\\\"positive\\\"),\\n        },\\n    )\\n    provider = SubnetUniverseProvider(persist_file=str(universe_tmp))\\n    provider.replace_snapshot_for_tests(prior)\\n    provider.set_builder(\\n        SnapshotBuilder(\\n            tmc_fetch=lambda: ({100}, {100: {\\\"netuid\\\": 100, \\\"name\\\": \\\"SN100\\\"}}, True),\\n            probe_fetch=lambda netuids, deadline: ({100: True, 130: False, 132: False}, False),\\n        )\\n    )\\n    result = provider.refresh_once()\\n    assert 130 not in result.netuids\\n    assert 132 not in result.netuids\\n    assert 100 in result.netuids\\n    assert result.refresh_incomplete is True\\n    assert provider.get_snapshot().netuids == result.netuids\\n\\n\\ndef _patch_registration(monkeypatch, members, *, pin=(\\\"0xabc\\\", \\\"ok\\\"), read=\\\"ok\\\"):\\n    class _Reader:\\n        def __init__(self, *args, **kwargs):\\n            self.provider_served = \\\"fixture\\\"\\n\\n        def pin_finalized_head(self):\\n            return pin\\n\\n        def call_fn(self):\\n            return lambda method, params: (None, \\\"ok\\\")\\n\\n    monkeypatch.setattr(\\\"internal.chain_price.reader.ChainReader\\\", _Reader)\\n    monkeypatch.setattr(\\n        \\\"internal.chain_price.membership.get_member_netuids\\\",\\n        lambda call, at_hash: (list(members) if read == \\\"ok\\\" else [], read),\\n    )\\n\\n\\ndef test_registration_read_marks_registered_netuids_positive(monkeypatch):\\n    _patch_registration(monkeypatch, [1, 2])\\n    observed, complete = _default_probe_fetch([0, 1, 2, 129])\\n    assert observed == {1: True, 2: True, 129: False}\\n    assert complete is True\\n\\n\\n@pytest.mark.parametrize(\\n    \\\"kwargs\\\",\\n    [{\\\"read\\\": \\\"rate_limited\\\"}, {\\\"read\\\": \\\"invalid\\\"}, {\\\"pin\\\": (None, \\\"rpc_error\\\")}],\\n)\\ndef test_registration_read_failure_observes_nothing(monkeypatch, kwargs):\\n    _patch_registration(monkeypatch, [1, 2], **kwargs)\\n    observed, complete = _default_probe_fetch([0, 1, 2, 129])\\n    assert observed == {}\\n    assert complete is False\\n\\n\\ndef test_unregistered_netuid_leaves_after_grace_and_stays_gone(universe_tmp, monkeypatch):\\n    _patch_registration(monkeypatch, [1])\\n    prior = _prior_snapshot([1, 129])\\n    prior.validity_map[\\\"129\\\"] = _validity_entry(validity=\\\"positive\\\", sources=[\\\"blockmachine_probe\\\"])\\n    builder = SnapshotBuilder(tmc_fetch=lambda: ({1}, {1: {\\\"netuid\\\": 1}}, True))\\n\\n    built = builder.build(prior).snapshot\\n    entry = built.validity_map[\\\"129\\\"]\\n    assert entry[\\\"validity\\\"] == \\\"negative\\\"\\n    assert entry[\\\"negative_since\\\"]\\n    assert 129 in built.netuids\\n\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    aged = UniverseSnapshot(\\n        netuids=built.netuids,\\n        rows=built.rows,\\n        resolved_at=datetime.now(timezone.utc).isoformat(),\\n        status=\\\"ok\\\",\\n        degraded=False,\\n        validity_map={**built.validity_map, \\\"129\\\": {**entry, \\\"negative_since\\\": old}},\\n    )\\n    rebuilt = builder.build(aged).snapshot\\n    assert 129 not in rebuilt.netuids\\n    assert 1 in rebuilt.netuids\\n    assert 129 not in builder.build(rebuilt).snapshot.netuids\\n\\n\\ndef test_registered_netuid_missing_from_tmc_stays_positive(universe_tmp, monkeypatch):\\n    _patch_registration(monkeypatch, [1, 130])\\n    builder = SnapshotBuilder(tmc_fetch=lambda: ({1}, {1: {\\\"netuid\\\": 1}}, True))\\n    built = builder.build(_prior_snapshot([1])).snapshot\\n    assert 130 in built.netuids\\n    assert built.validity_map[\\\"130\\\"][\\\"validity\\\"] == \\\"positive\\\"\\n\\n\\ndef test_chain_member_enters_when_tmc_incomplete_and_prior_snapshot(universe_tmp, monkeypatch):\\n    \\\"\\\"\\\"Replit gap 1: incomplete TaoStats must not hide chain-registered members.\\\"\\\"\\\"\\n    _patch_registration(monkeypatch, list(range(1, 131)))\\n    builder = SnapshotBuilder(tmc_fetch=lambda: (set(), {}, False))\\n    built = builder.build(_prior_snapshot([1, 2, 3])).snapshot\\n    assert 130 in built.netuids\\n    assert built.validity_map[\\\"130\\\"][\\\"validity\\\"] == \\\"positive\\\"\\n\\n\\ndef test_chain_member_at_netuid_200_enters_when_outside_probe_range(monkeypatch):\\n    \\\"\\\"\\\"Registration positives must enter membership even above MAX_NETUIDS-1 probe list.\\\"\\\"\\\"\\n    _patch_registration(monkeypatch, [1, 200])\\n    builder = SnapshotBuilder(tmc_fetch=lambda: (set(), {}, False))\\n    built = builder.build(_prior_snapshot([1])).snapshot\\n    assert 200 in built.netuids\\n    assert built.validity_map[\\\"200\\\"][\\\"validity\\\"] == \\\"positive\\\"\\n\\n\\ndef test_probe_fetch_deadline_blocks_second_provider_and_stays_incomplete(monkeypatch):\\n    \\\"\\\"\\\"D2/D3: reader deadline on clients; slow provider burns budget, fast never contacted.\\\"\\\"\\\"\\n    import internal.chain_client as chain_client_mod\\n    import internal.chain_price.reader as reader_mod\\n    from internal.chain_client import ChainClient\\n    from internal.chain_price.reader import ChainReader\\n\\n    slow = ChainClient(endpoint=\\\"https://slow.example\\\", init_volume_db=False)\\n    fast = ChainClient(endpoint=\\\"https://fast.example\\\", init_volume_db=False)\\n    posts: list[str] = []\\n\\n    def fake_post(endpoint, payload, timeout, **kwargs):\\n        posts.append(endpoint)\\n        time.sleep(timeout)\\n        raise requests.ConnectionError(\\\"down\\\")\\n\\n    monkeypatch.setattr(chain_client_mod, \\\"_timed_post\\\", fake_post)\\n    monkeypatch.setattr(\\n        reader_mod.cfg,\\n        \\\"rpc_provider_clients\\\",\\n        lambda: [(\\\"slow\\\", slow), (\\\"fast\\\", fast)],\\n    )\\n    budget = 0.15\\n    deadline = time.monotonic() + budget\\n    reader_deadlines: list = []\\n    real_init = ChainReader.__init__\\n\\n    def _capture_deadline(self, *args, **kwargs):\\n        reader_deadlines.append(kwargs.get(\\\"deadline_monotonic\\\"))\\n        return real_init(self, *args, **kwargs)\\n\\n    monkeypatch.setattr(ChainReader, \\\"__init__\\\", _capture_deadline)\\n    started = time.monotonic()\\n    observed, complete = _default_probe_fetch([1], deadline=deadline)\\n    elapsed = time.monotonic() - started\\n    assert reader_deadlines == [deadline]\\n    assert observed == {}\\n    assert complete is False\\n    assert elapsed <= budget + 0.2\\n    assert not any(\\\"fast.example\\\" in ep for ep in posts)\\n    assert any(\\\"slow.example\\\" in ep for ep in posts)\\n\\n\\ndef test_probe_fetch_incomplete_when_deadline_expires_during_read(monkeypatch):\\n    from internal.chain_price.reader import ChainReader\\n\\n    def slow_pin(self):\\n        time.sleep(0.03)\\n        return \\\"0xabc\\\", \\\"ok\\\"\\n\\n    monkeypatch.setattr(ChainReader, \\\"pin_finalized_head\\\", slow_pin)\\n    monkeypatch.setattr(\\n        \\\"internal.chain_price.membership.get_member_netuids\\\",\\n        lambda call, at_hash: ([1], \\\"ok\\\"),\\n    )\\n    observed, complete = _default_probe_fetch([1], deadline=time.monotonic() + 0.005)\\n    assert observed == {}\\n    assert complete is False\\n\\n\\n@pytest.mark.parametrize(\\\"total_raw\\\", [None, \\\"0x81\\\"])\\ndef test_total_networks_invalid_makes_probe_incomplete(monkeypatch, total_raw):\\n    \\\"\\\"\\\"M3b at probe layer: invalid membership batch → incomplete probe, no observations.\\\"\\\"\\\"\\n    from internal.chain_price.storage_keys import map_key_hex, total_networks_key_hex\\n\\n    total_key = total_networks_key_hex()\\n    net_key = map_key_hex(b\\\"NetworksAdded\\\", 1)\\n\\n    class _Reader:\\n        def __init__(self, *args, **kwargs):\\n            self.provider_served = \\\"fixture\\\"\\n\\n        def pin_finalized_head(self):\\n            return \\\"0xabc\\\", \\\"ok\\\"\\n\\n        def call_fn(self):\\n            def _call(method, params):\\n                if method == \\\"state_getKeysPaged\\\":\\n                    return [net_key], \\\"ok\\\"\\n                if method == \\\"state_queryStorageAt\\\":\\n                    block = params[1]\\n                    keys = params[0]\\n                    assert total_key in keys\\n                    return [\\n                        {\\n                            \\\"block\\\": block,\\n                            \\\"changes\\\": [[net_key, \\\"0x01\\\"], [total_key, total_raw]],\\n                        }\\n                    ], \\\"ok\\\"\\n                return None, \\\"rpc_error\\\"\\n\\n            return _call\\n\\n    monkeypatch.setattr(\\\"internal.chain_price.reader.ChainReader\\\", _Reader)\\n    observed, complete = _default_probe_fetch([1])\\n    assert observed == {}\\n    assert complete is False\\n\\n\\ndef test_default_price_one_does_not_imply_registration(monkeypatch):\\n    \\\"\\\"\\\"Fail-first: a 1.0 price on an unregistered netuid must not count as positive.\\\"\\\"\\\"\\n\\n    class _Client:\\n        def get_alpha_price_probed(self, netuid):\\n            return 1.0, \\\"ok\\\"\\n\\n    monkeypatch.setattr(\\\"internal.chain_client.get_default_client\\\", lambda: _Client())\\n    _patch_registration(monkeypatch, list(range(1, 129)))\\n\\n    observed, complete = _default_probe_fetch(list(range(200)))\\n    assert complete is True\\n    assert observed.get(129) is False\\n    assert observed.get(128) is True\\n\\n\\ndef test_cold_start_keeps_root_when_chain_lists_1_to_128_and_tmc_is_incomplete(monkeypatch):\\n    \\\"\\\"\\\"Root is never in NetworksAdded; a cold snapshot must still contain it without claiming chain registration.\\\"\\\"\\\"\\n    _patch_registration(monkeypatch, list(range(1, 129)))\\n    builder = SnapshotBuilder(tmc_fetch=lambda: (set(), {}, False))\\n    built = builder.build(None).snapshot\\n    assert 0 in built.netuids\\n    assert set(range(1, 129)) <= set(built.netuids)\\n    root = built.validity_map[\\\"0\\\"]\\n    assert \\\"blockmachine_probe\\\" not in root[\\\"sources\\\"]\\n    assert root[\\\"validity\\\"] != \\\"negative\\\"\\n\\n\\ndef test_complete_chain_read_beats_a_failed_tmc_read(universe_tmp):\\n    \\\"\\\"\\\"Live gap: with TMC down and the chain read complete, a chain-unregistered netuid must still go negative.\\\"\\\"\\\"\\n    prior = _prior_snapshot([42, 43])\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, False),\\n        probe_fetch=lambda netuids, deadline: ({42: False, 43: True}, True),\\n    )\\n    built = builder.build(prior).snapshot\\n    assert built.validity_map[\\\"42\\\"][\\\"validity\\\"] == \\\"negative\\\"\\n    assert built.validity_map[\\\"43\\\"][\\\"validity\\\"] == \\\"positive\\\"\\n    assert 42 in built.netuids\\n\\n\\ndef test_chain_unregistered_row_leaves_after_grace_even_if_tmc_is_down(universe_tmp):\\n    old = (datetime.now(timezone.utc) - timedelta(seconds=STALE_GRACE_SECONDS + 60)).isoformat()\\n    prior = _prior_snapshot([42, 43])\\n    prior = replace(\\n        prior,\\n        validity_map={\\n            **prior.validity_map,\\n            \\\"42\\\": _validity_entry(validity=\\\"negative\\\", sources=[], negative_since=old),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: (set(), {}, False),\\n        probe_fetch=lambda netuids, deadline: ({42: False, 43: True}, True),\\n    )\\n    assert 42 not in builder.build(prior).snapshot.netuids\\n\\n\\ndef test_failed_chain_read_does_not_undo_a_chain_negative(universe_tmp):\\n    \\\"\\\"\\\"A chain-negative netuid that TMC still lists must stay negative, with its grace clock, across a failed chain read.\\\"\\\"\\\"\\n    started = (datetime.now(timezone.utc) - timedelta(hours=5)).isoformat()\\n    prior = _prior_snapshot([42])\\n    prior = replace(\\n        prior,\\n        validity_map={\\n            \\\"42\\\": _validity_entry(validity=\\\"negative\\\", sources=[\\\"taomarketcap\\\"], disputed=True, negative_since=started),\\n        },\\n    )\\n    builder = SnapshotBuilder(\\n        tmc_fetch=lambda: ({42}, {42: {\\\"netuid\\\": 42}}, True),\\n        probe_fetch=lambda netuids, deadline: ({}, False),\\n    )\\n    entry = builder.build(prior).snapshot.validity_map[\\\"42\\\"]\\n    assert entry[\\\"validity\\\"] == \\\"negative\\\"\\n    assert entry[\\\"negative_since\\\"] == started\\n\",\"startLine\":380,\"endLine\":1143,\"totalLines\":1143,\"truncated\":false,\"source\":\"fixture\"}",
