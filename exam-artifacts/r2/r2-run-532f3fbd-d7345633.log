le[[List[int], float], Tuple[Dict[int, Optional[bool]], bool]]\\n        ] = None,\\n        probe_budget_seconds: float = 30.0,\\n    ) -> None:\\n        self._tmc_fetch = tmc_fetch or _default_tmc_fetch\\n        self._probe_fetch = probe_fetch\",\"startLine\":450,\"endLine\":549,\"totalLines\":849,\"truncated\":false,\"source\":\"fixture\"}",
