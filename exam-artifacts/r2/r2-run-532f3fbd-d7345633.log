gative_since=negative_since,\\n            refresh_incomplete=entry_incomplete,\\n        )\\n        evidence = DropEvidence(tmc=tmc_val, probe=probe_val, negative_since=negative_since)\\n        if validity == \\\"negative\\\" and _eligible_for_removal(netuid, evidence, now):\",\"startLine\":315,\"endLine\":370,\"totalLines\":848,\"truncated\":false,\"source\":\"fixture\"}",
