list(out.values())\\n\\n\\ndef subnet_volume(sn: Dict[str, Any]) -> float:\\n    \\\"\\\"\\\"Unified 24h turnover — ``volume`` or buy+sell chain volumes.\\\"\\\"\\\"\\n    if not isinstance(sn, dict):\\n        return 0.0\\n    raw = sn.get(\\\"volume\\\")\\n    if raw is not None and raw != \\\"\\\":\\n        try:\\n            return float(raw)\\n        except (TypeError, ValueError):\\n            pass\\n    try:\\n        buy = float(sn.get(\\\"buy_volume_24h\\\") or 0)\\n        sell = float(sn.get(\\\"sell_volume_24h\\\") or 0)\\n        return buy + sell\\n    except (TypeError, ValueError):\\n        return 0.0\\n\\n\\ndef r1b_f2_netuids_b(validity_map):\\n    return sorted(k for k in (int(x) for x in validity_map.keys()) if k)\\n\",\"startLine\":1,\"endLine\":74,\"totalLines\":74,\"truncated\":false,\"source\":\"fixture\"}",
