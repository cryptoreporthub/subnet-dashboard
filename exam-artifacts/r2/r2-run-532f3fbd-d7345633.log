          "output": "{\"number\":9407,\"headSha\":\"e6194fed7d8ffb289adee21bb5c9d2af11f879a4\",\"baseSha\":\"882980b817986fdcd2766fb18d46525b8e1955fd\",\"draft\":false,\"title\":\"universe: align membership keys with run_mode helper\",\"files\":[\"internal/subnet_universe.py\",\"internal/run_mode.py\"],\"url\":\"https://github.com/cryptoreporthub/subnet-dashboard/pull/9407\",\"fileCount\":2,\"mc\":\"missing\",\"cursor\":\"missing\",\"ditto\":\"missing\",\"replit\":\"missing\",\"suite\":\"missing\",\"replitTagged\":false,\"next\":\"review\",\"source\":\"fixture\"}",
