          "output": "{\"number\":9442,\"headSha\":\"a34965c9e4933b1732040e827aea9a767d98504e\",\"baseSha\":\"882980b817986fdcd2766fb18d46525b8e1955fd\",\"draft\":false,\"title\":\"universe: read api_key header before interpreting chain gaps\",\"files\":[\"internal/subnet_universe.py\"],\"url\":\"https://github.com/cryptoreporthub/subnet-dashboard/pull/9442\",\"fileCount\":1,\"mc\":\"missing\",\"cursor\":\"missing\",\"ditto\":\"missing\",\"replit\":\"missing\",\"suite\":\"missing\",\"replitTagged\":false,\"next\":\"review\",\"source\":\"fixture\"}",
