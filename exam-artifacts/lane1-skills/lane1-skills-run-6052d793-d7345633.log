          "output": "{\"ok\":true,\"path\":\"internal/r1b_perf_09.py\",\"sha\":\"882980b817986fdcd2766fb18d46525b8e1955fd\",\"text\":\"\\\"\\\"\\\"Grace helper.\\\"\\\"\\\"\\nfrom datetime import datetime\\n\\nSTALE_GRACE_SECONDS = 48 * 3600\\n\\n\\ndef grace_elapsed_enough(now: datetime, started: datetime, grace: int = STALE_GRACE_SECONDS) -> bool:\\n    return (now - started).total_seconds() >= grace\\n\",\"startLine\":1,\"endLine\":9,\"totalLines\":9,\"truncated\":false,\"source\":\"fixture\"}",
