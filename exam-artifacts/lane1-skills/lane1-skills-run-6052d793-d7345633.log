ot _eligible_for_removal(netuid, evidence, now):\\n            return False\\n    return True\\n\\n\\ndef _hold_prior(prior: UniverseSnapshot, status: str, message: str) -> UniverseSnapshot:\\n    return UniverseSnapshot(\\n        netuids=prior.netuids,\\n        rows=prior.rows,\\n        resolved_at=prior.resolved_at,\\n        status=status,\\n        degraded=True,\\n        validity_map=dict(prior.validity_map),\\n        cap_reached=prior.cap_reached,\\n        refresh_incomplete=True,\\n        message=message,\\n    )\\n\\n\",\"startLine\":250,\"endLine\":320,\"totalLines\":848,\"truncated\":false,\"source\":\"fixture\"}",
