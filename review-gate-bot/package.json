{
  "name": "subnet-review-gate",
  "private": true,
  "type": "module",
  "description": "Mission Control review gate for cryptoreporthub/subnet-dashboard. Review-only: no merge, deploy, restart, secret or label tool.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev": "agent-sdk dev --dir .",
    "validate": "agent-sdk validate --dir .",
    "eval": "agent-sdk eval --dir .",
    "oracle:regen": "python3 evals/oracle-gen/gen.py",
    "oracle:check": "python3 evals/oracle-gen/gen.py --check",
    "oracle:check:fast": "python3 evals/oracle-gen/gen.py --check --skip-behavior"
  },
  "dependencies": {
    "@grok/agent-sdk": "0.3.0",
    "@octokit/rest": "^21.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
