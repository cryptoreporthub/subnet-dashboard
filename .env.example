# Subnet integration API keys (optional — app degrades without them)
# See docs/SUBNET_INTEGRATIONS.md for pricing and cut/keep decisions.

# SN22 DeSearch — social/web evidence ($0.10+/100 searches; free credits at signup)
# https://console.desearch.ai/
# DESEARCH_API_KEY=

# SN50 Synth — macro BTC/ETH forecasts ($49/mo Standard, 100 credits — defer unless paid)
# https://dashboard.synthdata.co/choose-plan/
# SYNTH_API_KEY=

# SN64 Chutes — SimiVision council chat LLM ($10/mo Plus or pay-as-you-go)
# https://chutes.ai/
# CHUTES_API_KEY=
# CHUTES_BASE_URL=https://llm.chutes.ai/v1
# CHUTES_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# SN118 Ditto — dogfood memory layer (no key required for status badge)
# DITTO_BASE_URL=https://api.heyditto.ai

# Fly.io (production):
# flyctl secrets set DESEARCH_API_KEY=... CHUTES_API_KEY=... --app subnet-dashboard
