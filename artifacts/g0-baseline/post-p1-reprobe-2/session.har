al {\n  font-family: var(--font-brand, var(--font-display), sans-serif);\n  font-size: clamp(1.35rem, 5vw, 1.8rem);\n  font-weight: 800;\n}\n.message-intel--v2 .message-intel__flow-val small {\n  font-family: var(--font-mono, monospace);\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--mi-text-faint);\n}\n.message-intel--v2 .message-intel__flow-meter {\n  height: 6px;\n  border-radius: 99px;\n  background: rgba(255,255,255,0.07);\n  overflow: hidden;\n  margin: 8px 0;\n}\n.message-intel--v2 .message-intel__flow-meter > div {\n  height: 100%;\n  width: 0;\n  border-radius: 99px;\n  background: linear-gradient(90deg, var(--mi-green), var(--mi-blue));\n}\n.message-intel--v2 .message-intel__flow-sub {\n  font-size: 12px;\n  color: var(--mi-text-dim);\n  line-height: 1.45;\n  margin: 0;\n}\n\n.message-intel--v2 .message-intel__bay {\n  display: grid;\n  gap: 10px;\n  align-items: start;\n  width: 100%;\n  min-width: 0;\n  overflow-x: clip;\n}\n#section-message-intel,\n.message-intel--v2 .message-intel__tile--orbit,\n.message-intel--v2 .message-intel__hall {\n  scroll-margin-top: 72px;\n  overflow: visible;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  margin-left: auto;\n  margin-right: auto;\n}\n.message-intel--v2 .message-intel__hall {\n  grid-area: hall;\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 10px;\n  align-items: start;\n}\n.message-intel--v2 .message-intel__mode--rank > .message-intel__hall {\n  display: contents;\n}\n.message-intel--v2 .message-intel__hall > .message-intel__tile { grid-area: auto; }\n.message-intel--v2 .message-intel__tile { min-width: 0; }\n.message-intel--v2 .message-intel__tile .message-intel__panel,\n.message-intel--v2 .message-intel__tile .message-intel__spotlight,\n.message-intel--v2 .message-intel__tile .message-intel__proof,\n.message-intel--v2 .message-intel__tile .message-intel__hc-strip { margin-bottom: 0; height: 100%; }\n.message-intel--v2 .message-intel__tile--orbit { grid-area: orbit; }\n.message-i