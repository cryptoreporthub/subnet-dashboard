  border-radius: 12px;\n  margin-bottom: 10px;\n  max-width: 88%;\n  font-size: 13px;\n  line-height: 1.55;\n}\n\n.chat-msg.user {\n  background: rgba(0, 255, 65, 0.08);\n  border: 1px solid var(--border-default);\n  margin-left: auto;\n}\n\n.chat-msg.bot {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n}\n\n.chat-msg .who {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-bottom: 3px;\n}\n\n.chat-text {\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.chat-input {\n  display: flex;\n  gap: 10px;\n  margin-top: 10px;\n}\n\n.chat-input input {\n  flex: 1;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: 11px;\n  padding: 12px 14px;\n  color: var(--text-primary);\n  font-family: var(--font-body);\n  font-size: 13px;\n  outline: none;\n}\n\n.chat-input input:focus {\n  border-color: var(--accent-bright);\n  box-shadow: 0 0 12px var(--accent-glow);\n}\n\n.chat-input button {\n  background: linear-gradient(135deg, var(--accent-bright), var(--accent-primary));\n  color: var(--bg-base);\n  border: none;\n  border-radius: 11px;\n  padding: 0 20px;\n  font-weight: 700;\n  font-family: var(--font-display);\n  cursor: pointer;\n}\n\n.chat-input button:disabled { opacity: 0.5; cursor: wait; }\n\n.chat-meta {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-top: 8px;\n}\n\n/* ---------- Chat (cockpit tint) ---------- */\n.chat-msg.user {\n  background: var(--cockpit-green-soft);\n  border-color: var(--cockpit-green-line);\n}\n.chat-input input:focus {\n  border-color: var(--cockpit-green);\n  box-shadow: 0 0 14px var(--cockpit-green-glow);\n}\n.chat-input button {\n  background: linear-gradient(135deg, #00c8ff, #00ff41);\n  color: var(--bg-cockpit);\n}\n"},"headersSize":0,"bodySize":889,"redirectURL":"","_transferSize":889},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1636.73,"recei