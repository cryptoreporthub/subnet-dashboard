-columns: 22px minmax(0, 1fr);\n  gap: 8px;\n  padding: 8px 0;\n  border-top: 1px solid rgba(255,255,255,0.07);\n}\n.message-intel--v2 .message-intel__power-why,\n.message-intel--v2 .message-intel__narr-why {\n  font-size: 11px;\n  color: var(--mi-text-dim);\n  line-height: 1.4;\n  margin-top: 2px;\n}\n.message-intel--v2 .message-intel__factor {\n  display: grid;\n  grid-template-columns: 64px minmax(0, 1fr) 28px;\n  gap: 8px;\n  align-items: center;\n  margin-top: 5px;\n}\n.message-intel--v2 .message-intel__factor span,\n.message-intel--v2 .message-intel__factor em {\n  font-family: var(--font-mono, monospace);\n  font-size: 9px;\n  color: var(--mi-text-faint);\n}\n.message-intel--v2 .message-intel__factor em { text-align: right; }\n.message-intel--v2 .message-intel__factor i {\n  display: block;\n  height: 5px;\n  border-radius: 3px;\n  background: var(--mi-green);\n}\n.message-intel--v2 .message-intel__factor i[data-axis=\"conviction\"] { background: var(--mi-blue); }\n.message-intel--v2 .message-intel__factor i[data-axis=\"quality\"] { background: var(--mi-orange); }\n.message-intel--v2 .message-intel__power-top {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.message-intel--v2 .message-intel__power-sent {\n  margin-left: auto;\n  font-family: var(--font-mono, monospace);\n  font-size: 9.5px;\n  padding: 3px 8px;\n  border-radius: 999px;\n  color: var(--mi-blue);\n  background: rgba(63, 201, 255, 0.12);\n}\n.message-intel--v2 .message-intel__power-sent[data-sent=\"bullish\"] {\n  color: var(--mi-green);\n  background: rgba(31, 212, 124, 0.12);\n}\n.message-intel--v2 .message-intel__power-sent[data-sent=\"bearish\"] {\n  color: var(--mi-orange);\n  background: rgba(240, 197, 111, 0.12);\n}\n.message-intel--v2 .message-intel__awaiting {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 0;\n  border-top: 1px solid rgba(255,255,255,0.07);\n}\n.message-intel--v2 .message-intel__receipt-toggle,\n.message-intel--v2 .message-intel__power-calls {\n  grid-column: auto;\n  justify-self: start;\n  margin-top: 6px;\n  min-height: 30px;\n  padding: 4px 10px;\n  border: 1px solid rgba(63, 201, 255, 0.35);\n  border-radius: 999px;\n  background: rgba(63, 201, 255, 0.07);\n  color: var(--mi-blue);\n  font-family: var(--font-mono, monospace);\n  font-size: 9.5px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: box-shadow 0.2s ease, border-color 0.2s ease;\n}\n.message-intel--v2 .message-intel__receipt-toggle:hover,\n.message-intel--v2 .message-intel__power-calls:hover {\n  border-color: rgba(63, 201, 255, 0.7);\n  box-shadow: 0 0 12px rgba(63, 201, 255, 0.25);\n}\n.message-intel--v2 .message-intel__champ-name .message-intel__receipt-toggle {\n  margin: 0 0 0 8px;\n  padding: 2px 8px;\n}\n.message-intel--v2 .message-intel__accolade-row {\n  grid-template-columns: 22px minmax(0, 1fr) auto;\n  align-items: start;\n}\n.message-intel--v2 .message-intel__accolade-row .message-intel__receipt-toggle { margin-top: 2px; }\n.message-intel--v2 .message-intel__accolade-star { color: var(--mi-orange); text-shadow: 0 0 10px rgba(240, 197, 111, 0.55); }\n.message-intel--v2 .message-intel__receipt-src {\n  font-family: var(--font-mono, monospace);\n  font-size: 9.5px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--mi-blue);\n  text-decoration: none;\n  border-bottom: 1px dashed rgba(63, 201, 255, 0.45);\n  width: fit-content;\n}\n.message-intel--v2 .message-intel__receipt-src:hover { color: var(--mi-text); border-bottom-style: solid; }\n.message-intel--v2 .message-intel__receipt { position: relative; padding-right: 4px; }\n.message-intel--v2 .message-intel__receipt .message-intel__receipt-src { margin-top: 2px; }\n.message-intel--v2 .message-intel__crown-actions {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 6px;\n}\n.message-intel--v2 .message-intel__crown-row .message-intel__receipt-toggle { margin-top: 0; }\n.message-intel--v2 .message-intel__detail-source { margin: 8px 0 0; }\n.message-intel--v2 .message-intel__consensus-receipt .message-intel__receipt-src,\n.message-intel--v2 .message-intel__divergence-receipt .message-intel__receipt-src { margin-left: 8px; }\n.message-intel--v2 .message-intel__caller-fullname {\n  color: var(--mi-text-faint);\n  font-size: 10px;\n  font-weight: 400;\n}\n.message-intel--v2 .message-intel__awaiting-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: var(--mi-orange);\n  opacity: 0.5;\n  flex: 0 0 auto;\n}\n.message-intel--v2 .message-intel__awaiting p {\n  margin: 0;\n  font-size: 11px;\n  color: var(--mi-text-faint);\n  line-height: 1.45;\n}\n.message-intel--v2 .message-intel__axes span {\n  font-family: var(--font-mono, monospace);\n  font-size: 9px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--mi-text-faint);\n}\n.message-intel--v2 .message-intel__axes i {\n  display: block;\n  height: 4px;\n  border-radius: 99px;\n  background: linear-gradient(90deg, var(--mi-blue), var(--mi-violet));\n}\n.message-intel--v2 .message-intel__axes i[data-axis=\"conviction\"] {\n  background: linear-gradient(90deg, var(--mi-violet), var(--mi-orange));\n}\n.message-intel--v2 .message-intel__caution {\n  display: inline-block;\n  margin-top: 4px;\n  font-family: var(--font-mono, monospace);\n  font-size: 9.5px;\n  letter-spacing: 0.04em;\n  color: var(--mi-orange);\n}\n.message-intel--v2 .message-intel__dock {\n  margin-top: 12px;\n  padding-top: 12px;\n  border-top: 1px dashed rgba(255,255,255,0.12);\n}\n.message-intel--v2 .message-intel__command-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n.message-intel--v2 .message-intel__command-list span {\n  font-family: var(--font-mono, monospace);\n  font-size: 10.5px;\n  min-height: 44px;\n  display: inline-flex;\n  align-items: center;\n  padding: 0 12px;\n  border: 1px solid var(--glass-border);\n  border-radius: 999px;\n  color: var(--mi-text-dim);\n}\n.message-intel--v2 .message-intel__dock-note {\n  margin: 8px 0 10px;\n  font-size: 11px;\n  color: var(--mi-text-faint);\n  line-height: 1.45;\n}\n\n@media (min-width: 740px) {\n  .message-intel--v2 .message-intel__masthead {\n    grid-template-columns: minmax(0, 1fr);\n    align-items: stretch;\n  }\n  .message-intel--v2 .message-intel__identity .message-intel__page-title {\n    font-size: clamp(1.55rem, 3.6vw, 2.4rem);\n  }\n  .message-intel--v2 .message-intel__hall { display: contents; }\n  .message-intel--v2 .message-intel__mode[data-pulse-pane=\"listen\"] {\n    grid-template-columns: 1fr;\n  }\n  .message-intel--v2 .message-intel__mode[data-pulse-pane=\"listen\"] .message-intel__tile--recap,\n  .message-intel--v2 .message-intel__mode[data-pulse-pane=\"listen\"] .message-intel__hero-stats {\n    grid-column: 1 / -1;\n  }\n  .message-intel--v2 .message-intel__mode[data-pulse-pane=\"rank\"] {\n    grid-template-columns: 1fr;\n  }\n  .message-intel--v2 .message-intel__trending { display: block; }\n}\n@media (max-width: 739px) {\n  .message-intel--v2 .message-intel__heartbeat {\n    grid-template-columns: minmax(0, 1fr) auto;\n    grid-template-rows: auto auto;\n  }\n  .message-intel--v2 .message-intel__ekg { grid-column: 1 / -1; }\n  .message-intel--v2 .message-intel__instrument .message-intel__pulsar {\n    width: 72px;\n    height: 72px;\n  }\n  .message-intel--v2 .message-intel__instrument .message-intel__core {\n    width: 48px;\n    height: 48px;\n  }\n  .message-intel--v2 .message-intel__sky {\n    max-width: none;\n    width: 100%;\n  }\n  .message-intel--v2 .message-intel__trending,\n  .message-intel--v2 .message-intel__view-all { display: none; }\n  .message-intel--v2 .message-intel__tile--orbit .message-intel__panel.glass-card,\n  .message-intel--v2 .message-intel__tile--feed .message-intel__panel.glass-card,\n  .message-intel--v2 .message-intel__tile--desk .message-intel__panel.glass-card,\n  .message-intel--v2 .message-intel__tile--pulse .message-intel__panel.glass-card {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n    padding: 6px 2px 10px;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .message-intel--v2 .message-intel__ekg path,\n  .message-intel--v2 .message-intel__sky-carrier,\n  .message-intel--v2 .message-intel__sky-carrier .message-intel__sky-node,\n  .message-intel--v2 .message-intel__sky-hub,\n  .message-intel--v2 .message-intel__sky-hub-core,\n  .message-intel--v2 .message-intel__sky-hub-plasma,\n  .message-intel--v2 .message-intel__sky-hub-filaments,\n  .message-intel--v2 .message-intel__sky-plasma-ring,\n  .message-intel--v2 .message-intel__sky-core-glow,\n  .message-intel--v2 .message-intel__sky-starfield,\n  .message-intel--v2 .message-intel__sky-bg-moon,\n  .message-intel--v2 .message-intel__sky-track--line,\n  .message-intel--v2 .message-intel__vis-pulse-dot,\n  .message-intel--v2 .message-intel__sky-dot::before { animation: none !important; }\n}\n\n/* Kept for Quiet-motion / test hooks — root no longer breathes an opaque board. */\n@keyframes message-intel-board-breathe {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 1; }\n}\n\n/* ── 2b. Spotlight zone: hero + week-top ─────────────────────────────────── */\n.message-intel--v2 .message-intel__spotlight {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 12px;\n  margin-bottom: 14px;\n  position: relative;\n  overflow: hidden;\n}\n/* Grid gap replaces individual bottom margins inside spotlight */\n.message-intel--v2 .message-intel__spotlight .message-intel__hero,\n.message-intel--v2 .message-intel__spotlight .message-intel__week-top {\n  margin-bottom: 0;\n}\n/* If only one child is visible the grid collapses gracefully */\n.message-intel--v2 .message-intel__spotlight > [hidden]:only-child {\n  display: none;\n}\n\n/* Intentional animation 3: diagonal gleam sweeps the spotlight (living-brain pulse) */\n.message-intel--v2 .message-intel__spotlight::after {\n  content: \"\";\n  position: absolute;\n  top: -60%;\n  left: -40%;\n  width: 55%;\n  height: 260%;\n  background: linear-gradient(\n    108deg,\n    transparent 28%,\n    rgba(31, 212, 124, 0.04) 46%,\n    rgba(63, 201, 255, 0.03) 54%,\n    transparent 72%\n  );\n  animation: message-intel-spotlight-gleam 11s linear infinite;\n  pointer-events: none;\n  z-index: 2;\n}\n@keyframes message-intel-spotlight-gleam {\n  0%   { transform: translateX(-15%); opacity: 0; }\n  8%   { opacity: 1; }\n  78%  { opacity: 1; }\n  100% { transform: translateX(380%); opacity: 0; }\n}\n\n/* ── 3. Feed row slide-in keyframe (animation applied to row rule above) ─── */\n@keyframes message-intel-row-in {\n  from { opacity: 0; transform: translateX(-10px); }\n  to   { opacity: 1; transform: translateX(0); }\n}\n/* Subtle stagger — gives the cascade a living-pulse feel without JS */\n.message-intel--v2 .message-intel__feed-rows .message-intel__feed-row:nth-child(2) { animation-delay: 0.05s; }\n.message-intel--v2 .message-intel__feed-rows .message-intel__feed-row:nth-child(3) { animation-delay: 0.10s; }\n.message-intel--v2 .message-intel__feed-rows .message-intel__feed-row:nth-child(4) { animation-delay: 0.14s; }\n.message-intel--v2 .message-intel__feed-rows .message-intel__feed-row:nth-child(n+5) { animation-delay: 0.18s; }\n\n/* ── Source strip: pulse ribbon visual polish ────────────────────────────── */\n.message-intel--v2 .message-intel__source-strip {\n  /* upgrade from plain border to a glowing pulse ribbon */\n  border-color: rgba(31, 212, 124, 0.22);\n  box-shadow: 0 0 18px -10px var(--mi-green-glow);\n  position: relative;\n}\n\n/* ── Section labels: slightly more desk-like weight ─────────────────────── */\n.message-intel--v2 .message-intel__sec-bar {\n  width: 3px;\n  height: 14px;\n}\n.message-intel--v2 .message-intel__panel-title {\n  font-size: 11.5px;\n  letter-spacing: 0.12em;\n}\n\n/* ── Week-top flagship treatment: violet glow on hover ──────────────────── */\n.message-intel--v2 .message-intel__week-top:hover {\n  box-shadow: 0 0 36px -14px var(--mi-violet-glow);\n  transition: box-shadow 0.3s ease;\n}\n\n/* ── Mobile spotlight: stack full-width ─────────────────────────────────── */\n@media (max-width: 739px) {\n  .message-intel--v2 .message-intel__spotlight {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ---- Telegram pulse v2 — tribunal amber tone-down ---- */\n.message-intel--v2 {\n  border-color: rgba(255, 184, 0, 0.35) !important;\n  box-shadow:\n    0 0 36px -18px rgba(255, 184, 0, 0.28),\n    0 0 0 1px rgba(255, 184, 0, 0.1) inset !important;\n  animation: none;\n}\n\n.message-intel--v2 .message-intel__flagship-chip {\n  opacity: 0.55;\n  font-size: 9px;\n  letter-spacing: 0.14em;\n  border-color: rgba(255, 184, 0, 0.22);\n  color: rgba(255, 184, 0, 0.65);\n  background: rgba(255, 184, 0, 0.06);\n}\n\n.message-intel--v2 .message-intel__source-strip {\n  font-size: 12px;\n  color: var(--mi-text-dim);\n  border-color: rgba(255, 184, 0, 0.12);\n  background: var(--glass-fill-subtle);\n}\n\n.message-intel--v2 .message-intel__source-strip b {\n  color: rgba(255, 184, 0, 0.85);\n  font-weight: 600;\n}\n\n.message-intel--v2 .message-intel__legend {\n  display: flex;\n  flex-wrap: nowrap;\n  gap: 10px 14px;\n  opacity: 0.55;\n  font-size: 10px;\n  padding: 6px 0 4px;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n.message-intel--v2 .message-intel__legend-item {\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.message-intel--v2 .message-intel__live-tag {\n  color: rgba(255, 184, 0, 0.8);\n  border-color: rgba(255, 184, 0, 0.25);\n}\n\n.message-intel--v2 .message-intel__summary-24h,\n.message-intel--v2 .message-intel__proof,\n.message-intel--v2 .message-intel__hc-strip {\n  border-color: rgba(255, 184, 0, 0.12);\n}\n\n/* Phase 2 SA2 — Telegram desk visual enhancements (Grok LOCK) */\n.message-intel__summary-24h-head {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.message-intel__sent-gauge-wrap {\n  flex-shrink: 0;\n}\n\n.message-intel__sent-gauge {\n  --mi-sent-deg: 180deg;\n  position: relative;\n  width: 48px;\n  height: 48px;\n}\n\n.message-intel__sent-gauge-ring {\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: conic-gradient(\n    from var(--mi-sent-deg),\n    rgba(56, 189, 248, 0.85) 0deg,\n    rgba(255, 184, 0, 0.75) 120deg,\n    rgba(148, 163, 184, 0.35) 220deg,\n    rgba(251, 113, 133, 0.7) 300deg,\n    rgba(56, 189, 248, 0.85) 360deg\n  );\n  mask: radial-gradient(circle, transparent 58%, #000 60%);\n  -webkit-mask: radial-gradient(circle, transparent 58%, #000 60%);\n  animation: mi-sent-rim 10s linear infinite;\n}\n\n.message-intel__sent-gauge-core {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-mono, 'JetBrains Mono', monospace);\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: rgba(226, 232, 240, 0.9);\n}\n\n@keyframes mi-sent-rim {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.message-intel__feed-row--enter {\n  animation: mi-feed-enter 0.42s ease-out backwards;\n  animation-delay: calc(var(--mi-i, 0) * 42ms);\n}\n\n.message-intel__feed-row--hot {\n  box-shadow:\n    inset 3px 0 0 rgba(255, 184, 0, 0.62),\n    inset 6px 0 18px rgba(56, 189, 248, 0.12);\n}\n\n@keyframes mi-feed-enter {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .message-intel__sent-gauge-ring {\n    animation: none;\n  }\n\n  .message-intel__feed-row--enter {\n    animation: none;\n  }\n}\n\n/* Message intel — mobile touch targets (≤640, migrated from ui-legacy.css P3-3g) */\n@media (max-width: 640px) {\n  .message-intel--v2 {\n    padding-left: max(0px, env(safe-area-inset-left, 0px));\n    padding-right: max(0px, env(safe-area-inset-right, 0px));\n    overflow-x: visible;\n  }\n\n  .message-intel--v2 .message-intel__page-title {\n    font-size: clamp(1.55rem, 8vw, 1.9rem) !important;\n    line-height: 1.12;\n  }\n\n  .message-intel--v2 .message-intel__hero-main {\n    gap: 12px;\n  }\n\n  .message-intel--v2 .message-intel__week-top-meta {\n    gap: 8px;\n  }\n\n  .message-intel--v2 .message-intel__filter-chip {\n    min-height: 44px;\n    padding: 8px 12px;\n  }\n\n  .message-intel--v2 .message-intel__status-rail {\n    font-size: 11px;\n  }\n\n  .message-intel--v2 .message-intel__pulse,\n  .message-intel--v2 .message-intel__live-tag {\n    font-size: 11px;\n  }\n}\n\n/* ── Telegram pulse: cosmic-glass intercept (overrides opaque flagship paint) ─\n   Clear glass so the site cosmic sky reads through — same language as Council. */\n.message-intel--v2 {\n  background: var(--glass-fill-card) !important;\n  background-image: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 40%, transparent 72%) !important;\n  border-color: var(--glass-border, rgba(255, 255, 255, 0.14)) !important;\n  box-shadow: 0 1px 0 rgba(255,255,255,0.08), var(--shadow-card, 0 8px 32px rgba(0, 0, 0, 0.32)) !important;\n  animation: none;\n}\n\n.message-intel--v2 .message-intel__masthead {\n  padding: clamp(6px, 1.5vw, 16px) clamp(2px, 0.8vw, 10px) 16px;\n  margin-bottom: 10px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.message-intel--v2 .message-intel__topbar {\n  align-items: center;\n  gap: 10px;\n}\n\n.message-intel--v2 .message-intel__brand {\n  color: rgba(213, 228, 234, 0.82);\n  letter-spacing: 0.12em;\n}\n\n.message-intel--v2 .message-intel__page-title {\n  margin-top: 12px;\n  font-size: clamp(2rem, 5.2vw, 3.8rem);\n  line-height: 0.98;\n  letter-spacing: -0.045em;\n  text-wrap: balance;\n}\n\n.message-intel--v2 .message-intel__page-sub {\n  max-width: 58ch;\n  margin-top: 10px;\n  color: rgba(199, 215, 222, 0.72);\n  font-size: clamp(0.9rem, 1.5vw, 1rem);\n}\n\n.message-intel--v2 .message-intel__flagship-chip {\n  opacity: 1;\n  padding: 5px 8px;\n  border-color: rgba(255, 184, 0, 0.45);\n  color: rgba(255, 210, 93, 0.94);\n  background: linear-gradient(135deg, rgba(255, 184, 0, 0.18), rgba(255, 184, 0, 0.05));\n  box-shadow: 0 0 18px -10px rgba(255, 184, 0, 0.95);\n}\n\n.message-intel--v2 .message-intel__pulse-stage {\n  gap: 12px;\n  padding: 12px;\n  margin-bottom: 16px;\n  border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.14));\n  border-radius: var(--glass-radius, 12px);\n  background: var(--glass-fill-subtle);\n}\n\n.message-intel--v2 .message-intel__source-strip {\n  min-height: 48px;\n  padding: 10px 13px;\n  border-color: var(--glass-border, rgba(255, 255, 255, 0.14));\n  border-radius: var(--glass-radius, 12px);\n  background: var(--glass-fill-subtle);\n}\n\n.message-intel--v2 .message-intel__live-tag {\n  padding: 4px 7px;\n  border-radius: 999px;\n  color: #caffdd;\n  border-color: rgba(70, 244, 147, 0.48);\n  background: rgba(31, 212, 124, 0.13);\n}\n\n.message-intel--v2 .message-intel__summary-24h,\n.message-intel--v2 .message-intel__proof,\n.message-intel--v2 .message-intel__hc-strip,\n.message-intel--v2 .message-intel__callers,\n.message-intel--v2 .message-intel__consensus,\n.message-intel--v2 .message-intel__divergence {\n  border-radius: 14px;\n  border-color: rgba(255, 255, 255, 0.08);\n  background: rgba(255, 255, 255, 0.015);\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n}\n\n.message-intel--v2 .message-intel__legend {\n  gap: 7px 12px;\n  padding: 2px 1px 0;\n  opacity: 0.78;\n  scrollbar-width: thin;\n}\n\n.message-intel--v2 .message-intel__legend-item {\n  padding: 3px 0;\n  color: rgba(202, 216, 224, 0.75);\n}\n\n.message-intel--v2 .message-intel__sec-label {\n  align-items: center;\n  padding-bottom: 9px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.message-intel--v2 .message-intel__sec-bar {\n  width: 4px;\n  height: 18px;\n  border-radius: 999px;\n  box-shadow: 0 0 14px currentColor;\n}\n\n.message-intel--v2 .message-intel__panel-title {\n  font-size: 12px;\n  letter-spacing: 0.14em;\n}\n\n.message-intel--v2 .message-intel__panel-unit {\n  margin-left: auto;\n  padding: 3px 7px;\n  border: 1px solid rgba(255, 255, 255, 0.09);\n  border-radius: 999px;\n  color: rgba(197, 215, 222, 0.60);\n  background: transparent;\n}\n\n.message-intel--v2 .message-intel__panel--feed {\n  margin-top: 0;\n  margin-bottom: 16px;\n  padding: clamp(14px, 2vw, 22px);\n  border-color: rgba(255, 255, 255, 0.08);\n  border-radius: var(--glass-radius, 12px);\n  background: rgba(255, 255, 255, 0.015);\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n}\n\n.message-intel--v2 .message-intel__filter-bar {\n  gap: 12px;\n  margin: 14px 0 16px;\n  padding: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.07);\n  border-radius: 12px;\n  background: var(--glass-fill-subtle);\n}\n\n.message-intel--v2 .message-intel__filter-label {\n  color: rgba(178, 205, 215, 0.66);\n  letter-spacing: 0.1em;\n}\n\n.message-intel--v2 .message-intel__filter-chip {\n  border-radius: 999px;\n  transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease, transform 150ms ease;\n}\n\n.message-intel--v2 .message-intel__filter-chip:hover,\n.message-intel--v2 .message-intel__filter-chip:focus-visible {\n  transform: translateY(-1px);\n  border-color: rgba(63, 201, 255, 0.60);\n  box-shadow: 0 0 0 3px rgba(63, 201, 255, 0.12);\n}\n\n.message-intel--v2 .message-intel__feed {\n  position: relative;\n}\n\n.message-intel--v2 .message-intel__feed::before {\n  content: \"\";\n  position: absolute;\n  top: 11px;\n  bottom: 11px;\n  left: 16px;\n  width: 1px;\n  background: linear-gradient(to bottom, rgba(31, 212, 124, 0.68), rgba(63, 201, 255, 0.18) 75%, transparent);\n  pointer-events: none;\n}\n\n.message-intel--v2 .message-intel__feed-row {\n  position: relative;\n  margin: 0 0 9px;\n  border: 1px solid rgba(255, 255, 255, 0.075);\n  border-radius: 13px;\n  background: var(--glass-fill-subtle);\n  background-image: linear-gradient(100deg, rgba(255,255,255,0.04), transparent);\n  box-shadow: 0 1px 0 rgba(255,255,255,0.06);\n  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;\n}\n\n.message-intel--v2 .message-intel__feed-row::after {\n  content: \"\";\n  position: absolute;\n  top: 15px;\n  left: 12px;\n  width: 9px;\n  height: 9px;\n  border: 2px solid rgba(169, 245, 209, 0.92);\n  border-radius: 50%;\n  background: #07100f;\n  box-shadow: 0 0 0 4px rgba(31, 212, 124, 0.12), 0 0 12px -2px rgba(31, 212, 124, 0.80);\n}\n\n.message-intel--v2 .message-intel__feed-row:hover,\n.message-intel--v2 .message-intel__feed-row:focus-within {\n  z-index: 1;\n  transform: translateX(3px);\n  border-color: rgba(63, 201, 255, 0.35);\n  background: var(--glass-fill-subtle);\n  background-image: linear-gradient(100deg, rgba(63, 201, 255, 0.08), transparent);\n  box-shadow: 0 1px 0 rgba(255,255,255,0.08), 0 0 22px -18px rgba(63, 201, 255, 0.78);\n}\n\n.message-intel--v2 .message-intel__feed-row--hot {\n  border-color: var(--warm-hairline, rgba(255, 170, 100, 0.40));\n  background: rgba(255, 170, 100, 0.05);\n  box-shadow: inset 3px 0 0 rgba(255, 170, 100, 0.70);\n}\n\n.message-intel--v2 .message-intel__feed-row--hot::after {\n  border-color: rgba(255, 223, 139, 0.98);\n  box-shadow: 0 0 0 4px rgba(255, 184, 0, 0.15), 0 0 14px -2px rgba(255, 184, 0, 0.92);\n}\n\n@media (min-width: 740px) {\n  .message-intel--v2 .message-intel__pulse-stage {\n    grid-template-columns: 1fr;\n  }\n\n  .message-intel--v2 .message-intel__proof,\n  .message-intel--v2 .message-intel__callers,\n  .message-intel--v2 .message-intel__consensus,\n  .message-intel--v2 .message-intel__divergence {\n    min-height: 100%;\n  }\n}\n\n@media (max-width: 739px) {\n  .message-intel--v2 .message-intel__masthead {\n    padding: 4px 0 13px;\n  }\n\n  .message-intel--v2 .message-intel__page-title {\n    font-size: clamp(2rem, 12vw, 2.8rem);\n  }\n\n  .message-intel--v2 .message-intel__pulse-stage {\n    padding: 9px;\n    border-radius: 14px;\n  }\n\n  .message-intel--v2 .message-intel__filter-bar {\n    padding: 10px;\n  }\n\n  .message-intel--v2 .message-intel__feed::before {\n    left: 13px;\n  }\n\n  .message-intel--v2 .message-intel__feed-row::after {\n    left: 9px;\n  }\n\n  .message-intel--v2 .message-intel__feed-row:hover,\n  .message-intel--v2 .message-intel__feed-row:focus-within {\n    transform: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .message-intel--v2 .message-intel__filter-chip,\n  .message-intel--v2 .message-intel__feed-row {\n    transition: none;\n  }\n}\n\n/* Phase 2 SA3 — picks + radar visual enhancements (Grok LOCK) */\n#section-picks .pick-card--reveal .conviction-fill {\n  transform: scaleX(0);\n  transform-origin: left center;\n  animation: pick-conf-reveal 0.55s ease-out forwards;\n  animation-delay: calc(var(--pick-i, 0) * 55ms);\n}\n\n@keyframes pick-conf-reveal {\n  to {\n    transform: scaleX(1);\n  }\n}\n\n.pick-card--lead {\n  isolation: isolate;\n}\n\n.pick-card--lead::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  padding: 1px;\n  background: conic-gradient(\n    from var(--pick-rim-angle, 0deg),\n    rgba(255, 184, 0, 0.55),\n    rgba(56, 189, 248, 0.45),\n    rgba(255, 184, 0, 0.35),\n    rgba(56, 189, 248, 0.55)\n  );\n  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  -webkit-mask-composite: xor;\n  mask-composite: exclude;\n  pointer-events: none;\n  z-index: 2;\n  animation: pick-lead-rim 8s linear infinite;\n}\n\n.pick-card--lead-hour::after {\n  filter: drop-shadow(0 0 10px rgba(255, 184, 0, 0.35));\n}\n\n.pick-card--lead-day::after {\n  filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.35));\n}\n\n@keyframes pick-lead-rim {\n  to {\n    --pick-rim-angle: 360deg;\n  }\n}\n\n.chart-canvas-wrap--radar {\n  position: relative;\n  isolation: isolate;\n}\n\n.chart-canvas-wrap--radar::before {\n  content: \"\";\n  position: absolute;\n  inset: -3px;\n  border-radius: inherit;\n  background: conic-gradient(\n    from 0deg,\n    rgba(31, 212, 124, 0.45),\n    rgba(56, 189, 248, 0.4),\n    rgba(31, 212, 124, 0.25),\n    rgba(56, 189, 248, 0.45)\n  );\n  opacity: 0.55;\n  animation: radar-frame-spin 14s linear infinite;\n  z-index: 0;\n  pointer-events: none;\n}\n\n.chart-canvas-wrap--radar canvas {\n  position: relative;\n  z-index: 1;\n}\n\n@keyframes radar-frame-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.radar-item--enter {\n  animation: radar-item-enter 0.45s ease-out backwards;\n  animation-delay: calc(var(--radar-i, 0) * 48ms);\n}\n\n@keyframes radar-item-enter {\n  from {\n    opacity: 0;\n    transform: translateX(-8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n.radar-item--lead {\n  box-shadow: inset 0 0 0 1px rgba(31, 212, 124, 0.22);\n  background: rgba(31, 212, 124, 0.04);\n  border-radius: var(--radius-md, 8px);\n  padding: 8px 10px;\n}\n\n.radar-item__track {\n  margin-top: 6px;\n  height: 4px;\n  border-radius: 999px;\n  background: rgba(148, 163, 184, 0.12);\n  overflow: hidden;\n}\n\n.radar-item__bar {\n  height: 100%;\n  border-radius: inherit;\n  transform-origin: left center;\n  transition: width 0.35s ease;\n}\n\n.radar-item__bar--up {\n  background: linear-gradient(90deg, rgba(56, 189, 248, 0.35), rgba(56, 189, 248, 0.85));\n}\n\n.radar-item__bar--down {\n  background: linear-gradient(90deg, rgba(148, 163, 184, 0.25), rgba(148, 163, 184, 0.55));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  #section-picks .pick-card--reveal .conviction-fill,\n  .pick-card--lead::after,\n  .chart-canvas-wrap--radar::before,\n  .radar-item--enter {\n    animation: none;\n  }\n\n  #section-picks .pick-card--reveal .conviction-fill {\n    transform: scaleX(1);\n  }\n\n  .chart-canvas-wrap--radar::before {\n    transform: none;\n  }\n}\n\n/* Phase 2 SA4 — market pulse + predictions (Grok LOCK) */\n.sr-pulse__oneline.live-only {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px 10px;\n}\n\n.sr-pulse__breadth-wrap {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  isolation: isolate;\n}\n\n.sr-pulse__breadth-halo {\n  position: absolute;\n  inset: -4px -8px;\n  border-radius: 999px;\n  opacity: 0.45;\n  z-index: 0;\n  pointer-events: none;\n  animation: pulse-breadth-halo 4s ease-in-out infinite;\n}\n\n.sr-pulse__breadth-wrap:has(.sr-pulse__oneline-part--bullish) .sr-pulse__breadth-halo {\n  background: radial-gradient(circle, rgba(31, 212, 124, 0.35) 0%, transparent 70%);\n}\n\n.sr-pulse__breadth-wrap:has(.sr-pulse__oneline-part--bearish) .sr-pulse__breadth-halo {\n  background: radial-gradient(circle, rgba(255, 159, 63, 0.32) 0%, transparent 70%);\n}\n\n.sr-pulse__breadth-wrap:has(.sr-pulse__oneline-part--neutral) .sr-pulse__breadth-halo {\n  background: radial-gradient(circle, rgba(56, 189, 248, 0.28) 0%, transparent 70%);\n}\n\n.sr-pulse__breadth-wrap .sr-pulse__oneline-part {\n  position: relative;\n  z-index: 1;\n  padding: 2px 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(148, 163, 184, 0.18);\n  background: var(--glass-fill-subtle);\n  backdrop-filter: blur(6px);\n}\n\n@keyframes pulse-breadth-halo {\n  0%,\n  100% {\n    transform: scale(1);\n    opacity: 0.35;\n  }\n  50% {\n    transform: scale(1.08);\n    opacity: 0.55;\n  }\n}\n\n.sr-pulse__ratio-meter {\n  --pulse-up: 1;\n  --pulse-down: 1;\n  --pulse-total: calc(var(--pulse-up) + var(--pulse-down));\n  display: inline-block;\n  width: 52px;\n  height: 6px;\n  border-radius: 999px;\n  background: linear-gradient(\n    90deg,\n    rgba(31, 212, 124, 0.85) 0%,\n    rgba(31, 212, 124, 0.85) calc(var(--pulse-up) / var(--pulse-total) * 100%),\n    rgba(255, 159, 63, 0.75) calc(var(--pulse-up) / var(--pulse-total) * 100%),\n    rgba(255, 159, 63, 0.75) 100%\n  );\n  box-shadow: 0 0 10px rgba(31, 212, 124, 0.15);\n  vertical-align: middle;\n}\n\n.kpi--accuracy-gauge {\n  position: relative;\n  isolation: isolate;\n}\n\n.kpi__gauge-ring {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  padding: 1px;\n  background: conic-gradient(\n    from -90deg,\n    rgba(31, 212, 124, 0.75) 0deg,\n    rgba(31, 212, 124, 0.75) calc(var(--kpi-p, 0) * 3.6deg),\n    rgba(148, 163, 184, 0.15) calc(var(--kpi-p, 0) * 3.6deg),\n    rgba(148, 163, 184, 0.15) 360deg\n  );\n  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  -webkit-mask-composite: xor;\n  mask-composite: exclude;\n  pointer-events: none;\n  z-index: 0;\n  animation: kpi-gauge-fill 0.6s ease-out;\n}\n\n.kpi--accuracy-gauge--amber .kpi__gauge-ring {\n  background: conic-gradient(\n    from -90deg,\n    rgba(255, 159, 63, 0.8) 0deg,\n    rgba(255, 159, 63, 0.8) calc(var(--kpi-p, 0) * 3.6deg),\n    rgba(148, 163, 184, 0.15) calc(var(--kpi-p, 0) * 3.6deg),\n    rgba(148, 163, 184, 0.15) 360deg\n  );\n}\n\n.kpi--accuracy-gauge > :not(.kpi__gauge-ring) {\n  position: relative;\n  z-index: 1;\n}\n\n@keyframes kpi-gauge-fill {\n  from {\n    opacity: 0.35;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n.story-strip__item--enter {\n  animation: story-strip-enter 0.4s ease-out backwards;\n  animation-delay: calc(var(--story-i, 0) * 40ms);\n}\n\n.story-strip__item--correct {\n  box-shadow: inset 3px 0 0 rgba(31, 212, 124, 0.65), 0 0 14px rgba(31, 212, 124, 0.08);\n}\n\n.story-strip__item--wrong {\n  box-shadow: inset 3px 0 0 rgba(255, 159, 63, 0.55), 0 0 12px rgba(255, 159, 63, 0.06);\n}\n\n@keyframes story-strip-enter {\n  from {\n    opacity: 0;\n    transform: translateX(-6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sr-pulse__breadth-halo {\n    animation: none;\n    opacity: 0.4;\n  }\n\n  .kpi__gauge-ring {\n    animation: none;\n  }\n\n  .story-strip__item--enter {\n    animation: none;\n  }\n}\n\n/* Phase 2 SA5 — social, health HUD, fonts, integrations rail (Grok LOCK) */\n.ops-readiness-badge {\n  display: inline-flex !important;\n  align-items: center;\n  font-family: var(--font-mono, 'JetBrains Mono', monospace);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  padding: 4px 8px;\n  border-radius: var(--radius-pill, 9999px);\n  border: 1px solid rgba(148, 163, 184, 0.2);\n  background: var(--glass-fill-subtle);\n  animation: ops-readiness-pulse 3s ease-in-out infinite;\n}\n\n.ops-readiness--ready {\n  color: var(--accent-primary, #1fd47c);\n  border-color: rgba(31, 212, 124, 0.35);\n  box-shadow: 0 0 12px rgba(31, 212, 124, 0.12);\n}\n\n.ops-readiness--warming {\n  color: var(--accent-orange, #ff9f3f);\n  border-color: rgba(255, 159, 63, 0.35);\n}\n\n.ops-readiness--degraded {\n  color: #fb7185;\n  border-color: rgba(251, 113, 133, 0.35);\n  animation: ops-readiness-pulse-rose 2.5s ease-in-out infinite;\n}\n\n@keyframes ops-readiness-pulse {\n  0%,\n  100% {\n    opacity: 0.88;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n\n@keyframes ops-readiness-pulse-rose {\n  0%,\n  100% {\n    opacity: 0.75;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n\n.soc-card {\n  position: relative;\n  isolation: isolate;\n}\n\n.soc-card--bullish {\n  box-shadow: inset 0 0 0 1px rgba(31, 212, 124, 0.18);\n}\n\n.soc-card--bearish {\n  box-shadow: inset 0 0 0 1px rgba(251, 113, 133, 0.16);\n}\n\n.soc-card--neutral {\n  box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.14);\n}\n\n.soc-card--hot {\n  animation: soc-hot-halo 4s ease-in-out infinite;\n}\n\n@keyframes soc-hot-halo {\n  0%,\n  100% {\n    box-shadow: 0 0 0 0 rgba(31, 212, 124, 0.08), inset 0 0 0 1px rgba(31, 212, 124, 0.22);\n  }\n  50% {\n    box-shadow: 0 0 18px rgba(31, 212, 124, 0.12), inset 0 0 0 1px rgba(31, 212, 124, 0.35);\n  }\n}\n\n.soc-card--enter {\n  animation: soc-card-enter 0.42s ease-out backwards;\n  animation-delay: calc(var(--soc-i, 0) * 44ms);\n}\n\n@keyframes soc-card-enter {\n  from {\n    opacity: 0;\n    transform: translateY(8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.soc-vol-track {\n  margin-top: 6px;\n  height: 3px;\n  border-radius: 999px;\n  background: rgba(148, 163, 184, 0.12);\n  overflow: hidden;\n}\n\n.soc-vol-fill {\n  display: block;\n  height: 100%;\n  width: calc(var(--soc-vol, 0) * 1%);\n  border-radius: inherit;\n  background: linear-gradient(90deg, rgba(56, 189, 248, 0.35), rgba(31, 212, 124, 0.75));\n  transition: width 0.35s ease;\n}\n\n.subnet-int-strip--live {\n  box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.18), 0 0 16px rgba(56, 189, 248, 0.08);\n}\n\n.subnet-int-strip--live .subnet-int-dot--connected {\n  animation: subnet-int-live-halo 2.5s ease-in-out infinite;\n}\n\n@keyframes subnet-int-live-halo {\n  0%,\n  100% {\n    box-shadow: 0 0 4px rgba(31, 212, 124, 0.35);\n  }\n  50% {\n    box-shadow: 0 0 10px rgba(56, 189, 248, 0.55);\n  }\n}\n\n.subnet-int-strip--stale .subnet-int-strip__count {\n  animation: subnet-int-stale-breathe 2.8s ease-in-out infinite;\n}\n\n@keyframes subnet-int-stale-breathe {\n  0%,\n  100% {\n    opacity: 0.65;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .ops-readiness-badge,\n  .soc-card--hot,\n  .soc-card--enter,\n  .subnet-int-strip--live .subnet-int-dot--connected,\n  .subnet-int-strip--stale .subnet-int-strip__count {\n    animation: none;\n  }\n\n  .soc-vol-fill {\n    transition: none;\n  }\n}\n\n\n/* ---- Pump desk (migrated from ui-legacy.css, P3-3f) ---- */\n/* Pump desk (from pump_alert.html) */\n/* —— Pump desk flagship: Situation Room formation theater —— */\n.pump-alert {\n    --pd-ink: #e8f0e9;\n    --pd-sub: #94a3b8;\n    --pd-dim: #64748b;\n    --pd-line: rgba(148, 163, 184, 0.14);\n    --pd-panel: transparent;\n    --pd-lead: #fbbf24;\n    --pd-live: #fb7185;\n    --pd-exit: #34d399;\n    --pd-cyan: #38bdf8;\n    position: relative;\n    margin: 0;\n    padding: 18px 0 28px;\n    border-top: 1px solid var(--pd-line);\n    color: var(--pd-ink);\n    overflow: hidden;\n}\n.pump-alert--board {\n    border-top: none;\n    padding-top: 8px;\n    border-left: 3px solid var(--pd-cyan);\n    padding-left: 12px;\n    margin-left: -2px;\n}\n.pd-atmosphere {\n    position: absolute;\n    inset: -20% -10% auto -10%;\n    height: 70%;\n    pointer-events: none;\n    background:\n      radial-gradient(ellipse 70% 55% at 12% 20%, rgba(56, 189, 248, 0.10), transparent 60%),\n      radial-gradient(ellipse 50% 40% at 88% 8%, rgba(251, 191, 36, 0.07), transparent 55%);\n    z-index: 0;\n}\n.pump-alert > *:not(.pd-atmosphere) { position: relative; z-index: 1; }\n\n.pd-head { margin-bottom: 14px; }\n.pd-head__top { margin-bottom: 10px; }\n.pd-title {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin: 0;\n    font-size: clamp(22px, 5vw, 28px);\n    font-weight: 800;\n    letter-spacing: -0.03em;\n    color: var(--pd-ink);\n}\n.pd-eyebrow {\n    margin: 4px 0 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: var(--pd-dim);\n}\n.pd-live {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #34d399;\n    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55);\n    animation: pdLivePulse 2s ease-out infinite;\n}\n@keyframes pdLivePulse {\n    0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }\n    70% { box-shadow: 0 0 0 8px rgba(52, 211, 153, 0); }\n    100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }\n}\n\n.pd-proof {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n}\n.pd-proof__ready {\n    display: flex;\n    align-items: baseline;\n    gap: 10px;\n    flex-wrap: wrap;\n}\n.pd-proof__pct {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 28px;\n    font-weight: 800;\n    line-height: 1;\n    color: #fbbf24;\n    text-shadow: 0 0 18px rgba(251, 191, 36, 0.25);\n}\n.pd-proof__copy {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    color: var(--pd-sub);\n}\n.pd-proof__building {\n    margin: 0;\n    font-size: 12.5px;\n    line-height: 1.45;\n    color: var(--pd-sub);\n}\n.pd-freshness {\n    margin: 0 0 8px;\n    font-size: 12px;\n    line-height: 1.4;\n    color: #fbbf24;\n}\n.pd-census {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n}\n.pd-census__chip {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    padding: 5px 9px;\n    border-radius: 8px;\n    border: 1px solid var(--pd-line);\n    background: var(--glass-fill-subtle);\n    color: var(--pd-sub);\n}\n.pd-census__chip b { color: var(--pd-ink); font-weight: 700; }\n.pd-census__chip--lead { border-color: rgba(251, 191, 36, 0.35); }\n.pd-census__chip--lead b { color: #fbbf24; }\n.pd-census__chip--live { border-color: rgba(251, 113, 133, 0.35); }\n.pd-census__chip--live b { color: #fb7185; }\n.pd-census__chip--exit { border-color: rgba(52, 211, 153, 0.35); }\n.pd-census__chip--exit b { color: #34d399; }\n\n/* Primary lead theater */\n.pd-lead,\n.pds-hero,\n.pump-hero__card,\n#pump-desk-hero {\n    background: var(--glass-fill) !important;\n    background-image: none !important;\n    backdrop-filter: blur(var(--glass-blur));\n    -webkit-backdrop-filter: blur(var(--glass-blur));\n    border: 1px solid var(--glass-border);\n    border-radius: var(--glass-radius);\n}\n\n.pd-lead {\n    margin-bottom: 16px;\n    padding: 14px 14px 16px;\n    border-color: rgba(251, 191, 36, 0.28);\n    box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.04), 0 12px 32px rgba(0, 0, 0, 0.28);\n}\n.pd-lead--confirmed {\n    border-color: rgba(251, 113, 133, 0.35);\n    box-shadow: 0 0 0 1px rgba(251, 113, 133, 0.06), 0 12px 32px rgba(0, 0, 0, 0.28);\n}\n.pd-lead--exit {\n    border-color: rgba(52, 211, 153, 0.35);\n}\n\n.pd-lead {\n    position: relative;\n    overflow: hidden;\n}\n.pd-lead__visual {\n    position: absolute;\n    inset: -12% -6% -20% 42%;\n    pointer-events: none;\n    z-index: 0;\n    overflow: hidden;\n    background:\n      radial-gradient(ellipse 60% 55% at 68% 42%, rgba(56, 189, 248, 0.16), transparent 68%),\n      radial-gradient(ellipse 45% 40% at 92% 18%, rgba(14, 165, 233, 0.1), transparent 62%);\n}\n.pd-lead__visual--accumulating {\n    background:\n      radial-gradient(ellipse 58% 52% at 70% 40%, rgba(251, 191, 36, 0.18), transparent 68%),\n      radial-gradient(ellipse 42% 38% at 90% 16%, rgba(245, 158, 11, 0.12), transparent 62%);\n}\n.pd-lead__visual--pumping {\n    background:\n      radial-gradient(ellipse 58% 52% at 70% 40%, rgba(251, 113, 133, 0.2), transparent 68%),\n      radial-gradient(ellipse 42% 38% at 90% 16%, rgba(244, 63, 94, 0.12), transparent 62%);\n}\n.pd-lead__visual--cooling {\n    background:\n      radial-gradient(ellipse 58% 52% at 70% 40%, rgba(52, 211, 153, 0.16), transparent 68%),\n      radial-gradient(ellipse 42% 38% at 90% 16%, rgba(16, 185, 129, 0.1), transparent 62%);\n}\n.pd-lead__arc {\n    position: absolute;\n    right: 4%;\n    top: 8%;\n    width: min(42%, 7rem);\n    height: auto;\n    opacity: 0.85;\n}\n.pd-lead__arc-track {\n    stroke: rgba(148, 163, 184, 0.2);\n    stroke-width: 3;\n    stroke-linecap: round;\n}\n.pd-lead__arc-fill {\n    stroke: rgba(56, 189, 248, 0.55);\n    stroke-width: 3;\n    stroke-linecap: round;\n}\n.pd-lead--confirmed .pd-lead__arc-fill { stroke: rgba(251, 113, 133, 0.6); }\n.pd-lead--exit .pd-lead__arc-fill { stroke: rgba(52, 211, 153, 0.55); }\n.pd-lead__identity,\n.pd-lead__bar,\n.pd-phase,\n.pd-verdict,\n.pd-evidence,\n.pd-raw,\n.pd-triad,\n.pd-chip,\n.pd-angles,\n.pd-cta {\n    position: relative;\n    z-index: 1;\n}\n\n.pd-lead__identity {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n}\n.pd-lead__badge {\n    flex-shrink: 0;\n    margin-top: 2px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    padding: 4px 8px;\n    border-radius: 6px;\n    color: #fde68a;\n    background: rgba(251, 191, 36, 0.16);\n    border: 1px solid rgba(251, 191, 36, 0.28);\n}\n.pd-lead__badge--chase-risk,\n.pd-lead__badge--just-started {\n    color: #fecdd3;\n    background: rgba(251, 113, 133, 0.16);\n    border-color: rgba(251, 113, 133, 0.3);\n}\n.pd-lead__badge--fading {\n    color: #a7f3d0;\n    background: rgba(52, 211, 153, 0.14);\n    border-color: rgba(52, 211, 153, 0.28);\n}\n.pump-pattern-chip {\n    display: inline-block;\n    max-width: 100%;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0.02em;\n    padding: 3px 8px;\n    border-radius: 999px;\n    color: #a5f3fc;\n    background: rgba(34, 211, 238, 0.12);\n    border: 1px solid rgba(34, 211, 238, 0.28);\n}\n.pump-pattern-chip--row { margin: 4px 0 0; max-width: 92%; }\n/* One cyan rail — up to 5 compact legs (↑4%/2h·…); nowrap + subtle horizontal scroll */\n.pump-pattern-rail {\n  width: 100%;\n  max-width: 100%;\n  margin-top: 4px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n}\n.pump-pattern-rail::-webkit-scrollbar { display: none; }\n.pump-pattern-line {\n  margin: 0;\n  display: block;\n  white-space: nowrap;\n  font-family: 'JetBrains Mono', ui-monospace, monospace;\n  font-size: 9px;\n  font-weight: 600;\n  line-height: 1.3;\n  letter-spacing: 0.01em;\n  color: #a5f3fc;\n  text-shadow: 0 0 12px rgba(34, 211, 238, 0.12);\n}\n.pump-pattern-line--hero {\n  margin: 0;\n}\n.pump-pattern-tip,\n.pd-r__num[title],\n.pds-ladder__num[title],\n.tribunal-hero__brand[title] {\n  cursor: help;\n}\n.pump-pattern-rail + .pd-r__why,\n.pump-pattern-rail + .pds-ladder__why {\n  margin-top: 5px;\n}\n.pd-lead__identity + .pump-pattern-rail,\n.pds-hero__copy > .pump-pattern-rail {\n  margin: 4px 0 8px;\n}\n.pd-lead--pattern-highlight {\n    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.35), 0 8px 28px rgba(34, 211, 238, 0.08);\n}\n.pd-lead__who { flex: 1 1 auto; min-width: 0; }\n.pd-lead__name {\n    display: block;\n    font-size: 18px;\n    font-weight: 700;\n    color: var(--pd-ink);\n    text-decoration: none;\n    letter-spacing: -0.02em;\n}\n.pd-lead__sn {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    font-weight: 600;\n    color: var(--pd-dim);\n}\n.pd-lead__ago {\n    display: block;\n    margin-top: 2px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    color: var(--pd-dim);\n}\n.pd-lead__meter {\n    flex-shrink: 0;\n    text-align: right;\n}\n.pd-lead__meter-val {\n    display: block;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 32px;\n    font-weight: 800;\n    line-height: 1;\n    color: #fbbf24;\n}\n.pd-lead--confirmed .pd-lead__meter-val { color: #fb7185; }\n.pd-lead--exit .pd-lead__meter-val { color: #34d399; }\n.pd-lead__meter-val i { font-size: 14px; font-style: normal; opacity: 0.55; }\n.pd-lead__meter-lbl {\n    display: block;\n    margin-top: 3px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: var(--pd-dim);\n}\n\n.pd-lead__bar {\n    position: relative;\n    margin-top: 12px;\n    height: 28px;\n    border-radius: 8px;\n    background: var(--glass-fill-card);\n    border: 1px solid var(--pd-line);\n    overflow: hidden;\n}\n.pd-lead__bar-fill {\n    display: block;\n    height: 100%;\n    background: linear-gradient(90deg, rgba(251, 191, 36, 0.25), rgba(251, 191, 36, 0.7));\n    box-shadow: 0 0 12px rgba(251, 191, 36, 0.35);\n}\n.pd-lead--confirmed .pd-lead__bar-fill {\n    background: linear-gradient(90deg, rgba(251, 113, 133, 0.25), rgba(251, 113, 133, 0.7));\n    box-shadow: 0 0 12px rgba(251, 113, 133, 0.3);\n}\n.pd-lead__trend {\n    position: absolute;\n    inset: 4px 8px;\n    opacity: 0.9;\n}\n.pd-lead__trend .pump-progress { width: 100%; height: 20px; display: block; }\n\n.pd-phase {\n    display: flex;\n    gap: 0;\n    margin: 12px 0 0;\n    padding: 0;\n    list-style: none;\n    border: 1px solid var(--pd-line);\n    border-radius: 10px;\n    overflow: hidden;\n}\n.pd-phase__step {\n    flex: 1;\n    padding: 7px 4px;\n    text-align: center;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: var(--pd-dim);\n    background: var(--glass-fill-subtle);\n    border-right: 1px solid var(--pd-line);\n}\n.pd-phase__step:last-child { border-right: none; }\n.pd-phase__step--now {\n    color: #fde68a;\n    background: rgba(251, 191, 36, 0.14);\n    font-weight: 700;\n}\n.pd-lead--confirmed .pd-phase__step--now {\n    color: #fecdd3;\n    background: rgba(251, 113, 133, 0.14);\n}\n.pd-lead--exit .pd-phase__step--now {\n    color: #a7f3d0;\n    background: rgba(52, 211, 153, 0.14);\n}\n\n.pd-verdict { margin-top: 14px; }\n.pd-verdict__move {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n    color: var(--pd-ink);\n}\n.pd-verdict__thesis {\n    margin: 6px 0 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: #cbd5e1;\n}\n.pd-verdict__trigger {\n    margin: 10px 0 0;\n    padding: 10px 12px;\n    border-radius: 10px;\n    border: 1px solid rgba(56, 189, 248, 0.28);\n    background: rgba(56, 189, 248, 0.06);\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11.5px;\n    line-height: 1.45;\n    color: #bae6fd;\n}\n.pd-lead--confirmed .pd-verdict__trigger {\n    border-color: rgba(251, 113, 133, 0.3);\n    background: rgba(251, 113, 133, 0.06);\n    color: #fecdd3;\n}\n\n.pd-evidence {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 8px;\n    margin-top: 14px;\n}\n.pd-evidence__cell {\n    padding: 10px 8px;\n    border-radius: 10px;\n    background: var(--glass-fill-card);\n    border: 1px solid var(--pd-line);\n}\n.pd-evidence__k {\n    display: block;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--pd-dim);\n}\n.pd-evidence__v {\n    display: block;\n    margin-top: 4px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 20px;\n    font-weight: 800;\n    line-height: 1;\n    color: var(--pd-ink);\n}\n.pd-evidence__v--gap { color: #6ee7b7; }\n.pd-evidence__cap {\n    display: block;\n    margin-top: 6px;\n    font-size: 10px;\n    line-height: 1.35;\n    color: var(--pd-dim);\n}\n\n.pd-metrics-bar,\n.pds-metrics-bar {\n    margin-top: 12px;\n    padding: 8px 10px;\n    border-radius: 8px;\n    background: var(--glass-fill-card);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid var(--pd-line);\n}\n.pds-metrics-bar {\n    border-color: var(--pds-line);\n    background: var(--glass-fill-card);\n}\n.pd-metrics-bar__line,\n.pds-metrics-bar__line {\n    margin: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    line-height: 1.5;\n    color: var(--pd-dim);\n}\n.pds-metrics-bar__line { color: var(--pds-dim); }\n.pd-metrics-bar__line + .pd-metrics-bar__line,\n.pds-metrics-bar__line + .pds-metrics-bar__line {\n    margin-top: 4px;\n}\n.pd-metrics-bar__line b,\n.pds-metrics-bar__line b {\n    color: var(--pd-ink);\n    font-weight: 700;\n}\n.pds-metrics-bar__line b { color: var(--pds-ink); }\n.pd-metrics-bar__line span + span::before,\n.pds-metrics-bar__line span + span::before {\n    content: \" | \";\n    color: rgba(148, 163, 184, 0.45);\n    font-weight: 400;\n}\n\n.pd-raw {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 12px;\n    margin: 10px 0 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    color: var(--pd-sub);\n}\n\n.pd-triad {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 8px;\n    margin-top: 12px;\n}\n.pd-triad__leg {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    padding: 9px 8px;\n    border-radius: 10px;\n    border: 1px solid #1e293b;\n    background: var(--glass-fill-subtle);\n    color: var(--pd-dim);\n}\n.pd-triad__leg--on {\n    border-color: rgba(52, 211, 153, 0.35);\n    background: rgba(52, 211, 153, 0.07);\n    color: #a7f3d0;\n}\n.pd-triad__leg b {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n}\n.pd-triad__leg em {\n    font-style: normal;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 12px;\n    font-weight: 700;\n    color: inherit;\n}\n.pd-dot {\n    display: inline-block;\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: #334155;\n    margin-bottom: 2px;\n}\n.pd-dot--in { background: #34d399; }\n.pd-dot--pr { background: #fb7185; }\n.pd-dot--coil { background: #fbbf24; }\n.pd-triad__leg:not(.pd-triad__leg--on) .pd-dot { background: #334155; }\n\n.pd-chip {\n    margin: 10px 0 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    color: var(--pd-sub);\n}\n.pd-chip--tg { color: #7dd3fc; }\n.pd-chip::before { content: '· '; color: var(--pd-dim); }\n\n.pd-cta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 14px;\n}\n.pd-peers {\n    margin-top: 10px;\n    padding-top: 10px;\n    border-top: 1px solid rgba(148, 163, 184, 0.14);\n}\n.pd-angles {\n    margin-top: 10px;\n    padding-top: 10px;\n    border-top: 1px solid rgba(148, 163, 184, 0.14);\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n}\n.pd-angles__section {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    padding: 10px 12px;\n    border-radius: var(--glass-radius);\n    background: var(--glass-fill) !important;\n    background-image: none !important;\n    border: 1px solid var(--glass-border);\n    backdrop-filter: blur(var(--glass-blur));\n    -webkit-backdrop-filter: blur(var(--glass-blur));\n}\n.pd-angles__head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n}\n.pd-angles__label {\n    margin: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #94a3b8;\n    font-weight: 600;\n}\n.pd-angles__label em {\n    font-style: normal;\n    text-transform: none;\n    letter-spacing: 0.02em;\n    color: #a8a29e;\n    font-weight: 500;\n}\n.pd-angles__more {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: #64748b;\n    text-decoration: none;\n}\n.pd-angles__more:hover { color: #7dd3fc; }\n.pd-angles__list {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n    gap: 8px;\n}\n.pd-angles__chip {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    min-width: 0;\n    padding: 8px 10px;\n    border: 1px solid rgba(148, 163, 184, 0.22);\n    background: var(--glass-fill-subtle);\n    color: #e2e8f0;\n    text-decoration: none;\n    font-size: 12px;\n}\n.pd-angles__chip-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; }\n.pd-angles__chip-meta { font-size: 10px; color: #94a3b8; }\n.pd-angles__chip-meta i,\n.pd-angles__chip-meta em { font-style: normal; }\n.pd-angles__chip b { color: #86efac; }\n.pd-angles__chip--combined {\n    border-color: rgba(252, 211, 77, 0.35);\n    background: rgba(120, 53, 15, 0.22);\n}\n.pd-angles__chip--combined b { color: #fcd34d; }\n.pd-angles__bar {\n    display: block;\n    height: 3px;\n    width: 100%;\n    background: rgba(148, 163, 184, 0.18);\n    overflow: hidden;\n}\n.pd-angles__bar-fill {\n    display: block;\n    height: 100%;\n    background: linear-gradient(90deg, #38bdf8, #4ade80);\n}\n.pd-angles__bar-fill--combined {\n    background: linear-gradient(90deg, #f59e0b, #fcd34d);\n}\n.pd-peers {\n    margin-top: 0;\n    padding-top: 0;\n    border-top: 0;\n}\n.pd-peers__meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n.pd-peers__label {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #94a3b8;\n}\n.pd-peers__lane, .pd-peers__rarity {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    color: #7dd3fc;\n}\n.pd-peers__list {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n    gap: 8px;\n    margin-top: 0;\n}\n.pd-peers__match {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    min-width: 0;\n    padding: 8px 10px;\n    border: 1px solid rgba(56, 189, 248, 0.28);\n    background: rgba(14, 165, 233, 0.1);\n    color: #e2e8f0;\n    text-decoration: none;\n    font-size: 12px;\n}\n.pd-peers__match-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; }\n.pd-peers__match b { color: #7dd3fc; }\n.pd-peers__match i { font-style: normal; color: #94a3b8; font-size: 10px; }\n.pd-peers__why { margin: 8px 0 0; font-size: 12px; line-height: 1.4; color: rgba(226, 232, 240, 0.72); }\n.pd-cta .home-cta { flex: 1 1 auto; text-align: center; min-width: 140px; }\n\n/* Board / ladder */\n.pd-board { margin-top: 4px; }\n.pd-board__lbl {\n    margin: 14px 0 8px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--pd-sub);\n}\n.pd-board__lbl span {\n    color: var(--pd-dim);\n    font-weight: 500;\n}\n.pd-board__rows { display: flex; flex-direction: column; gap: 8px; }\n\n.pd-r {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 0;\n    min-height: 64px;\n    padding: 11px 12px;\n    border-radius: 12px;\n    text-decoration: none;\n    color: inherit;\n    background: var(--pd-panel);\n    border: 1px solid var(--pd-line);\n    transition: border-color 0.15s ease, box-shadow 0.15s ease;\n}\n.pd-r:hover,\n.pd-r:focus-visible {\n    border-color: rgba(56, 189, 248, 0.4);\n    box-shadow: 0 0 16px rgba(56, 189, 248, 0.18);\n}\n.pd-r--active { border-color: rgba(251, 113, 133, 0.22); }\n.pd-r--exit { border-color: rgba(52, 211, 153, 0.2); opacity: 0.92; }\n.pd-r__top {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    min-width: 0;\n}\n.pd-r__main { flex: 1 1 auto; min-width: 0; }\n.pd-r__id {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex: 1 1 auto;\n    min-width: 0;\n}\n.pd-r__badge {\n    flex-shrink: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    padding: 3px 6px;\n    border-radius: 5px;\n    color: #fde68a;\n    background: rgba(251, 191, 36, 0.12);\n}\n.pd-r__badge--chase-risk,\n.pd-r__badge--just-started {\n    color: #fecdd3;\n    background: rgba(251, 113, 133, 0.14);\n}\n.pd-r__badge--fading {\n    color: #a7f3d0;\n    background: rgba(52, 211, 153, 0.12);\n}\n.pd-r__name {\n    min-width: 0;\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--pd-ink);\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n.pd-r__sn {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    font-weight: 500;\n    color: var(--pd-dim);\n}\n.pd-r__why {\n    margin: 5px 0 0;\n    font-size: 12px;\n    line-height: 1.35;\n    color: var(--pd-sub);\n}\n.pd-r__legs {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 4px;\n    margin-top: 7px;\n}\n.pd-r__leg {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    padding: 2px 6px;\n    border-radius: 4px;\n    color: var(--pd-dim);\n    border: 1px solid #1e293b;\n}\n.pd-r__leg--on {\n    color: #6ee7b7;\n    border-color: rgba(52, 211, 153, 0.35);\n}\n.pd-r__nums {\n    flex-shrink: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 6px;\n    text-align: right;\n    min-width: 54px;\n}\n.pd-r__num {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 14px;\n    font-weight: 800;\n    color: var(--pd-ink);\n    line-height: 1.1;\n}\n.pd-r__num i {\n    display: block;\n    font-style: normal;\n    font-size: 8px;\n    font-weight: 600;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--pd-dim);\n    margin-bottom: 1px;\n}\n.pd-r__num--gap { color: #6ee7b7; }\n\n.pd-empty {\n    margin: 8px 0 0;\n    padding: 22px 16px;\n    text-align: center;\n    font-size: 13px;\n    line-height: 1.5;\n    color: var(--pd-sub);\n    border: 1px dashed var(--pd-line);\n    border-radius: 12px;\n    background: var(--glass-fill-subtle);\n}\n\n/* Legacy non-compact card lane */\n.pump-alert__lane { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 4px; }\n.pump-alert__card { flex: 0 0 min(88vw, 300px); scroll-snap-align: start; padding: 12px; border-radius: var(--glass-radius); background: var(--glass-fill) !important; background-image: none !important; border: 1px solid var(--glass-border); backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); }\n.pump-alert__card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 8px; }\n.pump-alert__name { font-size: 13px; font-weight: 700; color: var(--pd-ink); text-decoration: none; }\n.pump-alert__badge { font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: 0.1em; padding: 3px 7px; border-radius: 6px; text-transform: uppercase; color: #fbbf24; }\n.pump-alert__triad { display: flex; gap: 6px; margin: 0 0 8px; flex-wrap: wrap; }\n.pump-alert__triad-leg { font-family: 'JetBrains Mono', monospace; font-size: 8px; padding: 3px 6px; border-radius: 5px; color: var(--pd-dim); border: 1px solid #1e293b; }\n.pump-alert__triad-leg--on { color: #34d399; border-color: rgba(52,211,153,0.4); }\n.pump-alert__thesis { font-size: 13px; line-height: 1.45; color: #cbd5e1; margin: 0 0 6px; }\n.pump-alert__trigger { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--pd-dim); margin: 0; }\n.pump-alert__meter { height: 3px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; margin-bottom: 8px; overflow: hidden; }\n.pump-alert__meter-fill { display: block; height: 100%; background: #fbbf24; }\n.pump-alert__size, .pump-alert__wallet-chip { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--pd-sub); margin: 0 0 4px; }\n\n/* Pump desk — same clear glass as the rest of the page (no 72% dark fill). */\n.pump-alert {\n  --pd-panel: transparent;\n  --pd-sub: #b6c2d1;\n  --pd-dim: #8b9bab;\n}\n.pd-lead,\n.pump-hero__card,\n#pump-desk-hero,\n.pump-alert__card,\n.pds-hero,\n.pds-ladder {\n  background-color: transparent !important;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06);\n}\n.pd-lead .pd-metrics-bar__line b,\n.pd-lead .pd-verdict__move,\n.pd-lead .pd-verdict__thesis,\n.pump-alert__thesis {\n  color: #e6edf4;\n}\n.pd-lead .pd-verdict__trigger,\n.pd-lead .pd-metrics-bar__line span,\n.pd-r__why,\n.pd-r__leg {\n  color: var(--pd-sub);\n}\n.pd-r__sn,\n.pd-r__num i,\n.pump-alert__trigger,\n.pd-r__dir .pump-pattern-chip {\n  color: var(--pd-dim);\n}\n.pd-r__dir {\n  display: inline-block;\n  margin-top: 5px;\n  max-width: 100%;\n}\n.pd-r__dir.pump-pattern-chip,\n.pd-r__dir.pump-pattern-chip--row,\n.pds-ladder__dir.pump-pattern-chip,\n.pds-ladder__dir.pump-pattern-chip--row {\n  color: #d7f2ff;\n  background: rgba(34, 211, 238, 0.16);\n  border-color: rgba(34, 211, 238, 0.34);\n  font-size: 10.5px;\n  font-weight: 600;\n}\n.pds-ladder__dir {\n  display: inline-block;\n  margin-left: 8px;\n  max-width: 58%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  vertical-align: middle;\n}\n.pd-r--exit .pd-r__dir,\n.pds-ladder--exit .pds-ladder__dir { display: none; }\n\n/* Compat probes */\n.pump-desk__empty {}\n.pump-hero__card {}\n.pump-desk__row {}\n.pd-row {}\n.pd-trust {}\n.pd-meta {}\n\n@media (max-width: 380px) {\n    .pd-evidence { grid-template-columns: 1fr; }\n    .pd-triad { grid-template-columns: 1fr; }\n    .pd-lead__meter-val { font-size: 26px; }\n}\n@media (min-width: 720px) {\n    .pump-alert__lane { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); overflow: visible; }\n    .pump-alert__card { flex: initial; }\n    .pd-proof { flex-direction: row; align-items: center; justify-content: space-between; }\n}\n@media (prefers-reduced-motion: reduce) {\n    .pd-live { animation: none; }\n    .pd-r { transition: none; }\n}\n\n/* Pump alert scan (from pump_alert_scan.html) */\n.pds--polish {\n    --pds-ink: #e8f0e9;\n    --pds-sub: #94a3b8;\n    --pds-dim: #64748b;\n    --pds-line: rgba(148, 163, 184, 0.14);\n    --pds-panel: var(--glass-fill-section);\n    position: relative;\n    padding: 14px 0 24px;\n    border-top: none;\n    border-left: 3px solid #38bdf8;\n    padding-left: 12px;\n    margin-left: -2px;\n    color: var(--pds-ink);\n    overflow: hidden;\n    background: transparent !important;\n  }\n  .pds-atmosphere {\n    position: absolute;\n    inset: -20% -10% auto -10%;\n    height: 65%;\n    pointer-events: none;\n    background: transparent;\n    z-index: 0;\n  }\n  .pds--polish > *:not(.pds-atmosphere) { position: relative; z-index: 1; }\n\n  .pds-head__row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 10px;\n  }\n  .pds-title {\n    margin: 0;\n    font-size: 22px;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .pds-full-desk {\n    flex-shrink: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: #38bdf8;\n    text-decoration: none;\n    padding: 5px 8px;\n    border: 1px solid rgba(56, 189, 248, 0.35);\n    border-radius: 6px;\n    background: rgba(56, 189, 248, 0.06);\n  }\n  .pds-full-desk:hover, .pds-full-desk:focus-visible {\n    background: rgba(56, 189, 248, 0.12);\n    border-color: rgba(56, 189, 248, 0.55);\n  }\n  .pds-live {\n    width: 7px; height: 7px; border-radius: 50%; background: #34d399;\n    box-shadow: 0 0 8px rgba(52, 211, 153, 0.5);\n  }\n\n  .pds-proof { display: flex; flex-direction: column; gap: 8px; }\n  .pds-proof__ready {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .pds-proof__pct {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 26px;\n    font-weight: 800;\n    line-height: 1;\n    color: #fbbf24;\n    text-shadow: 0 0 16px rgba(251, 191, 36, 0.22);\n  }\n  .pds-proof__copy {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    color: var(--pds-sub);\n    line-height: 1.4;\n  }\n  .pds-proof__line {\n    margin: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    color: var(--pds-sub);\n    line-height: 1.45;\n  }\n  .pds-proof__line--building { color: var(--pds-dim); }\n\n  .pds-census { display: flex; flex-wrap: wrap; gap: 6px; }\n  .pds-census__chip {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    padding: 4px 8px;\n    border-radius: 7px;\n    border: 1px solid var(--pds-line);\n    background: var(--glass-fill-subtle);\n    color: var(--pds-sub);\n  }\n  .pds-census__chip b { color: var(--pds-ink); font-weight: 700; }\n  .pds-census__chip--lead { border-color: rgba(251, 191, 36, 0.35); }\n  .pds-census__chip--lead b { color: #fbbf24; }\n  .pds-census__chip--live { border-color: rgba(251, 113, 133, 0.35); }\n  .pds-census__chip--live b { color: #fb7185; }\n  .pds-census__chip--exit { border-color: rgba(52, 211, 153, 0.35); }\n  .pds-census__chip--exit b { color: #34d399; }\n\n  .pds-hero {\n    margin-bottom: 16px;\n    padding: 12px;\n    border-color: rgba(251, 191, 36, 0.22);\n  }\n  .pds-hero--confirmed { border-color: rgba(251, 113, 133, 0.28); }\n  .pds-hero--exit { border-color: rgba(52, 211, 153, 0.28); }\n\n  .pds-hero__stage {\n    position: relative;\n    margin-bottom: 10px;\n    min-height: 7.5rem;\n    overflow: hidden;\n  }\n  .pds-hero__visual {\n    position: absolute;\n    inset: -12% -6% -20% 42%;\n    pointer-events: none;\n    z-index: 0;\n    overflow: hidden;\n    background:\n      radial-gradient(ellipse 60% 55% at 68% 42%, rgba(56, 189, 248, 0.16), transparent 68%),\n      radial-gradient(ellipse 45% 40% at 92% 18%, rgba(14, 165, 233, 0.1), transparent 62%);\n  }\n  .pds-hero__visual--accumulating {\n    background:\n      radial-gradient(ellipse 58% 52% at 70% 40%, rgba(251, 191, 36, 0.18), transparent 68%),\n      radial-gradient(ellipse 42% 38% at 90% 16%, rgba(245, 158, 11, 0.12), transparent 62%);\n  }\n  .pds-hero__visual--pumping {\n    background:\n      radial-gradient(ellipse 58% 52% at 70% 40%, rgba(251, 113, 133, 0.2), transparent 68%),\n      radial-gradient(ellipse 42% 38% at 90% 16%, rgba(244, 63, 94, 0.12), transparent 62%);\n  }\n  .pds-hero__visual--cooling {\n    background:\n      radial-gradient(ellipse 58% 52% at 70% 40%, rgba(52, 211, 153, 0.16), transparent 68%),\n      radial-gradient(ellipse 42% 38% at 90% 16%, rgba(16, 185, 129, 0.1), transparent 62%);\n  }\n  .pds-hero__arc {\n    position: absolute;\n    right: 4%;\n    top: 8%;\n    width: min(42%, 7rem);\n    height: auto;\n    opacity: 0.85;\n  }\n  .pds-hero__arc-track {\n    stroke: rgba(148, 163, 184, 0.2);\n    stroke-width: 3;\n    stroke-linecap: round;\n  }\n  .pds-hero__arc-fill {\n    stroke: rgba(56, 189, 248, 0.55);\n    stroke-width: 3;\n    stroke-linecap: round;\n  }\n  .pds-hero--confirmed .pds-hero__arc-fill { stroke: rgba(251, 113, 133, 0.6); }\n  .pds-hero--exit .pds-hero__arc-fill { stroke: rgba(52, 211, 153, 0.55); }\n  .pds-hero__copy { position: relative; z-index: 1; }\n  .pds-hero__top {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: 6px 10px;\n    margin-bottom: 6px;\n  }\n  .pds-hero__badge {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    padding: 4px 7px;\n    border-radius: 5px;\n    color: #fde68a;\n    background: rgba(251, 191, 36, 0.12);\n    border: 1px solid rgba(251, 191, 36, 0.25);\n  }\n  .pds-hero__badge--chase-risk, .pds-hero__badge--just-started {\n    color: #fecdd3; background: rgba(251, 113, 133, 0.12); border-color: rgba(251, 113, 133, 0.28);\n  }\n  .pds-hero__name {\n    font-size: 17px;\n    font-weight: 700;\n    color: var(--pds-ink);\n    text-decoration: none;\n  }\n  .pds-hero__name b {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    font-weight: 600;\n    color: var(--pds-dim);\n  }\n  .pds-hero__ago {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    color: var(--pds-dim);\n  }\n  .pds-hero__headline {\n    margin: 4px 0 0;\n  }\n  .pds-hero__pct {\n    display: block;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 40px;\n    font-weight: 800;\n    line-height: 1;\n    color: #38bdf8;\n  }\n  .pds-hero--confirmed .pds-hero__pct { color: #fb7185; }\n  .pds-hero__pct i { font-size: 16px; font-style: normal; opacity: 0.55; }\n  .pds-hero__pct-lbl {\n    display: block;\n    margin-top: 2px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--pds-dim);\n  }\n\n  .pds-hero__bar {\n    position: relative;\n    margin-top: 10px;\n    height: 22px;\n    border-radius: 6px;\n    background: var(--glass-fill-card);\n    border: 1px solid var(--pds-line);\n    overflow: hidden;\n  }\n  .pds-hero__bar-fill {\n    display: block;\n    height: 100%;\n    background: linear-gradient(90deg, rgba(251, 191, 36, 0.2), rgba(251, 191, 36, 0.65));\n  }\n  .pds-hero__spark {\n    position: absolute;\n    inset: 3px 6px;\n    opacity: 0.85;\n  }\n  .pds-hero__spark .pump-progress { width: 100%; height: 16px; display: block; }\n\n  .pds-phase {\n    display: flex;\n    gap: 0;\n    margin: 10px 0 0;\n    padding: 0;\n    list-style: none;\n    border: 1px solid var(--pds-line);\n    border-radius: 8px;\n    overflow: hidden;\n  }\n  .pds-phase__step {\n    flex: 1;\n    padding: 6px 2px;\n    text-align: center;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: var(--pds-dim);\n    background: var(--glass-fill-subtle);\n    border-right: 1px solid var(--pds-line);\n  }\n  .pds-phase__step:last-child { border-right: none; }\n  .pds-phase__step--now {\n    color: #fde68a;\n    background: rgba(251, 191, 36, 0.14);\n    font-weight: 700;\n  }\n  .pds-hero--confirmed .pds-phase__step--now {\n    color: #fecdd3;\n    background: rgba(251, 113, 133, 0.14);\n  }\n  .pds-hero--exit .pds-phase__step--now {\n    color: #a7f3d0;\n    background: rgba(52, 211, 153, 0.14);\n  }\n\n  .pds-hero__thesis {\n    margin: 8px 0 0;\n    font-size: 13.5px;\n    line-height: 1.45;\n    color: #cbd5e1;\n  }\n  .pds-hero__trigger {\n    margin: 6px 0 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    line-height: 1.4;\n    color: #94a3b8;\n  }\n\n  .pds-strip {\n    margin-top: 10px;\n    padding: 10px;\n    border-radius: 8px;\n    background: var(--glass-fill-subtle);\n    border: 1px solid var(--pds-line);\n  }\n  .pds-strip__metrics {\n    margin: 0;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 4px 12px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    color: var(--pds-dim);\n  }\n  .pds-strip__metrics b { color: var(--pds-ink); font-weight: 700; }\n  .pds-strip__gap { color: #6ee7b7; }\n  .pds-strip__triad {\n    margin: 8px 0 0;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n  .pds-strip__pill {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    font-weight: 600;\n    padding: 3px 8px;\n    border-radius: 5px;\n    color: var(--pds-dim);\n    border: 1px solid #1e293b;\n    background: var(--glass-fill-subtle);\n  }\n  .pds-strip__pill--on {\n    color: #6ee7b7;\n    border-color: rgba(52, 211, 153, 0.35);\n    background: rgba(52, 211, 153, 0.08);\n  }\n\n  .pds-hero__chip {\n    margin: 8px 0 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    color: var(--pds-sub);\n  }\n  .pds-hero__chip--tg { color: #7dd3fc; }\n  .pds-hero__chip--whale { color: #fbbf24; }\n  .pds-hero__chip--wallet { color: #a7f3d0; }\n  .pds-hero__chip--rug-history { color: #fca5a5; }\n  .pd-chip--rug-history { color: #fca5a5; }\n  .pds-angles__grouped,\n  .pd-angles__grouped {\n    display: block;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    line-height: 1.45;\n    color: var(--pds-sub);\n    padding: 6px 8px;\n    border-radius: 6px;\n    background: var(--glass-fill-subtle);\n    border: 1px solid rgba(148, 163, 184, 0.12);\n  }\n  .pd-angles__grouped { color: var(--pd-sub); }\n  .pds-angles__grouped b,\n  .pd-angles__grouped b {\n    color: #6ee7b7;\n    font-weight: 700;\n  }\n  .pds-angles__grouped-list,\n  .pd-angles__grouped-list {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n  .pds-peers {\n    margin-top: 10px;\n    padding-top: 10px;\n    border-top: 1px solid rgba(148, 163, 184, 0.12);\n  }\n  .pds-angles {\n    margin-top: 10px;\n    padding-top: 10px;\n    border-top: 1px solid rgba(148, 163, 184, 0.12);\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n  .pds-angles__section {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    padding: 10px 12px;\n    border-radius: var(--glass-radius);\n    background: var(--glass-fill) !important;\n    background-image: none !important;\n    border: 1px solid var(--glass-border);\n    backdrop-filter: blur(var(--glass-blur));\n    -webkit-backdrop-filter: blur(var(--glass-blur));\n  }\n  .pds-angles__head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n  }\n  .pds-angles__label {\n    margin: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #94a3b8;\n    font-weight: 600;\n  }\n  .pds-angles__label em {\n    font-style: normal;\n    text-transform: none;\n    letter-spacing: 0.02em;\n    color: #a8a29e;\n    font-weight: 500;\n  }\n  .pds-angles__more {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: #64748b;\n    text-decoration: none;\n  }\n  .pds-angles__more:hover { color: #7dd3fc; }\n  .pds-angles__list {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n    gap: 8px;\n  }\n  .pds-angles__chip {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    min-width: 0;\n    padding: 8px 10px;\n    border: 1px solid rgba(148, 163, 184, 0.22);\n    background: var(--glass-fill-subtle);\n    color: #e2e8f0;\n    text-decoration: none;\n    font-size: 12px;\n  }\n  .pds-angles__chip-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; }\n  .pds-angles__chip-meta {\n    font-size: 10px;\n    color: #94a3b8;\n  }\n  .pds-angles__chip-meta i,\n  .pds-angles__chip-meta em { font-style: normal; }\n  .pds-angles__chip b { font-weight: 600; color: #86efac; }\n  .pds-angles__chip--combined {\n    border-color: rgba(252, 211, 77, 0.35);\n    background: rgba(120, 53, 15, 0.22);\n  }\n  .pds-angles__chip--combined b { color: #fcd34d; }\n  .pds-angles__bar {\n    display: block;\n    height: 3px;\n    width: 100%;\n    background: rgba(148, 163, 184, 0.18);\n    overflow: hidden;\n  }\n  .pds-angles__bar-fill {\n    display: block;\n    height: 100%;\n    background: linear-gradient(90deg, #38bdf8, #4ade80);\n  }\n  .pds-angles__bar-fill--combined {\n    background: linear-gradient(90deg, #f59e0b, #fcd34d);\n  }\n  .pds-peers {\n    margin-top: 0;\n    padding-top: 0;\n    border-top: 0;\n  }\n  .pds-peers__meta {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 8px;\n  }\n  .pds-peers__label {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #94a3b8;\n  }\n  .pds-peers__lane,\n  .pds-peers__rarity {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px;\n    color: #7dd3fc;\n  }\n  .pds-peers__list {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n    gap: 8px;\n    margin-top: 0;\n  }\n  .pds-peers__match {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    min-width: 0;\n    padding: 8px 10px;\n    border: 1px solid rgba(56, 189, 248, 0.28);\n    background: rgba(14, 165, 233, 0.1);\n    color: #e2e8f0;\n    text-decoration: none;\n    font-size: 12px;\n  }\n  .pds-peers__match-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; }\n  .pds-peers__match b { font-weight: 600; color: #7dd3fc; }\n  .pds-peers__match i { font-style: normal; color: #94a3b8; font-size: 10px; }\n  .pds-hero__cta {\n    display: block;\n    margin-top: 12px;\n    text-align: center;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  .pds-board { margin-top: 4px; }\n  .pds-board__lbl {\n    margin: 14px 0 8px;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 11px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--pds-sub);\n  }\n  .pds-board__lbl span { color: var(--pds-dim); }\n  .pds-board__lbl--chase { color: #fb7185; }\n  .pds-board__lbl--exit { color: #34d399; }\n  .pds-board__lbl--watch { color: #94a3b8; }\n\n  .pds-empty-note {\n    margin: 0 0 10px;\n    font-size: 12.5px;\n    line-height: 1.45;\n    color: var(--pds-sub);\n  }\n\n  .pds--polish .pds-ladder {\n    display: block;\n    margin-bottom: 8px;\n    padding: 12px;\n    border-radius: var(--glass-radius);\n    text-decoration: none;\n    color: inherit;\n    background: var(--glass-fill) !important;\n    background-image: none !important;\n    border: 1px solid var(--glass-border);\n    backdrop-filter: blur(var(--glass-blur));\n    -webkit-backdrop-filter: blur(var(--glass-blur));\n    transition: border-color 0.15s, box-shadow 0.15s;\n  }\n  .pds--polish .pds-ladder:hover, .pds--polish .pds-ladder:focus-visible {\n    border-color: rgba(56, 189, 248, 0.4);\n    box-shadow: 0 0 14px rgba(56, 189, 248, 0.15);\n  }\n  .pds--polish .pds-ladder--active { border-color: rgba(251, 113, 133, 0.22); }\n  .pds--polish .pds-ladder--exit { opacity: 0.9; }\n  .pds--polish .pds-ladder--watch { border-color: rgba(148, 163, 184, 0.22); opacity: 0.92; }\n  .pds--polish .pds-ladder__head { display: flex; align-items: center; gap: 8px; }\n  .pds--polish .pds-ladder__badge {\n    flex-shrink: 0;\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px;\n    font-weight: 700;\n    padding: 3px 6px;\n    border-radius: 5px;\n    color: #fde68a;\n    background: rgba(251, 191, 36, 0.12);\n  }\n  .pds--polish .pds-ladder__badge--chase-risk { color: #fecdd3; background: rgba(251, 113, 133, 0.14); }\n  .pds--polish .pds-ladder__name {\n    flex: 1; min-width: 0;\n    font-size: 15px; font-weight: 700;\n    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n  }\n  .pds--polish .pds-ladder__name b {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 10px; font-weight: 500; color: var(--pds-dim);\n  }\n  .pds--polish .pds-ladder__nums { flex-shrink: 0; display: flex; gap: 12px; text-align: right; }\n  .pds--polish .pds-ladder__num {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 16px; font-weight: 800; line-height: 1.1; color: var(--pds-ink);\n  }\n  .pds--polish .pds-ladder__num i {\n    display: block; font-style: normal; font-size: 8px; font-weight: 600;\n    letter-spacing: 0.06em; text-transform: uppercase; color: var(--pds-dim); margin-bottom: 1px;\n  }\n  .pds--polish .pds-ladder__num--gap { color: #6ee7b7; }\n  .pds--polish .pds-ladder__why { margin: 8px 0 0; font-size: 12.5px; line-height: 1.4; color: var(--pds-sub); }\n  .pds--polish .pds-ladder__legs { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }\n  .pds--polish .pds-ladder__leg {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 9px; padding: 3px 7px; border-radius: 4px;\n    color: var(--pds-dim); border: 1px solid #1e293b;\n  }\n  .pds--polish .pds-ladder__leg--on {\n    color: #6ee7b7; border-color: rgba(52, 211, 153, 0.35);\n  }\n\n  .pds-empty {\n    padding: 20px;\n    text-align: center;\n    font-size: 13px;\n    color: var(--pds-sub);\n    border: 1px dashed var(--pds-line);\n    border-radius: 10px;\n  }\n  .pds-empty.desk-empty,\n  .pds-empty {\n    background: var(--glass-fill-subtle);\n  }\n\n\n/* ---- Driver.js onboarding tour (migrated from ui-legacy.css, P3-3h) ---- */\n/* ---------- driver.js onboarding tour — pewter/ice mist ---------- */\n.driver-popover {\n  background-color: rgba(16, 19, 26, 0.94);\n  background-image: var(--card-smoke);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(126, 200, 227, 0.28);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-elevated), 0 0 24px rgba(126, 200, 227, 0.08);\n  color: var(--text-primary);\n  padding: var(--space-4);\n  min-width: 260px;\n  max-width: 320px;\n}\n\n.driver-popover * {\n  font-family: var(--font-body);\n}\n\n.driver-popover-title {\n  font-family: var(--font-brand);\n  font-weight: 700;\n  font-size: 1.125rem;\n  color: #e8f4f8;\n  line-height: 1.35;\n  padding-right: 28px;\n}\n\n.driver-popover-description {\n  font-size: 0.9375rem;\n  color: var(--text-secondary);\n  line-height: 1.5;\n  margin-top: var(--space-2);\n}\n\n.driver-popover-close-btn {\n  color: var(--text-muted);\n}\n\n.driver-popover-close-btn:hover,\n.driver-popover-close-btn:focus {\n  color: #c5e8f4;\n}\n\n.driver-popover-progress-text {\n  color: var(--text-muted);\n  font-size: 12px;\n}\n\n.driver-popover-footer button {\n  background: rgba(22, 25, 32, 0.9);\n  border: 1px solid rgba(126, 200, 227, 0.22);\n  border-radius: var(--radius-sm);\n  color: #e8f4f8;\n  font-family: var(--font-body);\n  font-size: 13px;\n  font-weight: 600;\n  padding: 6px 12px;\n  text-shadow: none;\n  transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);\n}\n\n.driver-popover-footer button:hover,\n.driver-popover-footer button:focus {\n  background: rgba(140, 140, 150, 0.11);\n  border-color: rgba(126, 200, 227, 0.38);\n  color: #f0f8fc;\n}\n\n.driver-popover-arrow {\n  border-color: rgba(16, 19, 26, 0.94);\n}\n\n/* ---------- Vivid pass: brand mark + footer legibility (body prefix beats legacy) ---------- */\nbody.council-first-theme .logo-mark {\n  background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-primary) 100%);\n  box-shadow:\n    0 0 12px rgba(63, 201, 255, 0.5),\n    0 0 28px rgba(31, 212, 124, 0.28);\n  animation: none;\n}\n\nbody.council-first-theme footer.status .status-inner--meta {\n  font-size: 11px;\n  line-height: 1.6;\n  color: var(--text-muted);\n}\n\nbody.council-first-theme .footer-card__lbl {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n/* SimiVision ui.css — consolidated mobile-first (generated 2026-08-02) */\n\n/* ---------- Telegram evidence-weighted subnet consensus ---------- */\n.message-intel__consensus {\n  margin-top: 16px;\n  padding: 14px;\n  border: 1px solid rgba(126, 200, 227, 0.22);\n  border-radius: 12px;\n  background: var(--glass-fill-subtle);\n}\n\n.message-intel__panel-hint {\n  margin: 8px 0 12px;\n  color: var(--text-muted);\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.message-intel__consensus-list {\n  display: grid;\n  gap: 9px;\n}\n\n.message-intel__consensus-row {\n  padding: 11px;\n  border: 1px solid rgba(255, 255, 255, 0.11);\n  border-left: 3px solid #a78bfa;\n  border-radius: 9px;\n  background: rgba(255, 255, 255, 0.025);\n}\n\n.message-intel__consensus-row--bullish { border-left-color: #34d399; }\n.message-intel__consensus-row--bearish { border-left-color: #fb7185; }\n.message-intel__consensus-row--insufficient { border-left-color: #94a3b8; opacity: 0.88; }\n\n.message-intel__consensus-head {\n  display: flex;\n  gap: 10px;\n  align-items: baseline;\n  justify-content: space-between;\n}\n\n.message-intel__consensus-head a { color: var(--text-primary); text-decoration: none; }\n.message-intel__consensus-head a span { color: var(--text-muted); font-size: 11px; }\n.message-intel__consensus-head strong { font: 700 11px var(--font-mono, monospace); color: #c4b5fd; text-align: right; }\n.message-intel__consensus-row--bullish .message-intel__consensus-head strong { color: #6ee7b7; }\n.message-intel__consensus-row--bearish .message-intel__consensus-head strong { color: #fda4af; }\n.message-intel__consensus-row--insufficient .message-intel__consensus-head strong { color: #cbd5e1; }\n.message-intel__consensus-row > p { margin: 5px 0 0; color: var(--text-muted); font-size: 12px; line-height: 1.35; }\n.message-intel__consensus-row details { margin-top: 9px; color: var(--text-secondary); font-size: 12px; }\n.message-intel__consensus-row summary { cursor: pointer; color: #bae6fd; }\n.message-intel__consensus-receipts { display: grid; gap: 5px; margin-top: 8px; }\n.message-intel__consensus-receipts p { margin: 5px 0 0; color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }\n.message-intel__consensus-receipt {\n  display: block;\n  width: 100%;\n  padding: 7px;\n  border: 1px solid rgba(255,255,255,.09);\n  border-radius: 6px;\n  background: transparent;\n  color: var(--text-secondary);\n  text-align: left;\n  font-size: 12px;\n  cursor: pointer;\n}\n.message-intel__consensus-receipt:hover { border-color: rgba(126, 200, 227, .4); }\n.message-intel__consensus-receipt:focus-visible,\n.message-intel__divergence-receipt:focus-visible,\n.message-intel__divergence-row summary:focus-visible {\n  outline: 2px solid #bae6fd;\n  outline-offset: 2px;\n}\n\n/* ---------- Telegram consensus/outcome comparison ---------- */\n.message-intel__divergence {\n  margin-top: 16px;\n  padding: 14px;\n  border: 1px solid rgba(196, 181, 253, .26);\n  border-radius: 12px;\n  background: var(--glass-fill-subtle);\n}\n.message-intel__divergence-list { display: grid; gap: 9px; }\n.message-intel__divergence-row {\n  padding: 11px;\n  border: 1px solid rgba(255,255,255,.11);\n  border-left: 3px solid #94a3b8;\n  border-radius: 9px;\n  background: rgba(255,255,255,.025);\n}\n.message-intel__divergence-row--aligned { border-left-color: #34d399; }\n.message-intel__divergence-row--diverged { border-left-color: #fb7185; }\n.message-intel__divergence-row--neutral_outcome { border-left-color: #fbbf24; }\n.message-intel__divergence-head { display: flex; gap: 10px; align-items: baseline; justify-content: space-between; }\n.message-intel__divergence-head a { color: var(--text-primary); text-decoration: none; }\n.message-intel__divergence-head span, .message-intel__divergence-meta, .message-intel__divergence-caveat { color: var(--text-muted); font-size: 11px; }\n.message-intel__divergence-head strong { font: 700 11px var(--font-mono, monospace); color: #cbd5e1; text-align: right; }\n.message-intel__divergence-row--aligned .message-intel__divergence-head strong { color: #6ee7b7; }\n.message-intel__divergence-row--diverged .message-intel__divergence-head strong { color: #fda4af; }\n.message-intel__divergence-row--neutral_outcome .message-intel__divergence-head strong { color: #fde68a; }\n.message-intel__divergence-row > p { margin: 5px 0 0; color: var(--text-muted); font-size: 12px; line-height: 1.4; }\n.message-intel__divergence-row > p b { color: var(--text-secondary); }\n.message-intel__divergence-row details { margin-top: 9px; color: var(--text-secondary); font-size: 12px; }\n.message-intel__divergence-row summary { cursor: pointer; color: #ddd6fe; }\n.message-intel__divergence-receipts { display: grid; gap: 5px; margin-top: 8px; }\n.message-intel__divergence-receipt {\n  display: grid; gap: 4px; width: 100%; min-height: 40px; padding: 7px;\n  border: 1px solid rgba(255,255,255,.09); border-radius: 6px;\n  background: transparent; color: var(--text-secondary); text-align: left;\n  font-size: 12px; cursor: pointer;\n}\n.message-intel__divergence-receipt:hover { border-color: rgba(196, 181, 253, .5); }\n.message-intel__divergence-caveat { font-style: italic; }\n\n@media (max-width: 420px) {\n  .message-intel__consensus-head { align-items: flex-start; flex-direction: column; gap: 3px; }\n  .message-intel__consensus-head strong { text-align: left; }\n  .message-intel__divergence-head { align-items: flex-start; flex-direction: column; gap: 3px; }\n  .message-intel__divergence-head strong { text-align: left; }\n}\n\n\n/* ============ COSMIC GLASS (mobile-first, cosmetic-only) ============\n   Grey body smoke used to paint ON TOP of this layer and flatten it.\n   The sky is now the only atmosphere: saturated nebulae + milky-way ribbon\n   + dense prime-tiled stars. Glass stays transparent so the sky reads through. */\n\n.cosmic-sky {\n    position: fixed;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    overflow: hidden;\n    isolation: isolate;\n    background-color: #05070c;\n    background-image:\n        /* Corner nebulae sit on the sky itself so they always paint */\n        radial-gradient(ellipse 70vw 58vh at 8% 10%, color-mix(in srgb, var(--ds-signal-cyan) 58%, transparent), transparent 70%),\n        radial-gradient(ellipse 36vw 30vh at 4% 6%, color-mix(in srgb, var(--ds-signal-cyan) 40%, transparent), transparent 58%),\n        radial-gradient(ellipse 68vw 56vh at 92% 10%, color-mix(in srgb, var(--ds-nebula) 56%, transparent), transparent 72%),\n        radial-gradient(ellipse 34vw 28vh at 97% 5%, color-mix(in srgb, var(--ds-nebula) 38%, transparent), transparent 55%),\n        radial-gradient(ellipse 62vw 52vh at 8% 90%, color-mix(in srgb, var(--ds-rose) 50%, transparent), transparent 70%),\n        radial-gradient(ellipse 32vw 26vh at 3% 96%, color-mix(in srgb, var(--ds-rose) 34%, transparent), transparent 52%),\n        radial-gradient(ellipse 60vw 48vh at 94% 92%, color-mix(in srgb, var(--ds-amber) 48%, transparent), transparent 70%),\n        radial-gradient(ellipse 30vw 24vh at 98% 97%, color-mix(in srgb, var(--ds-amber) 32%, transparent), transparent 50%),\n        /* Milky-way ion ribbon */\n        linear-gradient(118deg,\n            transparent 20%,\n            color-mix(in srgb, var(--ds-signal-cyan) 18%, transparent) 36%,\n            color-mix(in srgb, var(--ds-nebula) 28%, transparent) 50%,\n            color-mix(in srgb, var(--ds-rose) 16%, transparent) 64%,\n            transparent 80%),\n        linear-gradient(118deg,\n            transparent 47%,\n            color-mix(in srgb, var(--ds-signal-cyan) 32%, transparent) 49.5%,\n            color-mix(in srgb, var(--ds-nebula) 30%, transparent) 50.5%,\n            transparent 53%),\n        /* Centre vignette — council numbers stay readable */\n        radial-gradient(ellipse 70% 58% at 50% 42%, transparent 0%, rgba(5, 7, 12, 0.38) 100%);\n}\n\n/* Living nebula — child layer so transform drift never tiles the stars */\n.cosmic-sky__nebula {\n    position: absolute;\n    inset: -28%;\n    z-index: 0;\n    pointer-events: none;\n    will-change: transform;\n    background:\n        radial-gradient(ellipse 58vw 48vh at 18% 20%, color-mix(in srgb, var(--ds-signal-cyan) 42%, transparent), transparent 68%),\n        radial-gradient(ellipse 56vw 50vh at 82% 18%, color-mix(in srgb, var(--ds-nebula) 40%, transparent), transparent 70%),\n        radial-gradient(ellipse 52vw 46vh at 16% 82%, color-mix(in srgb, var(--ds-rose) 36%, transparent), transparent 68%),\n        radial-gradient(ellipse 50vw 42vh at 86% 84%, color-mix(in srgb, var(--ds-amber) 34%, transparent), transparent 68%),\n        radial-gradient(ellipse 40vw 28vh at 50% 68%, color-mix(in srgb, var(--ds-nebula) 18%, transparent), transparent 70%);\n}\n\n/* Dense distant + mid-field stars. Prime tiles (337 / 563) so the grid never rhymes. */\n.cosmic-sky::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    background-image:\n        radial-gradient(1.1px 1.1px at 18px 42px, #fff 70%, transparent),\n        radial-gradient(1.4px 1.4px at 91px 14px, #e8f6ff 70%, transparent),\n        radial-gradient(0.9px 0.9px at 154px 88px, hsl(var(--chart-1) / 0.95) 70%, transparent),\n        radial-gradient(1.2px 1.2px at 221px 51px, #fff 70%, transparent),\n        radial-gradient(1.0px 1.0px at 288px 119px, hsl(var(--nebula) / 0.9) 70%, transparent),\n        radial-gradient(1.6px 1.6px at 47px 171px, #fff 65%, transparent),\n        radial-gradient(0.8px 0.8px at 129px 203px, rgba(255,255,255,0.7) 70%, transparent),\n        radial-gradient(1.3px 1.3px at 196px 246px, hsl(var(--chart-1) / 0.85) 70%, transparent),\n        radial-gradient(1.0px 1.0px at 263px 188px, #fff 70%, transparent),\n        radial-gradient(1.5px 1.5px at 312px 274px, hsl(var(--accent) / 0.8) 70%, transparent),\n        radial-gradient(0.9px 0.9px at 74px 301px, rgba(255,255,255,0.65) 70%, transparent),\n        radial-gradient(1.2px 1.2px at 168px 322px, hsl(var(--nebula) / 0.85) 70%, transparent),\n        radial-gradient(1.8px 1.8px at 62px 96px, #fff 45%, rgba(200,230,255,0.7) 70%, transparent),\n        radial-gradient(2.1px 2.1px at 241px 318px, #fff 40%, hsl(var(--chart-1) / 0.7) 72%, transparent),\n        radial-gradient(1.4px 1.4px at 118px 410px, #fff 55%, transparent),\n        radial-gradient(1.1px 1.1px at 307px 38px, hsl(var(--chart-5) / 0.8) 70%, transparent),\n        radial-gradient(2.2px 2.2px at 84px 148px, #fff 40%, rgba(255,245,220,0.75) 70%, transparent),\n        radial-gradient(1.3px 1.3px at 274px 392px, hsl(var(--chart-1) / 0.9) 70%, transparent),\n        radial-gradient(1.7px 1.7px at 431px 67px, #fff 50%, transparent),\n        radial-gradient(1.0px 1.0px at 512px 221px, hsl(var(--nebula) / 0.85) 70%, transparent),\n        radial-gradient(2.4px 2.4px at 198px 489px, #fff 35%, hsl(var(--accent) / 0.65) 70%, transparent),\n        radial-gradient(1.2px 1.2px at 356px 301px, rgba(255,255,255,0.8) 70%, transparent),\n        radial-gradient(1.5px 1.5px at 478px 544px, hsl(var(--chart-5) / 0.75) 70%, transparent),\n        radial-gradient(1.9px 1.9px at 41px 528px, #fff 45%, transparent);\n    background-size:\n        337px 337px, 337px 337px, 337px 337px, 337px 337px, 337px 337px, 337px 337px,\n        337px 337px, 337px 337px, 337px 337px, 337px 337px, 337px 337px, 337px 337px,\n        337px 337px, 337px 337px, 337px 337px, 337px 337px,\n        563px 563px, 563px 563px, 563px 563px, 563px 563px, 563px 563px, 563px 563px,\n        563px 563px, 563px 563px;\n    opacity: 0.92;\n}\n\n/* Bright anchor stars + coronas. Twinkle is opacity-only (composite). */\n.cosmic-sky::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    pointer-events: none;\n    background-image:\n        radial-gradient(2.8px 2.8px at 118px 196px, #fff 28%, color-mix(in srgb, var(--ds-signal-cyan) 90%, transparent) 58%, transparent),\n        radial-gradient(14px 14px at 118px 196px, color-mix(in srgb, var(--ds-signal-cyan) 28%, transparent), transparent 72%),\n        radial-gradient(2.4px 2.4px at 604px 462px, #fff 28%, color-mix(in srgb, var(--ds-amber) 90%, transparent) 58%, transparent),\n        radial-gradient(12px 12px at 604px 462px, color-mix(in srgb, var(--ds-amber) 24%, transparent), transparent 72%),\n        radial-gradient(3.0px 3.0px at 748px 128px, #fff 32%, color-mix(in srgb, var(--ds-nebula) 90%, transparent) 62%, transparent),\n        radial-gradient(16px 16px at 748px 128px, color-mix(in srgb, var(--ds-nebula) 26%, transparent), transparent 75%),\n        radial-gradient(2.2px 2.2px at 276px 704px, #fff 28%, color-mix(in srgb, var(--ds-rose) 90%, transparent) 58%, transparent),\n        radial-gradient(11px 11px at 276px 704px, color-mix(in srgb, var(--ds-rose) 22%, transparent), transparent 72%),\n        radial-gradient(2.6px 2.6px at 512px 318px, #fff 30%, rgba(220,240,255,0.9) 60%, transparent),\n        radial-gradient(13px 13px at 512px 318px, rgba(255,255,255,0.18), transparent 74%),\n        radial-gradient(2.0px 2.0px at 812px 640px, #fff 30%, color-mix(in srgb, var(--ds-signal-cyan) 85%, transparent) 60%, transparent),\n        radial-gradient(10px 10px at 812px 640px, color-mix(in srgb, var(--ds-signal-cyan) 20%, transparent), transparent 72%),\n        /* Cluster — cyan nebula (top-left), once per viewport */\n        radial-gradient(2.4px 2.4px at 8% 11%, #fff 70%, transparent),\n        radial-gradient(1.6px 1.6px at 9.6% 13.4%, #fff 70%, transparent),\n        radial-gradient(3.2px 3.2px at 11.2% 10.2%, #fff 50%, transparent),\n        radial-gradient(1.4px 1.4px at 12.6% 14.8%, rgba(255,255,255,0.85) 70%, transparent),\n        radial-gradient(2.0px 2.0px at 7.0% 16.2%, color-mix(in srgb, var(--ds-signal-cyan) 80%, #fff) 70%, transparent),\n        radial-gradient(1.5px 1.5px at 11.8% 17.0%, #fff 70%, transparent),\n        radial-gradient(2.6px 2.6px at 13.8% 12.4%, #fff 55%, transparent),\n        radial-gradient(1.2px 1.2px at 6.2% 12.8%, rgba(255,255,255,0.75) 70%, transparent),\n        radial-gradient(8px 8px at 11.2% 10.2%, color-mix(in srgb, var(--ds-signal-cyan) 22%, transparent), transparent 70%),\n        /* Cluster — violet nebula (top-right) */\n        radial-gradient(2.5px 2.5px at 90% 9%, #fff 70%, transparent),\n        radial-gradient(1.7px 1.7px at 92.4% 11.6%, #fff 70%, transparent),\n        radial-gradient(3.4px 3.4px at 88.2% 12.8%, #fff 48%, transparent),\n        radial-gradient(1.4px 1.4px at 93.8% 8.0%, rgba(255,255,255,0.85) 70%, transparent),\n        radial-gradient(2.1px 2.1px at 91.6% 15.2%, color-mix(in srgb, var(--ds-nebula) 80%, #fff) 70%, transparent),\n        radial-gradient(1.5px 1.5px at 87.0% 10.6%, #fff 70%, transparent),\n        radial-gradient(2.6px 2.6px at 94.6% 13.4%, #fff 55%, transparent),\n        radial-gradient(9px 9px at 88.2% 12.8%, color-mix(in srgb, var(--ds-nebula) 20%, transparent), transparent 70%),\n        /* Cluster — rose nebula (bottom-left) */\n        radial-gradient(2.4px 2.4px at 9% 84%, #fff 70%, transparent),\n        radial-gradient(1.7px 1.7px at 11.0% 86.6%, #fff 70%, transparent),\n        radial-gradient(3.1px 3.1px at 7.4% 87.4%, #fff 50%, transparent),\n        radial-gradient(1.4px 1.4px at 12.8% 83.0%, rgba(255,255,255,0.85) 70%, transparent),\n        radial-gradient(2.0px 2.0px at 8.2% 89.8%, color-mix(in srgb, var(--ds-rose) 80%, #fff) 70%, transparent),\n        radial-gradient(1.5px 1.5px at 11.4% 90.6%, #fff 70%, transparent),\n        radial-gradient(8px 8px at 7.4% 87.4%, color-mix(in srgb, var(--ds-rose) 20%, transparent), transparent 70%),\n        /* Cluster — amber nebula (bottom-right) */\n        radial-gradient(2.5px 2.5px at 91% 86%, #fff 70%, transparent),\n        radial-gradient(1.6px 1.6px at 93.4% 88.4%, #fff 70%, transparent),\n        radial-gradient(3.3px 3.3px at 89.2% 89.6%, #fff 48%, transparent),\n        radial-gradient(1.4px 1.4px at 94.8% 85.0%, rgba(255,255,255,0.85) 70%, transparent),\n        radial-gradient(2.1px 2.1px at 92.6% 91.8%, color-mix(in srgb, var(--ds-amber) 80%, #fff) 70%, transparent),\n        radial-gradient(1.5px 1.5px at 88.0% 87.2%, #fff 70%, transparent),\n        radial-gradient(8px 8px at 89.2% 89.6%, color-mix(in srgb, var(--ds-amber) 20%, transparent), transparent 70%),\n        /* Cluster — milky-way ribbon */\n        radial-gradient(2.0px 2.0px at 48% 32%, #fff 70%, transparent),\n        radial-gradient(1.4px 1.4px at 50.6% 34.4%, rgba(255,255,255,0.8) 70%, transparent),\n        radial-gradient(2.8px 2.8px at 52.4% 31.2%, #fff 50%, transparent),\n        radial-gradient(1.6px 1.6px at 54.0% 35.8%, #fff 70%, transparent),\n        radial-gradient(1.2px 1.2px at 46.4% 33.6%, rgba(255,255,255,0.75) 70%, transparent);\n    background-size:\n        881px 881px, 881px 881px, 881px 881px, 881px 881px,\n        881px 881px, 881px 881px, 881px 881px, 881px 881px,\n        881px 881px, 881px 881px, 881px 881px, 881px 881px,\n        100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%,\n        100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%,\n        100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%,\n        100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%,\n        100% 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100%;\n    opacity: 0.95;\n    animation: cosmic-star-twinkle 7s ease-in-out infinite alternate;\n}\n\n@keyframes cosmic-star-twinkle {\n    0%   { opacity: 0.62; }\n    50%  { opacity: 1; }\n    100% { opacity: 0.78; }\n}\n\n/* -- Prismatic glass — light enough that the sky shows through the cards -- */\n.glass-shell {\n    background: var(--glass-fill-section);\n    border: 1px solid var(--glass-border);\n    border-top-color: rgba(255, 255, 255, 0.32);\n    border-bottom-color: rgba(0, 0, 0, 0.45);\n    border-radius: var(--glass-radius);\n    position: relative;\n    z-index: 1;\n    -webkit-tap-highlight-color: transparent;\n}\n\n.glass-card {\n    background: var(--glass-fill-card);\n    background-image:\n        linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 36%, transparent 70%),\n        linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.02) 100%);\n    border: 1px solid var(--glass-border);\n    border-top: 1px solid rgba(255, 255, 255, 0.46);\n    border-bottom: 1px solid rgba(0, 0, 0, 0.50);\n    border-radius: var(--glass-radius);\n    box-shadow:\n        0 14px 34px -4px rgba(0, 0, 0, 0.62),\n        0 4px 10px -2px rgba(0, 0, 0, 0.36),\n        inset 0 1px 1px 0 rgba(255, 255, 255, 0.32),\n        inset 0 -1px 2px 0 rgba(0, 0, 0, 0.40),\n        var(--shadow-card);\n    position: relative;\n    z-index: 2;\n    -webkit-tap-highlight-color: transparent;\n    transition: border-color 0.25s ease, box-shadow 0.25s ease;\n    /* NO backdrop-filter here — mobile default */\n}\n\n@media (hover: hover) and (pointer: fine) {\n    .glass-card:hover {\n        border-top-color: rgba(255, 255, 255, 0.68);\n        border-left-color: rgba(255, 255, 255, 0.22);\n        border-right-color: rgba(255, 255, 255, 0.22);\n        box-shadow:\n            0 18px 40px -4px rgba(0, 0, 0, 0.72),\n            0 0 24px -4px hsl(var(--chart-1) / 0.18),\n            inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.42),\n            inset 0 -1px 2px 0 rgba(0, 0, 0, 0.50),\n            var(--shadow-card);\n    }\n}\n\n/* Instrument cells (WIN RATE / AVG ACC / SIGNAL…) used a 55% dark --glass fill. */\n.tribunal-hero { --glass: transparent; }\n.tribunal-hero__cell {\n    background: transparent !important;\n}\n\n/* ── Cosmic-glass blur gate (authoritative, global) ──────────────────────\n   MOBILE-FIRST zero GPU cost: kill ALL backdrop-filter (every element and\n   pseudo-element, including rules nested in mobile media queries) at the base\n   layer. `!important` guarantees this wins over any ungated blur declared\n   earlier in the file. Blur is then re-enabled ONLY inside the desktop /\n   fine-pointer gate below, and stays off under reduced-transparency. */\n*,\n*::before,\n*::after {\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n}\n\n/* Mouse / big screens: restore glass blur for the glass/panel surfaces. Not\n   under reduced-transparency (that keeps the base `none` above). */\n@media (hover: hover) and (pointer: fine), (min-width: 1024px) {\n    @media not (prefers-reduced-transparency: reduce) {\n        .glass-card,\n        .glass-card--hero,\n        .card,\n        .card-glass,\n        .k3-dossier,\n        .tribunal-hero__judge,\n        .tribunal-hero__panel,\n        .trust-banner,\n        .living-focus,\n        .brain-letter,\n        .proof-band,\n        .proof-band__subpanel,\n        .pds-angles__section,\n        .pd-angles__section,\n        .kpi-cell,\n        .council-stage .k3-signal,\n        .council-stage .k3-judge,\n        .council-stage .k3-weighed-row,\n        .sr-pulse__breadth-wrap .sr-pulse__oneline-part,\n        .sr-panel,\n        .kpi,\n        .cockpit-card,\n        .cockpit-card.card,\n        header.top,\n        header.top.sr-hud,\n        footer.status,\n        .top-nav,\n        .share-page__header,\n        .driver-popover,\n        .message-intel--v2 .message-intel__stat-chip {\n            backdrop-filter: blur(var(--glass-blur)) saturate(1.45) !important;\n            -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.45) !important;\n        }\n        /* Pseudo-element blur restored on desktop */\n        .tribunal-hero__ring-center::before {\n            backdrop-filter: blur(12px) !important;\n            -webkit-backdrop-filter: blur(12px) !important;\n        }\n        /* Focal tribunal hero keeps its stronger signature blur on desktop */\n        .tribunal-hero__card {\n            backdrop-filter: blur(var(--hero-glass-blur, 24px)) saturate(1.5) brightness(1.12) !important;\n            -webkit-backdrop-filter: blur(var(--hero-glass-blur, 24px)) saturate(1.5) brightness(1.12) !important;\n        }\n        /* Pump desk + Telegram pulse sit over the dark sky center. 16px blur\n           there frosts into a pewter slab (same reason instrument cells skip\n           blur). Hairline + sky, no stacked frost. */\n        .pd-lead,\n        .pump-hero__card,\n        #pump-desk-hero,\n        .pump-alert__card,\n        .pds-hero,\n        .pds-ladder,\n        .pds--polish .pds-ladder,\n        .pd-metrics-bar,\n        .pds-metrics-bar,\n        .message-intel--v2.glass-card,\n        .message-intel--v2 .glass-card,\n        .message-intel--v2 .message-intel__panel,\n        .message-intel--v2 .message-intel__pulse-stage,\n        .message-intel--v2 .message-intel__hero,\n        .message-intel--v2 .message-intel__week-top,\n        .message-intel--v2 .message-intel__crowns-drawer {\n            backdrop-filter: none !important;\n            -webkit-backdrop-filter: none !important;\n        }\n    }\n}\n\n.glass-flat {\n    background: var(--glass-fill-subtle);\n    border: 1px solid var(--glass-border);\n    border-radius: var(--glass-radius);\n    position: relative;\n    z-index: 1;\n    -webkit-tap-highlight-color: transparent;\n}\n\n/* Crisp data chip (stays flat/opaque so numbers stay sharp).\n   The champ-num selector is included directly so client-hydrated champions\n   markup (regenerated without the chip-flat class) gets the same treatment. */\n.chip-flat,\n.message-intel--v2 .message-intel__champ-num {\n    background: var(--cos-chip);\n    color: var(--cos-chip-ink);\n    font-family: var(--font-mono);\n    padding: 4px 8px;\n    border-radius: var(--radius-sm);\n    line-height: 1;\n    display: inline-block;\n    flex: none;\n    backdrop-filter: none !important;\n    -webkit-tap-highlight-color: transparent;\n}\n\n/* Off-screen culling: below-fold sections aren't painted (60s-refresh battery win) */\nsection.desk-zone,\n.message-intel__panel {\n    content-visibility: auto;\n    contain-intrinsic-size: auto 420px;\n}\n\n.message-intel--v2 .message-intel__locked-surface {\n    opacity: 0.62;\n    filter: saturate(0.55);\n}\n\n.message-intel--v2 .message-intel__locked-body {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n}\n\n.message-intel--v2 .message-intel__locked-button {\n    flex: none;\n    border: 1px solid var(--glass-border);\n    border-radius: 999px;\n    padding: 8px 14px;\n    color: var(--muted);\n    background: rgba(255,255,255,0.04);\n    cursor: not-allowed;\n}\n\n.message-intel--v2 .message-intel__command-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 14px;\n}\n\n.message-intel--v2 .message-intel__command-list span {\n    border: 1px solid var(--glass-border);\n    border-radius: 999px;\n    padding: 7px 11px;\n    color: var(--muted);\n    background: rgba(255,255,255,0.035);\n    font-family: var(--font-mono);\n    font-size: 0.82rem;\n}\n\n/* -- Remaining solid panels → glass tiers (MOBILE-FIRST: no backdrop-filter by default) --\n   These BEM-nested panels carry opaque fills (var(--mi-bg-card) #090d0b, rgba(...,~1) blacks)\n   from higher-specificity `.message-intel--v2 ...` rules, so a bare `.glass-flat` class can't win.\n   We match that specificity here and swap only the fill to the shared glass tokens. Applies to\n   both SSR markup and client-hydrated markup (rules target the panel wrapper, not a class the\n   hydrator drops). Blur stays behind the desktop media gate below — phones gain zero filter cost. */\n\n/* Secondary list / evidence panels → glass-flat fill */\n.message-intel--v2 .message-intel__callers,\n.message-intel--v2 .message-intel__consensus,\n.message-intel--v2 .message-intel__divergence,\n.message-intel--v2 .message-intel__proof,\n.message-intel--v2 .message-intel__hc-strip,\n.message-intel--v2 .message-intel__summary-24h {\n    background: var(--glass-fill-subtle);\n    background-image: none;\n    border-color: var(--glass-border);\n}\n\n/* Focal drawer + spotlight panels keep their accent glow but sit on glass, not opaque black */\n.message-intel--v2 .message-intel__hero,\n.message-intel--v2 .message-intel__week-top,\n.message-intel--v2 .message-intel__crowns-drawer {\n    background: var(--glass-fill-card);\n    border-color: var(--glass-border);\n}\n\n/* Proof-band footer subpanels (Source / Subnets / Trail / Integrations / Predictions) */\n.proof-band__subpanel {\n    background: var(--glass-fill-subtle);\n    background-image: none;\n    border-color: var(--glass-border);\n}\n\n/* Pump ladder rows used --pd-panel (82–90% dark). Same clear glass as cards. */\n.pd-r {\n    background: var(--glass-fill-subtle);\n}\n\n/* Cockpit cards → glass-card fill (base .card paints an opaque smoke gradient; defer to glass) */\n.cockpit-card,\n.cockpit-card.card {\n    background: var(--glass-fill-card);\n    background-image:\n        linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 36%, transparent 70%),\n        linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.02) 100%);\n    border-color: var(--glass-border);\n    border-top: 1px solid rgba(255, 255, 255, 0.46);\n    border-bottom: 1px solid rgba(0, 0, 0, 0.50);\n    box-shadow:\n        0 14px 34px -4px rgba(0, 0, 0, 0.62),\n        0 4px 10px -2px rgba(0, 0, 0, 0.36),\n        inset 0 1px 1px 0 rgba(255, 255, 255, 0.32),\n        inset 0 -1px 2px 0 rgba(0, 0, 0, 0.40);\n}\n\n/* Desktop / mouse: full glass upgrade for all glass-fill panels (matches .glass-card gate) */\n@media (hover: hover) and (pointer: fine), (min-width: 1024px) {\n    .message-intel--v2 .message-intel__hero,\n    .message-intel--v2 .message-intel__week-top,\n    .message-intel--v2 .message-intel__crowns-drawer,\n    .cockpit-card,\n    .cockpit-card.card,\n    .proof-band__subpanel,\n    .card,\n    .kpi,\n    .sr-panel {\n        backdrop-filter: blur(var(--glass-blur)) saturate(1.2);\n        -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.2);\n    }\n}\n\n/* System hooks */\n@media (prefers-reduced-transparency: reduce) {\n    .cosmic-sky { opacity: 0.55; }\n    .glass-card,\n    .glass-card--hero,\n    .message-intel--v2 .message-intel__hero,\n    .message-intel--v2 .message-intel__week-top,\n    .message-intel--v2 .message-intel__crowns-drawer,\n    .cockpit-card,\n    .cockpit-card.card,\n    .proof-band__subpanel,\n    .card,\n    .kpi,\n    .sr-panel { backdrop-filter: none; -webkit-backdrop-filter: none; }\n}\n\n/* Homepage pulse: compact folder desk, same site glass (transparent fill). */\n.message-intel--home-compact {\n    margin-top: 0.5rem;\n    margin-bottom: 0.75rem;\n    padding: 8px 12px 12px;\n    width: 100%;\n    max-width: min(100%, 430px);\n    margin-left: auto;\n    margin-right: auto;\n    overflow-x: clip;\n    box-sizing: border-box;\n}\n\n.message-intel--home-compact .message-intel__topbar {\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 8px;\n}\n\n.message-intel--home-compact .message-intel__flagship-chip {\n    display: none;\n}\n\n.message-intel--home-compact .message-intel__brand {\n    font-size: 9px;\n    letter-spacing: 0.1em;\n}\n\n.message-intel--home-compact .message-intel__top-actions {\n    margin-left: auto;\n}\n\n.message-intel--home-compact .message-intel__live-pill {\n    min-width: 0;\n    padding: 4px 8px;\n    font-size: 9px;\n}\n\n.message-intel--home-compact .message-intel__full-desk {\n    min-height: 28px;\n    padding: 4px 8px;\n    font-size: 9px;\n}\n\n.message-intel--home-compact .message-intel__page-title {\n    margin-bottom: 4px;\n    font-size: clamp(1.35rem, 4vw, 1.7rem) !important;\n}\n\n.message-intel--home-compact .message-intel__page-sub {\n    max-width: 60ch;\n    margin-bottom: 10px;\n    font-size: 0.75rem;\n}\n\n/* Message Intel compact home adjustments */\n.message-intel--home-compact .message-intel__source-strip {\n    margin-bottom: 8px;\n    padding: 8px 10px;\n    border-radius: 8px;\n    font-size: 10px;\n}\n\n.message-intel--home-compact .message-intel__summary-24h,\n.message-intel--home-compact .message-intel__proof,\n.message-intel--home-compact .message-intel__hc-strip {\n    margin-bottom: 8px;\n    padding: 9px 10px;\n    border-radius: 8px;\n}\n\n.message-intel--home-compact .message-intel__legend {\n    display: none;\n}\n\n.message-intel--home-compact .message-intel__foot {\n    margin-top: 8px;\n    font-size: 9px;\n}\n\n@media (max-width: 520px) {\n    .message-intel--home-compact {\n        padding: 6px 0 8px;\n    }\n\n    .message-intel--home-compact .message-intel__topbar {\n        align-items: flex-start;\n    }\n\n    .message-intel--home-compact .message-intel__top-actions {\n        gap: 4px;\n    }\n\n    .message-intel--home-compact .message-intel__full-desk {\n        font-size: 8px;\n    }\n}\n\n@media (min-width: 521px) {\n    .message-intel--home-compact {\n        padding-inline: 2px;\n    }\n}\n\n/* ==========================================================================\n   Learn Tab & Caller Strike-Rate / Proof / High Conviction Refined Cards\n   ========================================================================== */\n\n.message-intel__mode--learn {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    width: 100%;\n}\n\n.message-intel--v2 .message-intel__mode--learn {\n    display: flex;\n    flex-direction: column;\n    grid-template-columns: 1fr;\n    gap: 16px;\n    width: 100%;\n}\n\n.message-intel--v2 .message-intel__mode--learn .message-intel__tile {\n    grid-column: 1 / -1 !important;\n    width: 100%;\n}\n\n.message-intel__learn-card {\n    background: rgba(255, 255, 255, 0.015) !important;\n    border: 1px solid rgba(255, 255, 255, 0.08) !important;\n    border-radius: 14px;\n    padding: 16px;\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 4px 20px rgba(0, 0, 0, 0.08) !important;\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n}\n\n/* Caller Cards List */\n.message-intel__caller-cards-list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    width: 100%;\n}\n\n.message-intel__caller-card-v2 {\n    background: rgba(255, 255, 255, 0.018);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 12px;\n    padding: 12px 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    transition: all 0.2s ease;\n}\n\n.message-intel__caller-card-v2:hover {\n    background: rgba(255, 255, 255, 0.035);\n    border-color: rgba(255, 255, 255, 0.14);\n    transform: translateY(-1px);\n}\n\n.message-intel__caller-card-v2--gold {\n    border-color: rgba(245, 158, 11, 0.35);\n    background: linear-gradient(180deg, rgba(245, 158, 11, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%);\n    box-shadow: inset 0 0 16px -4px rgba(245, 158, 11, 0.12);\n}\n\n.message-intel__caller-card-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n}\n\n.message-intel__caller-card-user {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n.message-intel__caller-rank-pill {\n    font-family: var(--font-mono);\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--muted);\n    background: rgba(255, 255, 255, 0.06);\n    padding: 3px 7px;\n    border-radius: 6px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.message-intel__caller-card-v2--gold .message-intel__caller-rank-pill {\n    color: #f59e0b;\n    background: rgba(245, 158, 11, 0.15);\n    border-color: rgba(245, 158, 11, 0.35);\n}\n\n.message-intel__caller-avatar {\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, rgba(56, 189, 248, 0.25), rgba(168, 85, 247, 0.25));\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 11px;\n    font-weight: 700;\n    color: #fff;\n}\n\n.message-intel__caller-user-info {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n}\n\n.message-intel__caller-name {\n    font-size: 13px;\n    font-weight: 700;\n    color: #f8fafc;\n}\n\n.message-intel__caller-sub {\n    font-size: 10.5px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n}\n\n.message-intel__caller-rate-box {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 2px;\n}\n\n.message-intel__caller-rate-val {\n    font-size: 16px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    line-height: 1;\n}\n\n.message-intel__caller-rate-label {\n    font-size: 8.5px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    color: var(--muted);\n}\n\n.message-intel__caller-card-middle {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.message-intel__caller-stat-pill {\n    font-size: 10.5px;\n    color: var(--muted);\n    background: rgba(255, 255, 255, 0.04);\n    padding: 3px 8px;\n    border-radius: 6px;\n    border: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.message-intel__caller-stat-pill b {\n    color: #e2e8f0;\n}\n\n.message-intel__caller-stat-pill--streak {\n    color: #fb923c;\n    background: rgba(251, 146, 60, 0.1);\n    border-color: rgba(251, 146, 60, 0.2);\n}\n\n.message-intel__caller-card-footer {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 8px;\n    padding-top: 8px;\n    border-top: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.message-intel__caller-x-btn {\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #e2e8f0;\n    background: rgba(255, 255, 255, 0.06);\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    border-radius: 6px;\n    padding: 3px 10px;\n    text-decoration: none;\n    transition: all 0.2s ease;\n}\n\n.message-intel__caller-x-btn:hover {\n    background: rgba(255, 255, 255, 0.12);\n    border-color: rgba(255, 255, 255, 0.24);\n    color: #fff;\n}\n\n.message-intel__caller-receipt-btn {\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #38bdf8;\n    background: rgba(56, 189, 248, 0.1);\n    border: 1px solid rgba(56, 189, 248, 0.25);\n    border-radius: 6px;\n    padding: 3px 10px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n}\n\n.message-intel__caller-receipt-btn:hover {\n    background: rgba(56, 189, 248, 0.2);\n    border-color: rgba(56, 189, 248, 0.4);\n    transform: translateY(-1px);\n}\n\n.message-intel__learn-context-note {\n    font-size: 11px;\n    color: #94a3b8;\n    line-height: 1.4;\n    margin: 4px 0 0 0;\n    padding: 8px 12px;\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px dashed rgba(255, 255, 255, 0.08);\n    border-radius: 8px;\n}\n\n/* Learn Dual Grid — phone column at every viewport, including the full desk. */\n.message-intel__learn-dual-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 16px;\n    width: 100%;\n}\n\n.message-intel__learn-dual-grid > .message-intel__learn-card {\n    min-width: 0;\n    overflow: visible;\n}\n\n/* Telegram Proof Section */\n.message-intel__proof-stat-banner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(56, 189, 248, 0.05) 100%);\n    border: 1px solid rgba(16, 185, 129, 0.25);\n    border-radius: 10px;\n    padding: 10px 14px;\n}\n\n.message-intel__proof-stat-main {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n}\n\n.message-intel__proof-stat-rate {\n    font-size: 20px;\n    font-weight: 900;\n    font-family: var(--font-mono);\n    color: #10b981;\n    line-height: 1;\n}\n\n.message-intel__proof-stat-label {\n    font-size: 9.5px;\n    font-weight: 700;\n    color: #34d399;\n    letter-spacing: 0.08em;\n}\n\n.message-intel__proof-stat-sub {\n    font-size: 11px;\n    color: #e2e8f0;\n}\n\n.message-intel__proof-stat-sub b {\n    color: #10b981;\n    font-family: var(--font-mono);\n    font-weight: 800;\n}\n\n.message-intel__proof-cards-list {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.message-intel__proof-item-card {\n    background: rgba(255, 255, 255, 0.018);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 10px;\n    padding: 10px 12px;\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    transition: all 0.2s ease;\n}\n\n.message-intel__proof-item-card--hit {\n    border-left: 3px solid #10b981;\n}\n\n.message-intel__proof-item-card--miss {\n    border-left: 3px solid #ef4444;\n}\n\n.message-intel__proof-item-top {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 8px;\n    flex-wrap: wrap;\n}\n\n.message-intel__proof-item-status-badge {\n    font-size: 10px;\n    font-weight: 900;\n    font-family: var(--font-mono);\n    padding: 2px 6px;\n    border-radius: 4px;\n    letter-spacing: 0.04em;\n    line-height: 1;\n}\n\n.message-intel__proof-item-status-badge--hit {\n    color: #10b981;\n    background: rgba(16, 185, 129, 0.15);\n    border: 1px solid rgba(16, 185, 129, 0.35);\n}\n\n.message-intel__proof-item-status-badge--miss {\n    color: #f97316;\n    background: rgba(249, 115, 22, 0.15);\n    border: 1px solid rgba(249, 115, 22, 0.35);\n}\n\n.message-intel__proof-item-author {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.message-intel__proof-item-name {\n    font-size: 12px;\n    font-weight: 700;\n    color: #f1f5f9;\n    overflow-wrap: anywhere;\n}\n\n.message-intel__proof-item-meta {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n}\n\n.message-intel__proof-item-move {\n    font-size: 12px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n}\n\n.message-intel__proof-item-thesis {\n    font-size: 11.5px;\n    color: #cbd5e1;\n    line-height: 1.35;\n    margin: 0;\n    font-style: italic;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n}\n\n.message-intel__proof-item-footer {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 8px;\n    flex-wrap: wrap;\n    padding-top: 4px;\n    border-top: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.message-intel__proof-item-date {\n    font-size: 10px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n}\n\n.message-intel__proof-item-actions {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n}\n\n.message-intel__proof-item-receipt-btn {\n    font-size: 10px;\n    font-weight: 600;\n    color: #38bdf8;\n    background: rgba(56, 189, 248, 0.1);\n    border: 1px solid rgba(56, 189, 248, 0.25);\n    border-radius: 5px;\n    padding: 2px 7px;\n    cursor: pointer;\n}\n\n/* High Conviction Signals Section */\n.message-intel__hc-cards-list {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.message-intel__hc-card-v2 {\n    background: rgba(255, 255, 255, 0.018);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 10px;\n    padding: 10px 12px;\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n}\n\n.message-intel__hc-card-top {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 8px;\n    flex-wrap: wrap;\n}\n\n.message-intel__hc-card-badge-group {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n}\n\n.message-intel__hc-conv-pill {\n    font-size: 11px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    color: #a78bfa;\n    background: rgba(167, 139, 250, 0.12);\n    border: 1px solid rgba(167, 139, 250, 0.35);\n    padding: 3px 8px;\n    border-radius: 6px;\n    letter-spacing: 0.02em;\n}\n\n.message-intel__hc-card-author-tag {\n    font-size: 11.5px;\n    font-weight: 700;\n    color: #f1f5f9;\n}\n\n.message-intel__hc-card-sn-band {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: -2px;\n}\n\n.message-intel__skin-pill {\n    font-size: 11px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    padding: 3px 8px;\n    border-radius: 6px;\n}\n\n.message-intel__skin-pill--staked {\n    color: #34d399;\n    background: rgba(16, 185, 129, 0.15);\n    border: 1px solid rgba(52, 211, 153, 0.4);\n}\n\n.message-intel__skin-pill--ape {\n    color: #fb923c;\n    background: rgba(249, 115, 22, 0.15);\n    border: 1px solid rgba(251, 146, 60, 0.4);\n}\n\n.message-intel__hc-card-quote {\n    font-size: 11.5px;\n    color: #e2e8f0;\n    line-height: 1.4;\n    margin: 0;\n    font-style: normal;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n}\n\n.message-intel__hc-card-footer {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 8px;\n    flex-wrap: wrap;\n    padding-top: 4px;\n    border-top: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.message-intel__hc-card-date {\n    font-size: 10px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n}\n\n.message-intel__hc-card-actions {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 6px;\n}\n\n.message-intel__hc-card-sn-link {\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #a855f7;\n    background: rgba(168, 85, 247, 0.1);\n    border: 1px solid rgba(168, 85, 247, 0.25);\n    border-radius: 5px;\n    padding: 2px 8px;\n    text-decoration: none;\n    transition: all 0.2s ease;\n}\n\n.message-intel__hc-card-sn-link:hover {\n    background: rgba(168, 85, 247, 0.2);\n    border-color: rgba(168, 85, 247, 0.4);\n}\n\n/* Skin Guarantee Footer */\n.message-intel__skin-card {\n    background: rgba(255, 255, 255, 0.015) !important;\n    border: 1px solid rgba(255, 255, 255, 0.08) !important;\n    border-radius: 12px;\n    padding: 12px 16px;\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 4px 20px rgba(0, 0, 0, 0.08) !important;\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.message-intel__skin-disclaimer {\n    font-size: 11px;\n    color: #94a3b8;\n    text-align: center;\n    margin: 0;\n    line-height: 1.45;\n}\n\n/* ==========================================================================\n   Rank Tab Full Width & Segmented Controls Styling\n   ========================================================================== */\n\n.message-intel--v2 .message-intel__mode--rank {\n    display: flex;\n    flex-direction: column;\n    grid-template-columns: 1fr;\n    gap: 16px;\n    width: 100%;\n}\n\n.message-intel--v2 .message-intel__mode--rank .message-intel__tile,\n.message-intel--v2 .message-intel__mode--rank .message-intel__rank-pane {\n    grid-column: 1 / -1 !important;\n    width: 100%;\n}\n\n.message-intel__rank-subtabs {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    overflow-x: auto;\n    padding: 6px;\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 12px;\n    scrollbar-width: none;\n    -webkit-overflow-scrolling: touch;\n}\n\n.message-intel__rank-subtabs::-webkit-scrollbar {\n    display: none;\n}\n\n.message-intel__rank-subtab {\n    flex: 1;\n    min-width: 90px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 2px;\n    padding: 8px 10px;\n    border-radius: 8px;\n    background: transparent;\n    border: 1px solid transparent;\n    color: var(--muted);\n    cursor: pointer;\n    transition: all 0.2s ease;\n}\n\n.message-intel__rank-subtab:hover {\n    background: rgba(255, 255, 255, 0.04);\n    color: #f1f5f9;\n}\n\n.message-intel__rank-subtab.is-active {\n    background: rgba(56, 189, 248, 0.12);\n    border-color: rgba(56, 189, 248, 0.35);\n    color: #38bdf8;\n    box-shadow: 0 0 12px rgba(56, 189, 248, 0.15);\n}\n\n.message-intel__rank-subtab-icon {\n    font-size: 16px;\n    line-height: 1;\n}\n\n.message-intel__rank-subtab-title {\n    font-size: 11px;\n    font-weight: 700;\n    white-space: nowrap;\n}\n\n.message-intel__rank-subtab-badge {\n    font-size: 8.5px;\n    font-family: var(--font-mono);\n    padding: 1px 5px;\n    border-radius: 4px;\n    background: rgba(255, 255, 255, 0.06);\n    color: var(--muted);\n}\n\n.message-intel__rank-subtab.is-active .message-intel__rank-subtab-badge {\n    background: rgba(56, 189, 248, 0.25);\n    color: #e0f2fe;\n}\n\n.message-intel__rank-pane {\n    display: none;\n    width: 100%;\n}\n\n.message-intel__rank-pane.is-active {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n}\n\n.message-intel__rank-panel {\n    background: rgba(255, 255, 255, 0.015) !important;\n    border: 1px solid rgba(255, 255, 255, 0.08) !important;\n    border-radius: 14px;\n    padding: 16px;\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 4px 20px rgba(0, 0, 0, 0.08) !important;\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n}\n\n/* Podium Grid Styles */\n.message-intel__podium-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 12px;\n}\n\n.message-intel__podium-card {\n    background: rgba(255, 255, 255, 0.015);\n    border: 1px solid rgba(255, 255, 255, 0.06);\n    border-radius: 12px;\n    padding: 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    transition: all 0.2s ease;\n}\n\n.message-intel__podium-card--gold {\n    border-color: rgba(245, 158, 11, 0.35);\n    background: linear-gradient(180deg, rgba(245, 158, 11, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);\n    box-shadow: inset 0 0 20px -4px rgba(245, 158, 11, 0.1);\n}\n\n.message-intel__podium-card--silver {\n    border-color: rgba(148, 163, 184, 0.35);\n    background: linear-gradient(180deg, rgba(148, 163, 184, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);\n    box-shadow: inset 0 0 20px -4px rgba(148, 163, 184, 0.1);\n}\n\n.message-intel__podium-card--bronze {\n    border-color: rgba(217, 119, 6, 0.35);\n    background: linear-gradient(180deg, rgba(217, 119, 6, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);\n    box-shadow: inset 0 0 20px -4px rgba(217, 119, 6, 0.1);\n}\n\n.message-intel__podium-rank-pill {\n    font-size: 10.5px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    padding: 3px 8px;\n    border-radius: 6px;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n}\n\n.message-intel__podium-card--gold .message-intel__podium-rank-pill {\n    color: #f59e0b;\n    background: rgba(245, 158, 11, 0.15);\n    border: 1px solid rgba(245, 158, 11, 0.35);\n}\n\n.message-intel__podium-card--silver .message-intel__podium-rank-pill {\n    color: #cbd5e1;\n    background: rgba(148, 163, 184, 0.15);\n    border: 1px solid rgba(148, 163, 184, 0.35);\n}\n\n.message-intel__podium-card--bronze .message-intel__podium-rank-pill {\n    color: #fb923c;\n    background: rgba(251, 146, 60, 0.15);\n    border: 1px solid rgba(251, 146, 60, 0.35);\n}\n\n.message-intel__podium-vip-pill {\n    font-size: 9px;\n    font-weight: 700;\n    font-family: var(--font-mono);\n    color: #38bdf8;\n    background: rgba(56, 189, 248, 0.12);\n    border: 1px solid rgba(56, 189, 248, 0.3);\n    padding: 2px 6px;\n    border-radius: 4px;\n}\n\n.message-intel__podium-user {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n}\n\n.message-intel__podium-avatar-wrap {\n    position: relative;\n    flex-shrink: 0;\n}\n\n.message-intel__podium-avatar {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(168, 85, 247, 0.3));\n    border: 1px solid rgba(255, 255, 255, 0.25);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 11px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    color: #fff;\n}\n\n.message-intel__podium-avatar-badge {\n    position: absolute;\n    bottom: -2px;\n    right: -2px;\n    font-size: 9px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    background: rgba(255, 255, 255, 0.1);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    border-radius: 50%;\n    width: 15px;\n    height: 15px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    line-height: 1;\n}\n\n.message-intel__podium-identity {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n    min-width: 0;\n}\n\n.message-intel__podium-name {\n    font-size: 13.5px;\n    font-weight: 700;\n    color: #f8fafc;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.message-intel__podium-tenure {\n    font-size: 10.5px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.message-intel__podium-metrics {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 8px;\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px solid rgba(255, 255, 255, 0.06);\n    border-radius: 8px;\n    padding: 8px;\n}\n\n.message-intel__podium-metric {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 2px;\n}\n\n.message-intel__podium-metric-label {\n    font-size: 8.5px;\n    font-weight: 700;\n    color: var(--muted);\n    letter-spacing: 0.06em;\n}\n\n.message-intel__podium-metric-val {\n    font-size: 13px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n}\n\n.message-intel__podium-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding-top: 8px;\n    border-top: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.message-intel__podium-top-call {\n    font-size: 11px;\n    color: var(--muted);\n}\n\n.message-intel__podium-top-call b {\n    color: #10b981;\n    font-family: var(--font-mono);\n}\n\n.message-intel__podium-receipt-btn {\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #38bdf8;\n    background: rgba(56, 189, 248, 0.1);\n    border: 1px solid rgba(56, 189, 248, 0.25);\n    border-radius: 5px;\n    padding: 3px 8px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n}\n\n.message-intel__podium-receipt-btn:hover {\n    background: rgba(56, 189, 248, 0.2);\n    border-color: rgba(56, 189, 248, 0.4);\n}\n\n.message-intel__podium-card-top {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 6px;\n}\n\n.message-intel__podium-vip-pill--caution {\n    color: #fbbf24;\n    background: rgba(251, 191, 36, 0.12);\n    border-color: rgba(251, 191, 36, 0.35);\n}\n\n.message-intel__champ-wrap {\n    min-width: 0;\n    max-width: 100%;\n}\n\n@media (max-width: 480px) {\n    .message-intel__podium-grid {\n        grid-template-columns: 1fr;\n    }\n\n    .message-intel__podium-card {\n        min-width: 0;\n        overflow: hidden;\n    }\n\n    .message-intel__podium-tenure {\n        white-space: normal;\n    }\n\n    .message-intel__podium-metrics {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: 6px;\n        padding: 6px;\n    }\n\n    .message-intel__podium-metric {\n        min-width: 0;\n    }\n\n    .message-intel__podium-metric-label {\n        font-size: 7.5px;\n        letter-spacing: 0.04em;\n        text-align: center;\n    }\n\n    .message-intel__podium-metric-val {\n        font-size: 12px;\n    }\n\n    .message-intel__podium-footer {\n        flex-wrap: wrap;\n        gap: 8px;\n    }\n\n    .message-intel__dossier-row {\n        display: grid;\n        grid-template-columns: 2fr 1fr 1fr 1fr;\n        gap: 8px;\n        align-items: center;\n        padding: 10px 8px;\n    }\n\n    .message-intel__dossier-rate,\n    .message-intel__dossier-inf,\n    .message-intel__dossier-action {\n        flex-shrink: 1;\n        min-width: 0;\n    }\n\n    .message-intel__dossier-user {\n        min-width: 0;\n    }\n\n    .message-intel__dossier-name {\n        overflow: hidden;\n        text-overflow: ellipsis;\n        white-space: nowrap;\n    }\n}\n\n/* Dossier Rows List */\n.message-intel__champ-list {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin-top: 8px;\n}\n\n.message-intel__champ-list-header {\n    display: grid;\n    grid-template-columns: 2fr 1fr 1fr 1fr;\n    gap: 12px;\n    padding: 0 12px;\n    font-size: 9px;\n    font-weight: 700;\n    color: var(--muted);\n    letter-spacing: 0.08em;\n}\n\n.message-intel__dossier-row {\n    background: rgba(255, 255, 255, 0.015);\n    border: 1px solid rgba(255, 255, 255, 0.06);\n    border-radius: 10px;\n    padding: 10px 12px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    transition: all 0.2s ease;\n}\n\n.message-intel__dossier-row:hover {\n    background: rgba(255, 255, 255, 0.04);\n    border-color: rgba(255, 255, 255, 0.12);\n}\n\n.message-intel__dossier-user {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex: 1;\n    min-width: 0;\n}\n\n.message-intel__dossier-rank-badge {\n    font-family: var(--font-mono);\n    font-size: 10px;\n    font-weight: 700;\n    color: var(--muted);\n    padding: 2px 5px;\n    border-radius: 4px;\n    background: rgba(255, 255, 255, 0.06);\n    flex-shrink: 0;\n}\n\n.message-intel__dossier-avatar {\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 10px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    flex-shrink: 0;\n}\n\n.message-intel__dossier-info {\n    display: flex;\n    flex-direction: column;\n    gap: 1px;\n    min-width: 0;\n}\n\n.message-intel__dossier-name {\n    font-size: 12px;\n    font-weight: 700;\n    color: #f1f5f9;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.message-intel__dossier-sub {\n    font-size: 9.5px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.message-intel__dossier-rate {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 1px;\n    flex-shrink: 0;\n    min-width: 55px;\n}\n\n.message-intel__dossier-rate b {\n    font-size: 12px;\n    color: #10b981;\n    font-family: var(--font-mono);\n}\n\n.message-intel__dossier-streak {\n    font-size: 9px;\n    color: #fb923c;\n}\n\n.message-intel__dossier-inf {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 1px;\n    flex-shrink: 0;\n    min-width: 45px;\n}\n\n.message-intel__dossier-inf b {\n    font-size: 12px;\n    color: #38bdf8;\n    font-family: var(--font-mono);\n}\n\n.message-intel__dossier-action {\n    flex-shrink: 0;\n}\n\n.message-intel__dossier-receipt-btn {\n    font-size: 10px;\n    font-weight: 600;\n    color: #38bdf8;\n    background: rgba(56, 189, 248, 0.1);\n    border: 1px solid rgba(56, 189, 248, 0.25);\n    border-radius: 4px;\n    padding: 4px 8px;\n    cursor: pointer;\n}\n\n/* Chatter Power Cards */\n.message-intel__power-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n    gap: 12px;\n}\n\n.message-intel__power-card-v2 {\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 12px;\n    padding: 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n}\n\n.message-intel__power-card-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n\n.message-intel__power-rank-badge {\n    font-size: 11px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n    padding: 3px 7px;\n    border-radius: 6px;\n    background: rgba(255, 255, 255, 0.06);\n    color: var(--muted);\n}\n\n.message-intel__power-card-header .message-intel__power-rank-badge {\n    color: #a855f7;\n    background: rgba(168, 85, 247, 0.15);\n    border: 1px solid rgba(168, 85, 247, 0.35);\n}\n\n.message-intel__power-title-wrap {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.message-intel__power-score-badge {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n}\n\n.message-intel__power-score-label {\n    font-size: 8px;\n    font-weight: 700;\n    color: var(--muted);\n    letter-spacing: 0.08em;\n}\n\n.message-intel__power-score-val {\n    font-size: 16px;\n    font-weight: 900;\n    font-family: var(--font-mono);\n    color: #38bdf8;\n    line-height: 1;\n}\n\n.message-intel__power-factors {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n}\n\n.message-intel__power-factor {\n    display: grid;\n    grid-template-columns: 50px 1fr 35px;\n    align-items: center;\n    gap: 8px;\n}\n\n.message-intel__factor-lbl {\n    font-size: 9.5px;\n    color: var(--muted);\n}\n\n.message-intel__factor-meter {\n    height: 4px;\n    background: rgba(255, 255, 255, 0.08);\n    border-radius: 2px;\n    overflow: hidden;\n}\n\n.message-intel__factor-meter i {\n    display: block;\n    height: 100%;\n    border-radius: 2px;\n    background: #38bdf8;\n}\n\n.message-intel__meter--purple i { background: #a855f7; }\n.message-intel__meter--green i { background: #10b981; }\n\n.message-intel__factor-val {\n    font-size: 10px;\n    font-family: var(--font-mono);\n    font-weight: 700;\n    color: #e2e8f0;\n    text-align: right;\n}\n\n.message-intel__power-why-box {\n    font-size: 11px;\n    color: #cbd5e1;\n    background: rgba(255, 255, 255, 0.015);\n    border-radius: 6px;\n    padding: 8px;\n    margin: 0;\n    line-height: 1.4;\n}\n\n.message-intel__power-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding-top: 6px;\n    border-top: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.message-intel__power-sub-link {\n    font-size: 11px;\n    color: #38bdf8;\n    text-decoration: none;\n}\n\n.message-intel__power-calls-btn {\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #a855f7;\n    background: rgba(168, 85, 247, 0.1);\n    border: 1px solid rgba(168, 85, 247, 0.25);\n    border-radius: 5px;\n    padding: 2px 8px;\n    cursor: pointer;\n}\n\n/* Accolade Cards */\n.message-intel__accolades-grid-v2 {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n    gap: 12px;\n}\n\n.message-intel__accolade-card-v2 {\n    background: rgba(255, 255, 255, 0.015);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 12px;\n    padding: 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n}\n\n.message-intel__accolade-top {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n.message-intel__accolade-icon {\n    font-size: 22px;\n    line-height: 1;\n}\n\n.message-intel__accolade-title-wrap {\n    display: flex;\n    flex-direction: column;\n    gap: 1px;\n}\n\n.message-intel__accolade-title-wrap b {\n    font-size: 13px;\n    color: #f8fafc;\n}\n\n.message-intel__accolade-title-wrap span {\n    font-size: 10.5px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n}\n\n.message-intel__accolade-tag {\n    font-size: 9px;\n    font-weight: 700;\n    font-family: var(--font-mono);\n    color: #eab308;\n    background: rgba(234, 179, 8, 0.15);\n    border: 1px solid rgba(234, 179, 8, 0.35);\n    padding: 2px 6px;\n    border-radius: 4px;\n    margin-left: auto;\n}\n\n.message-intel__accolade-why-v2 {\n    font-size: 11.5px;\n    color: #cbd5e1;\n    line-height: 1.4;\n    margin: 0;\n}\n\n.message-intel__accolade-req {\n    font-size: 10px;\n    color: var(--muted);\n    font-family: var(--font-mono);\n}\n\n.message-intel__accolade-footer-v2 {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    padding-top: 6px;\n    border-top: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.message-intel__accolade-receipt-btn {\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #38bdf8;\n    background: rgba(56, 189, 248, 0.1);\n    border: 1px solid rgba(56, 189, 248, 0.25);\n    border-radius: 5px;\n    padding: 3px 8px;\n    cursor: pointer;\n}\n\n/* Reaction Crowns Cards */\n.message-intel__crowns-grid-v2 {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 10px;\n    width: 100%;\n    min-width: 0;\n}\n\n.message-intel__crown-card-v2 {\n    background: rgba(255, 255, 255, 0.015);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 12px;\n    padding: 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    min-width: 0;\n    max-width: 100%;\n    box-sizing: border-box;\n}\n\n.message-intel__crown-header-v2 {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 8px;\n    flex-wrap: wrap;\n    min-width: 0;\n}\n\n.message-intel__crown-info-v2 {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    min-width: 0;\n    flex: 1 1 140px;\n}\n\n.message-intel__crown-icon-v2 {\n    font-size: 18px;\n    line-height: 1;\n    flex: 0 0 auto;\n}\n\n.message-intel__crown-author-v2 {\n    font-size: 12.5px;\n    font-weight: 700;\n    color: #f1f5f9;\