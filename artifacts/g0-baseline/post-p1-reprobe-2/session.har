20)"},{"name":"server-timing","value":"app;dur=1803.8"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":5825,"mimeType":"text/javascript; charset=utf-8","compression":3684,"text":"/** §17.F4 — weekly letter UI (structured JSON → HTML, XSS-safe) */\n(function () {\n  \"use strict\";\n\n  function $(id) {\n    return document.getElementById(id);\n  }\n\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n\n  function pct(rate) {\n    if (rate == null || isNaN(rate)) return \"—\";\n    return (Number(rate) * 100).toFixed(1) + \"%\";\n  }\n\n  function fmtSigned(n) {\n    var v = Number(n);\n    if (isNaN(v)) return \"—\";\n    return (v >= 0 ? \"+\" : \"\") + v.toFixed(2) + \"%\";\n  }\n\n  function renderTopPick(top) {\n    top = top || {};\n    var body = \"\";\n    if (top.available && top.summary) {\n      body +=\n        '<p class=\"weekly-letter__lead\"><strong>' +\n        esc(top.summary) +\n        \"</strong>\" +\n        (top.action ? \" · \" + esc(String(top.action).toUpperCase()) : \"\") +\n        \"</p>\";\n      if (top.reason) body += '<p class=\"weekly-letter__note\">' + esc(top.reason) + \"</p>\";\n    } else if (top.held) {\n      body += '<p class=\"weekly-letter__lead\">No published long this period (honest HOLD / gate).</p>';\n      if (top.reason) body += '<p class=\"weekly-letter__note\">' + esc(top.reason) + \"</p>\";\n      if (top.summary) {\n        body += '<p class=\"weekly-letter__note\">Candidate: ' + esc(top.summary) + \"</p>\";\n      }\n    } else {\n      body += '<p class=\"weekly-letter__note\">No top pick data yet.</p>';\n    }\n    return (\n      '<section class=\"weekly-letter__block\" aria-labelledby=\"weekly-letter-top-pick\">' +\n      '<h3 class=\"weekly-letter__block-title\" id=\"weekly-letter-top-pick\">Top pick</h3>' +\n      body +\n      \"</section>\"\n    );\n  }\n\n  function renderWinRate(win) {\n    win = win || {};\n    var body = \"\";\n    if (win.available) {\n      body +=\n        '<p class=\"weekly-letter__lead\">Direction hit-rate: <strong>' +\n        pct(win.win_pct) +\n        \"</strong> (\" +\n        String(win.win_count || 0) +\n        \"/\" +\n        String(win.total_closed || 0) +\n        \" closed)</p>\";\n      if (win.excess_vs_hold_tao_pct != null) {\n        body +=\n          '<p class=\"weekly-letter__note\">Paper P&amp;L vs hold TAO: <strong>' +\n          fmtSigned(win.excess_vs_hold_tao_pct) +\n          \"</strong></p>\";\n      }\n    } else {\n      body += '<p class=\"weekly-letter__note\">No gradeable resolved picks yet.</p>';\n    }\n    return (\n      '<section class=\"weekly-letter__block\" aria-labelledby=\"weekly-letter-win-rate\">' +\n      '<h3 class=\"weekly-letter__block-title\" id=\"weekly-letter-win-rate\">Win rate</h3>' +\n      body +\n      \"</section>\"\n    );\n  }\n\n  function renderScenarios(rows) {\n    rows = rows || [];\n    var body = \"\";\n    if (!rows.length) {\n      body = '<p class=\"weekly-letter__note\">No scenarios recorded yet.</p>';\n    } else {\n      body = '<ul class=\"weekly-letter__list\">';\n      rows.forEach(function (s) {\n        var label = s.name || s.id || \"scenario\";\n        var regime = s.regime || \"unknown\";\n        var outcome = s.outcome || \"pending\";\n        body +=\n          '<li class=\"weekly-letter__item\">' +\n          '<span class=\"weekly-letter__item-name\">' +\n          esc(label) +\n          \"</span>\" +\n          '<span class=\"weekly-letter__item-meta\">' +\n          esc(regime) +\n          \" · \" +\n          esc(outcome) +\n          \"</span>\" +\n          \"</li>\";\n      });\n      body += \"</ul>\";\n    }\n    return (\n      '<section class=\"weekly-letter__block\" aria-labelledby=\"weekly-letter-scenarios\">' +\n      '<h3 class=\"weekly-letter__block-title\" id=\"weekly-letter-scenarios\">Scenarios (≤3)</h3>' +\n      body +\n      \"</section>\"\n    );\n  }\n\n  function render(root, payload) {\n    if (!root) return;\n    if (!payload || payload.status !== \"ok\") {\n      root.innerHTML =\n        '<p class=\"weekly-letter__empty\">Weekly letter unavailable right now.</p>';\n      return;\n    }\n    if (payload.empty) {\n      root.innerHTML =\n        '<p class=\"weekly-letter__empty\">No letter content yet — picks, grades, and scenarios populate as the council runs.</p>';\n      return;\n    }\n    root.innerHTML =\n      '<article class=\"weekly-letter__digest\">' +\n      renderTopPick(payload.top_pick) +\n      renderWinRate(payload.win_rate) +\n      renderScenarios(payload.scenarios) +\n      \"</article>\";\n  }\n\n  async function hydrate() {\n    var root = $(\"weekly-letter-root\");\n    var weekEl = $(\"weekly-letter-week\");\n    if (!root) return;\n    var fetchJson = window.apiFetchJson || function (url) {\n      return fetch(url).then(function (r) {\n        if (!r.ok) throw new Error(\"HTTP \" + r.status);\n        return r.json();\n      });\n    };\n    try {\n      var payload = await fetchJson(\"/api/letter/weekly\", 15000);\n      if (weekEl && payload.week_of) {\n        weekEl.textContent = \"Week of \" + payload.week_of;\n      }\n      render(root, payload);\n      root.classList.remove(\"is-loading\");\n      root.classList.remove(\"is-error\");\n      root.setAttribute(\"aria-busy\", \"false\");\n      if (window.LetterExport && window.LetterExport.weekly) {\n        window.LetterExport.weekly.setMarkdown(\n          payload.markdown,\n          \"weekly-letter-\" + (payload.week_of || \"export\")\n        );\n      }\n    } catch (e) {\n      if (weekEl) weekEl.textContent = \"SimiVision digest\";\n      root.classList.remove(\"is-loading\");\n      root.classList.add(\"is-error\");\n      root.setAttribute(\"aria-busy\", \"false\");\n      root.innerHTML =\n        '<p class=\"weekly-letter__empty is-error\">Could not load weekly letter — try again shortly.</p>';\n      if (window.LetterExport && window.LetterExport.weekly) {\n        window.LetterExport.weekly.setMarkdown(\"\");\n      }\n    }\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", hydrate);\n  } else {\n    hydrate();\n  }\n})();\n"},"headersSize":0,"bodySize":2141,"redirectURL":"","_transferSize":2141},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2307.482,"receive":182.102},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@ef0c99b3970209309943c75f130f876a","startedDateTime":"2026-08-26T20:24:35.018Z","time":2436.262,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/daily_recap.js?v=261c4f50","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/daily_recap.js?v=261c4f50"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[{"name":"v","value":"261c4f50"}],"headersSize":590,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Wed, 26 Aug 2026 20:24:34 GMT"},{"name":"etag","value":"\"60ca1a9b547c0113f6de7b9b73391d4e\""},{"name":"fly-request-id","value":"01M0ZVXXYKJCP0KY9A6J5Y8RFA-ord"},{"name":"last-modified","value":"Wed, 26 Aug 2026 19:25:36 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=1795.0"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":5577,"mimeType":"text/javascript; charset=utf-8","compression":3448,"text":"/** §17.F4b — daily recap UI (yesterday briefing, textContent-safe HTML) */\n(function () {\n  \"use strict\";\n\n  function $(id) {\n    return document.getElementById(id);\n  }\n\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n\n  function block(title, id, body) {\n    return (\n      '<section class=\"weekly-letter__block\" aria-labelledby=\"' +\n      id +\n      '\">' +\n      '<h3 class=\"weekly-letter__block-title\" id=\"' +\n      id +\n      '\">' +\n      esc(title) +\n      \"</h3>\" +\n      body +\n      \"</section>\"\n    );\n  }\n\n  function renderPicks(rows) {\n    rows = rows || [];\n    if (!rows.length) {\n      return '<p class=\"weekly-letter__note\">No council picks recorded for yesterday.</p>';\n    }\n    var html = '<ul class=\"weekly-letter__list\">';\n    rows.forEach(function (p) {\n      html +=\n        '<li class=\"weekly-letter__item\">' +\n        '<span class=\"weekly-letter__item-name\">' +\n        esc(p.summary || \"pick\") +\n        (p.action ? \" · \" + esc(String(p.action).toUpperCase()) : \"\") +\n        \"</span>\" +\n        (p.reason\n          ? '<span class=\"weekly-letter__item-meta\">' + esc(p.reason) + \"</span>\"\n          : \"\") +\n        \"</li>\";\n    });\n    html += \"</ul>\";\n    return html;\n  }\n\n  function renderResolutions(rows, stats) {\n    rows = rows || [];\n    if (!rows.length) {\n      return '<p class=\"weekly-letter__note\">No gradeable resolutions yesterday.</p>';\n    }\n    var html =\n      '<p class=\"weekly-letter__lead\"><strong>' +\n      String(stats.correct || 0) +\n      \"/\" +\n      String(stats.resolved_count || rows.length) +\n      \"</strong> direction hits</p>\";\n    html += '<ul class=\"weekly-letter__list\">';\n    rows.slice(0, 5).forEach(function (r) {\n      html +=\n        '<li class=\"weekly-letter__item\">' +\n        '<span class=\"weekly-letter__item-name\">' +\n        esc(r.name || \"SN\" + r.netuid) +\n        \"</span>\" +\n        '<span class=\"weekly-letter__item-meta\">' +\n        esc(r.outcome || \"?\") +\n        \" · pred \" +\n        esc(r.predicted_pct) +\n        \"% → \" +\n        esc(r.actual_pct) +\n        \"%</span></li>\";\n    });\n    html += \"</ul>\";\n    return html;\n  }\n\n  function renderSimpleList(rows, emptyMsg, labelKey) {\n    rows = rows || [];\n    if (!rows.length) return '<p class=\"weekly-letter__note\">' + esc(emptyMsg) + \"</p>\";\n    var html = '<ul class=\"weekly-letter__list\">';\n    rows.forEach(function (row) {\n      var label = row[labelKey] || row.name || row.id || \"item\";\n      var meta = row.regime\n        ? row.regime + \" · \" + (row.outcome || \"pending\")\n        : row.message || row.alert_type || \"\";\n      html +=\n        '<li class=\"weekly-letter__item\">' +\n        '<span class=\"weekly-letter__item-name\">' +\n        esc(label) +\n        \"</span>\" +\n        (meta ? '<span class=\"weekly-letter__item-meta\">' + esc(meta) + \"</span>\" : \"\") +\n        \"</li>\";\n    });\n    html += \"</ul>\";\n    return html;\n  }\n\n  function render(root, payload) {\n    if (!root) return;\n    if (!payload || payload.status !== \"ok\") {\n      root.innerHTML = '<p class=\"weekly-letter__empty\">Daily recap unavailable right now.</p>';\n      return;\n    }\n    if (payload.empty) {\n      root.innerHTML =\n        '<p class=\"weekly-letter__empty\">Nothing to recap for yesterday yet — picks and grades populate as the council runs.</p>';\n      return;\n    }\n    root.innerHTML =\n      '<article class=\"weekly-letter__digest\">' +\n      block(\"Picks\", \"daily-recap-picks\", renderPicks(payload.picks)) +\n      block(\n        \"Resolutions\",\n        \"daily-recap-resolutions\",\n        renderResolutions(payload.resolutions, payload.stats || {})\n      ) +\n      block(\n        \"Scenarios\",\n        \"daily-recap-scenarios\",\n        renderSimpleList(payload.scenarios, \"No scenarios recorded yesterday.\", \"name\")\n      ) +\n      block(\n        \"Alerts\",\n        \"daily-recap-alerts\",\n        renderSimpleList(payload.alerts, \"No notable alerts yesterday.\", \"message\")\n      ) +\n      \"</article>\";\n  }\n\n  async function hydrate() {\n    var root = $(\"daily-recap-root\");\n    var dateEl = $(\"daily-recap-date\");\n    if (!root) return;\n    var fetchJson = window.apiFetchJson || function (url) {\n      return fetch(url).then(function (r) {\n        if (!r.ok) throw new Error(\"HTTP \" + r.status);\n        return r.json();\n      });\n    };\n    try {\n      var payload = await fetchJson(\"/api/letter/daily\", 15000);\n      if (dateEl && payload.date) {\n        dateEl.textContent = \"Recap for \" + payload.date + \" (UTC)\";\n      }\n      render(root, payload);\n      root.classList.remove(\"is-loading\");\n      root.classList.remove(\"is-error\");\n      root.setAttribute(\"aria-busy\", \"false\");\n      if (window.LetterExport && window.LetterExport.daily) {\n        window.LetterExport.daily.setMarkdown(\n          payload.markdown,\n          \"daily-recap-\" + (payload.date || \"export\")\n        );\n      }\n    } catch (e) {\n      if (dateEl) dateEl.textContent = \"Morning briefing\";\n      root.classList.remove(\"is-loading\");\n      root.classList.add(\"is-error\");\n      root.setAttribute(\"aria-busy\", \"false\");\n      root.innerHTML =\n        '<p class=\"weekly-letter__empty is-error\">Could not load daily recap — try again shortly.</p>';\n      if (window.LetterExport && window.LetterExport.daily) {\n        window.LetterExport.daily.setMarkdown(\"\");\n      }\n    }\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", hydrate);\n  } else {\n    hydrate();\n  }\n})();\n"},"headersSize":0,"bodySize":2129,"redirectURL":"","_transferSize":2129},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2245.52,"receive":190.742},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@ef0c99b3970209309943c75f130f876a","startedDateTime":"2026-08-26T20:24:35.018Z","time":2596.031,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/watchlist_alerts.js?v=261c4f50","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/watchlist_alerts.js?v=261c4f50"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[{"name":"v","value":"261c4f50"}],"headersSize":600,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Wed, 26 Aug 2026 20:24:35 GMT"},{"name":"etag","value":"\"97bc8e1f02548258ad56abaaa9f69abf\""},{"name":"fly-request-id","value":"01M0ZVXXYKC92D15KEYZ0C4AEE-ord"},{"name":"last-modified","value":"Wed, 26 Aug 2026 19:25:36 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=1267.1"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":5638,"mimeType":"text/javascript; charset=utf-8","compression":3411,"text":"/** §17.F1/F2 — home watchlist pin + conviction alert check */\n(function () {\n  \"use strict\";\n\n  function $(id) {\n    return document.getElementById(id);\n  }\n\n  async function fetchJson(url, opts) {\n    const resp = await fetch(url, opts);\n    if (!resp.ok) throw new Error(\"HTTP \" + resp.status);\n    return resp.json();\n  }\n\n  async function loadWatchlist() {\n    return fetchJson(\"/api/watchlist\");\n  }\n\n  async function saveWatchlist(netuids) {\n    return fetchJson(\"/api/watchlist\", {\n      method: \"PUT\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ netuids: netuids }),\n    });\n  }\n\n  function setStatus(msg) {\n    const el = $(\"home-habit-status\");\n    if (!el) return;\n    let note = el.querySelector(\".home-habit-status__note\");\n    if (!note) {\n      note = document.createElement(\"span\");\n      note.className = \"home-habit-status__note\";\n      el.appendChild(note);\n    }\n    note.textContent = msg;\n  }\n\n  function updatePinButton(netuid, pinned) {\n    const btn = $(\"habit-pin-btn\");\n    if (!btn || !netuid) return;\n    btn.dataset.pinned = pinned ? \"1\" : \"0\";\n    btn.textContent = pinned ? \"Unpin subnet\" : \"Pin to watchlist\";\n  }\n\n  function isPinned(netuid) {\n    const btn = $(\"habit-pin-btn\");\n    if (!btn || String(btn.dataset.netuid) !== String(netuid)) return false;\n    return btn.dataset.pinned === \"1\";\n  }\n\n  async function togglePin(netuid) {\n    const n = parseInt(String(netuid), 10);\n    if (!n) return null;\n    const wl = await loadWatchlist();\n    let pins = (wl.netuids || []).map(Number).filter(Boolean);\n    const pinned = pins.indexOf(n) >= 0;\n    if (pinned) {\n      pins = pins.filter(function (x) { return x !== n; });\n    } else {\n      pins.push(n);\n    }\n    const saved = await saveWatchlist(pins);\n    updatePinButton(n, !pinned);\n    updateWatchSummary((saved.netuids || []).length);\n    setStatus(pinned ? \"Removed SN\" + n + \" from watchlist\" : \"Pinned SN\" + n);\n    document.dispatchEvent(new CustomEvent(\"habit-watchlist:change\", { detail: { netuid: n, pinned: !pinned } }));\n    return saved;\n  }\n\n  function updateWatchSummary(count) {\n    const el = $(\"habit-watchlist-summary\");\n    if (!el) return;\n    if (count > 0) {\n      el.textContent = \"Watchlist: \" + count + \" pinned\";\n    } else {\n      el.textContent = \"No pinned subnets\";\n    }\n  }\n\n  async function refreshWatchlistSummary() {\n    const el = $(\"habit-watchlist-summary\");\n    if (!el) return;\n    try {\n      const wl = await loadWatchlist();\n      updateWatchSummary((wl.netuids || []).length);\n    } catch (e) {\n      el.textContent = \"Watchlist unavailable\";\n    }\n  }\n\n  function initPin() {\n    const btn = $(\"habit-pin-btn\");\n    if (!btn || btn.disabled) return;\n    btn.addEventListener(\"click\", async function () {\n      const netuid = parseInt(btn.dataset.netuid || \"\", 10);\n      if (!netuid) return;\n      try {\n        await togglePin(netuid);\n      } catch (e) {\n        setStatus(\"Watchlist update failed\");\n      }\n    });\n  }\n\n  window.HabitWatchlist = { togglePin: togglePin, isPinned: isPinned, updatePinButton: updatePinButton };\n\n  function initAlerts() {\n    const btn = $(\"habit-alert-btn\");\n    if (!btn) return;\n\n    if (btn.dataset.enabled !== \"1\") {\n      btn.hidden = true;\n      return;\n    }\n\n    function setAlertDot(show) {\n      if (show) btn.classList.add(\"habit-alert-btn--dot\");\n      else btn.classList.remove(\"habit-alert-btn--dot\");\n    }\n\n    async function refreshAlertDot() {\n      if (btn.dataset.enabled !== \"1\") {\n        setAlertDot(false);\n        return;\n      }\n      try {\n        const st = await fetchJson(\"/api/conviction-alerts/status\");\n        const last = (st.last_run && st.last_run.created) || 0;\n        setAlertDot(Number(last) > 0);\n      } catch (e) {\n        setAlertDot(false);\n      }\n    }\n\n    refreshAlertDot();\n\n    btn.addEventListener(\"click\", async function () {\n      if (btn.dataset.enabled !== \"1\") {\n        setStatus(\"Conviction alerts disabled — enable CONVICTION_ALERTS_ENABLED on deploy\");\n        return;\n      }\n      btn.disabled = true;\n      try {\n        const out = await fetchJson(\"/api/conviction-alerts/notify\", { method: \"POST\" });\n        const created = out.created != null ? out.created : out.alerts_created;\n        const delivery = out.delivery || {};\n        const dry = delivery.dry_run || [];\n        let msg =\n          \"Alert check done\" +\n          (created != null ? \" · \" + created + \" created\" : \"\") +\n          (out.reason ? \" · \" + out.reason : \"\");\n        if (delivery.mode === \"dry_run\" && dry.length) {\n          msg +=\n            \" · dry-run \" +\n            dry.length +\n            \": \" +\n            dry\n              .slice(0, 2)\n              .map(function (row) {\n                return row.message || row.dedupe_key || \"alert\";\n              })\n              .join(\"; \");\n        } else if (delivery.skipped_watchlist) {\n          msg += \" · \" + delivery.skipped_watchlist + \" off-watchlist skipped\";\n        }\n        setStatus(msg);\n        const summary = $(\"habit-alerts-summary\");\n        if (summary && out.last_run_at) {\n          summary.textContent = \"Alerts on · last \" + out.last_run_at;\n        }\n        refreshAlertDot();\n      } catch (e) {\n        setStatus(\"Conviction alert check failed\");\n      } finally {\n        btn.disabled = false;\n      }\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      initPin();\n      initAlerts();\n      refreshWatchlistSummary();\n    });\n  } else {\n    initPin();\n    initAlerts();\n    refreshWatchlistSummary();\n  }\n})();\n"},"headersSize":0,"bodySize":2227,"redirectURL":"","_transferSize":2227},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2436.513,"receive":159.518},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@ef0c99b3970209309943c75f130f876a","startedDateTime":"2026-08-26T20:24:35.018Z","time":2474.027,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/letter_export.js?v=261c4f50","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/letter_export.js?v=261c4f50"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","