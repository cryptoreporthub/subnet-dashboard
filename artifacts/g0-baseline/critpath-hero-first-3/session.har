-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=792.1"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":1609,"mimeType":"text/css; charset=utf-8","compression":764,"text":"/* tribunal-hero-layout.css — single ring-geometry source (loads after ui.css).\n   Eye/vesica SVG + glow + center copy share one origin. No scaleY squash. */\n.tribunal-hero__stage {\n  position: relative;\n  width: 100%;\n  max-width: 430px;\n  margin: 0 auto;\n  height: 440px;\n  min-height: 0;\n  padding-top: 0;\n  overflow: hidden;\n}\n\n.tribunal-hero__stage::before {\n  background: repeating-radial-gradient(\n    ellipse 140% 82% at 50% 48%,\n    transparent 0px,\n    transparent 52px,\n    rgba(148, 180, 205, 0.05) 52px,\n    rgba(148, 180, 205, 0.05) 53px\n  );\n}\n\n.tribunal-hero__ring {\n  position: absolute;\n  left: 50%;\n  top: 48%;\n  width: min(300px, 86%);\n  height: 168px;\n  transform: translate(-50%, -50%);\n  z-index: 2;\n  pointer-events: none;\n}\n\n.tribunal-hero__radial {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  display: block;\n  transform: none;\n  filter: drop-shadow(0 6px 22px rgba(0, 0, 0, 0.45));\n}\n\n.tribunal-hero__ring-glow {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 72%;\n  height: 58%;\n  border-radius: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 0;\n  pointer-events: none;\n}\n\n.tribunal-hero__ring-center {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 3;\n  width: 150px;\n  pointer-events: none;\n}\n\n@media (max-width: 420px) {\n  .tribunal-hero__ring {\n    width: min(268px, 90%);\n    height: 148px;\n  }\n}\n\n@media (max-width: 390px) {\n  .tribunal-hero__stage {\n    height: 420px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tribunal-hero__ring-glow {\n    animation: none;\n  }\n}\n"},"headersSize":0,"bodySize":845,"redirectURL":"","_transferSize":845},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":965.982,"receive":394.313},"_resourceType":"stylesheet","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.237Z","time":1151.365,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/css/council-polish.css?v=7b9cae5e","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/css/council-polish.css?v=7b9cae5e"},{"name":":scheme","value":"https"},{"name":"accept","value":"text/css,*/*;q=0.1"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"priority","value":"u=0"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"style"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[{"name":"v","value":"7b9cae5e"}],"headersSize":629,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/css; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:32 GMT"},{"name":"etag","value":"\"acb69187f08f089b21499ff169e19e2d\""},{"name":"fly-request-id","value":"01M109DZBQ7SEMBF6BD90XS94F-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=745.9"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":4817,"mimeType":"text/css; charset=utf-8","compression":2867,"text":"/* ============================================================\n   Council final-polish (2026-08-11) — NET FLOW hero slot,\n   shimmer skeleton, live pulse. Pairs with:\n   templates/partials/premium/hero.html\n   All classes scoped cpol-* — no collisions with ui.css/base.css.\n   ============================================================ */\n\n.cpol-netflow {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  margin: 14px 0 18px;\n  padding: 16px 18px;\n  border-radius: var(--glass-radius, 18px);\n  border: 1px solid var(--glass-border, rgba(255,255,255,0.12));\n  background:\n    radial-gradient(520px 200px at 88% -20%, rgba(94,234,212,0.10), transparent 62%),\n    linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  box-shadow: 0 14px 44px -18px rgba(0,0,0,0.6);\n  overflow: hidden;\n}\n.cpol-netflow::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background-image:\n    radial-gradient(1.4px 1.4px at 12% 18%, rgba(255,255,255,0.8) 50%, transparent 51%),\n    radial-gradient(1px 1px at 62% 8%, rgba(94,234,212,0.9) 50%, transparent 51%),\n    radial-gradient(1.2px 1.2px at 84% 26%, rgba(255,255,255,0.7) 50%, transparent 51%),\n    radial-gradient(1px 1px at 38% 34%, rgba(255,255,255,0.6) 50%, transparent 51%);\n  background-size: 180px 180px;\n  opacity: 0.55;\n}\n\n.cpol-nf-kicker {\n  font-size: 10.5px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--text-faint, #5d6480);\n  font-weight: 650;\n}\n\n.cpol-nf-main {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.cpol-nf-value {\n  font-family: var(--mono-stack, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-weight: 800;\n  font-size: clamp(28px, 5vw, 40px);\n  letter-spacing: -0.02em;\n  line-height: 1;\n}\n.cpol-nf-value.up   { color: #34d399; text-shadow: 0 0 24px rgba(52,211,153,0.45), 0 0 56px rgba(52,211,153,0.18); }\n.cpol-nf-value.dn   { color: #fb7185; text-shadow: 0 0 24px rgba(251,113,133,0.45), 0 0 56px rgba(251,113,133,0.18); }\n.cpol-nf-value.flat { color: #eef2ff; }\n.cpol-nf-trend {\n  font-size: 15px;\n  animation: cpol-drift 2.4s ease-in-out infinite;\n}\n.cpol-nf-value.up ~ .cpol-nf-trend  { color: #34d399; }\n.cpol-nf-value.dn ~ .cpol-nf-trend  { color: #fb7185; }\n@keyframes cpol-drift { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }\n\n.cpol-nf-meta {\n  font-family: var(--mono-stack, ui-monospace, \"JetBrains Mono\", Menlo, monospace);\n  font-size: 11.5px;\n  color: var(--text-muted, #8b93b0);\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px 14px;\n}\n.cpol-nf-meta b { color: var(--text-primary, #eef2ff); font-weight: 650; }\n\n.cpol-nf-pills {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 2px;\n}\n.cpol-chip {\n  font-size: 10px;\n  padding: 3px 9px;\n  border-radius: 999px;\n  border: 1px solid rgba(255,255,255,0.10);\n  background: rgba(255,255,255,0.05);\n  color: var(--text-muted, #8b93b0);\n  white-space: nowrap;\n}\n.cpol-chip b { color: var(--text-primary, #eef2ff); font-weight: 650; }\n.cpol-chip.good { color: #34d399; border-color: rgba(52,211,153,0.32); background: rgba(52,211,153,0.08); }\n.cpol-chip.warn { color: #fbbf24; border-color: rgba(251,191,36,0.32); background: rgba(251,191,36,0.08); }\n.cpol-chip.bad  { color: #fb7185; border-color: rgba(251,113,133,0.32); background: rgba(251,113,133,0.08); }\n.cpol-chip.mono { font-family: var(--mono-stack, ui-monospace, \"JetBrains Mono\", Menlo, monospace); }\n\n/* Honest warm-up / empty state */\n.cpol-empty {\n  font-size: 12px;\n  color: var(--text-faint, #5d6480);\n  line-height: 1.6;\n  padding: 2px 0;\n}\n.cpol-empty b { color: var(--text-muted, #8b93b0); font-weight: 600; }\n\n/* Shimmer skeleton (replaces dead dashboards while data warms) */\n.cpol-skel {\n  position: relative;\n  overflow: hidden;\n  border-radius: 8px;\n  background: rgba(255,255,255,0.05);\n}\n.cpol-skel::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(100deg, transparent 30%, rgba(148,163,255,0.14) 50%, transparent 70%);\n  background-size: 220% 100%;\n  animation: cpol-shim 1.5s ease-in-out infinite;\n}\n@keyframes cpol-shim { 0% { background-position: 130% 0; } 100% { background-position: -90% 0; } }\n\n/* Live pulse dot */\n.cpol-pulse {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: #34d399;\n  box-shadow: 0 0 0 0 rgba(52,211,153,0.7);\n  animation: cpol-ping 2.2s ease-out infinite;\n  display: inline-block;\n  margin-right: 6px;\n}\n@keyframes cpol-ping {\n  0%   { box-shadow: 0 0 0 0 rgba(52,211,153,0.55); }\n  70%  { box-shadow: 0 0 0 8px rgba(52,211,153,0); }\n  100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .cpol-netflow::before, .cpol-skel::after, .cpol-pulse, .cpol-nf-trend { animation: none !important; }\n}\n"},"headersSize":0,"bodySize":1950,"redirectURL":"","_transferSize":1950},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":843.232,"receive":308.133},"_resourceType":"stylesheet","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.237Z","time":10.134,"request":{"method":"GET","url":"https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"cdn.jsdelivr.net"},{"name":":method","value":"GET"},{"name":":path","value":"/npm/driver.js@1.3.1/dist/driver.css"},{"name":":scheme","value":"https"},{"name":"accept","value":"text/css,*/*;q=0.1"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"priority","value":"u=4"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"style"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"cross-site"},{"name":"sec-fetch-storage-access","value":"active"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[],"headersSize":655,"bodySize":0},"response":{"status":200,"statusText":"","httpVersio