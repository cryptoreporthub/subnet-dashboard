me":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:32 GMT"},{"name":"etag","value":"\"9e0d4667bf73797622237c540136ba22\""},{"name":"fly-request-id","value":"01M109DZBYMJM5HY44SXZSCRRD-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=732.0"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":2172,"mimeType":"text/javascript; charset=utf-8","compression":999,"text":"/** §34-1 — one-line ops readiness next to freshness (graded / feed / resolver). */\n(function () {\n  'use strict';\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c];\n    });\n  }\n\n  function render(payload) {\n    var el = document.getElementById('opsReadinessBadge');\n    if (!el) return;\n    payload = payload || {};\n    var ready = payload.ready === true;\n    var status = String(payload.status || '').toLowerCase();\n    var issues = payload.issues || [];\n    var issueCount = issues.length;\n    var thin = payload.thin_ui_likely === true;\n\n    var grade;\n    var stateClass;\n    if (ready && status === 'ready') {\n      grade = 'READY';\n      stateClass = 'ops-readiness--ready';\n    } else if (thin || status === 'warming') {\n      grade = 'WARMING';\n      stateClass = 'ops-readiness--warming';\n    } else {\n      grade = 'DEGRADED';\n      stateClass = 'ops-readiness--degraded';\n    }\n\n    el.hidden = false;\n    el.textContent = grade;\n    el.className = 'ops-readiness-badge ' + stateClass;\n    if (issueCount) {\n      el.title = grade + ' · ' + issueCount + ' issue(s): ' + issues.slice(0, 4).join(', ');\n    } else {\n      el.title = grade + ' · production readiness';\n    }\n  }\n\n  function poll() {\n    var el = document.getElementById('opsReadinessBadge');\n    fetch('/api/ops/readiness', { headers: { Accept: 'application/json' } })\n      .then(function (r) {\n        if (!r.ok) throw new Error(String(r.status));\n        return r.json();\n      })\n      .then(function (payload) {\n        render(payload);\n      })\n      .catch(function () {\n        if (el) {\n          el.hidden = true;\n          el.textContent = '';\n        }\n      });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', poll);\n  } else {\n    poll();\n  }\n  function tick() {\n    if (document.visibilityState === 'hidden') return;\n    poll();\n  }\n  document.addEventListener('visibilitychange', function () {\n    if (document.visibilityState === 'visible') tick();\n  });\n  setInterval(tick, 120000);\n})();\n"},"headersSize":0,"bodySize":1173,"redirectURL":"","_transferSize":1173},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":836.858,"receive":250.073},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.244Z","time":1785.683,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/subnet_integrations.js?v=7b9cae5e","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/subnet_integrations.js?v=7b9cae5e"},{"name":":scheme","value":"https"},{"name":"a