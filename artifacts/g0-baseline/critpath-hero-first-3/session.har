subnet_id\":11,\"name\":\"TrajectoryRL\",\"signal_type\":\"neutral\",\"confidence\":0.5719,\"source_expert\":\"hype\",\"timestamp\":\"2026-08-27T00:12:49.540912Z\",\"evidence\":\"regime=neutral_bullish · 24h=+4.0%\",\"total_score\":52.83,\"price_change_24h\":3.9535,\"dominant_label\":null,\"hot\":{\"active\":false,\"score\":0,\"reasons\":[\"No strong bullish setup\"],\"label\":null},\"sell\":{\"active\":false,\"score\":2,\"reasons\":[\"MACD bearish crossover\"],\"label\":null},\"expert_contributions\":{\"quant\":0.543,\"hype\":0.6095,\"dark_horse\":0.5428,\"technical\":0.25}},\"dedupe_key\":\"signal_11_neutral\",\"subnet_id\":11,\"timestamp\":\"2026-08-27T00:14:14.121228Z\",\"active\":true,\"id\":\"signal_change-2026-08-27T00:14:14.121228Z\"},{\"alert_type\":\"signal_change\",\"severity\":\"info\",\"message\":\"SN9 signal → neutral (quant)\",\"details\":{\"subnet_id\":9,\"name\":\"iota\",\"signal_type\":\"neutral\",\"confidence\":0.5596,\"source_expert\":\"quant\",\"timestamp\":\"2026-08-27T00:12:49.368359Z\",\"evidence\":\"regime=neutral_bullish · 24h=-3.7%\",\"total_score\":46.62,\"price_change_24h\":-3.6812,\"dominant_label\":null,\"hot\":{\"active\":false,\"score\":1,\"reasons\":[\"Strong emission (4.06 TAO/day)\"],\"label\":null},\"sell\":{\"active\":false,\"score\":2,\"reasons\":[\"MACD bearish crossover\"],\"label\":null},\"expert_contributions\":{\"quant\":0.6882,\"hype\":0.5656,\"dark_horse\":0.4436,\"technical\":0.25}},\"dedupe_key\":\"signal_9_neutral\",\"subnet_id\":9,\"timestamp\":\"2026-08-27T00:14:14.048798Z\",\"active\":true,\"id\":\"signal_change-2026-08-27T00:14:14.048798Z\"},{\"alert_type\":\"signal_change\",\"severity\":\"info\",\"message\":\"SN6 signal → neutral (hype)\",\"details\":{\"subnet_id\":6,\"name\":\"Numinous\",\"signal_type\":\"neutral\",\"confidence\":0.5757,\"source_expert\":\"hype\",\"timestamp\":\"2026-08-27T00:12:29.580149Z\",\"evidence\":\"regime=neutral_bullish · 24h=+1.8%\",\"total_score\":50.03,\"price_change_24h\":1.769,\"dominant_label\":null,\"hot\":{\"active\":false,\"score\":0,\"reasons\":[\"No strong bullish setup\"],\"label\":null},\"sell\":{\"active\":false,\"score\":2,\"reasons\":[\"MACD bearish crossover\"],\"label\":null},\"expert_contributions\":{\"quant\":0.4496,\"hype\":0.5856,\"dark_horse\":0.5674,\"technical\":0.25}},\"dedupe_key\":\"signal_6_neutral\",\"subnet_id\":6,\"timestamp\":\"2026-08-27T00:14:13.944683Z\",\"active\":true,\"id\":\"signal_change-2026-08-27T00:14:13.944683Z\"},{\"alert_type\":\"signal_change\",\"severity\":\"info\",\"message\":\"SN5 signal → neutral (quant)\",\"details\":{\"subnet_id\":5,\"name\":\"Hone\",\"signal_type\":\"neutral\",\"confidence\":0.5882,\"source_expert\":\"quant\",\"timestamp\":\"2026-08-27T00:12:23.476427Z\",\"evidence\":\"regime=neutral_bullish · 24h=+0.2%\",\"total_score\":47.58,\"price_change_24h\":0.1637,\"dominant_label\":null,\"hot\":{\"active\":false,\"score\":3,\"reasons\":[\"Oversold convergence (3/7 oscillators)\"],\"label\":null},\"sell\":{\"active\":false,\"score\":2,\"reasons\":[\"MACD bearish crossover\"],\"label\":null},\"expert_contributions\":{\"quant\":0.5062,\"hype\":0.4935,\"dark_horse\":0.4797,\"technical\":0.25}},\"dedupe_key\":\"signal_5_neutral\",\"subnet_id\":5,\"timestamp\":\"2026-08-27T00:14:13.759812Z\",\"active\":true,\"id\":\"signal_change-2026-08-27T00:14:13.759812Z\"},{\"alert_type\":\"signal_change\",\"severity\":\"info\",\"message\":\"SN4 signal → neutral (quant)\",\"details\":{\"subnet_id\":4,\"name\":\"Targon\",\"signal_type\":\"neutral\",\"confidence\":0.5616,\"source_expert\":\"quant\",\"timestamp\":\"2026-08-27T00:12:12.210831Z\",\"evidence\":\"regime=neutral_bullish · 24h=+1.0%\",\"total_score\":52.62,\"price_change_24h\":0.9634,\"dominant_label\":null,\"hot\":{\"active\":false,\"score\":1,\"reasons\":[\"Strong emission (7.47 TAO/day)\"],\"label\":null},\"sell\":{\"active\":false,\"score\":2,\"reasons\":[\"MACD bearish crossover\"],\"label\":null},\"expert_contributions\":{\"quant\":0.6752,\