m; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:32 GMT"},{"name":"etag","value":"\"15eda975e7d115c1f547db304a4882fe\""},{"name":"fly-request-id","value":"01M109DZBZKR2YNKYG7KF8V9D2-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=959.6"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":3324,"mimeType":"text/javascript; charset=utf-8","compression":1840,"text":"/** §21 L4 — trust banner binds /api/learning/stats trust_banner only (RF-2). */\n(function () {\n  \"use strict\";\n\n  window.SimiLearning = window.SimiLearning || { stats: null, trust_banner: null };\n\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n\n  function renderTrustBanner(tb) {\n    var host = document.getElementById(\"home-trust-banner\");\n    if (!host || !tb) return;\n    var ready = !!tb.ready;\n    host.className = \"trust-banner\" + (ready ? \" trust-banner--ready\" : \" trust-banner--blocked\");\n    host.removeAttribute(\"hidden\");\n\n    var html = \"\";\n    if (ready && tb.headline) {\n      html += '<p class=\"trust-banner__headline\">' + esc(tb.headline) + \"</p>\";\n    } else if (tb.message) {\n      html += '<p class=\"trust-banner__message\">' + esc(tb.message) + \"</p>\";\n    } else {\n      html +=\n        '<p class=\"trust-banner__message\">Building graded track record — trust surfaces stay honest until sample clears.</p>';\n    }\n    if (\n      tb.ledger_graded_30d != null &&\n      tb.min_graded != null &&\n      Number(tb.graded) < Number(tb.min_graded)\n    ) {\n      var ledgerLine = \"Measurement ledger (30d): \" + tb.ledger_graded_30d + \" graded\";\n      html += '<p class=\"trust-banner__ledger\">' + esc(ledgerLine) + \"</p>\";\n    }\n    if (tb.note) {\n      html += '<p class=\"trust-banner__note\">' + esc(tb.note) + \"</p>\";\n    }\n    host.innerHTML = html;\n  }\n\n  function cacheStats(stats, tb) {\n    window.SimiLearning.stats = stats || null;\n    window.SimiLearning.trust_banner = tb || null;\n  }\n\n  function applyPayload(payload) {\n    if (!payload) return;\n    var stats = payload.data || payload;\n    var tb = stats.trust_banner;\n    if (!tb && payload.trust_banner) {\n      tb = payload.trust_banner;\n      stats = Object.assign({}, stats, { trust_banner: tb });\n    }\n    if (tb) {\n      cacheStats(stats, tb);\n      renderTrustBanner(tb);\n    }\n  }\n\n  function fetchJson(url) {\n    return fetch(url).then(function (r) {\n      return r.ok ? r.json() : null;\n    });\n  }\n\n  function loadTrustBanner() {\n    if (window.SimiLearning && window.SimiLearning.stats) {\n      applyPayload(window.SimiLearning.stats);\n      return;\n    }\n    fetchJson(\"/api/learning/stats\")\n      .then(function (payload) {\n        if (payload) {\n          applyPayload(payload);\n          return;\n        }\n        return fetchJson(\"/api/learning-metrics\");\n      })\n      .then(function (fallback) {\n        if (fallback) applyPayload(fallback);\n      })\n      .catch(function () {});\n  }\n\n  // Cockpit hydration owns the first learning-stats request. This listener\n  // still covers pages where the cockpit script is intentionally absent.\n  document.addEventListener(\"home:hydrate-cache\", function () {\n    if (window.SimiLearning && window.SimiLearning.stats) applyPayload(window.SimiLearning.stats);\n  });\n  if (!document.documentElement.dataset.hydrate) {\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", loadTrustBanner);\n    } else {\n      loadTrustBanner();\n    }\n  }\n\n  document.addEventListener(\"home:cockpit-tick\", loadTrustBanner);\n\n  window.SimiTrustBanner = { refresh: loadTrustBanner, render: renderTrustBanner };\n})();\n"},"headersSize":0,"bodySize":1484,"redirectURL":"","_transferSize":1484},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1274.55,"receive":236.586},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.244Z","time":1525.7759999999998,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/market_drivers_ui.js?v=7b9cae5e","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/market_drivers_ui.js?v=7b9cae5e"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[{"name":"v","value":"7b9cae5e"}