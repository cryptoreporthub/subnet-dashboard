 212, 124, 0.1);\n  color: var(--mi-green);\n}\n.message-intel--v2 .message-intel__hero {\n  position: relative;\n  overflow: hidden;\n  border: 1px solid rgba(31, 212, 124, 0.28);\n  border-radius: 18px;\n  background:\n    linear-gradient(155deg, rgba(31, 212, 124, 0.12), rgba(63, 201, 255, 0.04) 60%),\n    var(--mi-bg-card);\n  padding: 20px 18px;\n  margin-bottom: 14px;\n  box-shadow: 0 0 60px -30px var(--mi-green-glow);\n}\n.message-intel--v2 .message-intel__hero::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: 0.45;\n  background-image:\n    linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);\n  background-size: 22px 22px;\n  mask-image: radial-gradient(ellipse 100% 100% at 100% 0%, black, transparent 70%);\n}\n.message-intel--v2 .message-intel__hero-eyebrow {\n  position: relative;\n  margin: 0 0 14px;\n  font-family: var(--font-mono, monospace);\n  font-size: 10px;\n  letter-spacing: 0.16em;\n  font-weight: 600;\n  color: var(--mi-green);\n  text-transform: uppercase;\n}\n.message-intel--v2 .message-intel__hero-main {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 12px;\n}\n.message-intel--v2 .message-intel__hero-icon {\n  width: 54px;\n  height: 54px;\n  border-radius: 50%;\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-mono, monospace);\n  font-weight: 800;\n  font-size: 22px;\n  color: #04060e;\n  border: 1px solid rgba(31, 212, 124, 0.45);\n  background:\n    radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--mi-green) 55%, white 20%) 0%, var(--mi-green) 48%, transparent 78%),\n    rgba(31, 212, 124, 0.2);\n  box-shadow: 0 0 24px -6px var(--mi-green-glow), 0 0 14px var(--mi-blue-glow);\n  animation: message-intel-node-beat 3.2s ease-in-out infinite;\n}\n.message-intel--v2 .message