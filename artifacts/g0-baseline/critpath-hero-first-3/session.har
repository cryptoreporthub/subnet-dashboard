cy=\"28\" r=\"3.4\"/>\n        <circle class=\"tribunal-hero__rim\" data-rim-marker=\"echo\" cx=\"42.77\" cy=\"70\" r=\"3.4\"/>\n        <circle class=\"tribunal-hero__rim\" data-rim-marker=\"pulse\" cx=\"197.23\" cy=\"70\" r=\"3.4\"/>\n      </svg>\n      <div class=\"tribunal-hero__ring-center\">\n        <span id=\"k3-orb-score\" class=\"tribunal-hero__pct\" data-gauge-value>—</span>\n        <span class=\"tribunal-hero__pct-label\">VERDICT CONFIDENCE</span>\n        <span class=\"tribunal-hero__consensus-chip\">· CONSENSUS</span>\n        <div class=\"tribunal-hero__verdict-pills\">\n          <span id=\"k3-action-badge\" class=\"tribunal-hero__verdict-label tribunal-hero__verdict-label--gate\">COLD</span>\n          \n          <span id=\"k3-action-hold\" class=\"tribunal-hero__verdict-label tribunal-hero__verdict-label--hold\" hidden></span>\n          \n        </div>\n      </div>\n      </div>\n\n      \n      <article class=\"tribunal-hero__judge tribunal-hero__judge--oracle\" data-judge=\"oracle\">\n        <span class=\"tribunal-hero__orbit\" aria-hidden=\"true\"></span>\n        <div class=\"tribunal-hero__judge-head\">\n          <span class=\"tribunal-hero__judge-signal-wrap\">\n            <span class=\"tribunal-hero__judge-signal-caption\">SIGNAL</span>\n            <span class=\"tribunal-hero__judge-signal\" data-judge-signal>—</span>\n          </span>\n          <span class=\"tribunal-hero__judge-weight\" data-judge-weight>—</span>\n        </div>\n        <h3 class=\"tribunal-hero__judge-name\">ORACLE</h3>\n        <span class=\"tribunal-hero__dissent\" data-dissent hidden aria-hidden=\"true\">∆ dissent</span>\n        <div class=\"tribunal-hero__last5\" data-last5 hidden>\n          <span class=\"tribunal-hero__last5-caption\">LAST 5</span>\n          <div class=\"tribunal-hero__last5-ticks\" aria-hidden=\"true\">\n            \n          </div>\n        </div>\n      </article>\n      \n      <article class=\"tribunal-hero__judge tribunal-hero__judge--echo\" data-judge=\"echo\">\n        <span class=\"tribunal-hero__orbit\" aria-hidden=\"true\"></span>\n        <div class=\"tribunal-hero__judge-head\">\n          <span class=\"tribunal-hero__judge-signal-wrap\">\n            <span class=\"tribunal-hero__judge-signal-caption\">SIGNAL</span>\n            <span class=\"tribunal-hero__judge-signal\" data-judge-signal>—</span>\n          </span>\n          <span class=\"tribunal-hero__judge-weight\" data-judge-weight>—</span>\n        </div>\n        <h3 class=\"tribunal-hero__judge-name\">ECHO</h3>\n        <span class=\"tribunal-hero__dissent\" data-dissent hidden aria-hidden=\"true\">∆ dissent</span>\n        <div class=\"tribunal-hero__last5\" data-last5 hidden>\n          <span class=\"tribunal-hero__last5-caption\">LAST 5</span>\n          <div class=\"tribunal-hero__last5-ticks\" aria-hidden=\"true\">\n            \n          </div>\n        </div>\n      </article>\n      \n      <article class=\"tribunal-hero__judge tribunal-hero__judge--pulse\" data-judge=\"pulse\">\n        <span class=\"tribunal-hero__orbit\" aria-hidden=\"true\"></span>\n        <div class=\"tribunal-hero__judge-head\">\n          <span class=\"tribunal-hero__judge-signal-wrap\">\n            <span class=\"tribunal-hero__judge-signal-caption\">SIGNAL</span>\n            <span class=\"tribunal-hero__judge-signal\" data-judge-signal>—</span>\n          </span>\n          <span class=\"tribunal-hero__judge-weight\" data-judge-weight>—</span>\n        </div>\n        <h3 class=\"tribunal-hero__judge-name\">PULSE</h3>\n        <span class=\"tribunal-hero__dissent\" data-dissent hidden aria-hidden=\"true\">∆ dissent</span>\n        <div class=\"tribunal-hero__last5\" data-last5 hidden>\n          <span class=\"tribunal-hero__last5-caption\">LAST 5</span>\n          <div class=\"tribunal-hero__last5-ticks\" aria-hidden=\"true\">\n            \n          </div>\n        </div>\n      </article>\n      \n    </div>\n  </div>\n\n  <div class=\"tribunal-hero__instrument\" data-instrument aria-label=\"Council instrument readout\">\n    <style>\n      .tribunal-hero__instrument { display: grid; grid-template-columns: 1fr 1fr 2.2fr; gap: 8px; margin-top: 12px; }\n      .tribunal-hero__instrument-head { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; padding: 0 2px; }\n      .tribunal-hero__instrument-title { font-size: 8px; letter-spacing: .16em; color: rgba(255,255,255,.5); text-transform: uppercase; }\n      .tribunal-hero__instrument-sync { font-size: 8px; letter-spacing: .12em; color: #7fe8e6; display: inline-flex; gap: 4px; align-items: center; }\n      .tribunal-hero__instrument-sync::before { content: \"\"; width: 5px; height: 5px; border-radius: 50%; background: #7fe8e6; box-shadow: 0 0 6px #7fe8e6; }\n      .tribunal-hero__cell--primary { display: flex; flex-direction: column; justify-content: center; gap: 5px; padding: 10px 12px; }\n      .tribunal-hero__cell--primary .tribunal-hero__cell-value { font-size: 18px; }\n      .tribunal-hero__cell-meter { display: block; height: 3px; border-radius: 999px; background: rgba(255,255,255,.1); overflow: hidden; }\n      .tribunal-hero__cell-meter i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2fd18a, #7dffb0); transition: width .6s cubic-bezier(.4,0,.2,1); }\n      .tribunal-hero__instrument-main { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }\n      .tribunal-hero__variance { grid-column: 1 / -1; display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; border: 1px solid rgba(120,205,225,.3); background: transparent; }\n      .tribunal-hero__variance-label { flex: none; font-size: 7.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.5); }\n      .tribunal-hero__variance-track { flex: 1; height: 5px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }\n      .tribunal-hero__variance-fill { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, rgba(74,232,152,.75), rgba(46,230,228,.95)); box-shadow: 0 0 8px rgba(46,230,228,.5); transition: width .6s cubic-bezier(.4,0,.2,1); }\n      .tribunal-hero__variance-value { flex: none; font-size: 9px; font-weight: 800; color: #7fe8e6; font-variant-numeric: tabular-nums; }\n      @keyframes cgInstrFlash { 0% { color: #7dffb0; text-shadow: 0 0 10px rgba(125,255,176,.55); } 100% { color: inherit; text-shadow: none; } }\n      .tribunal-hero__cell-value.flash { animation: cgInstrFlash .8s ease-out; }\n      @media (max-width: 720px) { .tribunal-hero__instrument { grid-template-columns: 1fr 1fr; } .tribunal-hero__instrument-main { grid-column: 1 / -1; grid-template-columns: repeat(2, 1fr); } }\n      @media (prefers-reduced-motion: reduce) { .tribunal-hero__cell-meter i, .tribunal-hero__variance-fill { transition: none; } }\n    </style>\n    <div class=\"tribunal-hero__instrument-head\">\n      <span class=\"tribunal-hero__instrument-title\">Council Instrument</span>\n      <span class=\"tribunal-hero__instrument-sync\">live</span>\n    </div>\n    <div class=\"tribunal-hero__cell tribunal-hero__cell--primary\">\n      <span class=\"tribunal-hero__cell-label\">AVG ACC</span>\n      <span class=\"tribunal-hero__cell-value\" data-metric=\"avg-acc\">—</span>\n      <span class=\"tribunal-hero__cell-meter\" aria-hidden=\"true\"><i style=\"width:0.0%\"></i></span>\n    </div>\n    <div class=\"tribunal-hero__cell tribunal-hero__cell--primary\">\n      <span class=\"tribunal-hero__cell-label\">WIN RATE</span>\n      <span class=\"tribunal-hero__cell-value\" data-metric=\"win-rate\">—</span>\n      <span class=\"tribunal-hero__cell-meter\" aria-hidden=\"true\"><i style=\"width:0.0%\"></i></span>\n    </div>\n    <div class=\"tribunal-hero__instrument-main\">\n      <div class=\"tribunal-hero__cell\"><span class=\"tribunal-hero__cell-label\">SIGNAL</span><span class=\"tribunal-hero__cell-value\" data-metric=\"signal\">·</span></div>\n      <div class=\"tribunal-hero__cell\"><span class=\"tribunal-hero__cell-label\">RSI</span><span class=\"tribunal-hero__cell-value\" data-metric=\"rsi\">—</span></div>\n      <div class=\"tribunal-hero__cell\"><span class=\"tribunal-hero__cell-label\">STOCH</span><span class=\"tribunal-hero__cell-value\" data-metric=\"stoch\">—</span></div>\n      <div class=\"tribunal-hero__cell\"><span class=\"tribunal-hero__cell-label\">7D</span><span class=\"tribunal-hero__cell-value\" data-metric=\"d7\">—</span></div>\n    </div>\n    <div class=\"tribunal-hero__variance\">\n      <span class=\"tribunal-hero__variance-label\">Variance floor</span>\n      <span class=\"tribunal-hero__variance-track\"><i class=\"tribunal-hero__variance-fill\" style=\"width:0.0%\"></i></span>\n      <span class=\"tribunal-hero__variance-value\">—</span>\n    </div>\n  </div>\n  <p id=\"k3-call-headline\" class=\"tribunal-hero__sr-only\">COLD</p>\n\n  <div class=\"tribunal-hero__feed\" data-feed aria-hidden=\"true\">\n    <span class=\"tribunal-hero__feed-tick\"></span><span class=\"tribunal-hero__feed-tick\"></span><span class=\"tribunal-hero__feed-tick\"></span><span class=\"tribunal-hero__feed-tick\"></span><span class=\"tribunal-hero__feed-tick tribunal-hero__feed-tick--hot\"></span>\n    <span class=\"tribunal-hero__feed-label\">SIGNAL FEED · LATEST</span>\n  </div>\n\n  <footer class=\"tribunal-hero__panels\">\n    \n    <div class=\"tribunal-hero__panel\" data-panel=\"decision-log\">\n      <h4 class=\"tribunal-hero__panel-title\">Decision log</h4>\n      <dl class=\"tribunal-hero__panel-grid\">\n        <div><dt>Verdict</dt><dd data-decision-verdict>COLD</dd></div>\n        <div><dt>Confidence</dt><dd data-decision-confidence>—</dd></div>\n        <div><dt>Consensus</dt><dd data-decision-consensus>—</dd></div>\n        <div><dt>Brain</dt><dd data-decision-brain>—</dd></div>\n        <div class=\"tribunal-hero__panel-span\"><dt>Dissent</dt><dd data-decision-dissent>—</dd></div>\n      </dl>\n    </div>\n    \n    <div class=\"tribunal-hero__panel\" data-panel=\"accuracy-ledger\">\n      <h4 class=\"tribunal-hero__panel-title\">Council accuracy</h4>\n      <p class=\"tribunal-hero__panel-stat\" data-accuracy-win-rate>—</p>\n      <p class=\"tribunal-hero__panel-sub\" data-accuracy-sub>Building sample</p>\n      <p class=\"tribunal-hero__panel-meta\">\n        <span data-accuracy-graded>0</span> graded ·\n        <span data-accuracy-correct>0</span> hit ·\n        <span data-accuracy-wrong>0</span> miss\n      </p>\n      <div class=\"tribunal-hero__last5 tribunal-hero__panel-last5\" data-council-last5 hidden>\n        <span class=\"tribunal-hero__last5-caption\">LAST 5</span>\n        <div class=\"tribunal-hero__last5-ticks\" aria-hidden=\"true\">\n          \n        </div>\n      </div>\n    </div>\n    \n    <div class=\"tribunal-hero__panel\" data-panel=\"jury-move\">\n      <h4 class=\"tribunal-hero__panel-title\">Jury · last grading move</h4>\n      <ul class=\"tribunal-hero__jury-list\">\n        \n        <li class=\"tribunal-hero__jury-row\" data-jury=\"oracle\">\n          <span class=\"tribunal-hero__jury-name\">ORACLE</span>\n          <span class=\"tribunal-hero__jury-arrow\" data-jury-arrow data-arrow=\"·\">·</span>\n          <span class=\"tribunal-hero__jury-delta\" data-jury-delta>—</span>\n        </li>\n        \n        <li class=\"tribunal-hero__jury-row\" data-jury=\"echo\">\n          <span class=\"tribunal-hero__jury-name\">ECHO</span>\n          <span class=\"tribunal-hero__jury-arrow\" data-jury-arrow data-arrow=\"·\">·</span>\n          <span class=\"tribunal-hero__jury-delta\" data-jury-delta>—</span>\n        </li>\n        \n        <li class=\"tribunal-hero__jury-row\" data-jury=\"pulse\">\n          <span class=\"tribunal-hero__jury-name\">PULSE</span>\n          <span class=\"tribunal-hero__jury-arrow\" data-jury-arrow data-arrow=\"·\">·</span>\n          <span class=\"tribunal-hero__jury-delta\" data-jury-delta>—</span>\n        </li>\n        \n      </ul>\n    </div>\n    <div class=\"tribunal-hero__metric\" data-metric=\"alignment\" hidden aria-hidden=\"true\"></div>\n  </footer>\n\n  <p class=\"tribunal-hero__sync\" id=\"tribunal-hero-sync\" role=\"status\" aria-live=\"polite\" hidden></p>\n</section>\n<script>\n(function () {\n  var hero = document.getElementById('tribunal-hero');\n  if (!hero) return;\n  var EYE_CX = 120, EYE_CY = 70, EYE_RX = 77.23, EYE_RY = 42;\n  function placeOnPath(el, path, frac) {\n    if (!el) return;\n    if (path && path.getTotalLength) {\n      var len = path.getTotalLength();\n      if (len) {\n        var t = ((frac % 1) + 1) % 1;\n        var pt = path.getPointAtLength(t * len);\n        el.setAttribute('cx', pt.x.toFixed(2));\n        el.setAttribute('cy', pt.y.toFixed(2));\n        return;\n      }\n    }\n    var a = frac * Math.PI * 2 - Math.PI / 2;\n    el.setAttribute('cx', (EYE_CX + EYE_RX * Math.cos(a)).toFixed(2));\n    el.setAttribute('cy', (EYE_CY + EYE_RY * Math.sin(a)).toFixed(2));\n  }\n  function setArc(el, start, frac) {\n    if (!el) return;\n    var len = Math.max(0, Math.min(100, frac * 100));\n    el.setAttribute('stroke-dasharray', len.toFixed(1) + ' ' + (100 - len).toFixed(1));\n    el.setAttribute('stroke-dashoffset', (-start * 100).toFixed(1));\n  }\n  function hydateRing(weights) {\n    var outer = hero.querySelector('[data-eye-path]');\n    var inner = hero.querySelector('[data-conviction-arc]');\n    var p = parseFloat(hero.getAttribute('data-hero-conviction'));\n    if (inner && isFinite(p)) {\n      var c = Math.max(0, Math.min(100, p));\n      inner.setAttribute('stroke-dasharray', c.toFixed(1) + ' ' + (100 - c).toFixed(1));\n    }\n    var present = weights && [weights.oracle, weights.echo, weights.pulse].every(function (x) { return typeof x === 'number' && isFinite(x); });\n    if (!present) { hero.classList.add('tribunal-hero--consensus'); placeOnPath(hero.querySelector('[data-comet]'), inner || outer, 0.25); return; }\n    var total = weights.oracle + weights.echo + weights.pulse;\n    var fracs = ['oracle', 'echo', 'pulse'].map(function (k) { return weights[k] / total; });\n    var maxF = Math.max.apply(null, fracs);\n    if (maxF - Math.min.apply(null, fracs) < 0.02) {\n      hero.classList.add('tribunal-hero--consensus');\n      placeOnPath(hero.querySelector('[data-comet]'), inner || outer, 0.25);\n      return;\n    }\n    hero.classList.remove('tribunal-hero--consensus');\n    var started = 0;\n    ['oracle', 'echo', 'pulse'].forEach(function (k, i) {\n      var f = fracs[i];\n      setArc(hero.querySelector('[data-judge-arc=\"' + k + '\"]'), started, f);\n      placeOnPath(hero.querySelector('[data-rim-marker=\"' + k + '\"]'), outer, started + f / 2);\n      started += f;\n      var badge = hero.querySelector('[data-judge=\"' + k + '\"] [data-dissent]');\n      if (badge) badge.hidden = Math.abs(f - maxF) < 0.001;\n    });\n    placeOnPath(hero.querySelector('[data-comet]'), inner || outer, Math.min(0.99, (p || 0) / 100));\n    hero.setAttribute('data-consensus-delta', ((maxF - 1/3) * 100).toFixed(1) + '%');\n  }\n  function parseWeights() {\n    var raw = hero.getAttribute('data-weights');\n    if (!raw) return null;\n    var parts = raw.trim().split(/\\s+/).map(Number);\n    if (parts.length !== 3 || parts.some(function (x) { return !isFinite(x); })) return null;\n    return { oracle: parts[0], echo: parts[1], pulse: parts[2] };\n  }\n  function hydateMetrics(stats) {\n    if (!stats) return;\n    function setM(k, v, arrow) {\n      var el = hero.querySelector('[data-metric=\"' + k + '\"]');\n      if (el && v !== null && v !== undefined && v !== '') {\n        el.textContent = v;\n        if (arrow) el.setAttribute('data-arrow', arrow);\n        else el.removeAttribute('data-arrow');\n      }\n    }\n    function setMeter(k, pct) {\n      var el = hero.querySelector('[data-metric=\"' + k + '\"]');\n      var bar = el && el.parentNode && el.parentNode.querySelector('.tribunal-hero__cell-meter i');\n      if (bar && typeof pct === 'number' && isFinite(pct)) bar.style.width = Math.max(0, Math.min(100, pct)) + '%';\n    }\n    var tb = stats.trust_banner || {};\n    var graded = Number(tb.graded != null ? tb.graded : stats.graded) || 0;\n    var correct = Number(tb.correct != null ? tb.correct : stats.correct) || 0;\n    var wrong = Number(tb.wrong != null ? tb.wrong : stats.wrong) || 0;\n    var acc = null;\n    if (tb.ready && tb.accuracy != null && !isNaN(Number(tb.accuracy))) acc = Number(tb.accuracy) * 100;\n    else if (graded > 0 && correct + wrong > 0) acc = (correct / (correct + wrong)) * 100;\n    if (acc != null) {\n      var accTxt = Math.abs(acc - Math.round(acc)) < 0.05 ? Math.round(acc) + '%' : (Math.round(acc * 10) / 10) + '%';\n      setM('avg-acc', accTxt, acc >= 50 ? 'up' : 'down');\n      setM('win-rate', accTxt, acc >= 50 ? 'up' : 'down');\n      setMeter('avg-acc', acc);\n      setMeter('win-rate', acc);\n    }\n    var dw = stats.judge_weight_deltas;\n    if (dw) {\n      var signed = ['oracle', 'echo', 'pulse'].reduce(function (s, k) { return s + (typeof dw[k] === 'number' ? dw[k] : 0); }, 0);\n      if (Math.abs(signed) >= 0.0005) setM('signal', (signed >= 0 ? '+' : '') + signed.toFixed(2), signed >= 0 ? 'up' : 'down');\n    }\n    var r = stats.rsi, st = stats.stoch, d7 = stats.last7;\n    if (typeof r === 'number') setM('rsi', Math.round(r).toFixed(0), r >= 50 ? 'up' : 'down');\n    if (typeof st === 'number') setM('stoch', Math.round(st).toFixed(0), st >= 50 ? 'up' : 'down');\n    if (typeof d7 === 'number') setM('d7', (d7 >= 0 ? '+' : '') + d7.toFixed(1) + '%', d7 >= 0 ? 'up' : 'down');\n  }\n  function boot() {\n    hydateRing(parseWeights());\n    if (document.documentElement.dataset.hydrate === '0') return;\n    if (document.documentElement.dataset.hydrate === '1') return;\n    try {\n      fetch('/api/learning/stats', { headers: { 'Accept': 'application/json' } })\n        .then(function (r) { return r.ok ? r.json() : null; })\n        .then(function (d) {\n          if (!d) return;\n          var s = d.data || d;\n          hydateRing(s.judge_weights);\n          hydateMetrics(s);\n        })\n        .catch(function () {});\n    } catch (e) {}\n  }\n  boot();\n})();\ndocument.body && document.body.setAttribute('data-council-temp','cool');\n</script>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"home-job__cta\" role=\"group\" aria-label=\"Primary actions\" style=\"margin-top: 16px;\">\n        <button\n          type=\"button\"\n          class=\"home-cta home-cta--primary\"\n          id=\"habit-pin-btn\"\n        >Pin to watchlist</button>\n        <a class=\"home-cta home-cta--ghost\" href=\"#section-proof-band\">View proof</a>\n      </div>\n      <a id=\"hour-watch-now\" class=\"hour-watch-now hour-watch-now--building\" href=\"#\" aria-live=\"polite\">Hour watch loading…</a>\n      <p id=\"hour-watch-shift\" class=\"hour-watch-shift\" hidden aria-live=\"polite\"></p>\n    </div>\n  </div>\n</section>\n\n\n\n\n<section class=\"sr-pulse-ribbon desk-zone\" id=\"section-market-pulse\" aria-label=\"Market pulse and integrations\">\n  <div class=\"sr-pulse sr-pulse--compact sr-pulse--oneline hydrate-skel\">\n    <p class=\"sr-pulse__oneline skel-only\" role=\"status\" aria-hidden=\"true\">\n      <span class=\"skel skel-md\" style=\"width:72%;max-width:320px\"></span>\n    </p>\n    <p class=\"sr-pulse__oneline live-only\" role=\"status\">\n      <span class=\"sr-pulse__breadth-wrap\">\n        <span class=\"sr-pulse__breadth-halo\" aria-hidden=\"true\"></span>\n        <span class=\"sr-pulse__oneline-part sr-pulse__oneline-part--neutral\" id=\"market-pulse-breadth\">\n          Breadth Neutral · —\n        </span>\n      </span>\n      \n      <span class=\"sr-pulse__oneline-sep\" aria-hidden=\"true\">·</span>\n      <span class=\"sr-pulse__oneline-part\" id=\"market-pulse-avg\">\n        Avg 24h —\n      </span>\n      <span class=\"sr-pulse__oneline-sep\" aria-hidden=\"true\">·</span>\n      \n      <span class=\"sr-pulse__ticker sr-pulse__ticker--empty\" id=\"registry-ticker\">Registry empty — waiting on live subnet data.</span>\n      \n    </p>\n  </div>\n  <div class=\"subnet-integrations-bar\" id=\"subnetIntegrationsBar\" aria-label=\"Bittensor subnet integrations\">\n    <div class=\"subnet-integrations-bar__inner\" id=\"subnetIntegrationsBarInner\">\n      \n    </div>\n  </div>\n</section>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<section class=\"pds pds--polish desk-zone wrap-pad\" id=\"section-pump-alert\" aria-labelledby=\"pds-title\" data-home-live=\"1\" data-pump-compact=\"1\" data-pump-scan=\"1\" data-pump-polish=\"1\">\n  <div class=\"pds-atmosphere\" aria-hidden=\"true\"></div>\n\n  <header class=\"pds-head\">\n    <div class=\"pds-head__row\">\n      <h2 class=\"pds-title\" id=\"pds-title\">Pump desk<span class=\"pds-live\" aria-hidden=\"true\"></span></h2>\n      <a class=\"pds-full-desk\" href=\"/pump\">Open full desk →</a>\n    </div>\n    <div class=\"pds-proof\" id=\"pd-meta-wrap\">\n      \n      <p class=\"pds-proof__line pds-proof__line--building\" id=\"pump-alert-trust\">Early alerts: grading starts once lead phase entries resolve (1h).</p>\n      \n      <div class=\"pds-census\" id=\"pd-census\" aria-label=\"Desk census\">\n        <span class=\"pds-census__chip pds-census__chip--lead\"><b id=\"pd-census-lead\">0</b> lead</span>\n        <span class=\"pds-census__chip pds-census__chip--live\"><b id=\"pd-census-live\">0</b> live</span>\n        <span class=\"pds-census__chip pds-census__chip--exit\"><b id=\"pd-census-exit\">0</b> exit</span>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"pds-body\" id=\"pump-alert-body\">\n    <div class=\"pds-desk hydrate-skel\" id=\"pump-desk-panel\">\n      <div class=\"pds-desk__skel skel-only\" aria-hidden=\"true\">\n        <div class=\"pds-skel-hero skel skel-kpi\"></div>\n        <div class=\"pds-skel-row skel skel-md\"></div>\n        <div class=\"pds-skel-row skel skel-md\"></div>\n      </div>\n      <div class=\"pds-desk__live live-only\">\n      \n      <p class=\"pds-empty desk-empty pump-desk__empty\">Quiet — no warming or active names on the ladder right now.</p>\n      \n      </div>\n    </div>\n    <script type=\"application/json\" id=\"pump-map-data\">[]</script>\n  </div>\n</section>\n\n</div>\n\n\n<!-- SS-TG — Subnet Summers Telegram pulse (mobile-first cosmic glass desk) -->\n\n\n\n\n\n\n\n<section class=\"row wrap-pad desk-zone\" id=\"section-message-intel\" aria-labelledby=\"message-intel-title\" data-home-live>\n<div class=\"message-intel message-intel--v2 message-intel--home-compact\" data-pulse-mode=\"listen\">\n\n  <div class=\"message-intel__heartbeat\" id=\"message-intel-heartbeat\" data-mode=\"warming\" aria-live=\"polite\" style=\"display: none;\">\n    <svg class=\"message-intel__ekg\" viewBox=\"0 0 120 26\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n      <path id=\"message-intel-ekg\" d=\"M0,13 L18,13 L22,10 L26,16 L30,13 L58,13 L62,10 L66,16 L70,13 L98,13 L102,10 L106,16 L110,13 L120,13\"></path>\n    </svg>\n    <span class=\"message-intel__hb-mode\" id=\"message-intel-hb-mode\">WARMING</span>\n    <span class=\"message-intel__hb-last\" id=\"message-intel-hb-last\">awaiting first beat</span>\n    <span class=\"message-intel__hb-cal\" id=\"message-intel-hb-cal\">cal …</span>\n  </div>\n\n  <div class=\"message-intel__masthead\" style=\"display: none;\">\n    <div class=\"message-intel__instrument\">\n      <div class=\"message-intel__pulsar\" aria-hidden=\"true\">\n        <span class=\"message-intel__ping\"></span>\n        <span class=\"message-intel__ping\"></span>\n        <span class=\"message-intel__ping\"></span>\n        <span class=\"message-intel__core\"><i></i><i></i><i></i><i></i><i></i><i></i></span>\n      </div>\n      <div class=\"message-intel__identity\">\n        <div class=\"message-intel__source-strip\" id=\"message-intel-source-strip\" aria-live=\"polite\">\n          <span class=\"message-intel__brand\">SUBNET SUMMERS · <em>SIMIVISION</em></span>\n          <span class=\"message-intel__live-tag\" id=\"message-intel-live-tag\" hidden>Live</span>\n          <span id=\"message-intel-meta\">Desk warming — first beat lands with the listener.</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n\n\n<div class=\"message-intel__visualizer-card\" id=\"message-intel-trending-card\">\n  <div class=\"message-intel__vis-top-row\">\n    \n    <a class=\"message-intel__vis-full-desk-btn\" href=\"/subnetsummer\" title=\"Open full listener\">\n      <span>OPEN FULL DESK</span>\n      <span class=\"message-intel__vis-full-desk-arrow\">↗</span>\n    </a>\n    \n    <div class=\"message-intel__vis-top-pill\">\n      <span class=\"message-intel__vis-tg-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .37z\"/></svg>\n      </span>\n      <span class=\"message-intel__vis-handle\">@officialSubnetSummer</span>\n      <span class=\"message-intel__vis-members\"><i class=\"message-intel__vis-pulse-dot\" aria-hidden=\"true\"></i> 3.7K</span>\n    </div>\n  </div>\n\n  <div class=\"message-intel__visualizer-header\">\n    <span class=\"message-intel__vis-glow-label\">COSMIC RESONANCE CORE</span>\n    <span class=\"message-intel__vis-glow-sub\">TRENDING ORBIT · 1H</span>\n  </div>\n\n  <div id=\"message-intel-sky\" class=\"message-intel__sky\" data-empty=\"false\" aria-label=\"Cosmic Resonance Core visualizer\">\n    <div class=\"message-intel__sky-starfield\" aria-hidden=\"true\"></div>\n    <div class=\"message-intel__sky-bg-moon message-intel__sky-bg-moon--1\" aria-hidden=\"true\"></div>\n    <div class=\"message-intel__sky-bg-moon message-intel__sky-bg-moon--2\" aria-hidden=\"true\"></div>\n    <div class=\"message-intel__sky-core-glow\" aria-hidden=\"true\"></div>\n    <div class=\"message-intel__sky-plasma-ring message-intel__sky-plasma-ring--1\" aria-hidden=\"true\"></div>\n    <div class=\"message-intel__sky-plasma-ring message-intel__sky-plasma-ring--2\" aria-hidden=\"true\"></div>\n    <svg class=\"message-intel__sky-tracks\" viewBox=\"0 0 380 280\" aria-hidden=\"true\">\n      <defs>\n        <radialGradient id=\"mi-core-glow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n          <stop offset=\"0%\" stop-color=\"#ffffff\" stop-opacity=\"1\" />\n          <stop offset=\"22%\" stop-color=\"#38bdf8\" stop-opacity=\"0.95\" />\n          <stop offset=\"52%\" stop-color=\"#818cf8\" stop-opacity=\"0.65\" />\n          <stop offset=\"80%\" stop-color=\"#1e1b4b\" stop-opacity=\"0.25\" />\n          <stop offset=\"100%\" stop-color=\"#050714\" stop-opacity=\"0\" />\n        </radialGradient>\n        <linearGradient id=\"mi-orbit-main\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#38bdf8\" stop-opacity=\"0.95\" />\n          <stop offset=\"35%\" stop-color=\"#818cf8\" stop-opacity=\"0.85\" />\n          <stop offset=\"70%\" stop-color=\"#a855f7\" stop-opacity=\"0.9\" />\n          <stop offset=\"100%\" stop-color=\"#10b981\" stop-opacity=\"0.95\" />\n        </linearGradient>\n        <linearGradient id=\"mi-orbit-sec\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#c084fc\" stop-opacity=\"0.9\" />\n          <stop offset=\"45%\" stop-color=\"#38bdf8\" stop-opacity=\"0.5\" />\n          <stop offset=\"100%\" stop-color=\"#06b6d4\" stop-opacity=\"0.85\" />\n        </linearGradient>\n        <filter id=\"mi-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n          <feMerge>\n            <feMergeNode in=\"blur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n      </defs>\n      <ellipse class=\"message-intel__sky-track message-intel__sky-track--glow message-intel__sky-track--3d-main\" cx=\"190\" cy=\"140\" rx=\"162\" ry=\"46\" transform=\"rotate(-18 190 140)\" stroke=\"url(#mi-orbit-main)\" filter=\"url(#mi-glow)\" stroke-width=\"3.5\" opacity=\"0.95\"></ellipse>\n      <ellipse class=\"message-intel__sky-track message-intel__sky-track--line message-intel__sky-track--3d-main\" cx=\"190\" cy=\"140\" rx=\"162\" ry=\"46\" transform=\"rotate(-18 190 140)\" stroke=\"url(#mi-orbit-main)\" stroke-width=\"2\" stroke-dasharray=\"14 5 3 5\"></ellipse>\n      <ellipse class=\"message-intel__sky-track message-intel__sky-track--glow message-intel__sky-track--3d-sec\" cx=\"190\" cy=\"140\" rx=\"138\" ry=\"38\" transform=\"rotate(22 190 140)\" stroke=\"url(#mi-orbit-sec)\" filter=\"url(#mi-glow)\" stroke-width=\"2.8\" opacity=\"0.88\"></ellipse>\n      <ellipse class=\"message-intel__sky-track message-intel__sky-track--line message-intel__sky-track--3d-sec\" cx=\"190\" cy=\"140\" rx=\"138\" ry=\"38\" transform=\"rotate(22 190 140)\" stroke=\"url(#mi-orbit-sec)\" stroke-width=\"1.6\" stroke-dasharray=\"8 4\"></ellipse>\n      <ellipse class=\"message-intel__sky-track message-intel__sky-track--equator\" cx=\"190\" cy=\"140\" rx=\"80\" ry=\"80\" stroke=\"rgba(56, 189, 248, 0.35)\" stroke-dasharray=\"3 5\"></ellipse>\n    </svg>\n    <div class=\"message-intel__sky-hub\" aria-hidden=\"true\">\n      <div class=\"message-intel__sky-hub-core\"></div>\n      <div class=\"message-intel__sky-hub-filaments\"></div>\n      <div class=\"message-intel__sky-hub-starburst\"></div>\n      <div class=\"message-intel__sky-hub-plasma\"></div>\n    </div>\n  </div>\n  <p class=\"message-intel__sky-legend\"><span>closer = higher rank</span><span>bigger = higher rank</span><span>color = sentiment</span></p>\n</div>\n\n  <div class=\"message-intel__loop\" role=\"tablist\" aria-label=\"Listen Learn Rank Serve folders\">\n    <button type=\"button\" role=\"tab\" id=\"pulse-tab-listen\" data-beat=\"listen\" data-pulse-mode=\"listen\" aria-controls=\"message-intel-pane-listen\" aria-selected=\"true\" tabindex=\"0\">\n      <span class=\"message-intel__tab-icon message-intel__tab-icon--listen\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg>\n      </span>\n      <b>LISTEN</b><span>Signal Feed</span>\n    </button>\n    <button type=\"button\" role=\"tab\" id=\"pulse-tab-learn\" data-beat=\"learn\" data-pulse-mode=\"learn\" aria-controls=\"message-intel-pane-learn\" aria-selected=\"false\" tabindex=\"-1\">\n      <span class=\"message-intel__tab-icon message-intel__tab-icon--learn\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04z\"/><path d=\"M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04z\"/></svg>\n      </span>\n      <b>LEARN</b><span>Caller Tactics</span>\n    </button>\n    <button type=\"button\" role=\"tab\" id=\"pulse-tab-rank\" data-beat=\"rank\" data-pulse-mode=\"rank\" aria-controls=\"message-intel-pane-rank\" aria-selected=\"false\" tabindex=\"-1\">\n      <span class=\"message-intel__tab-icon message-intel__tab-icon--rank\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3.5\"/><ellipse cx=\"12\" cy=\"12\" rx=\"9.5\" ry=\"3.5\" transform=\"rotate(-30 12 12)\"/><ellipse cx=\"12\" cy=\"12\" rx=\"9.5\" ry=\"3.5\" transform=\"rotate(30 12 12)\"/></svg>\n      </span>\n      <b>RANK</b><span>Champion Ranks</span>\n    </button>\n    <button type=\"button\" role=\"tab\" id=\"pulse-tab-serve\" data-beat=\"serve\" data-pulse-mode=\"serve\" aria-controls=\"message-intel-pane-serve\" aria-selected=\"false\" tabindex=\"-1\">\n      <span class=\"message-intel__tab-icon message-intel__tab-icon--serve\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v8\"/><path d=\"m4.93 10.93 1.41 1.41\"/><path d=\"M2 18h2\"/><path d=\"M20 18h2\"/><path d=\"m19.07 10.93-1.41 1.41\"/><path d=\"M22 22H2\"/><path d=\"m8 22 4-10 4 10\"/></svg>\n      </span>\n      <b>SERVE</b><span>Chat &amp; Bot</span>\n    </button>\n  </div>\n\n  <div class=\"message-intel__bay\">\n\n    <!-- ── TAB 1: LISTEN (Signal Decoder Feed & Proof & Divergence) ── -->\n    <div class=\"message-intel__mode\" data-pulse-pane=\"listen\" role=\"tabpanel\" id=\"message-intel-pane-listen\" aria-labelledby=\"pulse-tab-listen\">\n      \n      <!-- 24-Hour Recap & Stats at a Glance (Top of Listen) -->\n      <div class=\"message-intel__tile message-intel__tile--recap\">\n        <div class=\"message-intel__summary-24h glass-card\" id=\"message-intel-summary-24h\" aria-live=\"polite\">\n          <div class=\"message-intel__summary-24h-top\">\n            <p class=\"message-intel__summary-24h-label\">Yesterday in summary</p>\n            <span class=\"message-intel__summary-24h-when\">24h lens</span>\n          </div>\n          <div class=\"message-intel__summary-24h-body\" id=\"message-intel-summary-24h-body\">\n            <p class=\"message-intel__summary-24h-narrative\">No 24-hour summary yet — the listener needs a full day of qualifying traffic before it publishes a recap.</p>\n            <div class=\"message-intel__summary-24h-stats\">\n              <div class=\"message-intel__summary-24h-stat\"><div class=\"message-intel__summary-24h-stat-v\">—</div><div class=\"message-intel__summary-24h-stat-l\">GRADED</div></div>\n              <div class=\"message-intel__summary-24h-stat\"><div class=\"message-intel__summary-24h-stat-v\">—</div><div class=\"message-intel__summary-24h-stat-l\">HIGH CONV</div></div>\n              <div class=\"message-intel__summary-24h-stat\"><div class=\"message-intel__summary-24h-stat-v\">—</div><div class=\"message-intel__summary-24h-stat-l\">HOT SUBNETS</div></div>\n              <div class=\"message-intel__summary-24h-stat\"><div class=\"message-intel__summary-24h-stat-v\">—</div><div class=\"message-intel__summary-24h-stat-l\">TOP ACC</div></div>\n              <div class=\"message-intel__summary-24h-stat\"><div class=\"message-intel__summary-24h-stat-v\">—</div><div class=\"message-intel__summary-24h-stat-l\">TOPICS</div></div>\n              <div class=\"message-intel__summary-24h-stat\"><div class=\"message-intel__summary-24h-stat-v\">—</div><div class=\"message-intel__summary-24h-stat-l\">RECENT MSGS</div></div>\n            </div>\n            <p class=\"message-intel__panel-hint\">Top subnets, movers, themes, and hourly volume appear here after the live listener data hydrates.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Pulse Snapshot / Stats At A Glance -->\n      <div class=\"message-intel__hero-stats\" id=\"message-intel-hero-stats\" aria-label=\"Pulse snapshot\">\n        <div class=\"message-intel__stat-chip\"><b id=\"message-intel-stat-archived\">—</b><span>Archived</span></div>\n        <div class=\"message-intel__stat-chip\"><b id=\"message-intel-stat-24h\">—</b><span>Last 24h</span></div>\n        <div class=\"message-intel__stat-chip\"><b id=\"message-intel-stat-conv\">—</b><span>Live conv.</span></div>\n        <div class=\"message-intel__stat-chip\"><b id=\"message-intel-stat-active\">—</b><span>Active</span></div>\n      </div>\n\n      <!-- Net flow & Yesterday's Most Talked About Spotlight -->\n      <div class=\"message-intel__tile message-intel__tile--flow\">\n        <div class=\"message-intel__pulse-stage message-intel__flow glass-card\" id=\"message-intel-flow\" aria-live=\"polite\">\n          <div class=\"message-intel__sec-label\">\n            <span class=\"message-intel__sec-bar message-intel__sec-bar--green\" aria-hidden=\"true\"></span>\n            <h3 class=\"message-intel__panel-title\">Net flow</h3>\n            <span class=\"message-intel__panel-unit\" id=\"message-intel-flow-dir\">WARMING</span>\n          </div>\n          <button type=\"button\" class=\"message-intel__flow-anchor\" id=\"message-intel-flow-anchor\">SN — · tap a trending row</button>\n          <div class=\"message-intel__flow-val\" id=\"message-intel-flow-val\">warming <small>· pool delta</small></div>\n          <div class=\"message-intel__flow-meter\" aria-hidden=\"true\"><div id=\"message-intel-flow-bar\"></div></div>\n          <p class=\"message-intel__flow-sub\" id=\"message-intel-flow-sub\">Needs two pool snapshots — nothing faked while it’s quiet.</p>\n        </div>\n      </div>\n\n      <div class=\"message-intel__tile message-intel__tile--spot\">\n        <div class=\"message-intel__spotlight\">\n          <div class=\"message-intel__hero glass-card\" id=\"message-intel-yesterday\">\n            <p class=\"message-intel__hero-eyebrow\">Yesterday&apos;s most talked about</p>\n            <div class=\"message-intel__hero-main\">\n              <span class=\"message-intel__hero-icon\" id=\"message-intel-yesterday-icon\" aria-hidden=\"true\">—</span>\n              <div>\n                <span class=\"message-intel__hero-name\" id=\"message-intel-yesterday-link\">Awaiting 24h leader</span>\n                <p class=\"message-intel__hero-meta\" id=\"message-intel-yesterday-stats\">No qualifying 24-hour leader yet.</p>\n              </div>\n            </div>\n            <div class=\"message-intel__hero-why\" id=\"message-intel-yesterday-chips\" hidden></div>\n            <p class=\"message-intel__hero-runner\" id=\"message-intel-yesterday-runner\" hidden></p>\n          </div>\n          <div class=\"message-intel__week-top glass-card\" id=\"message-intel-week-top\" hidden aria-live=\"polite\">\n            <div class=\"message-intel__sec-label\">\n              <span class=\"message-intel__sec-bar message-intel__sec-bar--violet\" aria-hidden=\"true\"></span>\n              <h3 class=\"message-intel__panel-title\" id=\"message-intel-week-top-title\">Comment of the week</h3>\n              <span class=\"message-intel__panel-unit\">7d · engagement</span>\n            </div>\n            <p class=\"message-intel__week-top-why\" id=\"message-intel-week-top-why\"></p>\n            <blockquote class=\"message-intel__week-top-quote\" id=\"message-intel-week-top-quote\"></blockquote>\n            <div class=\"message-intel__week-top-meta\">\n              <span class=\"message-intel__week-top-author\" id=\"message-intel-week-top-author\"></span>\n              <div class=\"message-intel__week-top-stats\" id=\"message-intel-week-top-stats\" aria-label=\"Engagement stats\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Live signal decoder — hydrated only from qualifying calls -->\n      <div class=\"message-intel__tile message-intel__tile--decoder\">\n        <div class=\"message-intel__panel message-intel__panel--decoder glass-card\" id=\"message-intel-decoder\">\n          <div class=\"message-intel__sec-label\"><span class=\"message-intel__sec-bar message-intel__sec-bar--blue\" aria-hidden=\"true\"></span><h3 class=\"message-intel__panel-title\">LIVE SIGNAL DECODER</h3><span class=\"message-intel__panel-unit\">awaiting qualifying call</span></div>\n          <div id=\"message-intel-decoder-body\" class=\"message-intel__decoder-empty\" aria-live=\"polite\">No qualifying call is available to decode yet. This panel will fill from the same live proof payload as the feed.</div>\n        </div>\n      </div>\n\n      <!-- Proof & divergence — hydrated from resolved outcome stories -->\n      <div class=\"message-intel__tile message-intel__tile--proof-chart\">\n        <div class=\"message-intel__panel message-intel__panel--proof-chart glass-card\" id=\"message-intel-divergence-visualizer\">\n          <div class=\"message-intel__sec-label\"><span class=\"message-intel__sec-bar message-intel__sec-bar--violet\" aria-hidden=\"true\"></span><h3 class=\"message-intel__panel-title\">PROOF &amp; DIVERGENCE</h3><span class=\"message-intel__panel-unit\">awaiting resolved outcomes</span></div>\n          <div id=\"message-intel-divergence-visualizer-body\" class=\"message-intel__divergence-empty\" aria-live=\"polite\">No resolved, evidence-qualified outcome stories yet. Pending calls stay out until their 24-hour proof is complete.</div>\n        </div>\n      </div>\n\n      <div class=\"message-intel__tile message-intel__tile--feed\">\n        <div class=\"message-intel__panel message-intel__panel--feed glass-card\">\n          <div class=\"message-intel__sec-label\">\n            <span class=\"message-intel__sec-bar message-intel__sec-bar--green\" aria-hidden=\"true\"></span>\n            <h3 class=\"message-intel__panel-title\">Live feed</h3>\n            <span class=\"message-intel__panel-unit\" id=\"message-intel-feed-hint\">newest first · filters under the tape</span>\n          </div>\n          <div id=\"message-intel-feed\" class=\"message-intel__feed\" aria-live=\"polite\" aria-busy=\"true\">\n            \n            <div class=\"hydrate-skeleton hydrate-skeleton--tall\" aria-hidden=\"true\">\n              <div class=\"hydrate-skeleton__line hydrate-skeleton__line--med\"></div>\n              <div class=\"hydrate-skeleton__line\"></div>\n              <div class=\"hydrate-skeleton__line hydrate-skeleton__line--short\"></div>\n            </div>\n             <p class=\"sr-only\" role=\"status\">Loading live feed — Telegram desk</p>\n            \n          </div>\n          <div id=\"message-intel-detail\" class=\"message-intel__detail\" hidden aria-live=\"polite\"></div>\n          <div class=\"message-intel__filter-bar\" id=\"message-intel-filter-bar\" aria-label=\"Feed filters\">\n            <div class=\"message-intel__filter-group\">\n              <span class=\"message-intel__filter-label\">Min conviction</span>\n              <div class=\"message-intel__filter-chips\" id=\"message-intel-conv-filters\" role=\"group\" aria-label=\"Minimum conviction\">\n                <button type=\"button\" class=\"message-intel__filter-chip message-intel__filter-chip--active\" data-min-conv=\"\">All</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-min-conv=\"60\">60%+</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-min-conv=\"70\">70%+</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-min-conv=\"80\">80%+</button>\n              </div>\n            </div>\n            <div class=\"message-intel__filter-group\">\n              <span class=\"message-intel__filter-label\">Subnet</span>\n              <div class=\"message-intel__filter-chips\" id=\"message-intel-subnet-filters\" role=\"group\" aria-label=\"Subnet filter\">\n                <button type=\"button\" class=\"message-intel__filter-chip message-intel__filter-chip--active\" data-netuid=\"\">All</button>\n              </div>\n            </div>\n            <div class=\"message-intel__filter-group\">\n              <span class=\"message-intel__filter-label\">Topic</span>\n              <div class=\"message-intel__filter-chips\" id=\"message-intel-topic-filters\" role=\"group\" aria-label=\"Topic filter\">\n                <button type=\"button\" class=\"message-intel__filter-chip message-intel__filter-chip--active\" data-topic=\"\">All</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-topic=\"validator\">Validator</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-topic=\"emissions\">Emissions</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-topic=\"alpha\">Alpha</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-topic=\"partnership\">Partnership</button>\n                <button type=\"button\" class=\"message-intel__filter-chip\" data-topic=\"market\">Market</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Quick Act Commands Dock Bar -->\n      <div class=\"message-intel__quick-dock glass-card\">\n        <div class=\"message-intel__quick-cmds-header\">\n          <span class=\"message-intel__quick-icon\">⚡</span>\n          <b>QUICK ACT COMMANDS</b>\n        </div>\n        <div class=\"message-intel__quick-chips\">\n          <a class=\"message-intel__q-chip\" href=\"https://t.me/OfficialSubnetSummer\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <span class=\"message-intel__q-cmd\">\n              <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg>\n              /summary\n            </span>\n            <small>Top 1h/24h</small>\n          </a>\n          <a class=\"message-intel__q-chip\" href=\"https://t.me/OfficialSubnetSummer\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <span class=\"message-intel__q-cmd\">\n              <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polygon points=\"16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76\"/></svg>\n              /track\n            </span>\n            <small>New Alert</small>\n          </a>\n          <a class=\"message-intel__q-chip\" href=\"https://t.me/OfficialSubnetSummer\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <span class=\"message-intel__q-cmd\">\n              <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n              /who\n            </span>\n            <small>Top Callers</small>\n          </a>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- ── TAB 2: LEARN (Caller Strike-Rate Deep Dive, Telegram Proof & High Conviction Calls) ── -->\n    <div class=\"message-intel__mode message-intel__mode--learn\" data-pulse-pane=\"learn\" role=\"tabpanel\" id=\"message-intel-pane-learn\" aria-labelledby=\"pulse-tab-learn\" hidden>\n      \n      <!-- Section 1: Caller Strike-Rate Leaderboard -->\n      <div class=\"message-intel__tile message-intel__tile--callers\">\n        <div class=\"message-intel__panel glass-card message-intel__learn-card\" id=\"message-intel-callers\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--green\">🎯</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">CALLER STRIKE-RATE</h3>\n                <p class=\"message-intel__rank-panel-sub\">Prediction accuracy from resolved qualifying calls · N≥5</p>\n              </div>\n            </div>\n            <div class=\"message-intel__caller-tabs\" role=\"group\" aria-label=\"Leaderboard window\">\n              <button type=\"button\" data-caller-days=\"7\">7d</button>\n              <button type=\"button\" class=\"is-active\" data-caller-days=\"30\">30d</button>\n              <button type=\"button\" data-caller-days=\"90\">90d</button>\n            </div>\n          </div>\n          <div id=\"message-intel-callers-body\" class=\"message-intel__leaderboard\" aria-live=\"polite\">\n            <p class=\"empty\">Strike rate from resolved qualifying calls only. Under 5 graded calls we show “too few graded calls to trust” — never a fake rank.</p>\n          </div>\n          <p class=\"message-intel__learn-context-note\">Prediction accuracy measured from earliest qualifying call. Only net engagement &gt;1k channels taken.</p>\n        </div>\n      </div>\n\n      <!-- Section 2 & 3: Dual-Card Proof & Skin Container -->\n      <div class=\"message-intel__learn-dual-grid\">\n        <!-- Card A: Telegram Call Proof -->\n        <div class=\"message-intel__panel glass-card message-intel__learn-card message-intel__learn-card--proof\" id=\"message-intel-proof\" aria-live=\"polite\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--cyan\">📜</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">TELEGRAM CALL PROOF</h3>\n                <p class=\"message-intel__rank-panel-sub\">On-chain price snapshot verification · historical outcomes</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--green\">● EVIDENCE GATED</span>\n            </div>\n          </div>\n          <div class=\"message-intel__proof-body\" id=\"message-intel-proof-body\"></div>\n        </div>\n\n        <!-- Card B: High Conviction Signals / Skin -->\n        <div class=\"message-intel__panel glass-card message-intel__learn-card message-intel__learn-card--hc\" id=\"message-intel-hc-strip\" aria-label=\"High conviction calls\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--gold\">⚡</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">HIGH CONVICTION MESSAGES</h3>\n                <p class=\"message-intel__rank-panel-sub\">≥70% conviction · on-chain skin in the game</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--gold\">● LOCKED PROOF</span>\n            </div>\n          </div>\n          <div class=\"message-intel__hc-rows\" id=\"message-intel-hc-rows\"></div>\n        </div>\n      </div>\n\n      <!-- Section 4: Skin Guarantee Footer -->\n      <div class=\"message-intel__tile message-intel__tile--skin-guarantee\">\n        <div class=\"message-intel__skin-card glass-card\">\n          <p class=\"message-intel__skin-disclaimer\">Skin is proof of intent, never proof of edge. Staked = verified on-chain • APE = degen alerts only (more honesty, less veracity)</p>\n        </div>\n      </div>\n\n      <!-- Preserved Hydration Anchor for Divergence & Consensus -->\n      <div id=\"message-intel-divergence\" class=\"message-intel__divergence\" style=\"display: none;\">\n        <p class=\"message-intel__panel-hint\">Telegram outcome stories compare recorded calls with later outcomes.</p>\n        <div id=\"message-intel-divergence-body\" aria-live=\"polite\"></div>\n      </div>\n    </div>\n\n    <!-- ── TAB 3: RANK (All 5 Leaderboards + Deep User Dossiers & Receipts Everywhere) ── -->\n    <div class=\"message-intel__mode message-intel__mode--rank\" data-pulse-pane=\"rank\" role=\"tabpanel\" id=\"message-intel-pane-rank\" aria-labelledby=\"pulse-tab-rank\" hidden>\n      \n      <!-- Rank Sub-Tab Segmented Controller -->\n      <div class=\"message-intel__rank-subtabs\" role=\"tablist\" aria-label=\"Leaderboard Categories\">\n        <button type=\"button\" class=\"message-intel__rank-subtab is-active\" data-rank-subtab=\"champions\" role=\"tab\" aria-selected=\"true\" id=\"rank-subtab-btn-champions\">\n          <span class=\"message-intel__rank-subtab-icon\">👑</span>\n          <span class=\"message-intel__rank-subtab-title\">Champions</span>\n          <span class=\"message-intel__rank-subtab-badge\">Weekly</span>\n        </button>\n        <button type=\"button\" class=\"message-intel__rank-subtab\" data-rank-subtab=\"power\" role=\"tab\" aria-selected=\"false\" id=\"rank-subtab-btn-power\">\n          <span class=\"message-intel__rank-subtab-icon\">⚡</span>\n          <span class=\"message-intel__rank-subtab-title\">Chatter Power</span>\n          <span class=\"message-intel__rank-subtab-badge\">v×c×q</span>\n        </button>\n        <button type=\"button\" class=\"message-intel__rank-subtab\" data-rank-subtab=\"accolades\" role=\"tab\" aria-selected=\"false\" id=\"rank-subtab-btn-accolades\">\n          <span class=\"message-intel__rank-subtab-icon\">🎖️</span>\n          <span class=\"message-intel__rank-subtab-title\">Accolades</span>\n          <span class=\"message-intel__rank-subtab-badge\">Reputation</span>\n        </button>\n        <button type=\"button\" class=\"message-intel__rank-subtab\" data-rank-subtab=\"crowns\" role=\"tab\" aria-selected=\"false\" id=\"rank-subtab-btn-crowns\">\n          <span class=\"message-intel__rank-subtab-icon\">🔥</span>\n          <span class=\"message-intel__rank-subtab-title\">Crowns</span>\n          <span class=\"message-intel__rank-subtab-badge\">Social</span>\n        </button>\n        <button type=\"button\" class=\"message-intel__rank-subtab\" data-rank-subtab=\"callers\" role=\"tab\" aria-selected=\"false\" id=\"rank-subtab-btn-callers\">\n          <span class=\"message-intel__rank-subtab-icon\">🎯</span>\n          <span class=\"message-intel__rank-subtab-title\">Strike-Rate</span>\n          <span class=\"message-intel__rank-subtab-badge\">N≥5</span>\n        </button>\n      </div>\n\n      <!-- Sub-Pane 1: Weekly Champions -->\n      <div class=\"message-intel__hall\">\n      <div class=\"message-intel__rank-pane is-active\" data-rank-pane=\"champions\" id=\"message-intel-rank-pane-champions\" role=\"tabpanel\">\n        <div class=\"message-intel__panel glass-card message-intel__rank-panel\" id=\"message-intel-champions-card\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--gold\">👑</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">WEEKLY CHAMPIONS</h3>\n                <p class=\"message-intel__rank-panel-sub\">Influence-ranked · subnet-call strike rate when proof available</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--gold\">● 7D PODIUM</span>\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--green\">N≥5 GRADED</span>\n            </div>\n          </div>\n          <div id=\"message-intel-champions\" class=\"message-intel__champions\" aria-live=\"polite\">\n            \n            <p class=\"empty\">No contributor history yet — champs appear as traffic grades.</p>\n            \n          </div>\n        </div>\n      </div>\n      </div><!-- /.message-intel__hall -->\n\n      <!-- Sub-Pane 2: Chatter Power -->\n      <div class=\"message-intel__rank-pane\" data-rank-pane=\"power\" id=\"message-intel-rank-pane-power\" role=\"tabpanel\" hidden>\n        <div class=\"message-intel__panel glass-card message-intel__rank-panel\" id=\"message-intel-power-card\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--cyan\">⚡</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">CHATTER POWER MATRIX</h3>\n                <p class=\"message-intel__rank-panel-sub\">Velocity (msgs/m) × Conviction (%) × Quality Score (%)</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--cyan\">● REAL-TIME</span>\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--purple\">TOP SUBNETS</span>\n            </div>\n          </div>\n          <div id=\"message-intel-power\" class=\"message-intel__power\" aria-live=\"polite\">\n            <p class=\"empty\">Ranks by who's talking, not how loud — velocity × conviction × author hit-rate. Why-lines land with trending v2.</p>\n          </div>\n        </div>\n\n        <div class=\"message-intel__panel glass-card message-intel__rank-panel\" id=\"message-intel-narrative-card\">\n          <div class=\"message-intel__sec-label\">\n            <span class=\"message-intel__sec-bar message-intel__sec-bar--orange\" aria-hidden=\"true\"></span>\n            <h3 class=\"message-intel__panel-title\">Narrative map</h3>\n            <span class=\"message-intel__panel-unit\">rising · peaking · decaying</span>\n          </div>\n          <div id=\"message-intel-narrative\" class=\"message-intel__narrative\" aria-live=\"polite\">\n            <p class=\"empty\">Rising / peaking / decaying fills from chatter-power deltas — the group’s weather, not a price chart.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Sub-Pane 3: Accolade Boards -->\n      <div class=\"message-intel__rank-pane\" data-rank-pane=\"accolades\" id=\"message-intel-rank-pane-accolades\" role=\"tabpanel\" hidden>\n        <div class=\"message-intel__panel glass-card message-intel__rank-panel\" id=\"message-intel-accolades-card\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--purple\">🎖️</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">ACCOLADE BOARDS</h3>\n                <p class=\"message-intel__rank-panel-sub\">Earned reputation badges · early alpha &amp; high substance</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--purple\">EARNED · N≥5</span>\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--gold\">EVIDENCE GATED</span>\n            </div>\n          </div>\n          <div id=\"message-intel-accolades\" class=\"message-intel__accolades\" aria-live=\"polite\">\n            <p class=\"empty\">Early &amp; Right / On Fire / High Signal land once strike samples fill.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Sub-Pane 4: Reaction Crowns -->\n      <div class=\"message-intel__rank-pane message-intel__crowns-drawer\" data-rank-pane=\"crowns\" id=\"message-intel-rank-pane-crowns\" role=\"tabpanel\" hidden>\n        <div class=\"message-intel__panel glass-card message-intel__rank-panel\" id=\"message-intel-crowns-card\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--pink\">🔥</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">REACTION CROWNS</h3>\n                <p class=\"message-intel__rank-panel-sub\">Top resonating Telegram alpha messages &amp; quote receipts</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--pink\">● SOCIAL ALPHA</span>\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--cyan\">7D ROLLING</span>\n            </div>\n          </div>\n          <div id=\"message-intel-crowns\" class=\"message-intel__crowns\" aria-live=\"polite\">\n            <p class=\"empty\">No reaction crowns yet — they appear as the group reacts.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Sub-Pane 5: Caller Strike-Rate -->\n      <div class=\"message-intel__rank-pane\" data-rank-pane=\"callers\" id=\"message-intel-rank-pane-callers\" role=\"tabpanel\" hidden>\n        <div class=\"message-intel__panel glass-card message-intel__rank-panel\" id=\"message-intel-rank-callers-card\">\n          <div class=\"message-intel__rank-header\">\n            <div class=\"message-intel__rank-title-group\">\n              <span class=\"message-intel__rank-header-icon message-intel__rank-header-icon--green\">🎯</span>\n              <div>\n                <h3 class=\"message-intel__rank-panel-title\">CALLER STRIKE-RATE</h3>\n                <p class=\"message-intel__rank-panel-sub\">Full directional accuracy &amp; on-chain skin verification</p>\n              </div>\n            </div>\n            <div class=\"message-intel__rank-header-tags\">\n              <span class=\"message-intel__rank-pill message-intel__rank-pill--green\">● N≥5 QUALIFIED</span>\n            </div>\n          </div>\n          <div class=\"message-intel__caller-tabs\" role=\"group\" aria-label=\"Leaderboard window\">\n            <button type=\"button\" data-caller-days=\"7\">7d</button>\n            <button type=\"button\" class=\"is-active\" data-caller-days=\"30\">30d</button>\n            <button type=\"button\" data-caller-days=\"90\">90d</button>\n          </div>\n          <div id=\"message-intel-callers-body-rank\" class=\"message-intel__leaderboard\" aria-live=\"polite\">\n            <p class=\"empty\">Strike rate from resolved qualifying calls only.</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- ── TAB 4: SERVE (My Desk, Watchlist & Bot Integration) ── -->\n    <div class=\"message-intel__mode\" data-pulse-pane=\"serve\" role=\"tabpanel\" id=\"message-intel-pane-serve\" aria-labelledby=\"pulse-tab-serve\" hidden>\n      <div class=\"message-intel__tile message-intel__tile--desk\">\n        <div class=\"message-intel__panel glass-card\" id=\"message-intel-my-desk-card\">\n          <div class=\"message-intel__sec-label\">\n            <span class=\"message-intel__sec-bar message-intel__sec-bar--violet\" aria-hidden=\"true\"></span>\n            <h3 class=\"message-intel__panel-title\">My Desk</h3>\n            <span class=\"message-intel__panel-unit\">watchlist · bot sync</span>\n          </div>\n          <div class=\"message-intel__my-desk\">\n            <div class=\"message-intel__upgrade\" id=\"message-intel-my-desk-upgrade\" hidden>\n              <p class=\"empty\">My Desk is open — pin subnets and set your alert thresholds.</p>\n            </div>\n            <div class=\"message-intel__desk-block\">\n              <p class=\"message-intel__desk-label\">Watchlist</p>\n              <div id=\"message-intel-watchlist-panel\" class=\"message-intel__watchlist-panel\" aria-live=\"polite\">\n                <p class=\"empty\">Loading your watchlist…</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"message-intel__tile message-intel__tile--pulse\">\n        <div class=\"message-intel__panel glass-card\" id=\"message-intel-pulse-card\">\n          <div class=\"message-intel__sec-label\">\n            <span class=\"message-intel__sec-bar message-intel__sec-bar--green\" aria-hidden=\"true\"></span>\n            <h3 class=\"message-intel__panel-title\">My Pulse</h3>\n            <span class=\"message-intel__panel-unit\">watchlisted only</span>\n          </div>\n          <div id=\"message-intel-my-pulse\" class=\"message-intel__pulse-list\" aria-live=\"polite\">\n            <p class=\"empty\">Pin a subnet — this digest only speaks for your desk.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"message-intel__dock\">\n        <div class=\"message-intel__command-list\" id=\"message-intel-commands-card\" aria-label=\"Telegram commands\">\n          <span class=\"is-live\">/summary</span>\n          <span>/trending</span>\n          <span>/track</span>\n          <span>/rank</span>\n          <span>/who</span>\n          <span>/alerts</span>\n          <span>/champions</span>\n          <span>/crowns</span>\n        </div>\n        <p class=\"message-intel__dock-note\">Green = live in chat. The rest are the same Listen→Learn→Rank→Serve loop — marked until the bot ships them.</p>\n        <div class=\"message-intel__legend\" aria-label=\"Scoring legend\">\n          <span class=\"message-intel__legend-item\"><span class=\"message-intel__sw message-intel__sw--blue\" aria-hidden=\"true\"></span><b>Conv.</b> jury score 0–100%</span>\n          <span class=\"message-intel__legend-item\"><span class=\"message-intel__sw message-intel__sw--violet\" aria-hidden=\"true\"></span><b>High</b> ≥ 60%</span>\n          <span class=\"message-intel__legend-item\"><span class=\"message-intel__sw message-intel__sw--orange\" aria-hidden=\"true\"></span><b>Influence</b> reach + light reaction bump, 7d</span>\n          <span class=\"message-intel__legend-item\"><span class=\"message-intel__sw message-intel__sw--lilac\" aria-hidden=\"true\"></span><b>Crowns</b> weekly emoji leaders</span>\n        </div>\n      </div>\n    </div>\n\n  </div><!-- /.message-intel__bay -->\n\n  <div class=\"message-intel__panel glass-card message-intel__locked-surface\" id=\"message-intel-wallet-card\" aria-label=\"Wallet connector coming soon\">\n    <div class=\"message-intel__sec-label\">\n      <span class=\"message-intel__sec-bar message-intel__sec-bar--orange\" aria-hidden=\"true\"></span>\n      <h3 class=\"message-intel__panel-title\">Skin in the game</h3>\n      <span class=\"message-intel__panel-unit\">LOCKED · COMING SOON</span>\n    </div>\n    <div class=\"message-intel__locked-body\">\n      <div>\n        <p><b>Wallet connector</b> will let you track calls alongside on-chain positions and surface your own record.</p>\n        <p class=\"message-intel__panel-hint\">No wallet connection is active yet. Your address will stay hidden until you choose to connect.</p>\n      </div>\n      <button type=\"button\" class=\"message-intel__locked-button\" disabled aria-disabled=\"true\">Connect wallet</button>\n    </div>\n  </div>\n\n  <p class=\"message-intel__foot\">Conviction is auto-scored from message text and author track record — not financial advice.</p>\n</div>\n</section>\n<section class=\"sr-weighing-rib desk-zone wrap-pad\" id=\"section-strategic-weighing\" aria-labelledby=\"sr-weighing-rib-title\">\n  <div class=\"sr-weighing-rib__head\">\n    <h2 class=\"sr-weighing-rib__title\" id=\"sr-weighing-rib-title\">Council weighing</h2>\n    <a class=\"sr-weighing-rib__link\" href=\"#section-proof-band\">Proof</a>\n  </div>\n  <!-- Council is weighing — Conviction Board (Weighing Room) -->\n\n\n\n<section class=\"row weighing-room\" id=\"section-simivision-picks\" aria-labelledby=\"sr-weighing-rib-title\"\n  data-gap-tick=\"\">\n  <div class=\"section-label\">\n    Council is weighing\n    <span class=\"wr-updated\" id=\"wr-updated\">· updated recently</span>\n  </div>\n  <p class=\"section-sub\">Names still on the table — sorted by proximity to a call, not a scoreboard.</p>\n  \n  <p class=\"wr-spine\" id=\"wr-spine\">Graded on close · weights update after resolve</p>\n  \n  <p class=\"wr-quiet\" id=\"wr-quiet\" hidden></p>\n  \n  \n  <p class=\"wr-handoff\" id=\"wr-handoff\" hidden></p>\n  \n\n  \n  <div class=\"card card-muted wr-empty desk-empty-shell\" id=\"weighing-room-body\">\n    <p class=\"empty desk-empty\">No other names on the table right now — council is quiet beyond today's call.</p>\n  </div>\n  \n  <p class=\"wr-footer\">These may become tomorrow&apos;s call. Or fade.</p>\n</section>\n</section>\n\n<section class=\"living-focus desk-zone wrap-pad\" id=\"section-living-focus\" aria-labelledby=\"living-focus-title\" data-brain-state=\"building\" data-focus-netuid=\"\">\n  <div class=\"living-focus__head\">\n    <h2 class=\"living-focus__title\" id=\"living-focus-title\">Living Focus</h2>\n    <p class=\"living-focus__sub\" id=\"living-focus-sub\">Focus · Contest · Prove it · Watch us update</p>\n    <p class=\"living-focus__status-chip\" id=\"living-focus-status-chip\" hidden></p>\n  </div>\n  <div class=\"living-focus__body\" id=\"living-focus-body\" aria-live=\"polite\">\n    <div class=\"living-focus__skeleton\" aria-hidden=\"true\">\n      <div class=\"living-focus__contest-dial living-focus__contest-dial--skeleton\" aria-hidden=\"true\">\n        <span class=\"living-focus__dial-pct\">—</span>\n        <span class=\"living-focus__dial-label\">Contest</span>\n      </div>\n      <p class=\"living-focus__quiet\">Focus opens when judges score this subnet.</p>\n    </div>\n  </div>\n  <p class=\"living-focus__identity-chip\" id=\"living-focus-identity-chip\" hidden></p>\n  <div class=\"living-focus__learn\" id=\"living-focus-learn\" hidden aria-live=\"polite\"></div>\n  <div class=\"living-focus__weights-slot\" id=\"living-focus-weights\" hidden aria-live=\"polite\"></div>\n  <div class=\"living-focus__evidence\" id=\"living-focus-evidence\" hidden aria-live=\"polite\"></div>\n  <div class=\"living-focus__trail-teaser\" id=\"living-focus-trail-teaser\" hidden aria-live=\"polite\"></div>\n  <div class=\"living-focus__switcher\" id=\"living-focus-switcher\" hidden></div>\n  <div class=\"living-focus__cta\" id=\"living-focus-cta\" hidden>\n    <a class=\"home-cta home-cta--ghost living-focus__share-link\" id=\"living-focus-share-link\" href=\"#\" hidden>Open subnet</a>\n    <button type=\"button\" class=\"home-cta home-cta--ghost\" id=\"living-focus-pin-btn\" hidden>Pin to watchlist</button>\n    <button type=\"button\" class=\"home-cta home-cta--primary\" id=\"living-focus-prove-btn\" hidden>Prove it: who sold this subnet?</button>\n  </div>\n</section>\n\n\n\n\n<section class=\"brain-letter desk-zone wrap-pad\" id=\"section-brain-letter\" aria-labelledby=\"brain-letter-title\" data-brain-state=\"quiet\">\n  <div class=\"brain-letter__head weekly-letter__head\">\n    <h2 class=\"brain-letter__title weekly-letter__title\" id=\"brain-letter-title\">Brain letter</h2>\n    <p class=\"brain-letter__meta weekly-letter__meta\" id=\"brain-letter-date\">Morning brief · graded memory</p>\n    <div class=\"weekly-letter__actions brain-letter__actions\">\n      <button type=\"button\" class=\"home-cta home-cta--ghost brain-letter__action\" id=\"brain-letter-copy-desk\" disabled>Copy today&apos;s desk</button>\n      <button type=\"button\" class=\"home-cta home-cta--ghost brain-letter__action\" id=\"brain-letter-copy\" disabled>Copy markdown</button>\n      <button type=\"button\" class=\"home-cta home-cta--primary brain-letter__action\" id=\"brain-letter-download\" disabled>Download</button>\n    </div>\n  </div>\n  <div class=\"brain-letter__desk-strip\" id=\"brain-letter-desk-strip\" aria-label=\"Desk strip\">\n    \n    <p class=\"brain-letter__desk-val desk-empty\">Morning brief lands after graded calls resolve.</p>\n    \n  </div>\n  <details class=\"brain-letter__full\" id=\"brain-letter-full\">\n    <summary class=\"brain-letter__full-summary home-cta home-cta--ghost\">Open full letter</summary>\n  <div id=\"brain-letter-root\" class=\"brain-letter__body weekly-letter__body\" aria-live=\"polite\">\n    \n    <p class=\"weekly-letter__empty\">Brief writes after the first graded windows land.</p>\n    \n  </div>\n  </details>\n</section>\n\n<link rel=\"stylesheet\" href=\"/static/css/dev_pulse.css?v=7b9cae5e\">\n<section class=\"sr-dev-pulse\" id=\"section-dev-pulse\" aria-labelledby=\"dev-pulse-title\">\n  <div class=\"sr-dev-pulse__head\">\n    <h2 class=\"sr-dev-pulse__title\" id=\"dev-pulse-title\">Dev Pulse</h2>\n    <p class=\"sr-dev-pulse__sub\">Public repos from registry · council graded track record per subnet.</p>\n  </div>\n  <div class=\"sr-dev-pulse__summary\" id=\"dev-pulse-summary\" hidden></div>\n  <ul class=\"sr-dev-pulse__list\" id=\"dev-pulse-list\" aria-live=\"polite\">\n    <li class=\"sr-dev-pulse__empty\">Loading dev pulse…</li>\n  </ul>\n</section>\n<script src=\"/static/js/dev_pulse.js?v=7b9cae5e\" defer></script>\n\n<section id=\"section-proof-band\" class=\"proof-band desk-zone wrap-pad\" aria-labelledby=\"proof-band-title\" data-brain-state=\"building\">\n  <h2 id=\"proof-band-title\" class=\"proof-band__title\">What the loop learned</h2>\n  <div class=\"proof-band__score-hero\" id=\"proof-band-score-hero\">\n    \n    <div class=\"proof-band__pct\" id=\"proof-band-pct\" hidden>—</div>\n    <p class=\"proof-band__meta\" id=\"proof-band-meta\" hidden></p>\n    \n\n\n<div\n  class=\"desk-empty-state desk-empty-state--warming proof-band__quiet\"\n  id=\"proof-band-quiet\"\n  role=\"status\"\n>\n  <span class=\"desk-empty-state__glyph\" aria-hidden=\"true\"></span>\n  <div class=\"desk-empty-state__body\">\n    <p class=\"desk-empty-state__title\">Track record building</p>\n    <p class=\"desk-empty-state__text\">Graded history appears after calls resolve.</p>\n    \n  </div>\n</div>\n\n    \n    \n  </div>\n  <div class=\"proof-band__tabs\" role=\"tablist\" aria-label=\"Track record views\">\n    <button type=\"button\" class=\"proof-band__tab proof-band__tab--active\" data-proof-tab=\"council\" role=\"tab\" aria-selected=\"true\">Council accuracy</button>\n    <button type=\"button\" class=\"proof-band__tab\" data-proof-tab=\"pump\" role=\"tab\" aria-selected=\"false\">Pump early hit-rate</button>\n  </div>\n  <div class=\"proof-band__subpanels\" id=\"proof-band-subpanels\" aria-label=\"Evidence at a glance\">\n    <article class=\"proof-band__subpanel proof-band__subpanel--council\">\n      <span class=\"proof-band__subpanel-bar proof-band__subpanel-bar--green\" aria-hidden=\"true\"></span>\n      <h3 class=\"proof-band__subpanel-label\">Council accuracy</h3>\n      <p class=\"proof-band__subpanel-val\" id=\"proof-sub-council-val\">0/30</p>\n      <p class=\"proof-band__subpanel-meta desk-empty\" id=\"proof-sub-council-meta\">0/30 graded · sample gate</p>\n    </article>\n    <article class=\"proof-band__subpanel proof-band__subpanel--telegram\">\n      <span class=\"proof-band__subpanel-bar proof-band__subpanel-bar--blue\" aria-hidden=\"true\"></span>\n      <h3 class=\"proof-band__subpanel-label\">Telegram proof</h3>\n      <p class=\"proof-band__subpanel-val\" id=\"proof-sub-telegram-val\">—</p>\n      <p class=\"proof-band__subpanel-meta desk-empty\" id=\"proof-sub-telegram-meta\">Call proof grades after resolve</p>\n    </article>\n    <article class=\"proof-band__subpanel proof-band__subpanel--resolver\">\n      <span class=\"proof-band__subpanel-bar proof-band__subpanel-bar--orange\" aria-hidden=\"true\"></span>\n      <h3 class=\"proof-band__subpanel-label\">Resolver</h3>\n      <p class=\"proof-band__subpanel-val\" id=\"proof-sub-resolver-val\">0 pending</p>\n      <p class=\"proof-band__subpanel-meta desk-empty\" id=\"proof-sub-resolver-meta\">0 pending · 0 retryable · 0 graded</p>\n    </article>\n    <article class=\"proof-band__subpanel proof-band__subpanel--loop\">\n      <span class=\"proof-band__subpanel-bar proof-band__subpanel-bar--lilac\" aria-hidden=\"true\"></span>\n      <h3 class=\"proof-band__subpanel-label\">Loop learned</h3>\n      <p class=\"proof-band__subpanel-val\" id=\"proof-sub-loop-val\">0 graded</p>\n      <p class=\"proof-band__subpanel-meta desk-empty\" id=\"proof-sub-loop-meta\">0 graded · 0 pending · 0 retryable</p>\n    </article>\n  </div>\n  <div class=\"accuracy-lift-panel\" id=\"accuracy-lift-panel\" aria-labelledby=\"accuracy-lift-title\">\n    <h3 class=\"accuracy-lift-panel__title\" id=\"accuracy-lift-title\">Measurement ledger (30d)</h3>\n    <p class=\"accuracy-lift-panel__summary desk-empty\" id=\"accuracy-lift-summary\">Building graded history</p>\n    \n\n    <ul class=\"accuracy-lift-panel__experts\" id=\"accuracy-lift-experts\" hidden></ul>\n    <p class=\"accuracy-lift-panel__note\" id=\"accuracy-lift-note\">Full resolved ledger; trust gate uses published LONG picks only.</p>\n  </div>\n  <div id=\"proof-tab-council\" class=\"proof-band__panel\">\n    <div class=\"whats-working\" id=\"section-whats-working\" aria-labelledby=\"whats-working-title\">\n    <h3 class=\"whats-working__title\" id=\"whats-working-title\">What&apos;s working</h3>\n    <p class=\"whats-working__sub\">Signals that predicted token price — learned from graded picks.</p>\n    <div id=\"whats-working-chips\" class=\"whats-working__chips\" aria-live=\"polite\" data-brain-state=\"building\">\n      \n\n\n<div\n  class=\"desk-empty-state desk-empty-state--empty whats-working__empty desk-empty-state--inline\"\n  \n  role=\"status\"\n>\n  <span class=\"desk-empty-state__glyph\" aria-hidden=\"true\"></span>\n  <div class=\"desk-empty-state__body\">\n    <p class=\"desk-empty-state__title\">Signal rankings quiet</p>\n    <p class=\"desk-empty-state__text\">Top predictors fill in as picks grade.</p>\n    \n  </div>\n</div>\n\n    </div>\n    </div>\n  </div>\n  <div id=\"proof-tab-pump\" class=\"proof-band__panel\" hidden>\n    <div class=\"proof-band__score-hero\" id=\"proof-pump-hero\">\n      <p class=\"proof-band__quiet\" id=\"proof-pump-quiet\">Pump early hit-rate — 0 graded · evaluation insufficient sample</p>\n      <div class=\"proof-band__pct\" id=\"proof-pump-pct\" hidden></div>\n      <p class=\"proof-band__meta\" id=\"proof-pump-meta\" hidden></p>\n    </div>\n    <p><a href=\"#section-pump-alert\">Jump to lead scanner</a></p>\n  </div>\n  \n\n\n\n<section class=\"sr-cause-chain wrap-pad\" id=\"section-cause-chain\" aria-labelledby=\"cause-chain-title\">\n  <div class=\"sr-cause-chain__head\">\n    <h2 class=\"sr-cause-chain__title\" id=\"cause-chain-title\">Cause chain</h2>\n    <p class=\"sr-cause-chain__sub\">How today&apos;s call formed — signals to learning</p>\n  </div>\n  \n  <p class=\"sr-cause-chain__empty\">Quiet — chain appears when council clears an audited pick.</p>\n  \n</section>\n  \n<section class=\"story-strip story-strip--prominent wrap-pad\" id=\"section-story-strip\" aria-labelledby=\"story-strip-title\">\n  \n  \n  <div class=\"story-strip__head\">\n    <h2 class=\"story-strip__title\" id=\"story-strip-title\">Recent calls</h2>\n  </div>\n  <div id=\"story-strip-body\" aria-live=\"polite\">\n    \n  \n  <p class=\"story-strip__empty\" id=\"story-strip-empty\">\n    \n      No graded pick outcomes yet — fills as calls resolve.\n    \n  </p>\n  \n  </div>\n</section>\n  \n<section class=\"paper-portfolio wrap-pad\" id=\"section-paper-portfolio\" aria-labelledby=\"paper-portfolio-title\">\n  <div class=\"paper-portfolio__head\">\n    <h2 class=\"paper-portfolio__title\" id=\"paper-portfolio-title\">Paper portfolio</h2>\n    <p class=\"paper-portfolio__meta\">Council picks · P&amp;L vs hold TAO</p>\n  </div>\n  <div id=\"paper-portfolio-root\" class=\"paper-portfolio__body\" aria-live=\"polite\">\n    <p class=\"paper-portfolio__loading empty--quiet\">Paper P&amp;L appears after council picks resolve — check back after the next graded call.</p>\n  </div>\n</section>\n</section>\n\n\n<!-- 9. Mind Map -->\n<section class=\"row\" id=\"section-mindmap\" aria-labelledby=\"mindmap-section-title\">\n  <div class=\"section-label\">Mind Map</div>\n  <h2 class=\"section-title\" id=\"mindmap-section-title\">Mind Map</h2>\n  <p class=\"section-sub\">Explorable nodes and edges from <code>/api/mindmap/graph</code>.</p>\n  \n<style>\n  .mindmap-graph-section { margin-bottom: var(--space-6, 2rem); }\n  .mindmap-trail-root {\n    position: relative;\n    background:\n      radial-gradient(circle at 15% 0%, rgba(63, 201, 255, 0.05) 0%, transparent 55%),\n      var(--bg-surface, #111827);\n    border: 1px solid var(--border-subtle, #374151);\n    border-radius: var(--border-radius-card, 16px);\n    padding: 14px;\n  }\n  .mindmap-honest-empty {\n    padding: 1.5rem;\n    text-align: center;\n    color: var(--text-secondary, #9ca3af);\n    font-size: 0.9rem;\n    margin: 0;\n  }\n  .mindmap-honest-empty.hidden { display: none; }\n  .mindmap-trail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }\n  .mindmap-trail-list.hidden { display: none; }\n\n  /* Subnet identity band — mirrors the Hero orb's 6-hue k3NetuidBand() so a\n     subnet's Trail card reads as \"the same subnet\" you saw in Daily Call. */\n  .mindmap-trail-group { --sn-accent: #3fc9ff; }\n  .mindmap-trail-group[data-band=\"0\"] { --sn-accent: #3fc9ff; }\n  .mindmap-trail-group[data-band=\"1\"] { --sn-accent: #a78bfa; }\n  .mindmap-trail-group[data-band=\"2\"] { --sn-accent: #ffb74a; }\n  .mindmap-trail-group[data-band=\"3\"] { --sn-accent: #ff5fa8; }\n  .mindmap-trail-group[data-band=\"4\"] { --sn-accent: #34d399; }\n  .mindmap-trail-group[data-band=\"5\"] { --sn-accent: #60a5fa; }\n\n  /* The loop's own self-adjustment (judge/weight nudges with no netuid) isn't\n     any one subnet's card — it's the brain tuning itself, so it gets a\n     distinct glowing-white treatment and a slow breathing pulse instead of a\n     netuid hue, and always sorts first. */\n  .mindmap-trail-group[data-loop=\"1\"] {\n    --sn-accent: #f8fafc;\n    background: rgba(248, 250, 252, 0.04);\n    animation: mindmap-loop-breathe 4.5s ease-in-out infinite;\n  }\n  @keyframes mindmap-loop-breathe {\n    0%, 100% { box-shadow: 0 0 0 0 rgba(248, 250, 252, 0); }\n    50% { box-shadow: 0 0 14px 0 rgba(248, 250, 252, 0.12); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .mindmap-trail-group[data-loop=\"1\"] { animation: none; }\n  }\n\n  .mindmap-trail-group {\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px solid var(--border-subtle, #374151);\n    border-left: 3px solid var(--sn-accent);\n    border-radius: 10px;\n    overflow: hidden;\n  }\n  .mindmap-trail-group__summary {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 48px;\n    padding: 10px 14px;\n    cursor: pointer;\n    list-style: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .mindmap-trail-group__summary::-webkit-details-marker { display: none; }\n  .mindmap-trail-group__summary::marker { content: \"\"; }\n  .mindmap-trail-group__dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: var(--sn-accent);\n    flex-shrink: 0;\n    box-shadow: 0 0 6px 0 var(--sn-accent);\n  }\n  .mindmap-trail-group__name {\n    font-weight: 600;\n    color: var(--text-primary, #f9fafb);\n    font-size: 0.92rem;\n    flex: 1;\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .mindmap-trail-group__count {\n    font-family: var(--font-mono, monospace);\n    font-size: 0.7rem;\n    color: var(--text-muted, #6b7280);\n    flex-shrink: 0;\n  }\n  .mindmap-trail-group__chevron {\n    color: var(--text-muted, #6b7280);\n    transition: transform 150ms ease;\n    flex-shrink: 0;\n  }\n  .mindmap-trail-group[open] .mindmap-trail-group__chevron { transform: rotate(90deg); }\n\n  .mindmap-trail-rows {\n    list-style: none;\n    margin: 0;\n    padding: 2px 14px 12px 22px;\n    display: flex;\n    flex-direction: column;\n    border-top: 1px solid var(--border-subtle, #374151);\n  }\n  .mindmap-trail-row {\n    position: relative;\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    padding: 9px 0 9px 16px;\n    border-left: 1px solid rgba(255, 255, 255, 0.1);\n  }\n  .mindmap-trail-row:last-child { border-left-color: transparent; }\n  .mindmap-trail-row__dot {\n    position: absolute;\n    left: -4.5px;\n    top: 12px;\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    border: 1.5px solid var(--bg-surface, #111827);\n  }\n  .mindmap-trail-row--fresh .mindmap-trail-row__dot {\n    animation: mindmap-trail-pulse 2.2s ease-in-out infinite;\n  }\n  @keyframes mindmap-trail-pulse {\n    0%, 100% { box-shadow: 0 0 0 0 currentColor; }\n    50% { box-shadow: 0 0 0 4px transparent; }\n  }\n  .mindmap-trail-row__body { min-width: 0; flex: 1; }\n  .mindmap-trail-row__kind {\n    font-family: var(--font-mono, monospace);\n    font-size: 0.6rem;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    color: var(--text-muted, #6b7280);\n  }\n  .mindmap-trail-row__line {\n    font-size: 0.85rem;\n    color: var(--text-primary, #f9fafb);\n    line-height: 1.35;\n    overflow-wrap: anywhere;\n  }\n  .mindmap-trail-row__meta {\n    font-family: var(--font-mono, monospace);\n    font-size: 0.68rem;\n    color: var(--text-muted, #6b7280);\n    margin-top: 2px;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .mindmap-trail-row--fresh .mindmap-trail-row__dot { animation: none !important; }\n  }\n\n  .mindmap-integration-status {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    margin-bottom: 12px;\n  }\n  .mindmap-integration-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 3px 8px;\n    border-radius: 999px;\n    font-size: 0.68rem;\n    line-height: 1.2;\n    border: 1px solid var(--border-subtle, #374151);\n    color: var(--text-muted, #6b7280);\n    background: rgba(255, 255, 255, 0.02);\n  }\n  .mindmap-integration-badge__label { color: var(--text-secondary, #9ca3af); }\n  .mindmap-integration-badge__pill {\n    font-family: var(--font-mono, monospace);\n    font-size: 0.62rem;\n    text-transform: lowercase;\n    letter-spacing: 0.02em;\n  }\n  .mindmap-integration-badge--closed {\n    border-color: rgba(31, 212, 124, 0.35);\n    background: rgba(31, 212, 124, 0.08);\n  }\n  .mindmap-integration-badge--closed .mindmap-integration-badge__pill { color: var(--accent-primary, #1fd47c); }\n  .mindmap-integration-badge--partial {\n    border-color: rgba(255, 159, 63, 0.35);\n    background: rgba(255, 159, 63, 0.08);\n  }\n  .mindmap-integration-badge--partial .mindmap-integration-badge__pill { color: var(--accent-orange, #ff9f3f); }\n  .mindmap-integration-badge--blocked {\n    border-color: rgba(248, 113, 113, 0.3);\n    background: rgba(248, 113, 113, 0.06);\n  }\n  .mindmap-integration-badge--blocked .mindmap-integration-badge__pill { color: #f87171; }\n  .mindmap-integration-badge--display_only {\n    border-color: var(--border-subtle, #374151);\n    background: rgba(255, 255, 255, 0.03);\n  }\n  .mindmap-integration-badge--display_only .mindmap-integration-badge__pill { color: var(--text-secondary, #9ca3af); }\n  .mindmap-integration-badge--read_only {\n    border-color: rgba(63, 201, 255, 0.25);\n    background: rgba(63, 201, 255, 0.06);\n  }\n  .mindmap-integration-badge--read_only .mindmap-integration-badge__pill { color: var(--accent-blue, #3fc9ff); }\n\n  .mindmap-spine-chrome {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 14px;\n    align-items: center;\n    margin-bottom: 12px;\n    padding: 8px 12px;\n    border-radius: 8px;\n    border: 1px solid var(--border-subtle, #374151);\n    background: rgba(255, 255, 255, 0.02);\n    font-size: 0.78rem;\n    color: var(--text-secondary, #9ca3af);\n  }\n  .mindmap-spine-chrome__conviction,\n  .mindmap-spine-chrome__learn {\n    font-family: var(--font-mono, monospace);\n    font-size: 0.7rem;\n    line-height: 1.35;\n  }\n  .mindmap-spine-chrome__conviction[data-band] {\n    color: var(--sn-accent, var(--text-primary, #f9fafb));\n  }\n  .mindmap-spine-chrome__conviction[data-band=\"0\"] { --sn-accent: #3fc9ff; }\n  .mindmap-spine-chrome__conviction[data-band=\"1\"] { --sn-accent: #a78bfa; }\n  .mindmap-spine-chrome__conviction[data-band=\"2\"] { --sn-accent: #ffb74a; }\n  .mindmap-spine-chrome__conviction[data-band=\"3\"] { --sn-accent: #ff5fa8; }\n  .mindmap-spine-chrome__conviction[data-band=\"4\"] { --sn-accent: #34d399; }\n  .mindmap-spine-chrome__conviction[data-band=\"5\"] { --sn-accent: #60a5fa; }\n</style>\n\n\n\n<section class=\"cockpit mindmap-graph-section\" id=\"mindmap-graph-section\" aria-labelledby=\"mindmap-graph-heading\">\n  <div class=\"cockpit-header\">\n    <div>\n      <h2 id=\"mindmap-graph-heading\" class=\"cockpit-title sr-only\">Interactive Mindmap</h2>\n      <p class=\"cockpit-subtitle\">Every nudge, signal, and call — grouped by subnet, plus the Learning Loop's own weight adjustments.</p>\n    </div>\n  </div>\n\n  <div\n    id=\"mindmap-graph-root\"\n    class=\"mindmap-trail-root\"\n    data-api=\"/api/mindmap/graph\"\n    \n  >\n    <div id=\"mindmap-integration-status\" class=\"mindmap-integration-status\" aria-label=\"Data source integration status\">\n    \n    </div>\n    <div id=\"mindmap-spine-chrome\" class=\"mindmap-spine-chrome\" aria-live=\"polite\" aria-label=\"Focus spine summary\">\n      <span class=\"mindmap-spine-chrome__conviction\" data-spine=\"conviction\">Focus conviction — loading</span>\n      <span class=\"mindmap-spine-chrome__learn\" data-spine=\"learn\">Last learn — loading</span>\n    </div>\n    <p id=\"mindmap-graph-empty\" class=\"mindmap-honest-empty\">\n      Mindmap graph is empty on this deploy — trail rows and dispositions will appear as the learning loop warms up.\n    </p>\n    <ul id=\"mindmap-trail-list\" class=\"mindmap-trail-list hidden\" aria-label=\"Subnet trail, grouped by subnet\"></ul>\n  </div>\n</section>\n\n<script src=\"/static/js/mindmap_graph.js?v=7b9cae5e\" defer></script>\n</section>\n<!-- 12. Learning Trail -->\n<section class=\"row\" id=\"section-trail\" aria-labelledby=\"trail-title\">\n  <div class=\"section-label\">Learning Trail</div>\n  <h2 class=\"section-title\" id=\"trail-title\">Trace &amp; Prediction History</h2>\n  <p class=\"section-sub\">Evidence → signal → decision → prediction → judge — newest first.</p>\n  \n  <div class=\"card card-muted\"><p class=\"empty\">Learning trail warming up — trace bus events chronicle Council decisions as the loop runs.</p></div>\n  \n</section>\n\n<details class=\"intel-ribs wrap-pad\" id=\"intel-ribs\">\n  <summary class=\"intel-ribs__summary\">More intel · movers · dev signals</summary>\n  <div class=\"intel-ribs__body\">\n    \n<section class=\"sr-simileads wrap-pad\" id=\"section-simileads\" aria-labelledby=\"simileads-title\">\n  <div class=\"sr-simileads__head\">\n    <h2 class=\"sr-simileads__title\" id=\"simileads-title\">SimiLeads</h2>\n    <p class=\"sr-simileads__sub\">Score rising · price flat — mispricing watch</p>\n  </div>\n  \n  <p class=\"sr-simileads__empty\">No score–price divergence right now — fills when council warms ahead of tape.</p>\n  \n</section>\n    \n\n\n\n<section class=\"row caution-cells\" id=\"section-caution-cells\" aria-label=\"Caution cells\" hidden>\n  <div class=\"section-label\">Caution</div>\n  <ul class=\"caution-cells__list\" id=\"caution-cells-list\"></ul>\n</section>\n\n    \n\n\n\n\n\n\n\n<section class=\"sr-intel\" id=\"section-todays-intel\" aria-labelledby=\"todays-intel-title\">\n  <h2 class=\"sr-intel__title\" id=\"todays-intel-title\">Today&apos;s Intel</h2>\n  <div class=\"sr-intel__grid\">\n    \n    \n  </div>\n</section>\n    \n\n<section class=\"sr-dev-desk\" id=\"section-dev-signals-desk\" aria-labelledby=\"dev-signals-desk-title\">\n  <div class=\"sr-dev-desk__head\">\n    <h2 class=\"sr-dev-desk__title\" id=\"dev-signals-desk-title\">Dev Signals Desk</h2>\n    <p class=\"sr-dev-desk__sub\">Council signal pipeline — evidence from live posture, not curated research cards.</p>\n  </div>\n  \n  <p class=\"sr-dev-desk__empty\">Signal desk warming up — council posture cards appear after the pipeline scores subnets.</p>\n  \n</section>\n  </div>\n</details>\n\n<details class=\"letters-drawer wrap-pad\" id=\"letters-drawer\">\n  <summary>Letters · weekly &amp; daily</summary>\n  \n<section class=\"weekly-letter wrap-pad\" id=\"section-weekly-letter\" aria-labelledby=\"weekly-letter-title\">\n  <div class=\"weekly-letter__head\">\n    <h2 class=\"weekly-letter__title\" id=\"weekly-letter-title\">Weekly letter</h2>\n    <p class=\"weekly-letter__meta\" id=\"weekly-letter-week\">SimiVision digest · loading…</p>\n    <div class=\"weekly-letter__actions\">\n      <button type=\"button\" class=\"tab-btn\" id=\"weekly-letter-copy\" disabled>Copy markdown</button>\n      <button type=\"button\" class=\"tab-btn\" id=\"weekly-letter-download\" disabled>Download</button>\n    </div>\n  </div>\n  <div id=\"weekly-letter-root\" class=\"weekly-letter__body is-loading\" aria-live=\"polite\" aria-busy=\"true\">\n    <div class=\"hydrate-skeleton\" aria-hidden=\"true\">\n      <span class=\"hydrate-skeleton__line\"></span>\n      <span class=\"hydrate-skeleton__line hydrate-skeleton__line--med\"></span>\n      <span class=\"hydrate-skeleton__line hydrate-skeleton__line--short\"></span>\n    </div>\n  </div>\n</section>\n  \n<section class=\"weekly-letter daily-recap wrap-pad\" id=\"section-daily-recap\" aria-labelledby=\"daily-recap-title\">\n  <div class=\"weekly-letter__head\">\n    <h2 class=\"weekly-letter__title\" id=\"daily-recap-title\">Yesterday recap</h2>\n    <p class=\"weekly-letter__meta\" id=\"daily-recap-date\">Morning briefing · loading…</p>\n    <div class=\"weekly-letter__actions\">\n      <button type=\"button\" class=\"tab-btn\" id=\"daily-letter-copy\" disabled>Copy markdown</button>\n      <button type=\"button\" class=\"tab-btn\" id=\"daily-letter-download\" disabled>Download</button>\n    </div>\n  </div>\n  <div id=\"daily-recap-root\" class=\"weekly-letter__body is-loading\" aria-live=\"polite\" aria-busy=\"true\">\n    <div class=\"hydrate-skeleton\" aria-hidden=\"true\">\n      <span class=\"hydrate-skeleton__line\"></span>\n      <span class=\"hydrate-skeleton__line hydrate-skeleton__line--med\"></span>\n      <span class=\"hydrate-skeleton__line hydrate-skeleton__line--short\"></span>\n    </div>\n  </div>\n</section>\n</details>\n\n\n<details class=\"pro-drawer wrap-pad\" id=\"pro-cockpit\">\n  <summary class=\"pro-drawer__summary\">\n    <span>Pro cockpit</span>\n    <span class=\"pro-drawer__hint\">Story path · council bench · KPI · backtest</span>\n  </summary>\n  <div class=\"pro-drawer__body council-primary\">\n    \n<section class=\"story-path wrap-pad\" id=\"section-story-path\" aria-labelledby=\"story-path-title\">\n  \n  \n  <div class=\"story-path__head\">\n    <h2 class=\"story-path__heading\" id=\"story-path-title\">How we got here</h2>\n    <p class=\"story-path__sub\">Signals → judges → council pick → outcome → learning</p>\n  </div>\n  <ol class=\"story-path__chain\" id=\"story-path-chain\" aria-live=\"polite\">\n    \n    <li class=\"story-path__empty\" id=\"story-path-empty\">\n      \n        Quiet — story path fills when council clears an audited pick.\n      \n    </li>\n    \n  </ol>\n</section>\n    <div class=\"council-bench\">\n      <!-- 6. Council -->\n\n\n<style>\n  .council-bench-section { margin-top: 4px; }\n  .council-bench-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }\n  .council-bench-head .section-sub { margin: 4px 0 0; }\n  .council-grid.council-bench { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }\n  .council-arc-card { --arc-accent: #3fc9ff; display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 16px; border: 1px solid rgba(148,178,255,.16); background: transparent; backdrop-filter: blur(10px) saturate(140%); -webkit-backdrop-filter: blur(10px) saturate(140%); }\n  .council-arc { position: relative; width: 56px; height: 56px; flex: none; }\n  .council-arc svg { width: 100%; height: 100%; transform: rotate(-90deg); }\n  .council-arc__track { fill: none; stroke: rgba(255,255,255,.1); stroke-width: 3.5; }\n  .council-arc__fill { fill: none; stroke: var(--arc-accent); stroke-width: 3.5; stroke-linecap: round; filter: drop-shadow(0 0 5px var(--arc-accent)); transition: stroke-dasharray 1s cubic-bezier(.4,0,.2,1); }\n  .council-arc__value { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; }\n  .council-arc-card__body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }\n  .council-arc-card__name { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #fff; margin: 0; }\n  .council-arc-card__bias { align-self: flex-start; font-size: 8px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; border: 1px solid; background: transparent; }\n  .council-arc-card__bias--up { color: #7dffb0; border-color: rgba(74,232,152,.4); }\n  .council-arc-card__bias--down { color: #ff9a7a; border-color: rgba(255,107,122,.4); }\n  .council-arc-card__bias--even { color: rgba(255,255,255,.62); border-color: rgba(148,178,255,.32); }\n  .council-arc-card__bias--prior { color: #ffd58a; border-color: rgba(255,183,74,.42); }\n  .council-arc-card__graded { font-size: 8px; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.42); }\n  .council-arc-card__graded b { color: rgba(255,255,255,.72); font-variant-numeric: tabular-nums; }\n  .council-rogue { display: flex; align-items: center; gap: 12px; margin-top: 10px; padding: 10px 14px; border-radius: 14px; border: 1px dashed rgba(255,183,74,.45); background: transparent; }\n  .council-rogue__arc { position: relative; width: 44px; height: 44px; flex: none; }\n  .council-rogue__arc svg { width: 100%; height: 100%; transform: rotate(-90deg); }\n  .council-rogue__fill { stroke: #ffb74a; }\n  .council-rogue__value { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; color: #ffd58a; font-variant-numeric: tabular-nums; }\n  .council-rogue__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n  .council-rogue__name { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #ffd58a; margin: 0; }\n  .council-rogue__tag { font-size: 7.5px; font-weight: 800; letter-spacing: .14em; padding: 2px 8px; border-radius: 999px; border: 1px solid rgba(255,183,74,.4); color: rgba(255,217,138,.85); text-transform: uppercase; }\n  .council-rogue__meta { margin: 0; font-size: 10px; color: rgba(255,255,255,.55); line-height: 1.5; }\n  .council-rogue__meta b { color: #ffd58a; }\n  .council-cap-note { margin: 8px 0 0; font-size: 9.5px; color: rgba(255,255,255,.45); line-height: 1.5; }\n  @media (max-width: 720px) { .council-grid.council-bench { grid-template-columns: repeat(2, 1fr); } }\n  @media (max-width: 420px) { .council-grid.council-bench { grid-template-columns: 1fr; } }\n  @media (prefers-reduced-motion: reduce) { .council-arc__fill { transition: none; } }\n  @keyframes cgRogueFlash { 0% { color: #ffd58a; text-shadow: 0 0 10px rgba(255,183,74,.55); } 100% { color: inherit; text-shadow: none; } }\n  .council-arc__value.flash, .council-rogue__value.flash { animation: cgRogueFlash .8s ease-out; }\n</style>\n<section class=\"row council-bench-section\" id=\"section-council\" aria-labelledby=\"council-title\">\n  <div class=\"council-bench-head\">\n    <div>\n      <div class=\"section-label\">Bench</div>\n      <h2 class=\"section-title\" id=\"council-title\">Expert weights</h2>\n      <p class=\"section-sub\">Council weights (soul map) — quant, hype, dark horse, technical move when predictions resolve.</p>\n    </div>\n    \n    \n    \n  </div>\n  \n  <div class=\"card card-muted\" aria-live=\"polite\">\n    <div class=\"hydrate-skeleton hydrate-skeleton--tall\" aria-hidden=\"true\">\n      <div class=\"hydrate-skeleton__line hydrate-skeleton__line--med\"></div>\n      <div class=\"hydrate-skeleton__line\"></div>\n      <div class=\"hydrate-skeleton__line hydrate-skeleton__line--short\"></div>\n    </div>\n    <p class=\"sr-only\" role=\"status\">Council weights warming up</p>\n  </div>\n  \n\n  \n  \n</section>\n      <!-- 8. Judges -->\n<section class=\"row\" id=\"section-judges\" aria-labelledby=\"judges-title\">\n  <div class=\"section-label\">Judges</div>\n  <h2 class=\"section-title\" id=\"judges-title\">Three-judge read</h2>\n  <p class=\"section-sub\">Lane judges (Oracle / Echo / Pulse) — consensus on the active call.</p>\n  <div id=\"judges-panel\" class=\"card\" aria-live=\"polite\">\n    <p class=\"empty empty--quiet\">Quiet — lane judges (Oracle, Echo, Pulse) load when you open this drawer or when the focus subnet API responds.</p>\n  </div>\n</section>\n    </div>\n    <!-- 4. Top Picks -->\n<section class=\"row\" id=\"section-picks\" aria-labelledby=\"picks-title\">\n  <div class=\"section-label\">Horizons</div>\n  <h2 class=\"section-title\" id=\"picks-title\">1h and 24h calls</h2>\n  <p class=\"section-sub\">Shorter-horizon council picks — predicted move windows, not past returns.</p>\n  \n  <div class=\"card card-muted\"><p class=\"empty empty--quiet\">Quiet — no hour or day horizon picks ranked yet. Shorter calls appear when council scoring runs.</p></div>\n  \n</section>\n    <!-- 5. KPI Strip -->\n<section class=\"row\" id=\"section-kpi\" aria-labelledby=\"kpi-title\">\n  <div class=\"section-label\">KPI Strip</div>\n  <h2 class=\"section-title\" id=\"kpi-title\">Learning Loop KPIs</h2>\n  <p class=\"section-sub\">Resolver accuracy and prediction backlog — graded stats only.</p>\n  \n  \n  <div class=\"kpi-strip\" id=\"kpi-strip-root\">\n    <div class=\"kpi card kpi--accuracy-gauge\" id=\"kpi-accuracy-card\" style=\"--kpi-p: 0.0\">\n      <div class=\"kpi__gauge-ring\" aria-hidden=\"true\"></div>\n      <div class=\"lbl\">Accuracy</div>\n      <div class=\"val\" id=\"kpi-accuracy\">0.0%</div>\n      <div class=\"sub\" id=\"kpi-graded\">0✓ / 0✗ graded</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Expired</div>\n      <div class=\"val\" id=\"kpi-expired\">—</div>\n      <div class=\"sub\" id=\"kpi-expired-rate\">resolver backlog</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Cold Cache</div>\n      <div class=\"val\" id=\"kpi-cold-cache\">—</div>\n      <div class=\"sub\" id=\"kpi-cold-cache-sub\">missing price at horizon</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Pending</div>\n      <div class=\"val\" id=\"kpi-pending\">0</div>\n      <div class=\"sub\">awaiting horizon</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Integrity</div>\n      <div class=\"val\" id=\"kpi-integrity\" style=\"font-size:15px;\">—</div>\n      <div class=\"sub\" id=\"kpi-watchdog\">Resolver integrity</div>\n    </div>\n  </div>\n</section>\n    <!-- Judge backtest history (N4 / O2) -->\n<section class=\"row\" id=\"section-backtest\" aria-labelledby=\"backtest-title\">\n  <div class=\"section-label\">Signal Quality</div>\n  <h2 class=\"section-title\" id=\"backtest-title\">Judge Backtest History</h2>\n  <p class=\"section-sub\">Oracle, Echo, and Pulse paper-trade replay on resolved council predictions.</p>\n  <div class=\"card card-muted\" id=\"backtest-panel-root\">\n    <p class=\"empty empty--quiet\">Building — judge backtest replay loads from resolved predictions when the API responds.</p>\n  </div>\n  <div id=\"formula-lineage-root\" class=\"formula-lineage-root\" aria-live=\"polite\"></div>\n  <div id=\"formula-evolution-root\" class=\"formula-evolution-root\" aria-live=\"polite\"></div>\n</section>\n  </div>\n</details>\n\n\n<details class=\"market-drawer wrap-pad\" id=\"market-drawer\">\n  <summary class=\"market-drawer__summary\">\n    <span>Market &amp; tools</span>\n    <span class=\"market-drawer__hint\">Scanner · signals · staking · analytics</span>\n  </summary>\n  <div class=\"market-drawer__body\">\n    <!-- Hero / Market Snapshot -->\n<section class=\"row\" id=\"section-hero\" aria-labelledby=\"hero-title\">\n  <div class=\"section-label\">Market Snapshot · Live Feed</div>\n  <h2 class=\"section-title\" id=\"hero-title\">Bittensor Subnet Intelligence</h2>\n  <p class=\"section-sub\">Live scanner across 0 subnets · breadth <b>NEUTRAL</b></p>\n  \n  <div class=\"card card-muted\"><p class=\"empty\">Market snapshot warming up — subnet registry populates after the first data fetch.</p></div>\n  \n  <!-- NET FLOW always mounted so council_polish.js can hydrate after empty SSR. -->\n  <div class=\"cpol-netflow\" id=\"cpol-netflow\" data-api=\"/api/whales/flow-signals?hours=24&limit=10\">\n    <div class=\"cpol-nf-kicker\">NET FLOW · 24h — whale money in vs out</div>\n    <div class=\"cpol-nf-main\">\n      <div class=\"cpol-nf-value cpol-skel\" style=\"width:128px;height:36px;border-radius:10px\"></div>\n    </div>\n    <div class=\"cpol-nf-meta cpol-skel\" style=\"width:62%;height:12px;border-radius:6px;margin-top:10px\"></div>\n  </div>\n</section>\n    <!-- 2. Scanner -->\n<section class=\"row\" id=\"section-scanner\" aria-labelledby=\"scanner-title\">\n  <div class=\"section-label\">Scanner</div>\n  <h2 class=\"section-title\" id=\"scanner-title\">Live Subnet Scanner</h2>\n  <p class=\"section-sub\">Filter and sort the full registry — click a row for the shareable subnet page.</p>\n  <div class=\"card\">\n    <div class=\"card-head\">\n      <h3>Registry</h3>\n      <span class=\"src-tag\" id=\"scanner-meta\">Loading…</span>\n    </div>\n    <div class=\"tab-bar\" role=\"tablist\" aria-label=\"Scanner filters\" id=\"scanner-filters\">\n      <button type=\"button\" class=\"tab-btn active\" data-filter=\"all\">All</button>\n      <button type=\"button\" class=\"tab-btn\" data-filter=\"active\">Active</button>\n      <button type=\"button\" class=\"tab-btn\" data-filter=\"at-risk\">At Risk</button>\n      <button type=\"button\" class=\"tab-btn\" data-filter=\"deprecated\">Deprecated</button>\n    </div>\n    <div class=\"scanner-toolbar\">\n      <input type=\"search\" id=\"scanner-search\" class=\"chat-input input scanner-search\" placeholder=\"Search name or ID…\" aria-label=\"Search subnets\">\n      <select id=\"scanner-sort\" class=\"src-tag scanner-sort\" aria-label=\"Sort subnets\">\n        <option value=\"id\">Sort: ID</option>\n        <option value=\"emission\">Sort: Emission</option>\n        <option value=\"apy\">Sort: APY</option>\n      </select>\n    </div>\n    <div id=\"scanner-table\" class=\"scroll-y\" aria-live=\"polite\"></div>\n    <!-- O3 subnet report panel (API: GET /api/report/{netuid}) -->\n<div\n  id=\"subnet-report-panel\"\n  class=\"subnet-report\"\n  hidden\n  role=\"region\"\n  aria-labelledby=\"subnet-report-title\"\n  aria-busy=\"false\"\n  tabindex=\"-1\"\n>\n  <div class=\"subnet-report__head\">\n    <h3 class=\"subnet-report__title\" id=\"subnet-report-title\">Subnet report</h3>\n    <button type=\"button\" class=\"tab-btn subnet-report__close\" id=\"subnet-report-close\" aria-label=\"Close report\">Close</button>\n  </div>\n  <p class=\"subnet-report__meta\" id=\"subnet-report-meta\"></p>\n  <div id=\"subnet-report-body\" class=\"subnet-report__body\" aria-live=\"polite\">\n    <p class=\"subnet-report__empty\">Select a subnet in the scanner to load its report.</p>\n  </div>\n</div>\n  </div>\n</section>\n    <section class=\"investigation-panel wrap-pad\" id=\"section-investigation\" aria-labelledby=\"investigation-title\">\n  <h2 class=\"section-title\" id=\"investigation-title\">On-chain investigation</h2>\n  <p class=\"section-sub\">Wallet flows, subnet sellers, whale leaderboards — TaoStats-backed when API key is set.</p>\n\n  <div class=\"investigation-signals\" id=\"inv-signals-strip\">\n    <div class=\"investigation-signal-card\" id=\"inv-whale-summary\" aria-live=\"polite\">\n      <h3 class=\"investigation-signal-card__title\">Whale desk</h3>\n      <p class=\"investigation-signal-card__body\">Loading whale summary…</p>\n    </div>\n    <div class=\"investigation-signal-card\" id=\"inv-rugger-strip\" aria-live=\"polite\">\n      <h3 class=\"investigation-signal-card__title\">Rug watch</h3>\n      <p class=\"investigation-signal-card__body\">Loading rugger summary…</p>\n    </div>\n    <div class=\"investigation-signal-card\" id=\"inv-flow-strip\" aria-live=\"polite\">\n      <h3 class=\"investigation-signal-card__title\">Flow signals</h3>\n      <p class=\"investigation-signal-card__body\">Loading flow flips…</p>\n    </div>\n  </div>\n\n  <div class=\"investigation-grid\">\n    <div class=\"investigation-card\">\n      <h3>Subnet sellers</h3>\n      <label>Netuid <input type=\"number\" id=\"inv-netuid\" min=\"0\" max=\"256\" value=\"82\" class=\"inv-input\" /></label>\n      <button type=\"button\" id=\"inv-sellers-btn\" class=\"btn-secondary\">Top sellers</button>\n      <div id=\"inv-sellers-out\" class=\"inv-out\" aria-live=\"polite\">—</div>\n    </div>\n\n    <div class=\"investigation-card\">\n      <h3>Wallet lookup</h3>\n      <label>Coldkey <input type=\"text\" id=\"inv-wallet\" placeholder=\"5H6h1PUD…\" class=\"inv-input inv-wallet\" /></label>\n      <button type=\"button\" id=\"inv-wallet-btn\" class=\"btn-secondary\">Trace wallet</button>\n      <div id=\"inv-wallet-out\" class=\"inv-out\" aria-live=\"polite\">—</div>\n    </div>\n\n    <div class=\"investigation-card\">\n      <h3>Chat presets</h3>\n      <div class=\"inv-presets\">\n        <button type=\"button\" class=\"btn-secondary inv-preset\" data-action=\"sellers\" data-prompt=\"Who is selling {name} (SN{netuid})?\">Sellers: focus SN</button>\n        <button type=\"button\" class=\"btn-secondary inv-preset\" data-action=\"wallet\" data-prompt=\"Trace wallet activity for the address I provide on {name}.\">Trace wallet</button>\n        <button type=\"button\" class=\"btn-secondary inv-preset\" data-action=\"owner-check\">Owner vs sellers (API)</button>\n        <button type=\"button\" class=\"btn-secondary inv-preset\" data-action=\"ask\" data-prompt=\"Summarize seller risk and owner overlap for {name} (SN{netuid}).\">Ask investigation desk</button>\n        <button type=\"button\" class=\"btn-secondary inv-preset\" data-action=\"chat\" data-prompt=\"Is the subnet owner among recent sellers on SN{netuid}?\">Owner vs sellers (chat)</button>\n      </div>\n    </div>\n\n    <div class=\"investigation-card investigation-card--wide\">\n      <h3>Whale leaderboards</h3>\n      <div id=\"whale-leaderboards\" class=\"whale-boards\" aria-live=\"polite\">Open drawer loads whale boards…</div>\n    </div>\n  </div>\n</section>\n    <!-- Phase L — Live signals -->\n\n<section class=\"row\" id=\"section-signals\" aria-labelledby=\"signals-title\">\n  <div class=\"section-label\">Live Signals</div>\n  <h2 class=\"section-title\" id=\"signals-title\">Council Signal Pipeline</h2>\n  <p class=\"section-sub\">Buy / sell / neutral posture from the Phase L pipeline — <span id=\"signals-ws-status\" class=\"src-tag\">snapshot</span></p>\n  \n  <div class=\"kpi-strip\" id=\"signal-summary-root\">\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Tracked</div>\n      <div class=\"val\">0</div>\n      <div class=\"sub\">subnets with signals</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Buy</div>\n      <div class=\"val pos\">0</div>\n      <div class=\"sub\">bullish posture</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Sell</div>\n      <div class=\"val neg\">0</div>\n      <div class=\"sub\">bearish posture</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Neutral</div>\n      <div class=\"val\">0</div>\n      <div class=\"sub\">ratio 0.0</div>\n    </div>\n    <div class=\"kpi card\">\n      <div class=\"lbl\">Avg conf</div>\n      <div class=\"val accent-bright\">0.0%</div>\n      <div class=\"sub\">council confidence</div>\n    </div>\n  </div>\n  \n  <div class=\"card mt-3\">\n    <div class=\"card-head\">\n      <h3>Signal feed</h3>\n      <span class=\"src-tag\" id=\"signals-count-meta\">0 subnets</span>\n    </div>\n    <div id=\"signals-feed-root\" class=\"scroll-y\" aria-live=\"polite\">\n      \n      \n\n\n<div\n  class=\"desk-empty-state desk-empty-state--warming desk-empty-state--inline\"\n  \n  role=\"status\"\n>\n  <span class=\"desk-empty-state__glyph\" aria-hidden=\"true\"></span>\n  <div class=\"desk-empty-state__body\">\n    <p class=\"desk-empty-state__title\">Signal feed loading</p>\n    <p class=\"desk-empty-state__text\">Council scores populate once the subnet registry is available.</p>\n    \n  </div>\n</div>\n\n      \n    </div>\n  </div>\n</section>\n    <!-- Phase L — Alerts -->\n<section class=\"row\" id=\"section-alerts\" aria-labelledby=\"alerts-title\">\n  <div class=\"section-label\">Alerts</div>\n  <h2 class=\"section-title\" id=\"alerts-title\">Threshold &amp; Signal Alerts</h2>\n  <p class=\"section-sub\">Active breaches and signal-change notifications from <code>/api/alerts</code>.</p>\n  <div id=\"alerts-feed-root\" class=\"picks\" aria-live=\"polite\">\n    \n    <div class=\"card card-muted\"><p class=\"empty\">No active alerts — threshold breaches and signal changes appear here when detected.</p></div>\n    \n  </div>\n</section>\n    <!-- 3. Staking / Yield -->\n<section class=\"row\" id=\"section-staking\" aria-labelledby=\"staking-title\">\n  <div class=\"section-label\">Staking / Yield</div>\n  <h2 class=\"section-title\" id=\"staking-title\">Staking APY Leaders</h2>\n  <p class=\"section-sub\">Top subnets by stake yield — ranked from live registry economics. <span class=\"heuristic-tag\">Heuristic · /api/subnets</span></p>\n  \n  \n  <div class=\"card card-muted\"><p class=\"empty\">Loading staking APY leaders from live feed…</p></div>\n  \n</section>\n    <!-- 1. Technical Indicators -->\n<section class=\"row\" id=\"section-indicators\" aria-labelledby=\"indicators-title\">\n  <div class=\"section-label\">Technical Indicators</div>\n  <h2 class=\"section-title\" id=\"indicators-title\">Oscillator Panel</h2>\n  <p class=\"section-sub\">Sparkline momentum and heat-bar signal strength across top subnets.</p>\n  \n  <div class=\"card card-muted\"><p class=\"empty\">Technical indicators warming up — oscillator panel populates after price snapshots and candle history accumulate.</p></div>\n  \n</section>\n    <!-- 13. Undervalued Radar -->\n<section class=\"row\" id=\"section-undervalued\" aria-labelledby=\"undervalued-title\">\n  <div class=\"section-label\">Undervalued Radar</div>\n  <h2 class=\"section-title\" id=\"undervalued-title\">Undervalued Scoring Grid</h2>\n  <p class=\"section-sub\">Yield minus 24h momentum — higher score suggests deeper value vs. recent price action. <span class=\"heuristic-tag\">Heuristic · /api/subnets</span></p>\n  \n  <div class=\"card card-muted\"><p class=\"empty\">Loading undervalued scores from live subnet feed…</p></div>\n  \n</section>\n    <!-- 7. Radar -->\n<section class=\"row\" id=\"section-radar\" aria-labelledby=\"radar-title\">\n  <div class=\"section-label\">Radar</div>\n  <h2 class=\"section-title\" id=\"radar-title\">Undervalued Overlay Radar</h2>\n  <p class=\"section-sub\">Five-axis radar comparing yield, momentum, emission, social, and composite undervalued score. <span class=\"heuristic-tag\">Heuristic · /api/subnets</span></p>\n  \n  \n  <div class=\"card card-muted\"><p class=\"empty\">Radar chart warming up — needs at least three subnets with registry economics.</p></div>\n  \n</section>\n    <!-- 2b. Subnet rollup (optional grouping lane) -->\n<section class=\"row\" id=\"section-subnet-groups\" aria-labelledby=\"subnet-groups-title\">\n  <div class=\"section-label\">Subnet lens</div>\n  <h2 class=\"section-title\" id=\"subnet-groups-title\">Per-subnet rollup</h2>\n  <p class=\"section-sub\">Collapse indicators, picks, trail, and predictions by subnet — keyed on <code>netuid</code> / <code>id</code>.</p>\n  <div id=\"subnet-groups-root\" class=\"subnet-groups-stack\" aria-live=\"polite\">\n    <p class=\"empty\">Building subnet rollup…</p>\n  </div>\n</section>\n    <!-- 10. Social -->\n<section class=\"row\" id=\"section-social\" aria-labelledby=\"social-title\">\n  <div class=\"section-label\">Social</div>\n  <h2 class=\"section-title\" id=\"social-title\">Social Sentiment</h2>\n  <p class=\"section-sub\">Per-subnet mention volume and sentiment from message intel or registry fields.</p>\n  <div id=\"social-sentiment-root\">\n  \n  \n  \n  <div class=\"card card-muted\"><p class=\"empty\">No social mentions for today&apos;s desk yet — Telegram ingest is off on this deploy.</p></div>\n  \n  </div>\n</section>\n    <!-- 11. Chat -->\n<section class=\"row\" id=\"section-chat\" aria-labelledby=\"chat-title\">\n  <div class=\"section-label\">Chat</div>\n  <h2 class=\"section-title\" id=\"chat-title\">SimiVision Chat</h2>\n  <p class=\"section-sub\">Ask the intelligence layer — grounded in live mindmap context when available.</p>\n  <div class=\"chat-presets\" id=\"chatPresets\" role=\"group\" aria-label=\"Quick prompts\">\n    <button type=\"button\" class=\"chat-preset\" data-prompt=\"Why is today's pick on this subnet?\">Why today's pick?</button>\n    <button type=\"button\" class=\"chat-preset\" data-prompt=\"Explain yield trap vs staking APY for the daily call.\">Yield vs price</button>\n    <button type=\"button\" class=\"chat-preset\" data-prompt=\"What signals are working best on graded picks?\">What's working</button>\n    <button type=\"button\" class=\"chat-preset\" data-prompt=\"Summarize learning stats and resolver integrity.\">Learning stats</button>\n  </div>\n  <div class=\"card chat-box\">\n    <div class=\"chat-log\" id=\"chatLog\" role=\"log\" aria-live=\"polite\">\n      <div class=\"chat-msg bot\">\n        <div class=\"who\">SIMIVISION</div>\n        <div class=\"chat-text\">Council cockpit online. Ask about subnets, picks, or learning stats.</div>\n      </div>\n    </div>\n    <div class=\"chat-input\">\n      <input type=\"text\" id=\"chatInput\" placeholder=\"Ask SimiVision…\" aria-label=\"Chat message\" autocomplete=\"off\">\n      <button type=\"button\" id=\"chatSend\">Send</button>\n    </div>\n    <p class=\"chat-meta\" id=\"chatMeta\">LLM: ready</p>\n  </div>\n</section>\n  </div>\n</details>\n\n\n\n\n\n  \n\n\n\n\n<footer class=\"status\" id=\"section-footer\" data-source=\"snapshot\">\n  <div class=\"footer-cards\" aria-label=\"Site status\">\n    <div class=\"footer-card footer-card--source\">\n      <span class=\"footer-card__lbl\">Source</span>\n      <span class=\"footer-card__val\"><span class=\"st-dot\" aria-hidden=\"true\"></span> <b id=\"footer-source-label\">Snapshot</b></span>\n    </div>\n    <div class=\"footer-card\">\n      <span class=\"footer-card__lbl\">Subnets</span>\n      <span class=\"footer-card__val\" data-footer-metric=\"subnets\"><b id=\"footer-subnets-count\">—</b></span>\n    </div>\n    <div class=\"footer-card\">\n      <span class=\"footer-card__lbl\">Trail</span>\n      <span class=\"footer-card__val\" data-footer-metric=\"trail\"><b id=\"footer-trail-count\">—</b></span>\n    </div>\n    <div class=\"footer-card footer-card--integrations\">\n      <span class=\"footer-card__lbl\">Integrations</span>\n      <span class=\"footer-