 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[],"headersSize":714,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:41 GMT"},{"name":"etag","value":"\"383b89269b7ba5e0988f9d8dbba16c07\""},{"name":"fly-request-id","value":"01M109E9313WFFF95P5PKM12DM-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=1831.2"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":6226,"mimeType":"text/javascript; charset=utf-8","compression":3676,"text":"/* Optional lane — per-subnet grouping / collapse (frontend-only) */\n(function () {\n  'use strict';\n\n  var dataEl = document.getElementById('subnet-group-data');\n  var rootEl = document.getElementById('subnet-groups-root');\n  if (!dataEl || !rootEl) return;\n\n  var STORAGE_PREFIX = 'subnet-group-open-'; // persisted open state per netuid\n\n  function confPct(c) {\n    c = Number(c) || 0;\n    return c <= 1 ? c * 100 : c;\n  }\n\n  function esc(s) {\n    return String(s).replace(/[&<>\"']/g, function (c) {\n      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c];\n    });\n  }\n\n  function subnetKey(row) {\n    if (!row) return null;\n    var n = row.netuid != null ? row.netuid : row.id;\n    return n == null ? null : Number(n);\n  }\n\n  function parseData() {\n    try {\n      return JSON.parse(dataEl.textContent);\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function buildGroups(data) {\n    var groups = {};\n    (data.roster || []).forEach(function (sn) {\n      var key = subnetKey(sn);\n      if (key == null) return;\n      groups[key] = {\n        meta: sn,\n        indicators: [],\n        hour_picks: [],\n        day_picks: [],\n        trail: [],\n        predictions: [],\n      };\n    });\n\n    function assign(list, field) {\n      (list || []).forEach(function (row) {\n        var key = subnetKey(row);\n        if (key == null) return;\n        if (!groups[key]) {\n          groups[key] = {\n            meta: row,\n            indicators: [],\n            hour_picks: [],\n            day_picks: [],\n            trail: [],\n            predictions: [],\n          };\n        }\n        groups[key][field].push(row);\n      });\n    }\n\n    assign(data.indicators, 'indicators');\n    assign(data.hour_picks, 'hour_picks');\n    assign(data.day_picks, 'day_picks');\n    assign(data.predictions, 'predictions');\n\n    (data.trail || []).forEach(function (row) {\n      var key = subnetKey(row);\n      if (key != null && groups[key]) {\n        groups[key].trail.push(row);\n        return;\n      }\n      if (!row.subnet) return;\n      Object.keys(groups).forEach(function (k) {\n        var g = groups[k];\n        if (g.meta && g.meta.name === row.subnet) g.trail.push(row);\n      });\n    });\n\n    return groups;\n  }\n\n  function signalCount(g) {\n    return (\n      g.indicators.length +\n      g.hour_picks.length +\n      g.day_picks.length +\n      g.trail.length +\n      g.predictions.length\n    );\n  }\n\n  function renderChild(label, text) {\n    return (\n      '<div class=\"subnet-group-item\">' +\n      '<span class=\"subnet-group-item-label\">' + esc(label) + '</span>' +\n      '<span class=\"subnet-group-item-val\">' + esc(text) + '</span>' +\n      '</div>'\n    );\n  }\n\n  function renderGroup(key, g) {\n    var meta = g.meta || {};\n    var name = meta.name || ('SN' + key);\n    var id = subnetKey(meta) || key;\n    var count = signalCount(g);\n    if (count === 0) return '';\n\n    var open = localStorage.getItem(STORAGE_PREFIX + key) === '1';\n    var items = '';\n\n    g.indicators.forEach(function (row) {\n      var os = row.oversold || {};\n      var ob = row.overbought || {};\n      var parts = [];\n      if (os.convergent) parts.push('OVERSOLD ' + (os.count || 0) + '/' + (os.total || 0));\n      if (ob.convergent) parts.push('OVERBOUGHT ' + (ob.count || 0) + '/' + (ob.total || 0));\n      if (!parts.length) parts.push('NEUTRAL');\n      items += renderChild('Indicators', parts.join(' · '));\n    });\n    g.hour_picks.forEach(function (row) {\n      items += renderChild(\n        'Hour pick',\n        'score ' + Number(row.score || 0).toFixed(1) +\n          ' · conf ' + confPct(row.confidence).toFixed(0) + '%'\n      );\n    });\n    g.day_picks.forEach(function (row) {\n      items += renderChild(\n        'Day pick',\n        'score ' + Number(row.score || 0).toFixed(1) +\n          ' · conf ' + confPct(row.confidence).toFixed(0) + '%'\n      );\n    });\n    g.trail.forEach(function (row) {\n      items += renderChild('Trail', (row.signal || '—') + ' → ' + (row.decision || '—'));\n    });\n    g.predictions.forEach(function (row) {\n      items += renderChild('Prediction', row.statement || row.status || 'pending');\n    });\n\n    var status = String(meta.status || 'unknown');\n    var badge =\n      status === 'active' ? 'badge-buy' : status === 'deprecated' ? 'badge-sell' : 'badge-watch';\n\n    return (\n      '<details class=\"subnet-group card\" data-subnet-key=\"' + id + '\"' + (open ? ' open' : '') + '>' +\n      '<summary class=\"subnet-group-summary\">' +\n      '<span class=\"subnet-group-caret\" aria-hidden=\"true\"></span>' +\n      '<span class=\"pick-name\">' + esc(name) + '</span>' +\n      '<span class=\"pick-meta\">SN' + id + '</span>' +\n      '<span class=\"badge ' + badge + '\">' + esc(status) + '</span>' +\n      '<span class=\"subnet-group-count\">' + count + ' signal' + (count === 1 ? '' : 's') + '</span>' +\n      '</summary>' +\n      '<div class=\"subnet-group-body\">' + items + '</div>' +\n      '</details>'\n    );\n  }\n\n  function init() {\n    var data = parseData();\n    if (!data) {\n      rootEl.innerHTML = '<p class=\"empty\">Subnet rollup unavailable — context payload missing.</p>';\n      return;\n    }\n\n    var groups = buildGroups(data);\n    var keys = Object.keys(groups)\n      .map(Number)\n      .sort(function (a, b) {\n        var ea = (groups[a].meta && groups[a].meta.emission) || 0;\n        var eb = (groups[b].meta && groups[b].meta.emission) || 0;\n        return eb - ea;\n      });\n\n    var html = keys.map(function (k) { return renderGroup(k, groups[k]); }).filter(Boolean).join('');\n    if (!html) {\n      rootEl.innerHTML =\n        '<p class=\"empty\">Subnet rollup warming up — signals appear as indicators, picks, and trail events populate.</p>';\n      return;\n    }\n\n    rootEl.innerHTML = html;\n    rootEl.querySelectorAll('details.subnet-group').forEach(function (el) {\n      el.addEventListener('toggle', function () {\n        var key = el.getAttribute('data-subnet-key');\n        if (!key) return;\n        localStorage.setItem(STORAGE_PREFIX + key, el.open ? '1' : '0');\n      });\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n\n  window.__refreshSubnetGroups = init;\n})();\n"},"headersSize":0,"bodySize":2550,"redirectURL":"","_transferSize":2550},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1958.187,"receive":61.812},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:42.390Z","time":-1,"request":{"method":"GET","url":"wss://subnet-dashboard.fly.dev/ws/signals","httpVersion":"HTTP/1.1","cookies":[{"name":"message-intel-owner","value":"raqQWnDH3EjgNHyWJqk3aMccc3rPDfjv.2d7d12887c6b313c7a823ef761f0e54170d116d61c455618a88f47e896a8cea1"}],"headers":[{"name":"Upgrade","value":"websocket"},{"name":"Origin","value":"https://subnet-dashboard.fly.dev"},{"name":"Cache-Control","value":"no-cache"},{"name":"Pragma","value":"no-cache"},{"name":"Cookie","value":"message-intel-owner=raqQWnDH3EjgNHyWJqk3aMccc3rPDfjv.2d7d12887c6b313c7a823ef761f0e54170d116d61c455618a88f47e896a8cea1"},{"name":"Connection","value":"Upgrade"},{"name":"Sec-WebSocket-Key","value":"I5ptUHITfl5uPziYVJ7A/A=="},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"},{"name":"Sec-WebSocket-Version","value":"13"},{"name":"Host","value":"subnet-dashboard.fly.dev"},{"name":"Sec-WebSocket-Extensions","value":"permessage-deflate; client_max_window_bits"}],"queryString":[],"headersSize":625,"bodySize":-1},"response":{"status":101,"statusText":"Switching Protocols","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"upgrade",