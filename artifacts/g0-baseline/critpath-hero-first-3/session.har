int -->\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css\" media=\"print\" onload=\"this.media='all'\">\n    <noscript><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css\"></noscript>\n    <link rel=\"stylesheet\" href=\"/static/css/chat.css\" media=\"print\" onload=\"this.media='all'\">\n    <noscript><link rel=\"stylesheet\" href=\"/static/css/chat.css\"></noscript>\n    <link rel=\"stylesheet\" href=\"/static/vendor/uplot/uPlot.min.css\" media=\"print\" onload=\"this.media='all'\">\n    <noscript><link rel=\"stylesheet\" href=\"/static/vendor/uplot/uPlot.min.css\"></noscript>\n</head>\n<body class=\"council-first-theme\">\n    <div class=\"cosmic-sky\" aria-hidden=\"true\"><span class=\"cosmic-sky__nebula\"></span></div>\n    \n<a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n<main id=\"main-content\" class=\"app-shell council-first\" tabindex=\"-1\">\n  \n\n<script>document.documentElement.dataset.hydrate='1';</script>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<div class=\"sr-front\">\n<header class=\"top sr-hud\" id=\"section-header\" aria-label=\"Site header\">\n  <div class=\"top-inner\">\n    <div class=\"logo\">\n      <div class=\"logo-mark brand-mark\" aria-hidden=\"true\"></div>\n      <div>\n        <div class=\"logo-text brand-mist\">SimiVision <span class=\"beta-stamp\" aria-label=\"Beta\">BETA</span></div>\n        <div class=\"logo-sub\">Subnet intelligence</div>\n      </div>\n    </div>\n    <div class=\"header-actions sr-hud-status\">\n      <span id=\"headerDataSource\" hidden>snapshot</span>\n      <span class=\"data-freshness-badge data-freshness-snapshot\" id=\"dataFreshnessBadge\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" title=\"Live feed correlation time\">Live</span>\n      <button type=\"button\" class=\"cmd-palette-trigger\" id=\"cmd-palette-trigger\" title=\"Search (Ctrl+K)\">Search</button>\n      <span class=\"live-pill live-pill--snapshot\" id=\"liveFeedPill\" role=\"status\" aria-live=\"polite\" hidden aria-hidden=\"true\"><span class=\"live-dot\" aria-hidden=\"true\"></span>SNAPSHOT</span>\n      <span class=\"utc-clock\" id=\"utcClock\" hidden aria-hidden=\"true\">--:--:-- UTC</span>\n      <span class=\"ops-readiness-badge ops-readiness--warming\" id=\"opsReadinessBadge\" role=\"status\" aria-live=\"polite\" hidden title=\"Production readiness\"></span>\n    </div>\n  </div>\n</header>\n<nav class=\"top-nav\" aria-label=\"Page sections\">\n  <a href=\"#section-daily-pick\" aria-current=\"page\">Council</a>\n  <a href=\"#section-simivision-picks\">Weighing</a>\n  <a href=\"#section-pump-alert\">Lead</a>\n  <a href=\"#section-living-focus\">Focus</a>\n  <a href=\"#section-proof-band\">Proof</a>\n</nav>\n<div id=\"subnetIntegrationsCorner\" class=\"subnet-integrations-corner\" hidden aria-live=\"polite\"></div>\n\n<section class=\"council-stage home-job\" id=\"section-daily-pick\" aria-labelledby=\"council-stage-title\" data-home-live=\"1\">\n  <div class=\"council-stage__atmosphere\" aria-hidden=\"true\"></div>\n  <div class=\"council-stage__inner\">\n    <div id=\"council-stage-body\" class=\"council-stage__body home-job__body\">\n      <div id=\"home-daily-call\" class=\"home-job__call-host\" aria-live=\"polite\">\n        <div\n          class=\"k3-dossier\"\n          id=\"k3-dossier\"\n          data-testid=\"council-hero\"\n        >\n          <div class=\"k3-layer open\" id=\"k3-layer-claim\">\n            \n\n\n\n\n<style>\n  .tribunal-hero { --glass: transparent; --glass-border: rgba(148,178,255,.16); position: relative; }\n  .tribunal-hero__eye-track { fill: none; stroke: rgba(255,255,255,.2); stroke-width: 11; stroke-linejoin: round; }\n  .tribunal-hero__arc { fill: none; stroke-width: 11; stroke-linecap: round; stroke-linejoin: round; opacity: .85; transition: stroke-dasharray .9s ease, stroke-dashoffset .9s ease, opacity .5s ease; }\n  .tribunal-hero__arc--oracle { stroke: url(#cgOracle); }\n  .tribunal-hero__arc--echo { stroke: url(#cgEcho); }\n  .tribunal-hero__arc--pulse { stroke: url(#cgPulse); }\n  .tribunal-hero__conviction-arc { fill: none; stroke: url(#cgConviction); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }\n  .tribunal-hero__comet { fill: rgba(210,240,255,.9); filter: drop-shadow(0 0 5px cyan); }\n  .tribunal-hero__rim { fill: rgba(255,255,255,.9); }\n  .tribunal-hero.tribunal-hero--consensus .tribunal-hero__arc { opacity: .22; }\n  .tribunal-hero.tribunal-hero--consensus .tribunal-hero__conviction-arc { opacity: 1; }\n  .tribunal-hero__consensus-chip { display: none; }\n  .tribunal-hero--consensus .tribunal-hero__consensus-chip { display: inline-flex; }\n  .tribunal-hero__judge--oracle { --jglow: rgba(74,158,255,.85); }\n  .tribunal-hero__judge--echo { --jglow: rgba(66,232,150,.85); }\n  .tribunal-hero__judge--pulse { --jglow: rgba(190,110,255,.85); }\n  .tribunal-hero__judge { box-shadow: 0 0 12px -2px var(--jglow, transparent), 0 0 2px var(--jglow, transparent); }\n  .tribunal-hero__dissent { display: inline-flex; align-items: center; gap: 3px; border: 1px dashed rgba(255,255,255,.34); border-radius: 9px; padding: 1px 6px; font-size: 9px; letter-spacing: .08em; color: rgba(255,255,255,.72); }\n  .tribunal-hero__instrument { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; }\n  .tribunal-hero__cell { background: var(--glass); border: 1px solid var(--glass-border); border-radius: 10px; padding: 6px 8px; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }\n  .tribunal-hero__cell-label { display: block; font-size: 8px; letter-spacing: .14em; color: rgba(255,255,255,.5); text-transform: uppercase; }\n  .tribunal-hero__cell-value { display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 700; color: #eaf2ff; }\n  .tribunal-hero__cell-value[data-arrow=\"up\"]::after { content: \"▲\"; color: #4ae898; font-size: 8px; }\n  .tribunal-hero__cell-value[data-arrow=\"down\"]::after { content: \"▼\"; color: #ff6b7a; font-size: 8px; }\n  .tribunal-hero__feed { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 3px; height: 26px; margin-top: 8px; padding: 0 4px; }\n  .tribunal-hero__feed-tick { flex: 1; border-radius: 2px 2px 0 0; background: linear-gradient(180deg, rgba(120,160,255,.85), rgba(56,84,160,.35)); height: 40%; opacity: .55; }\n  .tribunal-hero__feed-tick--hot { height: 100%; opacity: 1; box-shadow: 0 0 8px cyan; animation: cgPulse 1.6s ease-in-out infinite; }\n  .tribunal-hero__feed-label { display: block; flex-basis: 100%; font-size: 8px; letter-spacing: .14em; color: rgba(255,255,255,.5); text-transform: uppercase; margin-top: 2px; }\n  @keyframes cgPulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n  @media (max-width: 420px) { .tribunal-hero__cell { padding: 5px 6px; } .tribunal-hero__cell-value { font-size: 12px; } }\n  @media (prefers-reduced-motion: reduce) { .tribunal-hero__arc { transition: none; } }\n</style>\n<section\n  class=\"tribunal-hero\"\n  id=\"tribunal-hero\"\n  data-verdict-kind=\"cold\"\n  data-temp=\"cool\"\n  data-testid=\"tribunal-hero\"\n  data-hero-verdict=\"cold\"\n  \n  \n  \n  style=\"--p: 74;\"\n>\n  <header class=\"tribunal-hero__masthead\">\n    <div class=\"tribunal-hero__masthead-row\">\n      <h2 class=\"tribunal-hero__brand\" id=\"tribunal-hero-title\">Awaiting subnet</h2>\n      <p class=\"tribunal-hero__live\" role=\"status\">\n        <span class=\"tribunal-hero__kicker-dot\" aria-hidden=\"true\"></span>LIVE\n      </p>\n    </div>\n    <div class=\"tribunal-hero__meta-pills\" aria-label=\"Council metadata\">\n      \n      <span class=\"tribunal-hero__meta-pill\">3 VOTERS</span>\n      <span class=\"tribunal-hero__meta-pill\">AUDIT GATE 40% audit gate</span>\n    </div>\n    <p id=\"tribunal-hero-hold-reason\" class=\"tribunal-hero__hold-reason\" role=\"status\" hidden>None</p>\n  </header>\n\n  <div class=\"tribunal-hero__card\">\n    <div class=\"tribunal-hero__puffs\" aria-hidden=\"true\">\n      <span class=\"tribunal-hero__puff tribunal-hero__puff--1\"></span>\n      <span class=\"tribunal-hero__puff tribunal-hero__puff--2\"></span>\n      <span class=\"tribunal-hero__puff tribunal-hero__puff--3\"></span>\n      <span class=\"tribunal-hero__puff tribunal-hero__puff--4\"></span>\n      <span class=\"tribunal-hero__puff tribunal-hero__puff--5\"></span>\n      <span class=\"tribunal-hero__puff tribunal-hero__puff--6\"></span>\n    </div>\n\n    <div class=\"tribunal-hero__stage\">\n      <div class=\"tribunal-hero__hud-frame\" aria-hidden=\"true\">\n        <span class=\"tribunal-hero__bracket tribunal-hero__bracket--tl\"></span>\n        <span class=\"tribunal-hero__bracket tribunal-hero__bracket--tr\"></span>\n        <span class=\"tribunal-hero__bracket tribunal-hero__bracket--bl\"></span>\n        <span class=\"tribunal-hero__bracket tribunal-hero__bracket--br\"></span>\n      </div>\n\n      <svg class=\"tribunal-hero__rays\" viewBox=\"0 0 390 440\" aria-hidden=\"true\">\n        <path class=\"tribunal-hero__ray tribunal-hero__ray--oracle\" d=\"M195 96 C195 108 195 118 195 128\" />\n        <path class=\"tribunal-hero__ray tribunal-hero__ray--echo\" d=\"M78 348 C104 328 118 310 132 294\" />\n        <path class=\"tribunal-hero__ray tribunal-hero__ray--pulse\" d=\"M312 348 C286 328 272 310 258 294\" />\n      </svg>\n\n      \n      \n      \n      <div class=\"tribunal-hero__ring\">\n      <div class=\"tribunal-hero__ring-glow\" aria-hidden=\"true\"></div>\n      <svg class=\"tribunal-hero__radial\" viewBox=\"0 0 240 140\" aria-hidden=\"true\" data-glass-ring>\n        <defs>\n          <linearGradient id=\"cgOracle\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#3f8cff\"/><stop offset=\"100%\" stop-color=\"#7ec3ff\"/>\n          </linearGradient>\n          <linearGradient id=\"cgEcho\" x1=\"