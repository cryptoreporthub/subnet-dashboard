*/\n(function () {\n  \"use strict\";\n\n  var whisperTimer = null;\n\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n\n  function fmtAge(iso) {\n    if (!iso) return \"\";\n    var t = Date.parse(iso);\n    if (isNaN(t)) return \"\";\n    var mins = Math.max(0, Math.floor((Date.now() - t) / 60000));\n    if (mins < 1) return \"just now\";\n    if (mins === 1) return \"1m ago\";\n    return mins + \"m ago\";\n  }\n\n  function dayHold(snapshot) {\n    var day = snapshot && snapshot.day;\n    if (!day) return false;\n    return String(day.action || \"HOLD\").toUpperCase() === \"HOLD\" && !day.published;\n  }\n\n  function renderShiftWhisper(meta) {\n    var el = document.getElementById(\"hour-watch-shift\");\n    if (!el) return;\n    if (!meta || !meta.changed || !meta.previous_lead) {\n      el.hidden = true;\n      el.textContent = \"\";\n      return;\n    }\n    var prev = meta.previous_lead;\n    var lead = document.getElementById(\"hour-watch-now\");\n    var curName = lead && lead.dataset.name ? lead.dataset.name : \"lead\";\n    el.textContent = \"1h lead shifted · \" + (prev.name || \"SN\" + prev.netuid) + \" → \" + curName;\n    el.hidden = false;\n    if (whisperTimer) clearTimeout(whisperTimer);\n    var reduced = window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    if (!reduced) {\n      whisperTimer = setTimeout(function () {\n        el.hidden = true;\n      }, 8000);\n    }\n  }\n\n  function patchHourWatch(snapshot) {\n    var host = document.getElementById(\"hour-watch-now\");\n    if (!host || !snapshot) return;\n\n    var hour = snapshot.hour || {};\n    var picks = hour.picks || [];\n    var meta = hour.meta || {};\n    var emittedAt = snapshot.emitted_at;\n\n    if (!picks.length) {\n      host.className = \"hour-watch-now hour-watch-now--quiet\";\n      host.textContent = meta.quiet_reason || \"Council quiet on 1h — no name cleared the short lens\";\n      host.removeAttribute(\"href\");\n      host.dataset.netuid = \"\";\n      host.dataset.name = \"\";\n      renderShiftWhisper(meta);\n      return;\n    }\n\n    var lead = picks[0];\n    var pct = Math.round(Number(lead.final_confidence || lead.confidence || 0) * 100);\n    var name = lead.name || (lead.netuid != null ? \"SN\" + lead.netuid : \"—\");\n    var age = fmtAge(lead.generated_at || emittedAt);\n    var line = \"Now · \" + name;\n    if (lead.netuid != null) line += \" SN\" + lead.netuid;\n    line += \" · \" + pct + \"% · exploratory\";\n    if (age) line += \" · updated \" + age;\n    if (dayHold(snapshot)) line += \" · not today's call\";\n\n    host.className = \"hour-watch-now hour-watch-now--live\";\n    host.textContent = line;\n    host.href = \"/?focus=\" + encodeURIComponent(String(lead.netuid));\n    host.dataset.netuid = String(lead.netuid);\n    host.dataset.name = name;\n    renderShiftWhisper(meta);\n  }\n\n  window.HourWatchUI = {\n    patchHourWatch: patchHourWatch,\n  };\n})();\n"},"headersSize":0,"bodySize":1575,"redirectURL":"","_transferSize":1575},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1133.359,"receive":317.969},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.244Z","time":1403.963,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/premium_judges.js?v=7b9cae5e","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/premium_judges.js?v=7b9cae5e"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[{"name":"v","value":"7b9cae5e"}],"headersSize":596,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:32 GMT"},{"name":"etag","value":"\"2678a1d1ba145357e0868ae0616b15e9\""},{"name":"fly-request-id","value":"01M109DZBZVGWE5NFEVA0M7KZV-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=878.3"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":5376,"mimeType":"text/javascript; charset=utf-8","compression":3015,"text":"/* Judge council cards — lazy load when Pro cockpit opens (§29-8) */\n(function () {\n  'use strict';\n\n  var panel = document.getElementById('judges-panel');\n  var drawer = document.getElementById('pro-cockpit');\n  if (!panel) return;\n\n  var loaded = false;\n  var FETCH_MS = 18000;\n\n  function esc(s) {\n    return String(s).replace(/[&<>\"']/g, function (c) {\n      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c];\n    });\n  }\n\n  function verdictClass(v) {\n    if (v === 'bullish' || v === 'long') return 'badge-buy';\n    if (v === 'bearish' || v === 'short') return 'badge-sell';\n    return 'badge-watch';\n  }\n\n  function focusNetuid() {\n    if (window.LivingFocus && window.LivingFocus.netuid != null) {\n      return window.LivingFocus.netuid;\n    }\n    var root = document.getElementById('section-living-focus');\n    if (root && root.getAttribute('data-focus-netuid')) {\n      return Number(root.getAttribute('data-focus-netuid'));\n    }\n    return null;\n  }\n\n  function alreadyRendered() {\n    return !!(panel.querySelector('.judge-summary') || panel.querySelector('.kpi-grid'));\n  }\n\n  function judgeCard(j, opts) {\n    opts = opts || {};\n    var verdict = (j.consensus && j.consensus.verdict) || 'neutral';\n    var score = j.consensus ? j.consensus.score : null;\n    var oracle = (j.oracle && j.oracle.score != null) ? Number(j.oracle.score).toFixed(2) : 'unavailable';\n    var echo = (j.echo && j.echo.score != null) ? Number(j.echo.score).toFixed(2) : 'unavailable';\n    var pulse = (j.pulse && j.pulse.score != null) ? Number(j.pulse.score).toFixed(2) : 'unavailable';\n    var title = opts.link\n      ? '<a href=\"/subnet/' + esc(j.netuid) + '\">' + esc(j.name || ('SN' + j.netuid)) + '</a>'\n      : esc(j.name || ('SN' + j.netuid));\n    var meta = 'SN' + esc(j.netuid) + (score != null ? ' · consensus ' + Number(score).toFixed(2) : ' · consensus unavailable');\n    if (opts.focus) meta += ' · Living Focus';\n    if (j.consensus && j.consensus.weights_degraded) meta += ' · weights unavailable';\n    function chip(label, block) {\n      if (block && (block.score == null || block.status === 'degraded' || block[label + '_degraded'])) {\n        return '<div class=\"kpi-cell\"><div class=\"k\">' + label.charAt(0).toUpperCase() + label.slice(1) + '</div><div class=\"v\">score unavailable</div></div>';\n      }\n      var val = block && block.score != null ? Number(block.score).toFixed(2) : '—';\n      return '<div class=\"kpi-cell\"><div class=\"k\">' + label.charAt(0).toUpperCase() + label.slice(1) + '</div><div class=\"v\">' + val + '</div></div>';\n    }\n    return '<article class=\"card judge-summary\" style=\"margin-bottom:10px;\">' +\n      '<div class=\"card-head\"><h3>' + title + '</h3>' +\n      '<span class=\"badge ' + verdictClass(verdict) + '\">' + esc(String(verdict).toUpperCase()) + '</span></div>' +\n      '<div class=\"pick-meta\">' + meta + '</div>' +\n      '<div class=\"kpi-grid\" style=\"grid-template-columns:repeat(3,1fr);margin-top:8px;\">' +\n      chip('oracle', j.oracle) + chip('echo', j.echo) + chip('pulse', j.pulse) +\n      '</div></article>';\n  }\n\n  function renderLeague(judges) {\n    if (!judges.length) {\n      panel.innerHTML = '<p class=\"empty empty--quiet\">Quiet — no lane judge scores yet. Council scoring warms after subnet snapshots load.</p>';\n      return;\n    }\n    var cards = judges.slice(0, 12).map(function (j) {\n      return judgeCard(j, { link: true });\n    }).join('');\n    panel.innerHTML = '<div class=\"picks\">' + cards + '</div>' +\n      '<p class=\"pick-meta\" style=\"margin-top:8px;\">' + judges.length + ' subnets scored</p>';\n  }\n\n  function fetchJson(url, ms) {\n    return new Promise(function (resolve, reject) {\n      var ctrl = new AbortController();\n      var timer = setTimeout(function () {\n        ctrl.abort();\n        reject(new Error('timeout'));\n      }, ms);\n      fetch(url, { headers: { Accept: 'application/json' }, signal: ctrl.signal })\n        .then(function (r) {\n          clearTimeout(timer);\n          if (!r.ok) throw new Error(String(r.status));\n          return r.json();\n        })\n        .then(resolve)\n        .catch(function (err) {\n          clearTimeout(timer);\n          reject(err);\n        });\n    });\n  }\n\n  function loadJudges() {\n    if (loaded || alreadyRendered()) {\n      loaded = true;\n      return;\n    }\n    loaded = true;\n    panel.innerHTML = '<p class=\"empty\">Building — lane judges loading…</p>';\n    var focus = focusNetuid();\n    var url = focus != null ? '/api/judges/' + encodeURIComponent(focus) : '/api/judges';\n    fetchJson(url, FETCH_MS)\n      .then(function (data) {\n        if (focus != null && data && !data.error) {\n          panel.innerHTML = judgeCard(data, { focus: true });\n          return;\n        }\n        renderLeague((data && data.judges) || []);\n      })\n      .catch(function () {\n        panel.innerHTML = '<p class=\"empty empty--quiet\">Quiet — lane judges unavailable. Retry when /api/judges responds.</p>';\n        loaded = false;\n      });\n  }\n\n  if (window.afterHeroCritical) window.afterHeroCritical(loadJudges);\n  else loadJudges();\n  if (drawer) {\n    drawer.addEventListener('toggle', function () {\n      if (drawer.open) loadJudges();\n    });\n  }\n\n  document.addEventListener('living-focus:change', function () {\n    if (!drawer || !drawer.open) return;\n    loaded = false;\n    loadJudges();\n  });\n})();\n"},"headersSize":0,"bodySize":2361,"redirectURL":"","_transferSize":2361},"cache":{},"timings":{"dns":-1,"connect":-