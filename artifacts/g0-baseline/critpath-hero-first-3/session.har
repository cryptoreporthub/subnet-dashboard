rsion":"HTTP/2.0","cookies":[{"name":"message-intel-owner","value":"raqQWnDH3EjgNHyWJqk3aMccc3rPDfjv.2d7d12887c6b313c7a823ef761f0e54170d116d61c455618a88f47e896a8cea1"}],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/social_sentiment.js"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"cookie","value":"message-intel-owner=raqQWnDH3EjgNHyWJqk3aMccc3rPDfjv.2d7d12887c6b313c7a823ef761f0e54170d116d61c455618a88f47e896a8cea1"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[],"headersSize":716,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:43 GMT"},{"name":"etag","value":"\"911edf1218e96c9f886639342424f8b6\""},{"name":"fly-request-id","value":"01M109EBMP9ZRYG5JAP0QJ543M-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=15.7"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":3935,"mimeType":"text/javascript; charset=utf-8","compression":2161,"text":"/** §19.M2 — social sentiment cards from live message-intel rollup */\n(function () {\n  \"use strict\";\n\n  var root = document.getElementById(\"social-sentiment-root\");\n  if (!root) return;\n\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n\n  function scoreClass(label) {\n    var l = String(label || \"neutral\").toLowerCase();\n    if (l === \"bullish\") return \"pos\";\n    if (l === \"bearish\") return \"neg\";\n    return \"neu\";\n  }\n\n  function tierClass(label) {\n    var l = String(label || \"neutral\").toLowerCase();\n    if (l === \"bullish\") return \"tier-cyan\";\n    if (l === \"bearish\") return \"tier-gold\";\n    return \"tier-lime\";\n  }\n\n  function renderRows(rows) {\n    var maxMentions = 1;\n    rows.forEach(function (row) {\n      var m = Number(row.mentions) || 0;\n      if (m > maxMentions) maxMentions = m;\n    });\n    var html = '<div class=\"soc-grid\">';\n    rows.forEach(function (row, idx) {\n      var label = String(row.label || \"neutral\").toLowerCase();\n      var pct = Math.round(Number(row.score || 0.5) * 100);\n      var mentions = Number(row.mentions) || 0;\n      var volPct = maxMentions > 0 ? Math.round((mentions / maxMentions) * 100) : 0;\n      var hotClass = idx === 0 && mentions > 0 ? \" soc-card--hot\" : \"\";\n      html +=\n        '<div class=\"card soc-card soc-card--' +\n        esc(label) +\n        \" soc-card--enter\" +\n        hotClass +\n        '\" style=\"--soc-i:' +\n        idx +\n        \"; --soc-vol:\" +\n        volPct +\n        '\">' +\n        '<div class=\"soc-head\">' +\n        '<span class=\"pick-name\">' +\n        esc(row.name || \"SN\" + row.netuid) +\n        \"</span>\" +\n        '<span class=\"soc-score ' +\n        scoreClass(label) +\n        '\">' +\n        esc(label.toUpperCase()) +\n        \"</span>\" +\n        \"</div>\" +\n        '<div class=\"pick-meta\">SN' +\n        esc(row.netuid) +\n        \" · \" +\n        esc(mentions) +\n        \" mentions</div>\" +\n        '<div class=\"soc-vol-track\" aria-hidden=\"true\"><span class=\"soc-vol-fill\"></span></div>' +\n        '<div class=\"conviction-bar mt-2\"><div class=\"conviction-fill ' +\n        tierClass(label) +\n        '\" style=\"width:' +\n        pct +\n        '%;\"></div></div>' +\n        \"</div>\";\n    });\n    html += \"</div>\";\n    return html;\n  }\n\n  function renderEmpty(listener) {\n    listener = listener || {};\n    if (listener.live) {\n      return (\n        '<div class=\"card card-muted\"><p class=\"empty\">Listener live — per-subnet sentiment ' +\n        \"cards populate when messages mention netuids.</p></div>\"\n      );\n    }\n    return (\n      '<div class=\"card card-muted\"><p class=\"empty\">Social sentiment warming up — ' +\n      \"message intel or registry mentions will populate here.</p></div>\"\n    );\n  }\n\n  async function hydrate(force) {\n    if (!force && root.querySelector(\".soc-card\")) return;\n    try {\n      var statusRes = await fetch(\"/api/message-intel/status\");\n      var status = statusRes.ok ? await statusRes.json() : null;\n      var res = await fetch(\"/api/message-intel/social?limit=6\");\n      if (!res.ok) throw new Error(\"HTTP \" + res.status);\n      var payload = await res.json();\n      if (payload.rows && payload.rows.length) {\n        root.innerHTML = renderRows(payload.rows);\n      } else if (!root.querySelector(\".soc-grid\")) {\n        root.innerHTML = renderEmpty(status && status.listener);\n      }\n    } catch (e) {\n      if (!root.querySelector(\".soc-card\") && !root.querySelector(\".soc-grid\")) {\n        root.innerHTML =\n          '<div class=\"card card-muted\"><p class=\"empty\">Social sentiment unavailable right now.</p></div>';\n      }\n    }\n  }\n\n  document.addEventListener(\"home:cockpit-tick\", function () {\n    hydrate(true);\n  });\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", hydrate);\n  } else {\n    hydrate();\n  }\n})();\n"},"headersSize":0,"bodySize":1774,"redirectURL":"","_transferSize":1774},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":98.728,"receive":28.257},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:44.942Z","time":127.522,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/api/message-intel/status","httpVersion":"HTTP/2.0","cookies":[{"name":"message-intel-owner","value":"raqQWnDH3EjgNHyWJqk3aMccc3rPDfjv.2d7d12887c6b313c7a823ef761f0e54170d116d61c455618a88f47e896a8cea1"}],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/api/message-intel/status"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{