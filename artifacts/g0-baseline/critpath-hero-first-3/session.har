nfTier(conf) {\n    var c = Number(conf);\n    if (c <= 1) c *= 100;\n    c = Math.round(c);\n    if (c > THRESHOLDS.cyan) return { tier: 'tier-cyan', conf: c };\n    if (c > THRESHOLDS.lime) return { tier: 'tier-lime', conf: c };\n    if (c > THRESHOLDS.gold) return { tier: 'tier-gold', conf: c };\n    return { tier: 'tier-red', conf: c };\n  }\n\n  global.ConvictionTiers = { THRESHOLDS: THRESHOLDS, confTier: confTier };\n})(typeof window !== 'undefined' ? window : this);\n"},"headersSize":0,"bodySize":484,"redirectURL":"","_transferSize":484},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1350.741,"receive":192.271},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.243Z","time":1629.514,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/js/empty_state.js?v=7b9cae5e","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/js/empty_state.js?v=7b9cae5e"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"referer","value":"https://subnet-dashboard.fly.dev/"},{"name":"sec-ch-ua","value":"\"Not=A?Brand\";v=\"99\", \"HeadlessChrome\";v=\"151\", \"Chromium\";v=\"151\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 G0Harness/1058"}],"queryString":[{"name":"v","value":"7b9cae5e"}],"headersSize":590,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-headers","value":"Content-Type, Authorization"},{"name":"access-control-allow-methods","value":"GET, POST, OPTIONS"},{"name":"cache-control","value":"public, max-age=300, must-revalidate"},{"name":"content-encoding","value":"zstd"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:32 GMT"},{"name":"etag","value":"\"3aaa40cfa80197acaa123fc2caa42963\""},{"name":"fly-request-id","value":"01M109DZBX88HEDRHF56K4NXZ1-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=1100.8"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":1796,"mimeType":"text/javascript; charset=utf-8","compression":856,"text":"/** Branded desk empty states for hydrate panels (ponytail: one helper, no framework). */\n(function (g) {\n  'use strict';\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c];\n    });\n  }\n\n  function buildDeskEmptyState(opts) {\n    opts = opts || {};\n    var kind = opts.kind || 'empty';\n    if (kind !== 'warming' && kind !== 'error') kind = 'empty';\n    var title = opts.title || '';\n    var body = opts.body || '';\n    var progressN = opts.progressN;\n    var progressMax = opts.progressMax;\n    var extra = opts.classExtra || '';\n    var id = opts.id || '';\n    var html =\n      '<div class=\"desk-empty-state desk-empty-state--' +\n      esc(kind) +\n      (extra ? ' ' + esc(extra) : '') +\n      '\"' +\n      (id ? ' id=\"' + esc(id) + '\"' : '') +\n      ' role=\"status\">';\n    html += '<span class=\"desk-empty-state__glyph\" aria-hidden=\"true\"></span>';\n    html += '<div class=\"desk-empty-state__body\">';\n    if (title) html += '<p class=\"desk-empty-state__title\">' + esc(title) + '</p>';\n    if (body) html += '<p class=\"desk-empty-state__text\">' + esc(body) + '</p>';\n    if (progressN != null && progressMax != null && Number(progressMax) > 0) {\n      var pct = Math.min(100, Math.round((Number(progressN) / Number(progressMax)) * 100));\n      html +=\n        '<p class=\"desk-empty-state__progress\">Building sample — ' +\n        esc(progressN) +\n        '/' +\n        esc(progressMax) +\n        '</p>';\n      html +=\n        '<div class=\"desk-empty-state__bar\" aria-hidden=\"true\"><span style=\"width:' +\n        pct +\n        '%\"></span></div>';\n    }\n    html += '</div></div>';\n    return html;\n  }\n\n  g.buildDeskEmptyState = buildDeskEmptyState;\n})(window);\n"},"headersSize":0,"bodySize":940,"redirectURL":"","_transferSize":940},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1458.435,"receive":171.079},"_resourceType":"script","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:2