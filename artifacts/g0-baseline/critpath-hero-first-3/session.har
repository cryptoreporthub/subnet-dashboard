ype","value":"text/css; charset=utf-8"},{"name":"date","value":"Thu, 27 Aug 2026 00:20:32 GMT"},{"name":"etag","value":"\"cb4c0f6d81b26ea070c0f05e970646e6\""},{"name":"fly-request-id","value":"01M109DZBQ4BEVBWMRXMXVB2XR-ord"},{"name":"last-modified","value":"Thu, 27 Aug 2026 00:03:26 GMT"},{"name":"permissions-policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"server","value":"Fly/e93089d61 (2026-08-20)"},{"name":"server-timing","value":"app;dur=1084.3"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"via","value":"2 fly.io, 2 fly.io"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"}],"content":{"size":1999,"mimeType":"text/css; charset=utf-8","compression":1109,"text":"/* SimiVision — chat panel */\n/* ---------- Chat ---------- */\n.chat-box {\n  display: flex;\n  flex-direction: column;\n  height: 420px;\n}\n\n.chat-log {\n  flex: 1;\n  overflow-y: auto;\n  padding: 6px 2px;\n}\n\n.chat-msg {\n  padding: 10px 13px;\n  border-radius: 12px;\n  margin-bottom: 10px;\n  max-width: 88%;\n  font-size: 13px;\n  line-height: 1.55;\n}\n\n.chat-msg.user {\n  background: rgba(0, 255, 65, 0.08);\n  border: 1px solid var(--border-default);\n  margin-left: auto;\n}\n\n.chat-msg.bot {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n}\n\n.chat-msg .who {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-bottom: 3px;\n}\n\n.chat-text {\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.chat-input {\n  display: flex;\n  gap: 10px;\n  margin-top: 10px;\n}\n\n.chat-input input {\n  flex: 1;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: 11px;\n  padding: 12px 14px;\n  color: var(--text-primary);\n  font-family: var(--font-body);\n  font-size: 13px;\n  outline: none;\n}\n\n.chat-input input:focus {\n  border-color: var(--accent-bright);\n  box-shadow: 0 0 12px var(--accent-glow);\n}\n\n.chat-input button {\n  background: linear-gradient(135deg, var(--accent-bright), var(--accent-primary));\n  color: var(--bg-base);\n  border: none;\n  border-radius: 11px;\n  padding: 0 20px;\n  font-weight: 700;\n  font-family: var(--font-display);\n  cursor: pointer;\n}\n\n.chat-input button:disabled { opacity: 0.5; cursor: wait; }\n\n.chat-meta {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-top: 8px;\n}\n\n/* ---------- Chat (cockpit tint) ---------- */\n.chat-msg.user {\n  background: var(--cockpit-green-soft);\n  border-color: var(--cockpit-green-line);\n}\n.chat-input input:focus {\n  border-color: var(--cockpit-green);\n  box-shadow: 0 0 14px var(--cockpit-green-glow);\n}\n.chat-input button {\n  background: linear-gradient(135deg, #00c8ff, #00ff41);\n  color: var(--bg-cockpit);\n}\n"},"headersSize":0,"bodySize":890,"redirectURL":"","_transferSize":890},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1435.639,"receive":175.16},"_resourceType":"stylesheet","serverIPAddress":"66.241.125.254","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.fly.dev","issuer":"YE1","validFrom":1787312973,"validTo":1795088972}},{"pageref":"page@69f91f05ab08b5e762ccfabd051f9be5","startedDateTime":"2026-08-27T00:20:32.237Z","time":1017.424,"request":{"method":"GET","url":"https://subnet-dashboard.fly.dev/static/vendor/uplot/uPlot.min.css","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"subnet-dashboard.fly.dev"},{"name":":method","value":"GET"},{"name":":path","value":"/static/vendor/uplot/uPlot.min.css"},{"name":":scheme","value":"https"},{"name":"accept","value":"text/css,*/*;q=0.1"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"priority","value":"u=4"},{"name":"referer","value":"https://subnet-dashboard.fly.dev